/* ================= 极简 AI 语音页面（按设计稿） ================= */

.pure-screen {
  position: relative;
  width: 100%;
  height: 100vh;
  min-height: 100vh;
  background: #ffffff;
  overflow: hidden;
  box-sizing: border-box;
}

.pure-back-hit {
  position: fixed;
  left: 0;
  z-index: 30;
  width: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pure-back-hit:active {
  opacity: 0.45;
}

.pure-back-arrow {
  font-size: 48rpx;
  font-weight: 300;
  color: #1d1d1f;
  line-height: 1;
  margin-left: -8rpx;
}

/* 1. 顶部状态 */
.top-meta {
  position: fixed;
  left: 0;
  right: 0;
  text-align: center;
  z-index: 20;
  pointer-events: none;
}

.top-meta-row {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(245, 245, 247, 0.92);
  border: 1rpx solid rgba(0, 0, 0, 0.06);
}

.top-meta-row--open {
  background: rgba(52, 199, 89, 0.1);
  border-color: rgba(52, 199, 89, 0.18);
}

.top-meta-row--closed {
  background: rgba(142, 142, 147, 0.1);
  border-color: rgba(142, 142, 147, 0.16);
}

.top-meta-row--stealth {
  background: rgba(175, 82, 222, 0.1);
  border-color: rgba(175, 82, 222, 0.18);
}

.top-meta-row--moving,
.top-meta-row--unknown {
  background: rgba(255, 159, 10, 0.12);
  border-color: rgba(255, 159, 10, 0.22);
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  background: #ff9f0a;
  border-radius: 50%;
  margin-right: 14rpx;
  flex-shrink: 0;
  box-shadow: 0 0 0 4rpx rgba(255, 159, 10, 0.18);
}

.status-dot--open {
  background: #34c759;
  box-shadow: 0 0 0 4rpx rgba(52, 199, 89, 0.2);
}

.status-dot--closed {
  background: #636366;
  box-shadow: 0 0 0 4rpx rgba(99, 99, 102, 0.16);
}

.status-dot--stealth {
  background: #af52de;
  box-shadow: 0 0 0 4rpx rgba(175, 82, 222, 0.2);
}

.status-dot--moving,
.status-dot--unknown {
  background: #ff9f0a;
  box-shadow: 0 0 0 4rpx rgba(255, 159, 10, 0.2);
}

.status-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d1d1f;
  letter-spacing: 0.5rpx;
  line-height: 1;
}

.top-meta-row--open .status-text {
  color: #248a3d;
}

.top-meta-row--closed .status-text {
  color: #48484a;
}

.top-meta-row--stealth .status-text {
  color: #8944ab;
}

.top-meta-row--moving .status-text,
.top-meta-row--unknown .status-text {
  color: #c93400;
}

/* 2. 核心区：AI 灵动弦 — 屏幕正中（可点击） */
.ai-engine {
  position: absolute;
  top: 46%;
  left: 0;
  right: 0;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  z-index: 1;
  padding: 80rpx 40rpx;
  box-sizing: border-box;
}

.ai-engine:active {
  opacity: 0.88;
}

.ai-engine.is-busy:active {
  opacity: 1;
}

.string-container {
  width: 480rpx;
  height: 4rpx;
  background: rgba(0, 0, 0, 0.03);
  position: relative;
  border-radius: 4rpx;
  overflow: visible;
}

.tap-hint {
  margin-top: 36rpx;
  font-size: 24rpx;
  color: #aeaeb2;
  letter-spacing: 0.08em;
}

.ai-string {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 4rpx;
  background: linear-gradient(90deg,
      transparent 0%,
      #007aff 50%,
      transparent 100%
  );
  filter: blur(2rpx);
  transform-origin: center center;
  animation: string-flow 3s infinite ease-in-out;
}

.string-wave {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 240rpx;
  height: 56rpx;
  margin-top: -28rpx;
  margin-left: -120rpx;
  background: radial-gradient(ellipse at center, rgba(0, 122, 255, 0.14) 0%, transparent 72%);
  pointer-events: none;
  animation: ripple 2.5s infinite ease-in-out;
}

.ai-engine.quiet .ai-string {
  animation-duration: 2.4s;
}

.ai-engine.quiet .string-wave {
  animation-duration: 2.2s;
}

.ai-engine.speaking .ai-string {
  animation-duration: 1s;
  filter: blur(1.5rpx);
  opacity: 1;
}

.ai-engine.speaking .string-wave {
  animation-duration: 0.85s;
  background: radial-gradient(ellipse at center, rgba(0, 122, 255, 0.28) 0%, transparent 72%);
}

.ai-engine.dormant .ai-string {
  animation-duration: 3s;
  opacity: 0.45;
}

.ai-engine.dormant .string-wave {
  animation-duration: 2.8s;
  opacity: 0.35;
}

/* 3. 底部对话引导 */
.dialog-area {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
  text-align: center;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.main-msg {
  font-size: 48rpx;
  font-weight: 600;
  color: #1d1d1f;
  letter-spacing: -1rpx;
  margin-bottom: 20rpx;
  opacity: 0.9;
}

.sub-msg {
  font-size: 28rpx;
  color: #86868b;
  font-weight: 400;
  line-height: 1.4;
  margin-bottom: 36rpx;
  padding: 0 48rpx;
}

.speak-btn {
  min-width: 360rpx;
  height: 100rpx;
  padding: 0 48rpx;
  border-radius: 999rpx;
  background: #111;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.16);
  transition: transform 0.15s ease, opacity 0.15s ease, background 0.2s ease;
  box-sizing: border-box;
}

.speak-btn:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.speak-btn.is-listening {
  background: #007aff;
  box-shadow: 0 12rpx 32rpx rgba(0, 122, 255, 0.28);
}

.speak-btn-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 0.04em;
}

.admin-footer {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  text-align: center;
  font-size: 20rpx;
  color: #d1d1d6;
  letter-spacing: 2rpx;
  z-index: 2;
  pointer-events: none;
}

.kw-entry-hit {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.kw-entry-hit:active .kw-entry-link {
  opacity: 0.55;
}

.kw-entry-link {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 12rpx 20rpx;
}

.kw-entry-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #8e8e93;
  letter-spacing: 0.02em;
}

.kw-entry-arrow {
  font-size: 30rpx;
  font-weight: 300;
  color: #c7c7cc;
  line-height: 1;
  margin-top: -2rpx;
}

.kw-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(0, 0, 0, 0.32);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  animation: kwMaskIn 0.28s ease;
}

.kw-mask.is-closing {
  animation: kwMaskOut 0.28s ease forwards;
}

.kw-sheet {
  width: 100%;
  max-height: 82vh;
  background: #f5f5f7;
  border-radius: 40rpx 40rpx 0 0;
  padding: 16rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  box-shadow: 0 -12rpx 48rpx rgba(0, 0, 0, 0.08);
  animation: kwSheetIn 0.34s cubic-bezier(0.22, 1, 0.36, 1);
}

.kw-sheet.is-closing {
  animation: kwSheetOut 0.28s ease forwards;
}

@keyframes kwMaskIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes kwMaskOut {
  from { opacity: 1; }
  to { opacity: 0; }
}

@keyframes kwSheetIn {
  from {
    opacity: 0.96;
    transform: translateY(100%);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes kwSheetOut {
  from {
    opacity: 1;
    transform: translateY(0);
  }
  to {
    opacity: 0.96;
    transform: translateY(100%);
  }
}

.kw-sheet-handle {
  width: 64rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: #d1d1d6;
  align-self: center;
  margin-bottom: 24rpx;
}

.kw-sheet-head {
  padding: 0 8rpx 20rpx;
}

.kw-sheet-kicker {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: #8e8e93;
  letter-spacing: 0.12em;
  margin-bottom: 10rpx;
}

.kw-sheet-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #111;
  letter-spacing: -0.5rpx;
  line-height: 1.2;
  margin-bottom: 10rpx;
}

.kw-sheet-desc {
  font-size: 26rpx;
  color: #636366;
  line-height: 1.55;
}

.kw-sheet-scroll {
  flex: 1;
  max-height: 50vh;
  min-height: 300rpx;
}

.kw-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.kw-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.kw-card-label {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.kw-card-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #111;
}

.kw-card-hint {
  font-size: 22rpx;
  color: #aeaeb2;
}

.kw-card-count {
  font-size: 22rpx;
  font-weight: 600;
  color: #aeaeb2;
  padding-top: 4rpx;
}

.kw-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.kw-empty {
  font-size: 24rpx;
  color: #c7c7cc;
  margin-bottom: 20rpx;
  padding: 4rpx 0;
}

.kw-chip {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: #f5f5f7;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
}

.kw-chip-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.kw-chip-del {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.06);
  font-size: 24rpx;
  color: #636366;
  line-height: 32rpx;
  text-align: center;
}

.kw-field {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx;
  border-radius: 22rpx;
  background: #f5f5f7;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}

.kw-input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #111;
  box-sizing: border-box;
  background: transparent;
}

.kw-add-btn {
  flex-shrink: 0;
  height: 64rpx;
  padding: 0 26rpx;
  border-radius: 16rpx;
  background: #111;
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.kw-add-btn:active {
  opacity: 0.82;
}

.kw-sheet-actions {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-top: 8rpx;
  padding-top: 8rpx;
}

.kw-btn {
  flex: 1;
  height: 92rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.kw-btn--ghost {
  background: #fff;
  color: #111;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
}

.kw-btn--primary {
  background: #111;
  color: #fff;
}

.kw-btn--primary.is-busy {
  opacity: 0.55;
  pointer-events: none;
}

.kw-btn:active {
  opacity: 0.85;
}

@keyframes string-flow {
  0%, 100% {
    transform: scaleX(0.4);
    opacity: 0.2;
  }
  50% {
    transform: scaleX(1);
    opacity: 0.8;
  }
}

@keyframes ripple {
  0%, 100% {
    transform: scale(0.75);
    opacity: 0.25;
  }
  50% {
    transform: scale(1.35);
    opacity: 0.95;
  }
}
