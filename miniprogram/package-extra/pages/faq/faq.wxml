<view class="container">
  <view class="faq-top-nav">
    <view class="back-icon" catchtap="goBack" style="top: {{statusBarHeight + 4}}px;">
      <text class="back-arrow">‹</text>
    </view>
  </view>

  <view class="page-home {{showDetail && !detailClosing ? 'is-detail-open' : ''}}">
    <view class="header" style="padding-top: {{statusBarHeight + navBarHeight}}px;">
      <view class="header-row">
        <view class="header-copy">
          <text class="header-title">帮助中心</text>
          <text class="header-sub">请选择你的设备系列</text>
        </view>
        <view
          wx:if="{{isAuthorized}}"
          class="admin-toggle-btn {{isAdmin ? 'on' : ''}}"
          catchtap="toggleAdminMode"
        >{{isAdmin ? 'EXIT' : 'EDIT'}}</view>
      </view>
    </view>

    <view class="home-admin-tip" wx:if="{{isAdmin}}">
      <text>点系列改问题，再点问题改排查步骤</text>
    </view>

    <view class="card-stack card-stack--fill">
      <view
        class="big-card"
        wx:for="{{seriesList}}"
        wx:key="name"
        hover-class="big-card-hover"
        bindtap="openSeries"
        data-name="{{item.name}}"
      >
        <view class="big-card-row">
          <view class="big-card-left">
            <view class="big-card-key">MT</view>
            <text class="big-card-title">{{item.name}} 系列</text>
          </view>
          <view class="big-card-meta">
            <text class="big-card-sub">查看常见问题</text>
            <text class="big-card-chevron">›</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view
    class="detail-layer {{showDetail ? 'is-visible' : ''}} {{detailAnimIn && !detailClosing ? 'is-in' : ''}} {{detailClosing ? 'is-out' : ''}}"
    wx:if="{{showDetail || detailClosing}}"
    catchtouchmove="stopTap"
  >
    <view class="detail-panel">
      <view class="detail-nav" style="padding-top: {{statusBarHeight}}px; height: {{statusBarHeight + navBarHeight}}px;">
        <view class="detail-back" catchtap="closeDetail">‹</view>
        <text class="detail-nav-title">{{currentSeries}} 系列</text>
        <view class="detail-nav-right" wx:if="{{isAdmin}}" catchtap="onAddQuestion">新增</view>
        <view class="detail-nav-right" wx:else></view>
      </view>

      <scroll-view class="detail-scroll" scroll-y style="padding-top: {{statusBarHeight + navBarHeight}}px;">
        <view class="detail-fill" style="min-height: {{windowHeight - statusBarHeight - navBarHeight}}px;">
        <view class="detail-section-head">
          <text class="section-label">选择你遇到的问题</text>
        </view>

        <view class="detail-admin-add" wx:if="{{isAdmin}}" catchtap="onAddQuestion">＋ 新增问题</view>

        <view class="detail-loading" wx:if="{{questionsLoading}}">加载中…</view>
        <view class="detail-error" wx:elif="{{questionsError}}">
          <text>{{questionsError}}</text>
          <view class="detail-retry" catchtap="loadQuestions">重试</view>
        </view>

        <view class="card-stack card-stack--fill detail-q-section" wx:else>
          <view
            class="big-card big-card--q"
            wx:if="{{questions.length}}"
            wx:for="{{questions}}"
            wx:key="_id"
            hover-class="big-card-hover"
            bindtap="openQuestion"
            data-qid="{{item._id}}"
            data-tree-id="{{item.treeId}}"
            data-title="{{item.title}}"
          >
            <view class="big-card-row">
              <view class="big-card-left">
                <view class="big-card-key">MT</view>
                <text class="big-card-title">{{item.title}}</text>
              </view>
              <view class="item-admin-col" wx:if="{{isAdmin}}" catchtap="stopTap">
                <view
                  class="faq-q-sync"
                  catchtap="onToggleQuestionSyncAll"
                  data-qid="{{item._id}}"
                  data-sync-all="{{item.syncAll}}"
                >
                  <view class="faq-edit-check {{item.syncAll ? 'on' : ''}}"></view>
                  <text>同步全部</text>
                </view>
                <view class="item-admin-actions">
                  <view
                    class="item-admin-tag"
                    catchtap="onRenameQuestion"
                    data-qid="{{item._id}}"
                    data-title="{{item.title}}"
                    data-sync-all="{{item.syncAll}}"
                  >改名</view>
                  <view
                    class="item-admin-tag item-admin-tag--danger"
                    catchtap="onDeleteQuestion"
                    data-qid="{{item._id}}"
                    data-title="{{item.title}}"
                  >删除</view>
                </view>
              </view>
              <view class="big-card-meta" wx:else>
                <text class="big-card-sub">对照演示排查</text>
                <text class="big-card-chevron">›</text>
              </view>
            </view>
          </view>
          <view class="detail-empty" wx:if="{{!questions.length}}">
            <text>暂无问题</text>
            <view class="detail-retry" wx:if="{{isAdmin}}" catchtap="onAddQuestion">新增第一个问题</view>
          </view>
        </view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>

<view
  class="faq-edit-mask {{editModalAnimIn ? 'is-in' : ''}}"
  wx:if="{{showEditModal}}"
  catchtouchmove="stopTap"
  bindtap="closeEditModal"
>
  <view class="faq-edit-sheet {{editModalAnimIn ? 'is-in' : ''}}" catchtap="stopTap">
    <view class="faq-edit-handle"></view>
    <text class="faq-edit-title">{{editModalTitle}}</text>
    <input
      class="faq-edit-input"
      value="{{editModalValue}}"
      bindinput="onEditModalInput"
      placeholder="例如：点击没反应？"
      focus="{{editModalAnimIn}}"
      confirm-type="done"
      bindconfirm="confirmEditModal"
    />
    <view class="faq-edit-sync" bindtap="toggleEditSyncAll">
      <view class="faq-edit-check {{editModalSyncAll ? 'on' : ''}}"></view>
      <text>同步全部系列</text>
    </view>
    <view class="faq-edit-actions">
      <view class="faq-edit-btn ghost" bindtap="closeEditModal">取消</view>
      <view class="faq-edit-btn primary {{saving ? 'disabled' : ''}}" bindtap="confirmEditModal">确定</view>
    </view>
  </view>
</view>

<view
  class="faq-edit-mask {{deleteSheetAnimIn ? 'is-in' : ''}}"
  wx:if="{{showDeleteSheet}}"
  catchtouchmove="stopTap"
  bindtap="closeDeleteSheet"
>
  <view class="faq-edit-sheet {{deleteSheetAnimIn ? 'is-in' : ''}}" catchtap="stopTap">
    <view class="faq-edit-handle"></view>
    <text class="faq-edit-title">删除问题</text>
    <text class="faq-del-name">{{deleteSheetTitle}}</text>
    <text class="faq-del-hint">单独删除只从当前系列去掉；全量删除会从所有系列移除，并删掉这条排查流程。</text>
    <view class="faq-del-btn {{saving ? 'disabled' : ''}}" bindtap="confirmDeleteQuestion" data-scope="series">单独删除</view>
    <view class="faq-del-btn faq-del-btn--danger {{saving ? 'disabled' : ''}}" bindtap="confirmDeleteQuestion" data-scope="all">全量删除</view>
    <view class="faq-del-btn faq-del-btn--ghost {{saving ? 'disabled' : ''}}" bindtap="closeDeleteSheet">取消</view>
  </view>
</view>
