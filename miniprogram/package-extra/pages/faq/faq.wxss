page {
  background: #F5F5F5;
  height: 100%;
  color: #111;
}

.container {
  height: 100%;
  min-height: 100%;
  box-sizing: border-box;
  position: relative;
}

.page-home {
  height: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding-bottom: calc(8rpx + env(safe-area-inset-bottom));
  transition: transform 0.42s cubic-bezier(0.25, 0.1, 0.25, 1),
    opacity 0.42s cubic-bezier(0.25, 0.1, 0.25, 1);
  transform-origin: center center;
  will-change: transform, opacity;
}
.page-home.is-detail-open {
  transform: scale(0.96) translateX(-5%);
  opacity: 0.62;
  pointer-events: none;
}

/* 顶部返回（与 products 一致，详情层 z-index 更高会盖住） */
.faq-top-nav {
  position: relative;
  z-index: 10;
  height: 0;
}
.back-icon {
  position: fixed;
  left: 32rpx;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50;
}
.back-icon:active {
  transform: scale(0.95);
  opacity: 0.7;
}
.back-arrow {
  font-size: 52rpx;
  font-weight: 300;
  color: #111;
  line-height: 1;
}

/* Header */
.header {
  padding: 0 40rpx 12rpx;
  flex-shrink: 0;
}
.header-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}
.header-copy {
  flex: 1;
  min-width: 0;
}
.header-title {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: -1.2rpx;
  color: #111;
  line-height: 1.15;
}
.header-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.35;
  letter-spacing: 1.5rpx;
  color: #8e8e93;
}
.header--center {
  padding-left: 80rpx;
  padding-right: 80rpx;
}
.header--center .header-copy {
  text-align: center;
}

.admin-toggle-btn {
  flex-shrink: 0;
  margin-top: 8rpx;
  font-size: 22rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #EFEFEF;
  color: #111;
  border: none;
  font-weight: 650;
  line-height: 1.2;
  letter-spacing: 0.4rpx;
}
.admin-toggle-btn.on {
  background: #111;
  color: #fff;
}

.glass-list-section,
.card-stack {
  padding: 8rpx 28rpx 48rpx;
  margin-bottom: 0;
  display: flex;
  flex-direction: column;
}
.card-stack--fill {
  flex: 1;
  min-height: 0;
  padding: 8rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  justify-content: flex-start;
}
.card-stack--fill .big-card {
  margin-bottom: 20rpx;
}

.big-card {
  width: 100%;
  margin-bottom: 24rpx;
  padding: 0;
  box-sizing: border-box;
  background: #fff;
  border-radius: 88rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transition: transform 0.2s cubic-bezier(0.25, 1, 0.5, 1);
}
.big-card-hover {
  transform: scale(0.98);
  background: #fafafa;
}
.big-card-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 168rpx;
  padding: 28rpx 36rpx;
  box-sizing: border-box;
}
.big-card--q .big-card-row {
  min-height: 128rpx;
  padding: 22rpx 32rpx;
}
.big-card--q .big-card-key {
  width: 64rpx;
  min-width: 64rpx;
  height: 64rpx;
  font-size: 20rpx;
  border-radius: 18rpx;
  margin-right: 18rpx;
}
.big-card--q .big-card-title {
  font-size: 30rpx;
  font-weight: 650;
}
.big-card--q .big-card-sub {
  font-size: 22rpx;
}
.big-card--q .big-card-chevron {
  font-size: 36rpx;
}
.big-card-left {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1;
  padding-right: 12rpx;
}
.big-card-key {
  width: 80rpx;
  min-width: 80rpx;
  height: 80rpx;
  padding: 0;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: #111;
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 22rpx;
}
.big-card-copy {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}
.big-card-title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  color: #111;
  letter-spacing: -0.4rpx;
  line-height: 1.3;
}
.big-card-meta {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 12rpx;
}
.big-card-sub {
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1;
  letter-spacing: 1rpx;
  color: #8e8e93;
}
.big-card-chevron {
  font-size: 46rpx;
  color: #c7c7cc;
  font-weight: 300;
  margin-left: 6rpx;
  flex-shrink: 0;
  line-height: 1;
}

.section-label {
  font-size: 24rpx;
  color: #888;
  margin-left: 16rpx;
  margin-bottom: 16rpx;
  display: block;
  font-weight: 500;
}
.glass-container {
  background: transparent;
  border-radius: 0;
  overflow: visible;
  box-shadow: none;
}
.glass-item,
.solo-card {
  display: flex;
  align-items: center;
  padding: 32rpx 36rpx;
  background: #fff;
  border-radius: 36rpx;
  border-bottom: none;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.04);
}
.glass-item:last-child {
  border-bottom: none;
}
.glass-item-hover,
.solo-card-hover {
  background: #F7F7F7;
}
.item-icon {
  width: 72rpx;
  min-width: 72rpx;
  height: 72rpx;
  padding: 0;
  border-radius: 22rpx;
  margin-right: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  flex-shrink: 0;
  box-sizing: border-box;
}
.item-icon--mt {
  width: 72rpx;
  min-width: 72rpx;
  max-width: 72rpx;
  background: #111;
  color: #fff;
  font-size: 22rpx;
  letter-spacing: 0.5rpx;
}
.item-icon--general {
  background: #fff;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  color: #000;
  font-size: 22rpx;
  letter-spacing: 0;
}

.item-icon--diagnose {
  background: #F2F2F2;
  color: #111;
  font-size: 24rpx;
}
.item-icon--q {
  width: 72rpx;
  min-width: 72rpx;
  max-width: 72rpx;
  background: #111;
  color: #fff;
  font-size: 24rpx;
}

.faq-troubleshoot-section {
  margin-top: 8rpx;
  margin-bottom: 48rpx;
}

.faq-troubleshoot-entry {
  min-height: 112rpx;
}

.related-loading {
  padding: 28rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.35);
}

.item-subtext {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.4;
  color: rgba(0, 0, 0, 0.42);
}

.glass-section-add {
  margin: 20rpx 0 0;
  padding: 28rpx 32rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #111;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
  background: #F7F7F7;
}
.glass-section-add:active {
  background: #EFEFEF;
}
.glass-item-main {
  flex: 1;
  min-width: 0;
}
.item-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #111;
}
.item-chevron {
  font-size: 40rpx;
  color: #c7c7cc;
  font-weight: 300;
  margin-left: 8rpx;
}
.home-admin-tip,
.detail-admin-tip {
  margin: 0 32rpx 24rpx;
  padding: 22rpx 28rpx;
  background: #fff;
  border-radius: 28rpx;
  font-size: 24rpx;
  color: #8e8e93;
  line-height: 1.5;
  box-shadow: 0 8rpx 32rpx rgba(15, 23, 42, 0.05);
}
.detail-admin-tip {
  margin-top: 0;
  margin-bottom: 16rpx;
}
.item-admin-col {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
  flex-shrink: 0;
}
.item-admin-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.faq-q-sync {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #333;
  padding: 4rpx 0;
}
.faq-q-sync .faq-edit-check {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
  border-radius: 8rpx;
  border-width: 2rpx;
}
.item-admin-tag {
  font-size: 22rpx;
  color: #111;
  padding: 6rpx 16rpx;
  background: #F2F2F2;
  border-radius: 999rpx;
}
.item-admin-tag--primary {
  background: #000;
  color: #fff;
}
.item-admin-tag--danger {
  background: #fff0f0;
  color: #d93025;
}
.item-admin-tag--on {
  background: #111;
  color: #fff;
}

/* 系列问题二级页 */
.detail-layer {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 100;
  background: #fff;
  transform: translate3d(100%, 0, 0);
  transition: transform 0.42s cubic-bezier(0.25, 0.1, 0.25, 1);
  will-change: transform;
  box-shadow: -12rpx 0 48rpx rgba(0, 0, 0, 0.08);
}
.detail-layer.is-visible.is-in {
  transform: translate3d(0, 0, 0);
}
.detail-layer.is-out {
  transform: translate3d(100%, 0, 0);
}
.detail-panel {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #F5F5F5;
}
.detail-nav {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding-left: 24rpx;
  padding-right: 24rpx;
  padding-bottom: 12rpx;
  box-sizing: border-box;
  background: rgba(245, 245, 245, 0.88);
  backdrop-filter: blur(20px);
}
.detail-back {
  width: 72rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  font-weight: 300;
  color: #111;
}
.detail-nav-title {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #111;
}
.detail-nav-right {
  min-width: 72rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: 30rpx;
  font-weight: 500;
  color: #111;
  padding-right: 8rpx;
}
.detail-scroll {
  flex: 1;
  height: 0;
  box-sizing: border-box;
}
.detail-fill {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}
.detail-q-section {
  margin-bottom: 0;
}
.detail-section-head {
  padding: 24rpx 48rpx 0;
}
.detail-admin-add {
  margin: 8rpx 32rpx 20rpx;
  height: 92rpx;
  border-radius: 28rpx;
  background: #111;
  color: #fff;
  font-size: 30rpx;
  font-weight: 650;
  box-shadow: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
.detail-admin-add:active {
  opacity: 0.85;
}
.detail-admin-hint {
  margin: 0 32rpx 16rpx;
  font-size: 24rpx;
  color: #888;
}
.detail-loading,
.detail-empty,
.detail-error {
  margin: 80rpx 40rpx;
  text-align: center;
  font-size: 28rpx;
  color: #8e8e93;
}
.detail-retry {
  margin: 28rpx auto 0;
  display: inline-block;
  padding: 16rpx 36rpx;
  border-radius: 999rpx;
  background: #111;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
}

.faq-edit-mask {
  position: fixed;
  inset: 0;
  z-index: 5000;
  background: rgba(15, 23, 42, 0);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 0;
  box-sizing: border-box;
  transition: background 0.28s ease;
}
.faq-edit-mask.is-in {
  background: rgba(15, 23, 42, 0.4);
}
.faq-edit-sheet {
  width: 100%;
  background: #F5F5F5;
  border-radius: 44rpx 44rpx 0 0;
  padding: 12rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  transform: translateY(100%);
  opacity: 1;
  transition: transform 0.34s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 -12rpx 40rpx rgba(0, 0, 0, 0.08);
}
.faq-edit-sheet.is-in {
  transform: translateY(0);
}
.faq-edit-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: #CBD5E1;
  margin: 8rpx auto 18rpx;
}
.faq-edit-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #111;
  margin-bottom: 24rpx;
}
.faq-edit-input {
  width: 100%;
  height: 92rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  background: #fff;
  border: none;
  border-radius: 24rpx;
  font-size: 28rpx;
  color: #111;
}
.faq-edit-sync {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #333;
}
.faq-edit-check {
  width: 36rpx;
  height: 36rpx;
  margin-right: 14rpx;
  border-radius: 10rpx;
  border: 3rpx solid #111;
  box-sizing: border-box;
  background: #fff;
}
.faq-edit-check.on {
  background: #111;
  box-shadow: inset 0 0 0 6rpx #fff;
}
.faq-edit-actions {
  margin-top: 28rpx;
  display: flex;
  gap: 16rpx;
}
.faq-edit-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 650;
}
.faq-edit-btn.ghost {
  background: #fff;
  color: #111;
}
.faq-edit-btn.primary {
  background: #111;
  color: #fff;
  box-shadow: none;
}
.faq-edit-btn.disabled {
  opacity: 0.45;
  pointer-events: none;
}
.faq-del-name {
  display: block;
  font-size: 30rpx;
  font-weight: 650;
  color: #111;
  margin-bottom: 12rpx;
}
.faq-del-hint {
  display: block;
  font-size: 24rpx;
  color: #8e8e93;
  line-height: 1.5;
  margin-bottom: 28rpx;
}
.faq-del-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 24rpx;
  background: #111;
  color: #fff;
  font-size: 28rpx;
  font-weight: 650;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}
.faq-del-btn--danger {
  background: #fff;
  color: #d93025;
}
.faq-del-btn--ghost {
  background: transparent;
  color: #888;
  margin-bottom: 0;
}
.faq-del-btn.disabled {
  opacity: 0.45;
  pointer-events: none;
}

.chevron {
  width: 16rpx;
  height: 16rpx;
  border-top: 4rpx solid #c7c7cc;
  border-right: 4rpx solid #c7c7cc;
  transform: rotate(45deg);
  flex-shrink: 0;
}

/* 详情页：右滑进入 / 右滑退出（退出时保持 is-in，叠加 is-leaving 才过渡） */
.page-detail {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: #fff;
  z-index: 100;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  transform: translate3d(100%, 0, 0);
  transition: transform 0.42s cubic-bezier(0.25, 0.1, 0.25, 1);
  will-change: transform;
  box-shadow: -12rpx 0 48rpx rgba(0, 0, 0, 0.08);
}
.page-detail.is-in {
  transform: translate3d(0, 0, 0);
}
.page-detail.is-in.is-leaving {
  transform: translate3d(100%, 0, 0);
}
.nav-bar {
  padding: 24rpx 40rpx 16rpx;
  position: sticky;
  top: 0;
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  box-sizing: border-box;
}
.back-link {
  font-size: 34rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  color: #000;
}
.back-link::before {
  content: '';
  width: 18rpx;
  height: 18rpx;
  border-left: 4rpx solid #000;
  border-bottom: 4rpx solid #000;
  transform: rotate(45deg);
  margin-right: 16rpx;
}
.detail-header {
  padding: 24rpx 40rpx 20rpx;
}
.detail-p-name {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  color: #000;
  line-height: 1.15;
  letter-spacing: -1rpx;
}
.detail-subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #8e8e93;
  letter-spacing: 0.5rpx;
}

.faq-empty {
  margin: 80rpx 40rpx;
  text-align: center;
}
.faq-empty-text {
  font-size: 28rpx;
  color: #8e8e93;
}

/* 折叠面板 */
.faq-accordion {
  margin: 40rpx 32rpx 80rpx;
}
.faq-row {
  position: relative;
  background: #fff;
  margin-bottom: 24rpx;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
  transition: margin 0.38s ease, transform 0.38s ease, box-shadow 0.38s ease;
}
.faq-row:last-child {
  margin-bottom: 0;
}

.faq-row.open {
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.1);
}
.faq-row-head {
  background: #fff;
}
.faq-row.open .faq-row-head {
  border-bottom: 1rpx solid #ebebef;
}
.faq-q {
  padding: 32rpx 32rpx 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
}
.faq-q-main {
  flex: 1;
  min-width: 0;
}
.faq-q-label {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: #8e8e93;
  letter-spacing: 1rpx;
  margin-bottom: 10rpx;
}
.faq-q-admin {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 0 32rpx 20rpx;
  background: #fff;
}
.faq-q-admin .faq-admin-btn {
  margin: 0;
}
.faq-q-text {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #000;
  line-height: 1.45;
  letter-spacing: -0.5rpx;
}
.arrow {
  width: 20rpx;
  height: 12rpx;
  border-left: 4rpx solid #c7c7cc;
  border-bottom: 4rpx solid #c7c7cc;
  transform: rotate(-45deg);
  transition: transform 0.3s ease;
  flex-shrink: 0;
  margin-top: 36rpx;
}
.faq-row.open .arrow {
  transform: rotate(135deg);
}
.faq-a {
  overflow: hidden;
  transition: max-height 0.4s ease;
  background: #fff;
}
.faq-a-inner {
  padding: 24rpx 28rpx 32rpx;
  background: #f7f7f9;
}
.faq-section {
  margin-bottom: 28rpx;
}
.faq-section:last-of-type {
  margin-bottom: 0;
}
.faq-section-label {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #8e8e93;
  margin-bottom: 16rpx;
  padding-left: 4rpx;
}
.video-wrap {
  margin-bottom: 0;
}
.faq-answer-card {
  padding: 0 4rpx;
}
.video-player {
  width: 100%;
  height: 350rpx;
  border-radius: 32rpx;
  background: #000;
}
.faq-answer-text {
  display: block;
  font-size: 30rpx;
  font-weight: 400;
  color: #3c3c43;
  line-height: 1.75;
  text-align: justify;
}
.faq-loading {
  margin: 60rpx 40rpx;
  text-align: center;
  font-size: 28rpx;
  color: #8e8e93;
}

.video-placeholder {
  width: 100%;
  height: 350rpx;
  border-radius: 32rpx;
  background: #f2f2f7;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}
.video-placeholder--admin {
  border: 2rpx dashed #111;
  background: #f0f7ff;
}
.video-placeholder-icon {
  font-size: 48rpx;
  color: #c7c7cc;
}
.video-placeholder--admin .video-placeholder-icon {
  color: #111;
}
.video-placeholder-text {
  font-size: 26rpx;
  color: #8e8e93;
}
.video-placeholder--admin .video-placeholder-text {
  color: #111;
}

.faq-admin-btn {
  font-size: 24rpx;
  color: #111;
  padding: 8rpx 20rpx;
  background: #f0f7ff;
  border-radius: 999rpx;
}
.faq-admin-btn--danger {
  color: #ff3b30;
  background: #fff0ef;
}
.faq-edit-text-btn {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #111;
  text-align: center;
  padding: 16rpx;
  background: #f0f7ff;
  border-radius: 16rpx;
}

.faq-admin-bar {
  position: sticky;
  bottom: 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom, 0px));
  background: linear-gradient(180deg, rgba(255, 255, 255, 0) 0%, #fff 30%);
}
.faq-admin-add {
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  background: #000;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
}
.faq-admin-add:active {
  opacity: 0.85;
}

/* 管理员弹窗 */
.faq-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}
.faq-modal-mask.closing {
  opacity: 0;
  transition: opacity 0.28s ease;
}
.faq-modal-box {
  width: 100%;
  max-width: 640rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 40rpx 36rpx 32rpx;
  box-sizing: border-box;
}
.faq-modal-box--sm {
  max-width: 560rpx;
}
.faq-modal-mask--rename {
  z-index: 1100;
}
.faq-modal-mask--admin {
  z-index: 1000;
}
.faq-modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #000;
  margin-bottom: 28rpx;
}
.faq-modal-label {
  display: block;
  font-size: 24rpx;
  color: #8e8e93;
  margin-bottom: 12rpx;
  margin-top: 20rpx;
}
.faq-modal-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: #f2f2f7;
  border-radius: 16rpx;
  font-size: 30rpx;
}
.faq-modal-textarea {
  width: 100%;
  min-height: 140rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  background: #f2f2f7;
  border-radius: 16rpx;
  font-size: 28rpx;
}
.faq-video-pick {
  width: 100%;
  min-height: 280rpx;
  background: #f2f2f7;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
}
.faq-video-preview {
  width: 100%;
  height: 280rpx;
}
.faq-video-pick-plus {
  font-size: 56rpx;
  color: #111;
  line-height: 1;
}
.faq-video-pick-hint {
  font-size: 24rpx;
  color: #8e8e93;
  margin-top: 12rpx;
}
.faq-modal-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}
.faq-modal-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.faq-modal-btn.cancel {
  background: #f2f2f7;
  color: #000;
}
.faq-modal-btn.confirm {
  background: #111;
  color: #fff;
}
.faq-modal-btn.confirm.disabled {
  opacity: 0.5;
}
