page {
  background: #f5f5f7;
  color: #111;
}

.ta-page {
  min-height: 100vh;
  background: #f5f5f7;
}

.ta-nav {
  position: fixed;
  inset: 0 0 auto;
  z-index: 20;
  display: flex;
  align-items: center;
  box-sizing: content-box;
  background: rgba(245, 245, 247, 0.94);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.ta-back,
.ta-nav-add {
  width: 120rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ta-back {
  font-size: 52rpx;
  font-weight: 300;
  color: #111;
}

.ta-nav-add {
  font-size: 24rpx;
  font-weight: 700;
  color: #111;
}

.ta-nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 750;
}

.ta-content {
  padding-left: 0;
  padding-right: 0;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.ta-intro {
  padding: 44rpx 8rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ta-intro-title {
  font-size: 44rpx;
  font-weight: 780;
}

.ta-intro-copy {
  font-size: 24rpx;
  line-height: 1.55;
  color: rgba(0, 0, 0, 0.48);
}

.ta-tree-strip {
  width: 100%;
  margin-bottom: 24rpx;
  white-space: nowrap;
}

.ta-tree-strip-inner {
  display: inline-flex;
  gap: 12rpx;
  padding-right: 24rpx;
}

.ta-tree-chip {
  padding: 18rpx 24rpx;
  border-radius: 18rpx;
  background: #fff;
  font-size: 24rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
}

.ta-tree-chip.is-on {
  background: #111;
  color: #fff;
}

.ta-tree-head {
  padding: 30rpx;
  border-radius: 28rpx;
  background: #111;
  color: #fff;
  display: flex;
  gap: 22rpx;
}

.ta-tree-head-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.ta-tree-title {
  font-size: 34rpx;
  font-weight: 750;
}

.ta-tree-meta {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.58);
  word-break: break-all;
}

.ta-head-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 14rpx;
  font-size: 22rpx;
  color: #8dc7ff;
}

.danger {
  color: #ff7b75 !important;
}

.ta-section-head {
  margin: 34rpx 4rpx 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  font-weight: 700;
}

.ta-section-head view {
  color: #007aff;
}

.ta-node-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.ta-node {
  padding: 26rpx;
  border-radius: 26rpx;
  background: #fff;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
}

.ta-node-top {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.ta-node-type,
.ta-node-sort {
  font-size: 19rpx;
  color: #007aff;
  font-weight: 750;
}

.ta-node-title {
  display: block;
  font-size: 29rpx;
  font-weight: 720;
}

.ta-node-id {
  display: block;
  margin-top: 8rpx;
  font-family: ui-monospace, Menlo, Consolas, monospace;
  font-size: 18rpx;
  color: rgba(0, 0, 0, 0.38);
  word-break: break-all;
}

.ta-node-body {
  display: block;
  margin-top: 12rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: rgba(0, 0, 0, 0.52);
}

.ta-node-options {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #f5f5f7;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 20rpx;
  color: rgba(0, 0, 0, 0.55);
}

.ta-node-actions {
  margin-top: 20rpx;
  display: flex;
  gap: 24rpx;
  font-size: 23rpx;
  color: #007aff;
}

.ta-empty,
.ta-loading,
.ta-error {
  padding: 100rpx 30rpx;
  text-align: center;
  color: rgba(0, 0, 0, 0.45);
}

.ta-empty--small {
  padding: 60rpx 30rpx;
}

.ta-empty .ta-primary {
  width: 300rpx;
  margin: 28rpx auto 0;
}

.ta-error {
  color: #c62828;
}

.ta-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(0, 0, 0, 0);
  display: flex;
  align-items: flex-end;
  transition: background 0.32s ease;
}
.ta-mask.is-in {
  background: rgba(0, 0, 0, 0.45);
}

.ta-sheet {
  width: 100%;
  height: 86vh;
  padding: 0;
  box-sizing: border-box;
  border-radius: 48rpx 48rpx 0 0;
  background: #EFEFF4;
  transform: translateY(100%);
  transition: transform 0.36s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 -20rpx 60rpx rgba(0, 0, 0, 0.16);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.ta-sheet.is-in {
  transform: translateY(0);
}
.ta-sheet.is-dragging {
  transition: none;
}

.ta-sheet-grab {
  flex-shrink: 0;
  padding: 8rpx 32rpx 0;
  background: #EFEFF4;
}

.ta-sheet-handle {
  width: 84rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #C7C7CC;
  margin: 12rpx auto 0;
}

.ta-sheet-head {
  flex-shrink: 0;
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 20rpx 32rpx 12rpx;
  background: #EFEFF4;
}

.ta-sheet-head--round {
  flex-direction: column;
  align-items: stretch;
  gap: 18rpx;
  padding: 8rpx 28rpx 18rpx;
  background: #EFEFF4;
}

.ta-sheet-title--round {
  text-align: center;
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.ta-seg--pill {
  padding: 6rpx;
  border-radius: 999rpx;
  background: rgba(118, 118, 128, 0.16);
}

.ta-seg-btn--pill {
  height: 68rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.ta-seg-btn--pill.is-on {
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.08);
}

.ta-form-pad--round {
  padding: 8rpx 28rpx 0;
}

.ta-round-card {
  background: #fff;
  border-radius: 36rpx;
  padding: 28rpx 28rpx 24rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.ta-round-label {
  display: block;
  margin-bottom: 14rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #8E8E93;
  letter-spacing: 1rpx;
}

.ta-round-label--inline {
  margin-bottom: 0;
}

.ta-round-card-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.ta-round-add {
  font-size: 26rpx;
  color: #007AFF;
  font-weight: 600;
  padding: 8rpx 4rpx 8rpx 16rpx;
}

.ta-round-title {
  width: 100%;
  min-height: 56rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #111;
  line-height: 1.35;
}

.ta-round-area {
  width: 100%;
  min-height: 88rpx;
  font-size: 28rpx;
  color: #111;
  line-height: 1.45;
}

.ta-round-divider {
  height: 1rpx;
  background: rgba(60, 60, 67, 0.08);
  margin: 22rpx 0;
}
.ta-round-rule {
  height: 2rpx;
  background: rgba(0, 0, 0, 0.18);
  margin: 6rpx 0 18rpx;
  border-radius: 2rpx;
}

.ta-round-video-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.ta-round-video {
  width: 100%;
  height: 220rpx;
  border-radius: 28rpx;
  background: #F2F2F7;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.ta-round-video.has-media {
  background: #000;
}

.ta-round-video-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.ta-round-video-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 999rpx;
  background: rgba(0, 122, 255, 0.12);
  color: #007AFF;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ta-round-video-text {
  font-size: 28rpx;
  color: #007AFF;
  font-weight: 600;
}

.ta-round-empty {
  padding: 18rpx 8rpx 8rpx;
  font-size: 26rpx;
  color: #AEAEB2;
}

.ta-round-tip {
  display: block;
  margin: 0 0 8rpx;
  font-size: 22rpx;
  color: #AEAEB2;
  line-height: 1.4;
}

.ta-round-sub {
  padding-top: 8rpx;
}

.ta-round-sub.is-split,
.ta-round-answer.is-split {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid rgba(0, 0, 0, 0.16);
}

.ta-round-sub-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.ta-round-badge {
  width: 40rpx;
  height: 40rpx;
  border-radius: 999rpx;
  background: #F2F2F7;
  color: #3A3A3C;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ta-round-input {
  width: 100%;
  min-height: 48rpx;
  font-size: 30rpx;
  color: #111;
  line-height: 1.35;
}

.ta-round-input--sub {
  margin-top: 14rpx;
  padding-top: 16rpx;
  font-size: 26rpx;
  color: #3A3A3C;
  border-top: 2rpx solid rgba(0, 0, 0, 0.14);
}

.ta-round-input--flex {
  flex: 1;
  min-width: 0;
  margin: 0 18rpx;
}

.ta-round-answer {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}

.ta-round-card--end {
  margin-top: 8rpx;
}

.ta-end-switch-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.ta-end-switch-copy {
  flex: 1;
  min-width: 0;
}

.ta-end-switch-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #111;
  margin-bottom: 6rpx;
}

.ta-end-switch-sub {
  display: block;
  font-size: 24rpx;
  color: #8E8E93;
  line-height: 1.35;
}

.ta-round-choice {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 18rpx;
  padding: 28rpx 26rpx;
  border-radius: 28rpx;
  background: #fff;
  border: 3rpx solid transparent;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.ta-round-choice--nested {
  margin-bottom: 14rpx;
  box-shadow: none;
  background: #F7F7FA;
  border-width: 2rpx;
}

.ta-round-choice--nested:last-child {
  margin-bottom: 0;
}

.ta-round-choice--nested.is-on {
  background: #F2F8FF;
}

.ta-round-choice.is-on {
  border-color: #007AFF;
  background: #F2F8FF;
}

.ta-round-choice-main {
  flex: 1;
  min-width: 0;
}

.ta-round-choice-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #111;
  margin-bottom: 8rpx;
}

.ta-round-choice-sub {
  display: block;
  font-size: 24rpx;
  color: #8E8E93;
  line-height: 1.4;
}

.ta-end-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid #C7C7CC;
  box-sizing: border-box;
  position: relative;
  flex-shrink: 0;
}

.ta-end-check.is-on {
  border-color: #007AFF;
  background: #007AFF;
}

.ta-end-check.is-on::after {
  content: '';
  position: absolute;
  left: 11rpx;
  top: 6rpx;
  width: 10rpx;
  height: 18rpx;
  border: 3rpx solid #fff;
  border-top: 0;
  border-left: 0;
  transform: rotate(45deg);
}

.ta-sheet-foot--round {
  flex-shrink: 0;
  padding: 14rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #EFEFF4;
}

.ta-primary--pill {
  width: 100%;
  height: 100rpx;
  border-radius: 999rpx;
  background: #111;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ta-primary--pill.disabled {
  opacity: 0.45;
}

.ta-form-spacer--slim {
  height: 28rpx;
}

.ta-foot-row {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 56rpx;
}

.ta-foot-row .ta-foot-link,
.ta-foot-row .ta-foot-danger {
  margin: 0;
  padding: 14rpx 8rpx;
  font-size: 28rpx;
}

.ta-seg {
  display: flex;
  padding: 4rpx;
  background: rgba(118, 118, 128, 0.12);
  border-radius: 18rpx;
}

.ta-seg-btn {
  flex: 1;
  height: 56rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 500;
  color: #636366;
}

.ta-seg-btn.is-on {
  background: #fff;
  color: #000;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.ta-seg-hint {
  display: block;
  margin-top: -4rpx;
  font-size: 22rpx;
  color: #8E8E93;
  line-height: 1.4;
}

.ta-form-pad--ios {
  padding: 0 32rpx;
}

.ios-cap {
  display: block;
  padding: 8rpx 8rpx 10rpx;
  font-size: 26rpx;
  color: #6D6D72;
  font-weight: 400;
}

.ios-foot {
  display: block;
  padding: 0 8rpx 16rpx;
  margin-top: -6rpx;
  font-size: 22rpx;
  color: #8E8E93;
  line-height: 1.45;
}

.ios-empty-tip {
  margin: 0 8rpx 16rpx;
  padding: 28rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(120, 120, 128, 0.08);
  font-size: 26rpx;
  color: #8E8E93;
  text-align: center;
}

.ta-soft-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.ta-soft-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 22rpx 24rpx 20rpx;
  box-sizing: border-box;
}

.ta-soft-item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.ta-soft-index {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  background: #F2F2F7;
  color: #3A3A3C;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ta-soft-input {
  width: 100%;
  min-height: 48rpx;
  font-size: 28rpx;
  color: #000;
  line-height: 1.4;
  box-sizing: border-box;
}

.ta-soft-input--sub {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(60, 60, 67, 0.08);
  font-size: 26rpx;
  color: #3A3A3C;
}

.ta-soft-input--flex {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.ta-soft-item--answer {
  padding: 20rpx 24rpx;
}

.ta-answer-row {
  display: flex;
  align-items: center;
}

.ta-answer-video {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(60, 60, 67, 0.08);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.ta-answer-video-label {
  font-size: 26rpx;
  color: #3A3A3C;
}

.ta-dashed-add {
  margin: 0 0 28rpx;
  height: 84rpx;
  border-radius: 20rpx;
  border: 2rpx dashed rgba(60, 60, 67, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #007AFF;
  font-size: 28rpx;
  font-weight: 500;
  background: rgba(0, 122, 255, 0.03);
  box-sizing: border-box;
}

.ta-dashed-add-plus {
  font-size: 32rpx;
  line-height: 1;
}

.ta-policy-tip {
  margin: 0 0 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(255, 149, 0, 0.1);
  color: #9A6700;
  font-size: 22rpx;
  line-height: 1.45;
}

.ios-cell--switch-stack {
  align-items: flex-start;
  padding-top: 20rpx;
  padding-bottom: 20rpx;
}

.ios-switch-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding-right: 12rpx;
}

.ios-switch-sub {
  font-size: 22rpx;
  color: #8E8E93;
  line-height: 1.35;
}

.ta-end-card {
  margin-bottom: 20rpx;
  padding: 28rpx 28rpx 24rpx;
  border-radius: 22rpx;
  background: #fff;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.ta-end-card.is-on {
  border-color: #007AFF;
  background: #F0F7FF;
}

.ta-end-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.ta-end-card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #000;
}

.ta-end-check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 3rpx solid #C7C7CC;
  box-sizing: border-box;
  position: relative;
}

.ta-end-check.is-on {
  border-color: #007AFF;
  background: #007AFF;
}

.ta-end-check.is-on::after {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 5rpx;
  width: 10rpx;
  height: 16rpx;
  border: 3rpx solid #fff;
  border-top: 0;
  border-left: 0;
  transform: rotate(45deg);
}

.ta-end-card-desc {
  display: block;
  font-size: 26rpx;
  color: #3A3A3C;
  line-height: 1.4;
  margin-bottom: 14rpx;
}

.ta-end-card-tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(52, 199, 89, 0.12);
  color: #248A3D;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.3;
}

.ta-end-card-tag--warn {
  background: rgba(255, 149, 0, 0.14);
  color: #C93400;
}

.ios-group {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 28rpx;
}

.ios-group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 10rpx;
  font-size: 24rpx;
  color: #6D6D72;
}

.ios-cell {
  padding: 22rpx 28rpx;
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.12);
  box-sizing: border-box;
}

.ios-cell:last-child {
  border-bottom: none;
}

.ios-cell--stack {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.ios-cell-label {
  font-size: 24rpx;
  color: #6D6D72;
  font-weight: 400;
}

.ios-cell-label-inline {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #000;
  font-weight: 400;
}

.ios-cell-input {
  width: 100%;
  font-size: 28rpx;
  color: #000;
  font-weight: 400;
  min-height: 44rpx;
  line-height: 1.4;
}

.ios-cell-area {
  width: 100%;
  min-height: 88rpx;
  font-size: 28rpx;
  color: #000;
  line-height: 1.45;
  font-weight: 400;
}

.ios-cell-foot {
  font-size: 22rpx;
  color: #8E8E93;
  line-height: 1.4;
