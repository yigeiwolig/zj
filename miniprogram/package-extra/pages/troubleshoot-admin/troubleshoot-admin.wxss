  box-shadow: 0 0 0 4rpx rgba(0, 122, 255, 0.35);
}

.tv-card.is-source {
  border-color: #007aff;
}

.tv-card.is-link-target {
  border-color: #34c759;
  background: #f3fff6;
}

.tv-card--orphan {
  border-color: #f5a623;
}

.tv-card-top {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.tv-type,
.tv-entry,
.tv-orphan-tag {
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}

.tv-type {
  background: #e8f3ff;
  color: #007aff;
}

.tv-entry {
  background: #111;
  color: #fff;
}

.tv-orphan-tag {
  background: #fff6e5;
  color: #b26a00;
}

.tv-title {
  display: block;
  font-size: 30rpx;
  font-weight: 750;
  color: #111;
  line-height: 1.35;
  margin-bottom: 14rpx;
}

.tv-answers {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.tv-answer {
  background: #f5f5f7;
  border-radius: 16rpx;
  padding: 16rpx 18rpx;
  border: 2rpx solid transparent;
}

.tv-answer.is-connectable {
  border-color: #111;
  background: #f0f0f2;
}

.tv-answer.is-picked {
  background: #111;
}

.tv-answer.is-picked .tv-answer-text,
.tv-answer.is-picked .tv-answer-hint {
  color: #fff;
}

.tv-answer-text {
  display: block;
  font-size: 26rpx;
  font-weight: 650;
  color: #111;
}

.tv-answer-hint {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #007aff;
}

.tv-end {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.45);
  font-weight: 600;
}

.tv-kids {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: flex-start;
  gap: 18rpx;
  margin-top: 8rpx;
  width: 100%;
}

.tv-kid {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 300rpx;
}

.tv-wire {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0 12rpx;
}

.tv-wire-line {
  width: 4rpx;
  height: 22rpx;
  background: #c7c7cc;
  border-radius: 4rpx;
}

.tv-wire-label {
  margin: 6rpx 0;
  max-width: 260rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #111;
  color: #fff;
  font-size: 20rpx;
  font-weight: 650;
  text-align: center;
}

.tv-slot {
  width: 300rpx;
  min-height: 140rpx;
  border: 2rpx dashed #c7c7cc;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #8e8e93;
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.6);
  padding: 20rpx;
  box-sizing: border-box;
  text-align: center;
}

.tv-slot-plus {
  font-size: 40rpx;
  font-weight: 300;
  line-height: 1;
  color: #111;
}

.tv-slot.is-link-target {
  border-color: #34c759;
  color: #248a3d;
  background: #f3fff6;
}

.tv-slot-sub {
  font-size: 20rpx;
  line-height: 1.4;
  color: rgba(0, 0, 0, 0.35);
}

.tv-orphan-block {
  margin-top: 28rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
}

.tv-orphan-title {
  display: block;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: #b26a00;
  font-weight: 650;
}

.tv-orphan-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
