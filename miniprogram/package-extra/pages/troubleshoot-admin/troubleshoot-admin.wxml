<view class="ta-page">
  <view class="ta-nav" style="height: {{navBarHeight}}px; padding-top: {{statusBarHeight}}px;">
    <view class="ta-back" bindtap="goBack">‹</view>
    <text class="ta-nav-title">{{pageTitle}}</text>
    <view
      class="ta-nav-add {{connectMode ? 'is-on' : ''}}"
      bindtap="toggleConnectMode"
      wx:if="{{selectedTree}}"
    >{{connectMode ? '取消' : '连接'}}</view>
    <view class="ta-nav-add" wx:else></view>
  </view>

  <view class="ta-content" style="padding-top: {{statusBarHeight + navBarHeight}}px;">
    <view class="ta-simple-tip">
      <text>卡片里写答案并保存：几个答案就自动长出几支，支路画在该卡片正下方</text>
      <text>点「再加一个答案」只多一支；空白步骤点「写两个答案并往下分叉」一次长出左右两支</text>
      <text>打开「最后一步」结束该支；树变宽后可左右滑动，操作后会自动滚到当前卡片</text>
    </view>

    <view class="ta-connect-bar" wx:if="{{connectMode}}">
      <text>{{connectHint || '先点一个答案'}}</text>
    </view>

    <view class="ta-error" wx:if="{{errorText}}">{{errorText}}</view>
    <view class="ta-loading" wx:if="{{loading}}">加载中…</view>

    <block wx:if="{{selectedTree && !loading}}">
      <view class="ta-pan-hint">分支会紧挨在卡片正下方；太宽时再左右滑</view>
      <scroll-view
        class="ta-tree-scroll"
        scroll-x
        scroll-y
        enhanced
        show-scrollbar
        enable-flex
        scroll-with-animation
        scroll-into-view="{{scrollIntoView}}"
      >
        <view class="tv-wrap" wx:if="{{flowTree}}">
          <flow-branch
            item="{{flowTree}}"
            connectMode="{{connectMode}}"
            connectPhase="{{connectPhase}}"
            connectSourceId="{{connectSourceId}}"
            connectOptIndex="{{connectOptIndex}}"
            bind:cardtap="onFlowCardTap"
            bind:branchtap="onBranchTap"
            bind:slotap="onEmptySlotTap"
            bind:deletetap="onDeleteNode"
            bind:addanswertap="onAddAnswerBranch"
            bind:extendtap="onExtendNode"
          />
        </view>
        <view class="ta-empty ta-empty--small" wx:else>
          <text>还没有内容</text>
          <view class="ta-primary" style="margin-top: 20rpx;" bindtap="openAddNode">＋ 写第一步</view>
        </view>
      </scroll-view>
    </block>
  </view>
</view>

<!-- 改这一步 -->
<view
  class="ta-mask {{nodeFormAnimIn ? 'is-in' : ''}}"
  wx:if="{{showNodeForm}}"
  catchtouchmove="true"
  bindtap="closeNodeForm"
>
  <view
    class="ta-sheet ta-sheet--node {{nodeFormAnimIn ? 'is-in' : ''}} {{nodeSheetDragging ? 'is-dragging' : ''}}"
    catchtap="stopTap"
    style="{{nodeSheetDragStyle}}"
  >
    <view
      class="ta-sheet-grab"
      catchtouchstart="onNodeSheetTouchStart"
      catchtouchmove="onNodeSheetTouchMove"
      catchtouchend="onNodeSheetTouchEnd"
      catchtouchcancel="onNodeSheetTouchEnd"
    >
      <view class="ta-sheet-handle"></view>
    </view>
    <view class="ta-sheet-head ta-sheet-head--round">
      <text class="ta-sheet-title ta-sheet-title--round">{{nodeForm._id ? '改这一步' : '写第一步'}}</text>
    </view>

    <scroll-view class="ta-sheet-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="ta-form-pad ta-form-pad--round">

        <block wx:if="{{stepKind !== 'end'}}">
          <view class="ta-round-card">
            <text class="ta-round-label">内容</text>
            <input
              class="ta-round-title"
              value="{{nodeForm.title}}"
              data-field="title"
              bindinput="onNodeInput"
              placeholder="这一步叫什么？"
              placeholder-class="ta-ph"
            />
            <view class="ta-round-divider"></view>
            <textarea
              class="ta-round-area"
              value="{{nodeForm.body}}"
              data-field="body"
              bindinput="onNodeInput"
              placeholder="补充说明（可选）"
              placeholder-class="ta-ph"
              auto-height
              maxlength="1000"
            />
            <view class="ta-round-divider"></view>
            <view class="ta-round-video-head" wx:if="{{nodeTempVideoPath || nodeForm.media.url}}">
              <text class="ta-round-label ta-round-label--inline">演示视频</text>
              <text class="ios-link-danger" catchtap="clearNodeVideo">移除</text>
            </view>
            <view
              class="ta-round-video {{nodeTempVideoPath || nodeForm.media.url ? 'has-media' : ''}}"
              bindtap="chooseNodeVideo"
            >
              <video
                wx:if="{{nodeTempVideoPath || nodeForm.media.url}}"
                class="ios-video"
                src="{{nodeTempVideoPath || nodeForm.media.url}}"
                controls="{{false}}"
                show-center-play-btn="{{false}}"
                autoplay="{{false}}"
              ></video>
              <view class="ta-round-video-empty" wx:else>
                <text class="ta-round-video-icon">▶</text>
                <text class="ta-round-video-text">添加演示视频</text>
              </view>
            </view>
          </view>

          <view class="ta-round-card">
            <view class="ta-round-card-bar">
              <text class="ta-round-label ta-round-label--inline">排查要点</text>
              <text class="ta-round-add" bindtap="onAddKeyPointRow">＋ 添加</text>
            </view>
            <view class="ta-round-rule"></view>
            <view class="ta-round-empty" wx:if="{{!keyPointRows.length}}">暂无，可跳过</view>
            <block wx:for="{{keyPointRows}}" wx:key="_rowId">
              <view class="ta-round-sub {{index ? 'is-split' : ''}}">
                <view class="ta-round-sub-bar">
                  <text class="ta-round-badge">{{index + 1}}</text>
                  <text class="ios-link-danger" data-index="{{index}}" catchtap="onRemoveKeyPointRow">删除</text>
                </view>
                <input
                  class="ta-round-input"
                  value="{{item.title}}"
                  data-index="{{index}}"
                  data-field="title"
                  bindinput="onKeyPointInput"
                  bindblur="onKeyPointInput"
                  placeholder="要点标题"
                  placeholder-class="ta-ph"
                />
                <input
                  class="ta-round-input ta-round-input--sub"
                  value="{{item.detail}}"
                  data-index="{{index}}"
                  data-field="detail"
                  bindinput="onKeyPointInput"
                  bindblur="onKeyPointInput"
                  placeholder="说明（可选）"
                  placeholder-class="ta-ph"
                />
              </view>
            </block>
          </view>

          <view class="ta-round-card">
            <view class="ta-round-card-bar">
              <text class="ta-round-label ta-round-label--inline">用户答案</text>
              <text class="ta-round-add" bindtap="onAddAnswerRow" wx:if="{{answerRows.length < 4}}">＋ 添加</text>
            </view>
            <text class="ta-round-tip">右侧开关：选此项时要用户录视频</text>
            <block wx:for="{{answerRows}}" wx:key="index">
              <view class="ta-round-answer {{index ? 'is-split' : ''}}">
                <text class="ta-round-badge">{{index + 1}}</text>
                <input
                  class="ta-round-input ta-round-input--flex"
                  value="{{item.label}}"
                  data-index="{{index}}"
                  bindinput="onAnswerLabelInput"
                  bindblur="onAnswerLabelInput"
                  placeholder="{{index === 0 ? '好了' : '还不行'}}"
                  placeholder-class="ta-ph"
                />
                <switch
                  checked="{{item.requireUserVideo}}"
                  data-index="{{index}}"
                  bindchange="onAnswerRequireVideo"
                  color="#34C759"
                />
              </view>
            </block>
          </view>
        </block>

        <view class="ta-round-card ta-round-card--end">
          <view class="ta-end-switch-row">
            <view class="ta-end-switch-copy">
              <text class="ta-end-switch-title">结束步骤</text>
              <text class="ta-end-switch-sub">打开后本支不再往下分叉</text>
            </view>
            <switch
              checked="{{stepKind === 'end'}}"
              bindchange="onEndStepSwitch"
              color="#34C759"
            />
          </view>

          <block wx:if="{{stepKind === 'end'}}">
            <view class="ta-round-divider"></view>
            <view
              class="ta-round-choice ta-round-choice--nested {{resultKindIndex === 0 ? 'is-on' : ''}}"
              data-index="0"
              catchtap="onResultKindTap"
            >
              <view class="ta-round-choice-main">
                <text class="ta-round-choice-title">正常结束</text>
                <text class="ta-round-choice-sub">感谢选择 MT · 视频不推送</text>
              </view>
              <view class="ta-end-check {{resultKindIndex === 0 ? 'is-on' : ''}}"></view>
            </view>
            <view
              class="ta-round-choice ta-round-choice--nested {{resultKindIndex === 1 ? 'is-on' : ''}}"
              data-index="1"
              catchtap="onResultKindTap"
            >
              <view class="ta-round-choice-main">
                <text class="ta-round-choice-title">提交售后</text>
                <text class="ta-round-choice-sub">等待处理 · 视频推管理员</text>
              </view>
              <view class="ta-end-check {{resultKindIndex === 1 ? 'is-on' : ''}}"></view>
            </view>
          </block>
        </view>

        <view class="ta-form-spacer ta-form-spacer--slim"></view>
      </view>
    </scroll-view>

    <view class="ta-sheet-foot ta-sheet-foot--round">
      <view class="ta-primary ta-primary--pill {{saving ? 'disabled' : ''}}" bindtap="saveNode">{{saving ? '保存中…' : '保存'}}</view>
      <view class="ta-foot-row">
        <text class="ta-foot-link" bindtap="closeNodeForm">取消</text>
        <text
          class="ta-foot-danger"
          wx:if="{{nodeForm._id}}"
          bindtap="onDeleteNode"
          data-id="{{nodeForm._id}}"
        >删除</text>
      </view>
    </view>
  </view>
</view>
