<view class="ta-page">
  <view class="ta-nav" style="height: {{navBarHeight}}px; padding-top: {{statusBarHeight}}px;">
    <view class="ta-back" bindtap="goBack">‹</view>
    <text class="ta-nav-title">排查方案管理</text>
    <view class="ta-nav-add" bindtap="openAddTree">新增</view>
  </view>

  <view class="ta-content" style="padding-top: {{statusBarHeight + navBarHeight}}px;">
    <view class="ta-intro">
      <text class="ta-intro-title">决策树内容</text>
      <text class="ta-intro-copy">先建主题，再建节点。选项每行写成“文字 | 下一节点ID”；跨主题写“文字 | tree:主题key”。</text>
    </view>

    <view class="ta-error" wx:if="{{errorText}}">{{errorText}}</view>
    <view class="ta-loading" wx:if="{{loading}}">加载中…</view>

    <scroll-view class="ta-tree-strip" scroll-x wx:if="{{trees.length}}">
      <view class="ta-tree-strip-inner">
        <view
          class="ta-tree-chip {{selectedTree && selectedTree._id === item._id ? 'is-on' : ''}}"
          wx:for="{{trees}}"
          wx:key="_id"
          data-id="{{item._id}}"
          bindtap="selectTree"
        >{{item.title}}</view>
      </view>
    </scroll-view>

    <view class="ta-empty" wx:if="{{!loading && !trees.length}}">
      <text>还没有排查主题</text>
      <view class="ta-primary" bindtap="openAddTree">创建第一个主题</view>
    </view>

    <block wx:if="{{selectedTree}}">
      <view class="ta-tree-head">
        <view class="ta-tree-head-main">
          <text class="ta-tree-title">{{selectedTree.title}}</text>
          <text class="ta-tree-meta">
            key: {{selectedTree.key}} · {{selectedTree.enabled ? '已启用' : '已停用'}}
          </text>
          <text class="ta-tree-meta">入口节点：{{selectedTree.entryNodeId || '未设置'}}</text>
        </view>
        <view class="ta-head-actions">
          <text bindtap="openEditTree">编辑</text>
          <text bindtap="previewTree">预览</text>
          <text class="danger" bindtap="deleteTree">删除</text>
        </view>
      </view>

      <view class="ta-section-head">
        <text>节点（{{nodes.length}}）</text>
        <view bindtap="openAddNode">＋ 新增节点</view>
      </view>

      <view class="ta-node-list" wx:if="{{nodes.length}}">
        <view class="ta-node" wx:for="{{nodes}}" wx:key="_id">
          <view class="ta-node-top">
            <text class="ta-node-type">{{item.type}}</text>
            <text class="ta-node-sort">{{item.sort}}</text>
          </view>
          <text class="ta-node-title">{{item.title}}</text>
          <text class="ta-node-id" selectable>ID：{{item._id}}</text>
          <text class="ta-node-body" wx:if="{{item.body}}">{{item.body}}</text>
          <view class="ta-node-options" wx:if="{{item.options.length}}">
            <text wx:for="{{item.options}}" wx:for-item="opt" wx:key="index">
              {{opt.label}} → {{opt.nextTreeKey ? ('tree:' + opt.nextTreeKey) : opt.nextNodeId}}
            </text>
          </view>
          <view class="ta-node-actions">
            <view data-id="{{item._id}}" bindtap="openEditNode">编辑</view>
            <view class="danger" data-id="{{item._id}}" bindtap="deleteNode">删除</view>
          </view>
        </view>
      </view>
      <view class="ta-empty ta-empty--small" wx:else>该主题还没有节点</view>
    </block>
  </view>
</view>

<!-- 主题编辑 -->
<view class="ta-mask" wx:if="{{showTreeForm}}" catchtouchmove="true">
  <view class="ta-sheet">
    <scroll-view class="ta-sheet-scroll" scroll-y>
      <text class="ta-sheet-title">{{treeForm._id ? '编辑主题' : '新增主题'}}</text>
      <text class="ta-label">主题名称</text>
      <input class="ta-input" value="{{treeForm.title}}" data-field="title" bindinput="onTreeInput" placeholder="例如：点击按钮没反应？" />
      <text class="ta-label">主题 key</text>
      <input class="ta-input" value="{{treeForm.key}}" data-field="key" bindinput="onTreeInput" disabled="{{treeForm._id ? true : false}}" placeholder="例如 btn_no_response" />
      <text class="ta-label">简短说明</text>
      <textarea class="ta-textarea ta-textarea--short" value="{{treeForm.subtitle}}" data-field="subtitle" bindinput="onTreeInput" />
      <text class="ta-label">入口节点 ID</text>
      <input class="ta-input" value="{{treeForm.entryNodeId}}" data-field="entryNodeId" bindinput="onTreeInput" placeholder="先保存节点，再复制 ID 回填" />
      <text class="ta-label">适用机型（逗号分隔；留空为全部）</text>
      <input class="ta-input" value="{{treeForm.modelTagsText}}" data-field="modelTagsText" bindinput="onTreeInput" />
      <text class="ta-label">排序</text>
      <input class="ta-input" type="number" value="{{treeForm.sort}}" data-field="sort" bindinput="onTreeInput" />
      <view class="ta-switch-row">
        <text>用户可见</text>
        <switch checked="{{treeForm.enabled}}" bindchange="onTreeEnabled" color="#111111" />
      </view>
      <view class="ta-sheet-actions">
        <view class="ta-secondary" bindtap="closeTreeForm">取消</view>
        <view class="ta-primary {{saving ? 'disabled' : ''}}" bindtap="saveTree">{{saving ? '保存中…' : '保存主题'}}</view>
      </view>
    </scroll-view>
  </view>
</view>

<!-- 节点编辑 -->
<view class="ta-mask" wx:if="{{showNodeForm}}" catchtouchmove="true">
  <view class="ta-sheet ta-sheet--node">
    <scroll-view class="ta-sheet-scroll" scroll-y>
      <text class="ta-sheet-title">{{nodeForm._id ? '编辑节点' : '新增节点'}}</text>
      <text class="ta-node-id" wx:if="{{nodeForm._id}}" selectable>ID：{{nodeForm._id}}</text>
      <text class="ta-label">节点类型</text>
      <picker range="{{nodeTypeRange}}" bindchange="onNodeTypeChange">
        <view class="ta-picker">{{nodeForm.type}} ›</view>
      </picker>
      <text class="ta-label">标题</text>
      <input class="ta-input" value="{{nodeForm.title}}" data-field="title" bindinput="onNodeInput" />
      <text class="ta-label">操作说明</text>
      <textarea class="ta-textarea" value="{{nodeForm.body}}" data-field="body" bindinput="onNodeInput" />
      <text class="ta-label">教学视频</text>
      <view class="ta-video-pick" bindtap="chooseNodeVideo">
        <video
          wx:if="{{nodeTempVideoPath || nodeForm.media.url}}"
          class="ta-video"
          src="{{nodeTempVideoPath || nodeForm.media.url}}"
          controls="{{false}}"
          show-center-play-btn="{{false}}"
        ></video>
        <text wx:else>＋ 选择或拍摄视频</text>
      </view>
      <view class="ta-clear-media" wx:if="{{nodeTempVideoPath || nodeForm.media.url}}" bindtap="clearNodeVideo">移除视频</view>
      <block wx:if="{{nodeForm.type !== 'result'}}">
        <text class="ta-label">选项与指向（每行一个）</text>
        <textarea
          class="ta-textarea ta-textarea--options"
          value="{{nodeOptionsText}}"
          bindinput="onNodeOptionsInput"
          placeholder="灯闪烁 | 下一节点ID&#10;进入其他主题 | tree:主题key"
        />
      </block>
      <block wx:else>
        <text class="ta-label">结果类型</text>
        <picker range="{{nodeResultRange}}" bindchange="onNodeResultChange">
          <view class="ta-picker">{{nodeForm.result}} ›</view>
        </picker>
        <text class="ta-label">结果按钮文案</text>
        <input class="ta-input" value="{{nodeForm.resultCta}}" data-field="resultCta" bindinput="onNodeInput" placeholder="例如：去故障报修" />
      </block>
      <text class="ta-label">排序</text>
      <input class="ta-input" type="number" value="{{nodeForm.sort}}" data-field="sort" bindinput="onNodeInput" />
      <view class="ta-sheet-actions">
        <view class="ta-secondary" bindtap="closeNodeForm">取消</view>
        <view class="ta-primary {{saving ? 'disabled' : ''}}" bindtap="saveNode">{{saving ? '保存中…' : '保存节点'}}</view>
      </view>
    </scroll-view>
  </view>
</view>
