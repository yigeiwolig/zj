<!-- pages/shouhou/shouhou.wxml -->
<view class="container">

<!-- ================== 首页 (iOS 风格) ================== -->
<view class="home-view {{inDetail ? 'shrink' : ''}}">
  <!-- 自定义导航栏（进二级详情时隐藏，避免 z-index 压在侧滑层上挡标题） -->
  <view wx:if="{{!inDetail}}" class="header" style="padding-top: {{statusBarHeight}}px;">
    <view class="back-icon" catchtap="goBack" style="top: {{statusBarHeight + 4}}px;">
        <text class="back-arrow">‹</text>
      </view>
    </view>
  <view wx:if="{{!inDetail}}" class="nav-header" style="padding-top: {{statusBarHeight + 22}}px;">
    <view class="sh-title-row sh-title-row--bar" style="min-height: {{navBarHeight + 28}}px;">
      <view class="sh-title-side sh-title-side--left"></view>
      <view class="sh-title-center">
        <text class="sh-title-text">MT 维修中心</text>
        <view wx:if="{{isAuthorized}}" class="admin-toggle-btn sh-admin-below-title {{isAdmin ? 'on' : ''}}" catchtap="toggleAdminMode">
          {{isAdmin ? 'EXIT' : 'EDIT'}}
        </view>
        <view wx:else class="sh-usage-guide-btn sh-usage-guide-btn--below-title" catchtap="openShouhouUsageTutorial">使用教程</view>
      </view>
      <view class="sh-title-side sh-title-side--right"></view>
    </view>
  </view>

  <scroll-view
    class="sh-home-scroll"
    scroll-y="{{true}}"
    enhanced="{{true}}"
    show-scrollbar="{{false}}"
    scroll-top="{{shHomeScrollTop}}"
    scroll-with-animation="{{shHomeScrollAnim}}"
    scroll-into-view="{{shGuideScrollIntoView}}"
  >
  <view id="shGuideModelPicker" class="sh-guide-model-picker">
  <view id="shGuideMainSeries" class="sh-guide-main-series">
  <!-- F1 系列 -->
  <view id="shGuideSeriesF1" class="sh-guide-series-block">
  <view class="section-title">F1 系列</view>
  <view class="card-grid card-grid-triple">
    <view class="i-card i-card--compact style-white" bindtap="enterModel" data-name="F1 PRO" data-series="F1">
      <view class="card-top"><text class="badge">标准版</text></view>
      <view class="card-btm"><view class="p-name">F1 PRO</view><view class="p-desc">日常优选</view><view class="p-price">¥288</view></view>
      <view class="circle-decor"></view>
    </view>
    <view class="i-card i-card--compact style-black" bindtap="enterModel" data-name="F1 MAX" data-series="F1">
      <view class="card-top"><text class="badge">高级版</text></view>
      <view class="card-btm"><view class="p-name">F1 MAX</view><view class="p-desc">性能进阶</view><view class="p-price">¥388</view></view>
      <view class="circle-decor"></view>
    </view>
    <view class="i-card i-card--compact style-ultra" bindtap="enterModel" data-name="F1 ULTRA" data-series="F1">
      <view class="card-top"><text class="badge badge--gold">旗舰款</text></view>
      <view class="card-btm"><view class="p-name">F1 ULTRA</view><view class="p-desc">巅峰配置</view><view class="p-price">¥588</view></view>
      <view class="circle-decor"></view>
    </view>
  </view>
  </view>

  <!-- F2 家族系列 -->
  <view id="shGuideSeriesF2" class="sh-guide-series-block">
  <view class="section-title">F2 家族系列</view>
  <view class="card-grid card-grid-triple card-grid-triple--with-long">
    <view class="i-card i-card--compact style-white" bindtap="enterModel" data-name="F2 PRO" data-series="F2">
      <view class="card-top"><text class="badge">普通版</text></view>
      <view class="card-btm"><view class="p-name">F2 PRO</view><view class="p-desc">日常优选</view><view class="p-price">¥488</view></view>
      <view class="circle-decor"></view>
    </view>
    <view class="i-card i-card--compact style-black" bindtap="enterModel" data-name="F2 MAX" data-series="F2">
      <view class="card-top"><text class="badge">高级版</text></view>
      <view class="card-btm"><view class="p-name">F2 MAX</view><view class="p-desc">性能进阶</view><view class="p-price">¥588</view></view>
      <view class="circle-decor"></view>
    </view>
    <view class="i-card i-card--compact style-ultra" bindtap="enterModel" data-name="F2 ULTRA" data-series="F2">
      <view class="card-top"><text class="badge badge--gold">旗舰款</text></view>
      <view class="card-btm"><view class="p-name">F2 ULTRA</view><view class="p-desc">巅峰配置</view><view class="p-price">¥688</view></view>
      <view class="circle-decor"></view>
    </view>
  </view>
  <view class="card-grid card-grid-f2long">
    <view class="f2-long-bar" bindtap="enterModel" data-name="F2 Long" data-series="F2 Long">
      <view class="f2-long-bar__main">
        <text class="f2-long-bar__tag">加长款</text>
        <text class="f2-long-bar__title">F2 Long</text>
        <text class="f2-long-bar__price">¥588</text>
      </view>
      <text class="f2-long-bar__link">查看详情 ›</text>
    </view>
  </view>
  </view>
  </view>

  <!-- F3 系列 -->
  <view id="shGuideSeriesF3" class="sh-guide-series-block">
  <view class="section-title">F3 系列</view>
  <view class="card-grid card-grid-double">
    <view class="i-card i-card--compact style-white" bindtap="enterModel" data-name="F3 PRO" data-series="F3">
      <view class="card-top"><text class="badge">标准版</text></view>
      <view class="card-btm"><view class="p-name">F3 PRO</view><view class="p-desc">日常优选</view><view class="p-price">¥788</view></view>
      <view class="circle-decor"></view>
    </view>
    <view class="i-card i-card--compact style-black" bindtap="enterModel" data-name="F3 MAX" data-series="F3">
      <view class="card-top"><text class="badge">旗舰款</text></view>
      <view class="card-btm"><view class="p-name">F3 MAX</view><view class="p-desc">巅峰配置</view><view class="p-price">¥888</view></view>
      <view class="circle-decor"></view>
    </view>
  </view>
  </view>
  </view>
  </scroll-view>

  <!-- 管理员一键同步数据按钮 -->
  <view wx:if="{{isAdmin}}" class="sync-all-container" style="padding: 40rpx 40rpx 50px;">
    <view class="sync-all-btn" catchtap="syncAllPartsToCloud">
      一键同步所有数据到云端
    </view>
  </view>
</view>

<!-- ================== 二级页面 (侧滑详情) ================== -->
<!-- 顶栏：占位高度=menuButton.top、导航行高=胶囊高度；不用 safeArea.top 与 status 取 max（工具里 safeArea 常偏大） -->
<view class="detail-view {{inDetail ? 'slide-in' : ''}}">
  <view class="detail-status-spacer" style="height: {{detailSafeTopPx}}px;"></view>
  <view class="detail-nav" style="min-height: {{detailNavBandPx}}px;">
    <view class="nav-back-btn" bindtap="exitModel">
      <text class="back-icon">‹</text>
    </view>
    <view class="nav-title-wrap">
      <text class="nav-title">{{detailNavTitle || currentModelName}}</text>
    </view>
    <view style="width: 40px;"></view>
  </view>

  <view class="content-scroll {{partsTableMode ? 'content-scroll--table-mode' : ''}}"
        bindtouchmove="handleAdminContainerTouchMove"
        bindtouchend="handleAdminContainerTouchEnd"
        bindtouchcancel="handleAdminContainerTouchEnd">
    <!-- 顶部 Tab -->
    <view class="tab-group">
      <view class="tab-item {{activeTab==='order'?'active':''}}" bindtap="switchTab" data-mode="order">维修工单</view>
      <view class="tab-item {{activeTab==='tutorial'?'active':''}}" bindtap="switchTab" data-mode="tutorial">维修教程</view>
    </view>

    <!-- TAB 1: 维修工单 -->
    <view wx:if="{{activeTab === 'order'}}">
      
      <!-- 服务类型切换 -->
      <view class="svc-switch" id="shGuideSvcSwitch">
        <view class="svc-switch-pill {{serviceType==='repair' ? 'svc-switch-pill--repair' : ''}}"></view>
        <view class="svc-item {{serviceType==='parts'?'selected':''}}" bindtap="toggleService" data-type="parts">购买配件</view>
        <view class="svc-item {{serviceType==='repair'?'selected':''}}" bindtap="toggleService" data-type="repair">故障报修</view>
      </view>

      <!-- A. 配件选择区 -->
      <view wx:if="{{serviceType === 'parts'}}" id="shGuidePartsSection" class="parts-section {{partsTableMode ? 'parts-section--table-mode' : ''}}">
        <view class="parts-section-header">
          <view class="section-label">配件清单</view>
          <view wx:if="{{isAdmin}}" class="admin-tools-row">
            <view class="parts-table-mode-toggle {{partsTableMode ? 'on' : ''}}" catchtap="togglePartsTableMode">
              {{partsTableMode ? '卡片模式' : '表格模式'}}
            </view>
            <view class="sync-parts-btn" catchtap="syncPartsFromF1Pro">
              同步配件
            </view>
          </view>
        </view>

        <!-- 管理员表格模式：批量编辑名称/价格 -->
        <view wx:if="{{partsTableMode}}" class="parts-table-wrap">
          <view class="parts-table-head">
            <text class="parts-th parts-th--idx">#</text>
            <text class="parts-th parts-th--name">配件名称</text>
            <text class="parts-th parts-th--price">价格</text>
            <text class="parts-th parts-th--act"></text>
          </view>
          <block wx:for="{{partsTableDraft}}" wx:key="tableKey">
            <view class="parts-table-row">
              <text class="parts-td parts-td--idx">{{index + 1}}</text>
              <view class="parts-td-cell parts-td--name">
                <input
                  class="parts-td-input"
                  value="{{item.name}}"
                  bindinput="onPartsTableNameInput"
                  data-index="{{index}}"
                  placeholder="配件名称"
                />
              </view>
              <view class="parts-td-cell parts-td--price">
                <text class="parts-price-prefix">¥</text>
                <input
                  class="parts-td-input parts-price-input"
                  type="digit"
                  value="{{item.price}}"
                  bindinput="onPartsTablePriceInput"
                  data-index="{{index}}"
                  placeholder="0"
                />
              </view>
              <view class="parts-td parts-td--act" catchtap="adminRemovePartTableRow" data-index="{{index}}">✕</view>
            </view>
          </block>
          <view class="parts-table-add-row" catchtap="adminAddPartTableRow">+ 添加配件行</view>
        </view>

        <!-- 默认卡片模式 -->
        <view wx:else class="parts-container">
          <block wx:for="{{currentPartsList}}" wx:key="listKey">
            <view class="part-tag-wrapper" 
                  data-index="{{index}}">
              <view class="part-tag {{item.selected ? 'active' : ''}} {{item.preselected ? 'preselected' : ''}} {{item.preselected && !item.selected ? 'preselected-unchecked' : ''}} {{isDragging && dragIndex === index ? 'dragging' : ''}}"
                    bindtap="togglePart"
                    bindlongpress="handleLongPress"
                    data-index="{{index}}"
                    style="{{isDragging && dragIndex === index ? 'position: fixed; left: ' + dragX + 'px; top: ' + dragY + 'px; width: ' + cardWidth + 'px; opacity: 0.9; z-index: 9999; transition: none;' : ''}}">
                <text>{{item.name}}</text>
                <!-- 显示价格 -->
                <text class="part-price" style="color: #007AFF !important;">¥{{item.price || 0}}</text>
                <!-- 管理员改价/改名/删除按钮 (右下角) -->
                <view wx:if="{{isAdmin && !isDragging}}" class="admin-edit-price" catchtap="adminEditPartPrice" data-index="{{index}}">✎</view>
                <!-- 管理员排序标识（左上角） -->
                <view wx:if="{{isAdmin}}" class="sort-indicator" catchtap="doNothing">☰</view>
              </view>
              <!-- 占位符（拖动时显示） -->
              <view wx:if="{{isDragging && dragIndex === index}}" class="part-tag-placeholder"></view>
            </view>
          </block>
          <!-- 管理员添加配件按钮 -->
          <view wx:if="{{isAdmin}}" class="part-tag add-part-btn" catchtap="adminAddPart">
            <text style="font-size: 40rpx; color: #007AFF;">+</text>
            <text style="font-size: 24rpx; color: #666;">添加配件</text>
          </view>
        </view>
      </view>

      <!-- B. 故障报修区 -->
      <view wx:if="{{serviceType === 'repair'}}" id="shGuideRepairSection">
        <view class="section-label">故障描述</view>
        <textarea class="input-area" placeholder="请详细描述故障现象..." style="height: 100px;" value="{{repairDescription}}" bindinput="handleRepairInput"></textarea>
        <view class="upload-box" bindtap="chooseVideo">
          <!-- 已选择素材：视频和图片二选一，共用同一显示区域 -->
          <view wx:if="{{tempVideoPath || tempImagePath}}" class="upload-selected" catchtap="openRepairMediaPreview">
            <view class="upload-preview-container">
              <!-- 图片模式 -->
              <image wx:if="{{tempImagePath}}" src="{{tempImagePath}}" mode="aspectFill" class="upload-preview-img" lazy-load="true"></image>
              <!-- 视频模式 -->
              <block wx:else>
                <image wx:if="{{tempVideoThumb && tempVideoThumb !== 'AUTO_GENERATE'}}" src="{{tempVideoThumb}}" mode="aspectFill" class="upload-preview-img" lazy-load="true"></image>
                <video wx:else src="{{tempVideoPath}}" class="upload-preview-video" show-center-play-btn="{{false}}" enable-play-gesture="{{false}}" controls="{{false}}" preload="metadata"></video>
                <view class="upload-play-icon">▶</view>
              </block>
              <view class="upload-remove" catchtap="removeRepairVideo">✕</view>
            </view>
          </view>

          <!-- 未选择素材：显示上传提示 -->
          <view wx:else class="upload-placeholder">
            <view style="font-size:24px;">📹</view>
            <view class="upload-text">点击上传故障视频或照片</view>
            <view class="upload-sub">二选一：视频或照片</view>
          </view>
        </view>
      </view>

      <!-- 购买配件模式下的占位 - 根据内容动态调整 -->
      <view wx:if="{{serviceType === 'parts' && !partsTableMode}}" style="height: {{partsPlaceholderHeight}};"></view> 
    </view>

    <!-- TAB 2: 维修教程 -->
    <view wx:if="{{activeTab === 'tutorial'}}">
      <!-- 锁屏界面 -->
      <view wx:if="{{isLocked}}" class="lock-screen" bindtap="focusInput">
        <view style="font-size:40px; margin-bottom:20px;">🔒</view>
        <view style="font-weight:700; font-size:18px;">访客验证</view>
        <view style="color:#999; font-size:14px; margin-top:10px;">请输入对应型号密码</view>
        <view class="dots-row">
          <block wx:for="{{[0,1,2,3,4,5]}}" wx:key="*this">
            <view class="dot {{passInput.length > item ? 'filled' : ''}}"></view>
          </block>
        </view>
        <view wx:if="{{passError}}" style="color:red; font-size:14px; margin-top:20px;">密码错误</view>
        <input 
          class="hidden-input" 
          type="number" 
          maxlength="6" 
          bindinput="onPassInput" 
          value="{{passInput}}" 
          focus="{{focusPass}}"
          adjust-position="{{false}}"
          hold-keyboard="{{false}}"
          confirm-type="done"
        />
      </view>

      <!-- 视频列表 -->
      <view wx:else>
        <view wx:if="{{isAdmin}}" class="admin-add-area" bindtap="openModal" data-mode="video">
          <view class="plus-icon">+</view><text>上传新教程视频</text>
        </view>
        <view class="sh-tutorial-search-wrap">
          <view class="sh-tutorial-search-bar">
            <view class="sh-tutorial-search-icon" aria-hidden="true">
              <view class="sh-tutorial-search-icon-ring"></view>
            </view>
            <input
              class="sh-tutorial-search-input"
              type="text"
              value="{{tutorialSearchKeyword}}"
              placeholder="搜索教程标题"
              placeholder-class="sh-tutorial-search-placeholder"
              confirm-type="search"
              bindinput="onTutorialSearchInput"
              bindconfirm="onTutorialSearchInput"
            />
            <view
              class="sh-tutorial-search-clear"
              wx:if="{{tutorialSearchKeyword}}"
              catchtap="onTutorialSearchClear"
            >
              <text class="sh-tutorial-search-clear-x">×</text>
            </view>
          </view>
          <view class="sh-tutorial-search-hint" wx:if="{{tutorialSearchActive}}">
            <text class="sh-tutorial-search-hint-text" wx:if="{{tutorialSearchMatchCount > 0}}">找到 {{tutorialSearchMatchCount}} 条相关教程</text>
            <text class="sh-tutorial-search-hint-text sh-tutorial-search-hint-text--empty" wx:else>未找到「{{tutorialSearchKeyword}}」相关教程</text>
          </view>
        </view>
        <view class="sh-tutorial-list-label">如果找不到教程请联系MT管理员</view>
        <view class="video-list-container">
          <block wx:for="{{currentVideoList}}" wx:key="_listKey">
            <view
              class="sh-tutorial-card-shell {{tutorialSearchActive && item._searchPop ? 'sh-tutorial-card-shell--pop' : ''}}"
              style="{{tutorialSearchActive && item._searchPop ? 'animation-delay:' + item._popDelayMs + 'ms;' : ''}}"
            >
            <view class="video-card video-card--tutorial-chapter {{isAdmin && isDragging && dragIndex === index ? 'dragging' : ''}}"
              style="{{isAdmin && isDragging && dragIndex === index ? 'transform: translateY(' + dragOffsetY + 'px) scale(1.02);' : ''}}"
              bindtouchstart="{{isAdmin ? 'onDragStart' : ''}}"
              catchtouchmove="{{isAdmin && isDragging ? 'onDragMove' : ''}}"
              bindtouchend="{{isAdmin ? 'onDragEnd' : ''}}"
              bindtouchcancel="{{isAdmin ? 'onDragEnd' : ''}}"
              bindlongpress="{{isAdmin ? 'onLongPress' : ''}}"
              data-index="{{index}}"
              id="sh-tutorial-card-{{index}}"
            >
              <view class="v-chapter-cover-wrap" wx:if="{{item.src || item.thumb}}">
                <view class="v-chapter-cover-tap" catchtap="onTutorialCoverTap" data-index="{{index}}" mark:listIdx="{{index}}">
                  <video
                    wx:if="{{tutorialInlineMountIndex === index}}"
                    id="sh-tutorial-inline-{{index}}"
                    class="v-chapter-inline-video"
                    src="{{item.src}}"
                    poster="{{item.thumb}}"
                    data-index="{{index}}"
                    mark:listIdx="{{index}}"
                    object-fit="contain"
                    show-fullscreen-btn="{{false}}"
                    show-center-play-btn="{{true}}"
                    show-casting-button="{{false}}"
                    show-background-playback-button="{{false}}"
                    picture-in-picture-mode=""
                    controls="{{true}}"
                    enable-play-gesture="{{true}}"
                    muted="{{false}}"
                    bindloadedmetadata="onTutorialInlineLoadedMeta"
                    bindtimeupdate="onTutorialInlineTimeUpdate"
                    bindplay="onTutorialInlinePlay"
                    bindpause="onTutorialInlinePause"
                    bindended="onTutorialInlineEnded"
                    binderror="onTutorialInlineError"
                  ></video>
                  <view wx:else class="v-chapter-cover-placeholder" style="background: {{item.coverColor || '#1c1c1e'}};">
                    <image wx:if="{{item.thumb}}" class="v-chapter-cover-img" src="{{item.thumb}}" mode="aspectFill" lazy-load="{{true}}"></image>
                    <text class="v-chapter-cover-ph-play">▶</text>
                  </view>
                </view>
              </view>
              <view class="sh-tutorial-player-placeholder" wx:else>
                <text class="sh-tutorial-placeholder-text">暂无视频</text>
              </view>
              <view class="v-info sh-tutorial-v-info">
                <view class="v-info-head">
                  <text class="v-title">{{item.title}}</text>
                  <view class="v-mt-brand">
                    <text class="v-mt-m">M</text>
                    <view class="v-mt-t-block">
                      <text class="v-mt-t">T</text>
                      <view class="v-mt-mark"></view>
                    </view>
                  </view>
                </view>
                <view class="sh-tutorial-meta-row">
                  <text class="sh-tutorial-hint-in-card">双击屏幕暂停播放视频</text>
                  <view class="sh-tutorial-card-actions">
                    <view class="sh-tutorial-action-cell sh-tutorial-action-cell--primary" catchtap="openTutorialFullScreenVideo" data-index="{{index}}" mark:listIdx="{{index}}">
                      <text class="sh-tutorial-action-text">全屏播放</text>
                    </view>
                  </view>
                </view>
                <view class="sh-tutorial-video-subrow" wx:if="{{isAdmin}}">
                  <view class="video-admin-ops">
                    <text class="video-del" data-index="{{index}}" catchtap="deleteVideo">删除</text>
                  </view>
                </view>
              </view>
            </view>
            </view>
          </block>
        </view>
      </view>
    </view>

  </view>

  <!-- 底部栏 (根据 Service Type 变化) -->
  <view class="bottom-dock" id="shGuideFooterDock" wx:if="{{activeTab === 'order' && !partsTableMode}}">
    
    <!-- 情况A: 购买配件 (双按钮) -->
    <view class="footer-btn-group" wx:if="{{serviceType === 'parts'}}">
      <view class="btn-cart" bindtap="addToCart">加入购物车</view>
      <view class="btn-buy" bindtap="openCartOrder">立即购买</view>
    </view>

    <!-- 情况B: 故障报修 (单按钮) -->
    <view class="footer-btn-group" wx:if="{{serviceType === 'repair'}}">
      <view class="btn-black full" bindtap="openRepairOrder">提交维修工单</view>
    </view>

  </view>

  <!-- 表格模式底部栏：固定显示同步按钮 -->
  <view class="parts-table-dock" wx:if="{{activeTab === 'order' && serviceType === 'parts' && partsTableMode}}">
    <view class="parts-table-dock-btn parts-table-dock-btn--ghost" catchtap="togglePartsTableMode">退出表格</view>
    <view class="parts-table-dock-btn {{partsTableSyncing ? 'disabled' : ''}}" catchtap="syncPartsTableToCloud">
      {{partsTableSyncing ? '同步中...' : '完成同步'}}
    </view>
  </view>
</view>

<!-- 维修教程：全屏播放（与 azjc 安装教程全屏逻辑一致：pageOrientation auto + 窗口 w>h 门闸） -->
<view class="fullscreen-video-mask {{isTutorialVideoFullScreen ? 'active' : ''}} {{tutorialFullScreenMaskClosing ? 'closing' : ''}}" wx:if="{{isTutorialVideoFullScreen}}" catchtouchmove="noop" catchtap="noop">
  <view class="fullscreen-video-container {{tutorialFullScreenTransform}}" style="{{tutorialFullScreenInitialStyle}}" catchtouchmove="noop">
    <video
      class="fullscreen-video-player"
      src="{{tutorialFullScreenVideoUrl}}"
      preload="metadata"
      wx:if="{{tutorialFullScreenVideoUrl && tutorialFullScreenNativeUiReady}}"
      wx:key="sh-tut-fs-{{tutorialFullScreenNativeKey}}"
      controls="{{true}}"
      show-play-btn="{{true}}"
      show-center-play-btn="{{false}}"
      show-mute-btn="{{true}}"
      show-progress="{{true}}"
      show-fullscreen-btn="{{false}}"
      enable-play-gesture="{{false}}"
      vslide-gesture="{{false}}"
      vslide-gesture-in-fullscreen="{{false}}"
      object-fit="contain"
      bindplay="onTutorialFullScreenNativePlay"
      bindpause="onTutorialFullScreenNativePause"
      bindtimeupdate="onTutorialFullScreenVideoTimeUpdate"
      bindloadedmetadata="onTutorialFullScreenVideoLoadedMetadata"
      binderror="onTutorialFullScreenVideoError"
      id="sh-fullscreen-tutorial-video"
    >
      <cover-view wx:if="{{tutorialFullScreenLandscapeOk}}" class="azjc-close-video-btn" style="{{tutorialFullScreenCloseCoverStyle}}" catchtap="closeTutorialFullScreenVideo">×</cover-view>
      <!-- 透明点击层：单击切换播放/暂停（仅横屏时生效） -->
      <cover-view wx:if="{{tutorialFullScreenLandscapeOk}}" class="sh-fs-video-tap-layer" catchtap="toggleTutorialFullScreenPlay"></cover-view>
    </video>
    <!-- MT 自定义暂停键（横屏且暂停时显示，但竖屏提示出现时隐藏） -->
    <view class="sh-fs-center-play-wrap" wx:if="{{tutorialFullScreenPaused && tutorialFullScreenLandscapeOk && !tutorialFullScreenExitPortraitHint && tutorialFullScreenRotateHintDismissed}}" catchtap="toggleTutorialFullScreenPlay">
      <view class="center-play-triangle">
        <text class="mt-logo-text">MT</text>
      </view>
    </view>
    <view
      wx:if="{{tutorialFullScreenExitPortraitHint}}"
      class="fs-portrait-exit-web-root"
      catchtouchmove="noop"
      catchtap="noop"
    >
      <view class="fs-portrait-exit-card" catchtap="noop">
        <view class="fs-portrait-exit-phone-stage">
          <view class="fs-portrait-exit-phone"></view>
        </view>
        <view class="fs-portrait-exit-title">请竖握手机</view>
        <view class="fs-portrait-exit-desc">即将返回教程</view>
        <view class="fs-portrait-exit-skip" catchtap="closeTutorialFullScreenVideo">跳过</view>
      </view>
    </view>
    <view
      wx:if="{{!tutorialFullScreenLandscapeOk && !tutorialFullScreenRotateHintDismissed}}"
      class="fs-landscape-gate-web-root"
      catchtouchmove="noop"
      catchtap="noop"
    >
      <view class="fs-landscape-gate-close" catchtap="closeTutorialFullScreenVideo">×</view>
      <view class="fs-landscape-gate-card" catchtap="noop">
        <view class="fs-landscape-gate-body">
          <view class="fs-landscape-gate-stage">
            <view class="fs-landscape-gate-phone-wrap">
              <view class="fs-landscape-gate-phone-stage">
                <view class="fs-landscape-gate-phone-dial"></view>
              </view>
            </view>
            <view class="fs-landscape-gate-title">请横屏观看</view>
            <view class="fs-landscape-gate-desc-block">
              <view class="fs-landscape-gate-desc-line">竖屏窗口下暂不播放。</view>
              <view class="fs-landscape-gate-desc-line">请将手机横握。</view>
              <view class="fs-landscape-gate-desc-line">横屏后会尽量接着播放。</view>
            </view>
            <view class="fs-landscape-gate-lock-tip">
              <view class="fs-landscape-gate-lock-tip-badge">重点提示</view>
              <view class="fs-landscape-gate-desc-line fs-landscape-gate-desc-line--sub">若无法横屏，请从屏幕边缘下滑打开控制中心，</view>
              <view class="fs-landscape-gate-desc-line fs-landscape-gate-desc-line--sub fs-landscape-gate-lock-tip-strong">先关闭「竖排锁定」后再横握手机。</view>
            </view>
          </view>
        </view>
        <view class="fs-landscape-gate-footer">
          <view class="fs-landscape-gate-portrait-primary" catchtap="onAllowTutorialPortraitPlayback">竖屏播放（画面较小）</view>
          <view class="fs-landscape-gate-exit" catchtap="closeTutorialFullScreenVideo">退出全屏</view>
        </view>
      </view>
    </view>
  </view>
</view>

<!-- 6. 故障视频预览弹窗 -->
<view class="dark-mask" wx:if="{{showVideoPreview}}" bindtap="closeVideoPreview" catchtouchmove="noop"></view>
<view class="video-preview-modal" wx:if="{{showVideoPreview}}" catchtouchmove="noop">
  <view class="video-preview-box">
    <view class="video-preview-close" bindtap="closeVideoPreview">✕</view>
    <video 
      src="{{tempVideoPath}}" 
      id="repairVideoPreviewPlayer"
      preload="metadata"
      controls="{{false}}"
      autoplay="{{true}}" 
      object-fit="contain" 
      class="video-preview-player"
      bindplay="onVideoPlay"
      bindpause="onVideoPause"
    ></video>
    <!-- 🔴 新增：点击层，点击屏幕暂停/播放 -->
    <view class="video-preview-click-layer" bindtap="toggleVideoPlayPause"></view>
    <!-- 🔴 新增：暂停时显示的播放图标 -->
    <view class="video-preview-pause-overlay {{!isVideoPlaying ? 'show' : ''}}" catchtap="toggleVideoPlayPause">
      <view class="play-icon">
        <view class="play-triangle"></view>
      </view>
    </view>
  </view>
</view>


<!-- 加载小窗（与「我的」等同款：白底卡片 + 文案 + 进度条） -->
<view class="sh-loading-mask" wx:if="{{showLoadingAnimation}}" catchtouchmove="noop" catchtap="noop">
  <view class="sh-loader" catchtouchmove="noop" catchtap="noop">
    <text class="sh-loader-label">{{loadingText || '加载中...'}}</text>
    <view class="sh-loading-bar" aria-hidden="true"></view>
  </view>
</view>

<!-- 自定义故障设备选择器（底部弹出） -->
<view wx:if="{{showDevicePicker}}">
  <view class="device-picker-mask" bindtap="closeDevicePicker" catchtouchmove="noop"></view>
  <view class="device-picker-panel {{devicePickerActive ? 'device-picker-panel-opening' : 'device-picker-panel-closing'}}">
    <view class="dp-header">
      <view class="dp-btn" bindtap="closeDevicePicker">取消</view>
      <view class="dp-title">选择故障设备</view>
      <view class="dp-btn dp-confirm" bindtap="confirmDevicePicker">确定</view>
    </view>
    <!-- 简洁版：点击卡片选择设备（设备多时才允许滚动） -->
    <scroll-view 
      scroll-y="{{myDevices && myDevices.length > 3}}" 
      class="dp-card-list" 
      scroll-with-animation="{{myDevices && myDevices.length > 3}}" 
      scroll-into-view="{{(myDevices && myDevices.length > 3) ? deviceScrollId : ''}}"
    >
      <block wx:for="{{myDevices}}" wx:key="_id">
        <view 
          class="dp-card {{tempDeviceIndex === index ? 'active' : ''}}" 
          bindtap="chooseDeviceTemp" 
          data-index="{{index}}"
          id="device-{{index}}"
        >
          <view class="dp-card-main">
            <view class="dp-row">
              <text class="dp-sn">{{item.displaySn}}</text>
              <text class="dp-model">{{item.productModel || '未知型号'}}</text>
              <view class="dp-right-col">
                <view class="dp-status {{item.expiryDate ? (item.warrantyExpired ? 'expired' : 'active') : 'unknown'}}">
                  <text wx:if="{{!item.expiryDate}}">质保未登记</text>
                  <text wx:elif="{{item.warrantyExpired}}">已过保</text>
                  <text wx:else>质保中</text>
                </view>
                <text class="dp-warranty" wx:if="{{item.expiryDate}}">
                  {{ item.expiryDate + ' 到期' }}
                </text>
              </view>
            </view>
          </view>
        </view>
      </block>
      <view wx:if="{{!myDevices || myDevices.length === 0}}" class="dp-empty">
        暂无已绑定设备
      </view>
    </scroll-view>
  </view>
</view>

  <!-- 5. 全局自定义弹窗（带收缩退出动画） -->
  <view class="custom-dialog-mask {{dialogClosing ? 'closing' : ''}}" wx:if="{{dialog.show}}" bindtap="onDialogMaskTap" catchtouchmove="noop">
    <view class="custom-dialog-box" bindtap="dismissTransientModals" catchtouchmove="noop">
      <view class="cd-title">{{dialog.title}}</view>
      <view class="cd-content">{{dialog.content}}</view>
      <view class="cd-btn-row">
        <view class="cd-btn cancel" wx:if="{{dialog.showCancel}}" bindtap="closeCustomDialog">{{dialog.cancelText || '取消'}}</view>
        <view class="cd-btn confirm" bindtap="onDialogConfirm">{{dialog.confirmText || '确定'}}</view>
      </view>
    </view>
  </view>

  <!-- ================= 自动消失提示（无按钮，2秒后自动消失，带收缩退出动画） ================= -->
  <view class="auto-toast-mask {{autoToastClosing ? 'closing' : ''}}" wx:if="{{autoToast.show}}" catchtouchmove="noop" bindtap="dismissTransientModals">
    <view class="auto-toast-box" catchtouchmove="noop" bindtap="dismissTransientModals">
      <view class="at-title">{{autoToast.title}}</view>
      <view class="at-content">{{autoToast.content}}</view>
    </view>
  </view>

  <!-- 🔴 不再需要隐藏的 video 和 canvas 组件，因为我们直接使用 video 组件显示第一帧 -->

</view>

<!-- ================= 核心弹窗区域（container 外，避免被 detail-view 压住） ================= -->

<!-- 0. 购买配件过来时的预选完成提示小弹窗 -->
<view class="preselect-tip-mask" wx:if="{{showPreselectTip}}" catchtouchmove="noop" bindtap="closePreselectTip">
  <view class="preselect-tip-box" catchtap="noop">
    <view class="preselect-tip-title">已预选完成</view>
    <view class="preselect-tip-desc">点击下方「立即购买」购买配件</view>
    <view class="preselect-tip-btn" catchtap="closePreselectTip">知道了</view>
  </view>
  <view class="preselect-tip-arrow-to-buy" style="transform: translateX(50%) translateY({{arrowTranslateY}}rpx); transition: transform 0.4s ease-in-out;" catchtap="closePreselectTip">▼</view>
</view>

<!-- 1. 加入购物车成功弹窗 -->
<view class="success-mask {{cartSuccessClosing ? 'closing' : ''}}" wx:if="{{showCartSuccess || cartSuccessClosing}}" catchtouchmove="noop" bindtap="dismissTransientModals">
  <view class="success-box" catchtouchmove="noop" bindtap="dismissTransientModals">
    <view class="s-icon">✔</view>
    <view class="s-title">已加入购物车</view>
    <view class="s-desc">商品已保存，您可以继续选购或去结算</view>
    <view class="s-btn-row">
      <view class="s-btn outline" bindtap="onContinueShopping">继续选购</view>
      <view class="s-btn fill" bindtap="onGoToCheckout">立即结算</view>
    </view>
  </view>
</view>

<!-- ================= 2. 订单确认/结算弹窗 ================= -->
<view class="dark-mask order-checkout-backdrop {{orderModalClosing ? 'closing' : ''}}" wx:if="{{showOrderModal || orderModalClosing}}" bindtap="closeOrderModal" catchtouchmove="noop"></view>

<view class="overlay full-screen-overlay order-checkout-panel {{orderModalActive && !orderModalClosing ? 'active' : ''}}" wx:if="{{showOrderModal || orderModalClosing}}" catchtouchmove="noop">
  <!-- 顶部 -->
  <view class="checkout-header">
    <view class="nav-close" bindtap="closeOrderModal">✕</view>
    <view class="co-title">确认工单</view>
    <view style="width:40rpx"></view>
  </view>

  <scroll-view scroll-y class="checkout-scroll">
    <view class="checkout-body">

      <!-- 故障报修信息（仅在故障报修模式下显示） -->
      <view wx:if="{{serviceType === 'repair'}}" class="group-card">
        <view class="cart-header-row">
          <view class="cart-title">故障信息</view>
        </view>
        <view class="repair-info-display">
          <view class="repair-desc-section">
            <view class="repair-label">故障描述</view>
            <view class="repair-desc-text">{{repairDescription || '未填写'}}</view>
          </view>

          <!-- 新增：故障设备选择 -->
          <view class="repair-device-section">
            <view class="repair-label">
              故障设备
              <text class="required-star">*</text>
            </view>
            <!-- 有设备列表时，使用自定义选择器入口 -->
            <view 
              wx:if="{{myDevices && myDevices.length > 0}}" 
              class="ios-select" 
              bindtap="openDevicePicker"
            >
                <!-- 未选择时：显示红色提示文字（居中） -->
                <block wx:if="{{selectedDeviceIndex === null}}">
                <text class="ios-select-placeholder-text">请选择故障设备</text>
                </block>
                <!-- 已选择时：左边显示 SN，右边显示型号 -->
                <block wx:else>
                  <text class="ios-select-sn">{{myDevices[selectedDeviceIndex].displaySn}}</text>
                <view class="ios-select-model-wrapper">
                  <text class="ios-select-model {{myDevices[selectedDeviceIndex].expiryDate ? (myDevices[selectedDeviceIndex].warrantyExpired ? 'ios-select-model-expired' : 'ios-select-model-active') : ''}}">
                    {{myDevices[selectedDeviceIndex].productModel || '未知型号'}}
                  </text>
                </view>
                </block>
                <text class="ios-select-arrow">⌵</text>
              </view>
            <!-- 没有设备列表时的提示（与 case 页风格一致） -->
            <view wx:else class="ios-select repair-no-device">
              未找到已绑定设备
            </view>
          </view>

          <view class="repair-device-section">
            <view class="repair-label">
              控制版本
              <text class="required-star">*</text>
            </view>
            <view class="ctrl-variant-seg {{repairControlVariant === 'remote' ? 'is-remote' : (repairControlVariant === 'button' ? 'is-button' : '')}}"
              bindtouchstart="onCtrlVariantTouchStart"
              bindtouchend="onCtrlVariantTouchEnd"
              data-scope="repair"
            >
              <view class="ctrl-variant-thumb-wrap"><view class="ctrl-variant-thumb"></view></view>
              <view
                class="ctrl-variant-item {{repairControlVariant === 'button' ? 'is-on' : ''}}"
                catchtap="onRepairControlVariantChange"
                data-value="button"
              >按钮版</view>
              <view
                class="ctrl-variant-item {{repairControlVariant === 'remote' ? 'is-on' : ''}}"
                catchtap="onRepairControlVariantChange"
                data-value="remote"
              >遥控版</view>
            </view>
          </view>

          <view class="repair-video-section" wx:if="{{tempVideoPath || tempImagePath}}">
            <view class="repair-label">故障素材</view>
            <view class="repair-video-wrapper">
              <!-- 图片模式 -->
              <image wx:if="{{tempImagePath}}" src="{{tempImagePath}}" mode="aspectFill" class="repair-video-thumb" lazy-load="true"></image>
              <!-- 视频模式 -->
              <block wx:else>
                <!-- 如果有提取的封面图，显示图片 -->
                <image wx:if="{{tempVideoThumb && tempVideoThumb !== 'AUTO_GENERATE'}}" src="{{tempVideoThumb}}" mode="aspectFill" class="repair-video-thumb" lazy-load="true"></image>
                <!-- 否则显示 video 组件（会自动显示第一帧） -->
                <video wx:else src="{{tempVideoPath}}" id="repairVideoDisplay" class="repair-preview-video" show-center-play-btn="{{false}}" enable-play-gesture="{{false}}" controls="{{false}}" preload="metadata"></video>
                <view class="repair-play-overlay">▶</view>
              </block>
            </view>
          </view>
          <view class="repair-video-section" wx:else>
            <view class="repair-label">故障素材</view>
            <view class="repair-no-video">未上传素材</view>
          </view>
        </view>
      </view>

      <!-- 商品清单（仅在购买配件模式下显示） -->
      <view wx:if="{{serviceType === 'parts'}}" class="group-card">
        <view class="cart-header-row">
          <view class="cart-title">商品清单</view>
          <view class="clear-btn-stylish" bindtap="clearCart">
            <text>🗑 清空</text>
          </view>
        </view>

        <block wx:for="{{cart}}" wx:key="id">
          <view class="cart-row">
            <view class="cr-info">
              <view class="cr-name">{{item.name}}</view>
              <view class="cr-spec">{{item.spec}}</view>
            </view>

            <view class="cr-action">
              <view class="cr-price">¥{{item.total}}</view>
              <view class="mini-stepper">
                <view class="ms-btn" catchtap="handleCartQty" data-index="{{index}}" data-type="minus">-</view>
                <view class="ms-num">{{item.quantity}}</view>
                <view class="ms-btn" catchtap="handleCartQty" data-index="{{index}}" data-type="plus">+</view>
              </view>
            </view>
          </view>
        </block>

        <view wx:if="{{cart.length === 0}}" class="empty-cart">购物车暂无商品</view>

      </view>

      <!-- 配送方式（购买配件/故障报修都显示，风格对齐 shop） -->
      <view class="group-header-row">
        <view class="group-title-with-badge">
          <view class="group-title-text">配送方式</view>
          <view class="ship-pick-chip">
            <view class="ship-pick-badge ship-pick-badge--{{shippingMethod}}">
              <text class="ship-pick-icon-text">{{shippingMethod === 'sf' ? 'SF' : '中'}}</text>
            </view>
            <text class="ship-pick-desc">{{shippingMethodLabel}} · {{shippingFeeText}}</text>
          </view>
        </view>
      </view>
      <view class="shipping-box">
        <view class="ship-item {{shippingMethod=='zto'?'active':''}}" bindtap="changeShipping" data-method="zto">
          <view class="ship-item-head">
            <view class="ship-pick-badge ship-pick-badge--zto">
              <text class="ship-pick-icon-text">中</text>
            </view>
            <view class="ship-name">中通快递</view>
          </view>
          <view class="ship-price">
            <block wx:if="{{serviceType === 'repair'}}">包邮</block>
            <block wx:elif="{{checkoutFreeShipping}}">包邮</block>
            <block wx:else>
              <text wx:if="{{shippingFee > 0 && shippingMethod=='zto'}}">¥{{shippingFee}}</text>
              <text wx:else>待计算</text>
              <text style="font-size:20rpx;color:#999;display:block;margin-top:4rpx;">省内12/省外15</text>
            </block>
          </view>
        </view>
        <!-- 顺丰选项：故障报修也不包邮，按地址计费 -->
        <view class="ship-item {{shippingMethod=='sf'?'active':''}}" bindtap="changeShipping" data-method="sf">
          <view class="ship-item-head">
            <view class="ship-pick-badge ship-pick-badge--sf">
              <text class="ship-pick-icon-text">SF</text>
            </view>
            <view class="ship-name">顺丰速运</view>
          </view>
          <!-- 顺丰运费根据地址动态计算：省内13元，省外22元；未选中时展示区间价 -->
          <view class="ship-price {{shippingMethod=='sf' ? '' : 'ship-price-range'}}">
            <block wx:if="{{shippingMethod=='sf'}}">
              <text wx:if="{{shippingFee > 0}}">¥{{shippingFee}}</text>
              <text wx:else>待计算</text>
            </block>
            <block wx:else>
              <view class="price-range-item">省内<text class="price-num">¥13</text><text class="price-separator">；</text>省外<text class="price-num">¥22</text></view>
            </block>
          </view>
        </view>
      </view>

      <!-- 总价显示区（仅在购买配件模式下显示） -->
      <view wx:if="{{serviceType === 'parts'}}" class="final-total-row">
        <text class="ft-label">共 {{cart.length}} 件，总计</text>
        <text class="ft-price">¥{{isAdmin ? 0.01 : finalTotalPrice}}</text>
      </view>

      <!-- 收货信息 -->
      <view class="group-header-row">
        <view class="group-title-text">收货信息</view>
        <view class="paste-btn-header" bindtap="openSmartPasteModal">智能粘贴</view>
      </view>

      <view class="group-card form-group">

        <!-- 姓名 -->
        <view class="form-item">
          <view class="form-label">收货人</view>
          <input class="form-input" placeholder="请填写姓名" placeholder-class="ph-style" bindinput="onInput" data-key="name" value="{{orderInfo.name}}"/>
        </view>

        <!-- 手机号 -->
        <view class="form-item">
          <view class="form-label">手机号</view>
          <input class="form-input" type="number" maxlength="11" placeholder="请填写11位手机号" placeholder-class="ph-style" bindinput="onInput" data-key="phone" value="{{orderInfo.phone}}"/>
        </view>


        <!-- [新增] 省市区选择 -->
        <view class="form-item">
          <view class="form-label">省市区</view>
          <view class="address-picker-row">
            <picker mode="selector" range="{{provinceList}}" range-key="name" value="{{provinceIndex}}" bindchange="onProvinceChange" class="address-picker-btn">
              <view class="address-picker-btn-inner {{!selectedProvince ? 'placeholder' : ''}}">
                <text class="address-picker-text">{{selectedProvince || '请选择省份'}}</text>
              </view>
            </picker>
            <picker mode="selector" range="{{cityList}}" range-key="name" value="{{cityIndex}}" bindchange="onCityChange" class="address-picker-btn" disabled="{{!selectedProvince}}">
              <view class="address-picker-btn-inner {{!selectedCity ? 'placeholder' : ''}} {{!selectedProvince ? 'disabled' : ''}}">
                <text class="address-picker-text">{{selectedCity || '请选择城市'}}</text>
              </view>
            </picker>
            <picker mode="selector" range="{{districtList}}" range-key="name" value="{{districtIndex}}" bindchange="onDistrictChange" class="address-picker-btn" disabled="{{!selectedCity}}">
              <view class="address-picker-btn-inner {{!selectedDistrict ? 'placeholder' : ''}} {{!selectedCity ? 'disabled' : ''}}">
                <text class="address-picker-text">{{selectedDistrict || '请选择区县'}}</text>
              </view>
            </picker>
          </view>
        </view>

        <!-- [修改] 详细地址 -->
        <view class="form-item">
          <view class="form-label">详细地址</view>
          <input class="form-input" placeholder="如：某某街道101号" placeholder-class="ph-style" bindinput="onInput" data-key="detailAddress" value="{{detailAddress}}"/>
        </view>

      </view>

    </view>
  </scroll-view>

  <!-- 底部单按钮 (立即支付/提交维修工单) -->
  <view class="checkout-footer-single">
    <view
      class="btn-black full {{(repairSubmitting || showLoadingAnimation) ? 'is-disabled' : ''}}"
      catchtap="submitRealOrder">
      <text class="btn-main" wx:if="{{serviceType === 'parts'}}">立即支付 ¥{{isAdmin ? 0.01 : finalTotalPrice}}</text>
      <text class="btn-main" wx:elif="{{repairSubmitting || showLoadingAnimation}}">提交中...</text>
      <text class="btn-main" wx:elif="{{serviceType === 'repair' && shippingMethod == 'sf' && shippingFee > 0}}">提交维修工单 · 顺丰 ¥{{shippingFee}}</text>
      <text class="btn-main" wx:else>提交维修工单</text>
    </view>
    </view>
  </view>

<!-- 管理员调试：两张卡上下同时展示 -->
<view class="repair-terms-mask aftersale-debug-mask {{aftersaleNoticeDebugClosing ? 'closing' : ''}}" wx:if="{{showAftersaleNoticeDebugStack || aftersaleNoticeDebugClosing}}" catchtouchmove="noop" catchtap="noop">
  <scroll-view class="aftersale-debug-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="aftersale-debug-stack">
      <view class="aftersale-debug-tag">调试 · A卡（全员）</view>
      <view class="as-card card-blue aftersale-debug-card" catchtap="noop">
        <view class="as-card-header">
