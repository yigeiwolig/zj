<!-- 维修工单须知：同意后才可提交；不同意则不允许申请 -->
<view class="repair-terms-mask {{repairTermsClosing ? 'closing' : ''}}" wx:if="{{showRepairTermsModal || repairTermsClosing}}" catchtouchmove="noop" catchtap="noop">
  <view class="repair-terms-dialog" catchtap="noop" catchtouchmove="noop">
    <view class="repair-terms-header">
      <text class="repair-terms-title">维修服务条款</text>
      <text class="repair-terms-sub">申请维修前请阅读并选择「确认并继续」或「不同意」</text>
    </view>

    <scroll-view class="repair-terms-body" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{true}}">
      <view class="terms-timeline">
        <view class="terms-step">
          <view class="step-indicator">
            <view class="step-dot"></view>
            <view class="step-line"></view>
          </view>
          <view class="step-content">
            <text class="step-text">MT 向您寄出维修/故障更换配件时，<text class="repair-terms-hl">寄出运费由 MT 承担</text>。</text>
          </view>
        </view>
        <view class="terms-step">
          <view class="step-indicator">
            <view class="step-dot"></view>
            <view class="step-line"></view>
          </view>
          <view class="step-content">
            <text class="step-text">您需将故障配件寄回 MT 分析检查，<text class="repair-terms-hl">寄回运费由您自行承担</text>。</text>
          </view>
        </view>
        <view class="terms-step">
          <view class="step-indicator">
            <view class="step-dot"></view>
            <view class="step-line"></view>
          </view>
          <view class="step-content">
            <text class="step-text">请在故障描述中尽量写清楚：在什么情况下出现故障、可能原因是什么；也可随件附纸条说明，便于我们排查。</text>
          </view>
        </view>
        <view class="terms-step">
          <view class="step-indicator">
            <view class="step-dot"></view>
            <view class="step-line"></view>
          </view>
          <view class="step-content">
            <text class="step-text">若收到 MT 寄出的配件后，<text class="repair-terms-hl-warn">30 天内未寄回故障配件</text>，将扣除该设备 <text class="repair-terms-hl-warn">半年（180 天）质保</text>（与设备绑定，不可单独拆分）。</text>
          </view>
        </view>
        <view class="terms-step">
          <view class="step-indicator">
            <view class="step-dot"></view>
          </view>
          <view class="step-content">
            <text class="step-text">选择「不同意」将无法提交维修申请；仅「确认并继续」后可继续申请维修服务。</text>
          </view>
        </view>
      </view>
    </scroll-view>

    <view class="repair-terms-action">
      <text class="repair-terms-countdown-tip" wx:if="{{!repairTermsConfirmReady}}">请仔细阅读，{{repairTermsConfirmCountdown}} 秒后可确认</text>
      <view class="repair-terms-btns">
        <view class="repair-terms-btn repair-terms-btn--cancel" bindtap="onRepairTermsDisagree">不同意</view>
        <view
          class="repair-terms-btn repair-terms-btn--confirm {{repairTermsConfirmReady ? '' : 'is-disabled'}}"
          bindtap="onRepairTermsConfirm">
          <text wx:if="{{repairTermsConfirmReady}}">{{repairTermsConfirmLabel}}</text>
          <text wx:else>请阅读 ({{repairTermsConfirmCountdown}}s)</text>
        </view>
      </view>
    </view>
  </view>
</view>

<!-- 管理员上传弹窗（放在 container 外，避免被 detail-view 层叠挡住） -->
<view class="modal-mask {{showModalClosing ? 'closing' : ''}}" wx:if="{{showModal || showModalClosing}}" catchtouchmove="noop">
  <view class="modal-box" catchtouchmove="noop">
    <view class="modal-header">
      <text class="modal-title">{{modalMode === 'part' ? '添加新配件' : '发布新教程'}}</text>
    </view>
    <view class="input-label">名称/标题</view>
    <input class="modal-input" placeholder="{{modalMode === 'part' ? '输入配件名称' : '例如：更换主板教程'}}" model:value="{{modalInputVal}}" />
    <block wx:if="{{modalMode === 'part'}}">
      <view class="input-label">价格（元）</view>
      <input class="modal-input" type="digit" placeholder="0" model:value="{{modalPriceVal}}" />
    </block>
    
    <block wx:if="{{modalMode === 'video'}}">
      <view class="input-label">视频文件</view>
      <view wx:if="{{tempVideoThumb || tempVideoPath}}" class="upload-preview" bindtap="adminChooseVideo">
        <block wx:if="{{tempVideoThumb && tempVideoThumb !== 'AUTO_GENERATE'}}">
          <image src="{{tempVideoThumb}}" mode="aspectFill" class="preview-img" lazy-load="true"></image>
        </block>
        <block wx:elif="{{tempVideoPath}}">
          <video src="{{tempVideoPath}}" class="preview-video" show-center-play-btn="{{false}}" enable-play-gesture="{{false}}" controls="{{false}}" preload="metadata"></video>
        </block>
        <block wx:else>
          <view class="preview-placeholder">已选择视频</view>
        </block>
        <view class="re-upload-tip">点击更换</view>
      </view>
      <view wx:else class="file-upload-btn" bindtap="adminChooseVideo">
        <text>＋ 点击选择视频文件</text>
      </view>
    </block>

    <view class="modal-btns">
      <view class="modal-btn cancel" bindtap="closeModal">取消</view>
      <view class="modal-btn confirm {{isUploadingVideo ? 'disabled' : ''}}" bindtap="confirmModal">{{modalMode === 'part' ? '确认添加' : '确认发布'}}</view>
    </view>
  </view>
</view>

