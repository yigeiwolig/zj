/* 搜索命中：卡片容器自下而上弹出（避免与 .video-card transform 冲突） */
.sh-tutorial-card-shell--pop {
  opacity: 0;
  transform: translate3d(0, 56rpx, 0);
  animation: shTutorialCardPopUp 0.48s cubic-bezier(0.22, 1, 0.32, 1) forwards;
}

@keyframes shTutorialCardPopUp {
  from {
    opacity: 0;
    transform: translate3d(0, 56rpx, 0);
  }
  to {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }
}

/* === 视频教程列表 (大卡片风格) === */
.video-list-container {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
  padding-bottom: 60rpx;
}

.sh-tutorial-card-shell {
  display: block;
}

.video-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.06);
  display: flex;
  flex-direction: column;
  position: relative;
  transition: box-shadow 0.2s, opacity 0.2s;
  /* 性能优化：启用硬件加速 */
  transform: translateZ(0);
  backface-visibility: hidden;
}

/* 拖拽中的卡片：移除 transition，让 translateY 立即响应 */
.video-card.dragging {
  transition: none !important;
  transform: translateZ(0) scale(1.02);
  box-shadow: 0 12rpx 32rpx rgba(0,0,0,0.15);
  z-index: 100;
  opacity: 0.95;
  border: 2rpx solid #007AFF;
  /* 性能优化：提示浏览器优化此元素的动画 */
  will-change: transform;
}

/* 拖拽结束后，卡片回到原位的动画 */
.video-card:not(.dragging) {
  transition: transform 0.3s ease-out, box-shadow 0.2s, opacity 0.2s;
}

/* 教程卡片：四圆角 + 一圈柔光（0 0 扩散，避免阴影只压在下方） */
.video-card--tutorial-chapter {
  overflow: hidden;
  border-radius: 28rpx;
  box-shadow:
    0 0 0 1rpx rgba(0, 0, 0, 0.04),
    0 0 18rpx rgba(0, 0, 0, 0.06),
    0 0 40rpx rgba(0, 0, 0, 0.08),
    0 0 72rpx rgba(0, 0, 0, 0.05);
}

.video-card.video-card--tutorial-chapter.dragging {
  overflow: visible;
  box-shadow:
    0 0 1rpx rgba(0, 0, 0, 0.08),
    0 0 24rpx rgba(0, 0, 0, 0.1),
    0 0 52rpx rgba(0, 0, 0, 0.08);
}

/*
 * 列表内嵌 native video + cover-view（⛶、暂停 MT）：整卡常驻 translateZ(0) 会单独开合成层，
 * 滚动时 WebView 与原生层刷新节奏不一致，表现为 cover 滞后/飘在别的视频区域。
 * 非拖拽态去掉该 GPU 提示；拖拽时仍由内联 transform 或 .dragging 规则负责。
 */
.video-card.video-card--tutorial-chapter:not(.dragging) {
  transform: none;
  backface-visibility: visible;
}

.video-card--tutorial-chapter .sh-tutorial-v-info,
.video-card--tutorial-chapter .v-info {
  overflow: hidden;
  border-radius: 0;
}

