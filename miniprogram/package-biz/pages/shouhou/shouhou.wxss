  text-align: center;
  margin: 0;
  font-size: 24rpx;
  line-height: 60rpx;
  font-family: Arial, Helvetica, sans-serif;
  text-shadow: 0 0 6rpx rgba(255, 255, 255, 0.5);
  padding: 0;
  letter-spacing: 10rpx;
  font-weight: 600;
}

@keyframes gradientAnimation {
  0% {
    background-position: 0;
  }
  100% {
    background-position: 200% 0;
  }
}

/* 响应式适配 */
@media (max-width: 768px) {
