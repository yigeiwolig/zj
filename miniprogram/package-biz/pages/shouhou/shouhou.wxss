  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  pointer-events: auto;
}

.video-preview-pause-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  z-index: 2;
  pointer-events: auto;
  
  /* 🔴 核心动画：默认隐藏 */
  opacity: 0;
  transform: scale(1.2);
  transition: opacity 0.2s ease, transform 0.2s cubic-bezier(0.25, 0.8, 0.25, 1);
  visibility: hidden;
}

/* 暂停时显示 */
.video-preview-pause-overlay.show {
  opacity: 1;
  transform: scale(1);
  visibility: visible;
}

/* 🔴 播放图标样式（无底灰色，仿抖音） */
