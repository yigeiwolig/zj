  background: #1c1c1e;
  border-radius: 20rpx;
  z-index: 1;
  animation: shLoadingBar 0.3s alternate infinite ease-in-out;
}

@keyframes shLoadingBar {
  0%   { left: 0%; }
  50%  { left: 25%; }
  100% { left: 50%; }
}

/* 旧样式兼容 */
.loading-div {
  position: relative;
  max-width: 400rpx;
  width: 100%;
  height: 60rpx;
  background: linear-gradient(to right, white, black);
  background-size: 200% 100%;
  animation: gradientAnimation 10s linear infinite reverse;
  border-radius: 20rpx;
  box-shadow: 0 0 6rpx rgba(0, 0, 0, 0.3);
  -webkit-box-reflect: below 2rpx linear-gradient(to bottom, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.4));
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 40rpx;
  box-sizing: border-box;
}

.loading-text {
  color: white;
