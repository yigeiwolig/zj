  color: #007AFF;
  background: rgba(0, 122, 255, 0.1);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
}
.sh-guide-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1D1D1F;
  margin-bottom: 12rpx;
}
.sh-guide-desc {
  white-space: pre-line;
  font-size: 26rpx;
  color: #636366;
  line-height: 1.6;
  margin-bottom: 28rpx;
}
.sh-guide-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.sh-guide-skip {
  align-self: flex-end;
  font-size: 26rpx;
  color: #8E8E93;
  padding: 4rpx 8rpx;
}
.sh-guide-skip:active {
  opacity: 0.65;
}
.sh-guide-btn {
  width: 100%;
  height: 80rpx;
  background: #1D1D1F;
  color: #fff;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
}
.sh-guide-btn.is-locked {
  opacity: 0.55;
  pointer-events: none;
}
.sh-guide-btn:active {
  transform: scale(0.96);
}

/* ================= 售后告知卡 A/B（对齐参考稿，覆盖旧 paid-policy） ================= */
.as-card-mask {
  align-items: center;
  justify-content: center;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  background: rgba(0, 0, 0, 0.45);
  box-sizing: border-box;
}

.as-card-mask.closing .as-card {
  animation: paidPolicySheetOut 0.28s ease forwards;
}

.as-card {
  width: 100%;
  max-width: 686rpx;
  max-height: 86vh;
  overflow-y: auto;
  background: #ffffff;
  border-radius: 56rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid rgba(0, 0, 0, 0.02);
  box-sizing: border-box;
  animation: paidPolicySheetIn 0.32s cubic-bezier(0.22, 1, 0.36, 1);
}

.as-card-header {
  padding: 60rpx 40rpx 20rpx;
}

.as-status-tag {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
  display: inline-block;
  margin-bottom: 20rpx;
}

.as-status-tag.tag-blue { background: #e8f2ff; color: #0071e3; }
.as-status-tag.tag-orange { background: #fff1e8; color: #f56300; }

.as-card-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1d1d1f;
  letter-spacing: -1rpx;
  line-height: 1.25;
}

.as-card-body {
  padding: 0 40rpx 60rpx;
}

.as-lead-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #6e6e73;
  margin: 30rpx 0 40rpx;
}

.as-bold { font-weight: 700; color: #1d1d1f; }
.as-bold-red { font-weight: 700; color: #ff3b30; }

.as-order-box {
  background: #fbfbfd;
  border-radius: 40rpx;
  padding: 30rpx;
  border: 1rpx solid #f0f0f2;
  margin-bottom: 40rpx;
  box-sizing: border-box;
}

.as-order-row {
  display: flex;
  margin-bottom: 30rpx;
}

.as-order-row:last-child { margin-bottom: 0; }

.as-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-top: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.as-dot.dot-blue { background: #0071e3; }
.as-dot.dot-orange { background: #f56300; }

.as-content { flex: 1; min-width: 0; }

.as-item-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1d1d1f;
  margin-bottom: 8rpx;
  line-height: 1.35;
}

.as-item-desc {
  font-size: 24rpx;
  color: #86868b;
  line-height: 1.5;
}

.as-btn {
  width: 100%;
  height: 110rpx;
  border-radius: 32rpx;
  font-size: 32rpx;
  font-weight: 700;
  padding: 0 24rpx;
  border: none;
  display: flex;
  justify-content: center;
  align-items: center;
  box-sizing: border-box;
  white-space: nowrap;
}

.as-btn.btn-blue { background: #0071e3; color: #ffffff; }
.as-btn.btn-black { background: #1a1a1a; color: #ffffff; }
.as-btn.is-disabled { opacity: 0.42; }
.as-btn:active { opacity: 0.88; transform: scale(0.99); }

.as-fine-print {
  font-size: 22rpx;
  color: #a1a1a6;
  text-align: center;
  margin-bottom: 30rpx;
  line-height: 1.5;
}

.as-footer-logo {
  font-size: 20rpx;
  font-weight: 600;
  color: #d2d2d7;
  text-align: center;
  margin-top: 30rpx;
  letter-spacing: 2rpx;
}
