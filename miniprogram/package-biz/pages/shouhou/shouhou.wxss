page {
  background-color: #F2F2F7;
  font-family: -apple-system, Helvetica, sans-serif;
}

.container {
  width: 100vw;
  height: 100vh;
  position: relative;
  overflow: hidden;
}

/* === 首页视图 === */
.home-view {
  width: 100%;
  height: 100%;
  padding-top: 0;
  padding-bottom: 50px;
  overflow: hidden;
  transition: transform 0.4s ease, opacity 0.4s ease;
  background-color: #F2F2F7;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.sh-home-scroll {
  flex: 1;
  width: 100%;
  height: 0;
  box-sizing: border-box;
}

.sh-title-row--bar {
  position: relative;
  left: auto;
  right: auto;
  transform: none;
  width: 100%;
  align-items: center;
  padding-top: 4rpx;
}

.sh-title-center {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.sh-admin-below-title {
  margin-left: 0;
  margin-top: 0;
}

.sh-usage-guide-btn--below-title {
  margin-top: 0;
}

.sh-guide-series-block {
  width: 100%;
  box-sizing: border-box;
}

.sh-guide-main-series {
  width: 100%;
  box-sizing: border-box;
}

.sh-guide-model-picker {
  padding-top: 20rpx;
}

.sh-guide-series-block .section-title:first-child,
#shGuideSeriesF1 .section-title {
  margin-top: 8rpx;
}

.home-view.shrink {
  transform: scale(0.92);
  opacity: 0;
  pointer-events: none;
}

/* 顶部导航 */
.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  padding-left: 40rpx; 
  padding-right: 40rpx;
  box-sizing: border-box; 
  display: flex; 
  justify-content: space-between; 
  align-items: center;
  z-index: 10000;
  pointer-events: none;
  background: transparent;
}

.back-icon {
  position: absolute;
  left: 40rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: auto;
  transition: all 0.2s;
  z-index: 10001;
}
.back-icon:active {
  transform: scale(0.95);
  opacity: 0.7;
}
.back-arrow {
  font-size: 48rpx;
  font-weight: 300;
  color: #000;
  line-height: 1;
}

.nav-header {
  position: relative;
  flex-shrink: 0;
  width: 100%;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding: 0 32rpx 16rpx;
  box-sizing: border-box;
  background: rgba(242, 242, 247, 0.9);
  backdrop-filter: blur(20px);
  z-index: 100;
}

.brand-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%) translateY(-50%);
  font-size: 38rpx;
  font-weight: 800;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  pointer-events: auto;
}

.sh-title-row {
  position: absolute;
  left: 0;
  right: 0;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  box-sizing: border-box;
  pointer-events: auto;
}

.sh-title-side {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
}

.sh-title-side--left {
  justify-content: flex-start;
}

.sh-title-side--right {
  justify-content: flex-end;
}

.sh-title-text {
  flex-shrink: 0;
  font-size: 38rpx;
  font-weight: 800;
  color: #000;
  letter-spacing: 1px;
  text-align: center;
}

.sh-usage-guide-btn {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 600;
  color: #007AFF;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(0, 122, 255, 0.08);
  border: 1rpx solid rgba(0, 122, 255, 0.22);
  line-height: 1.2;
}

.sh-usage-guide-btn:active {
  opacity: 0.72;
  transform: scale(0.98);
}

/* 管理员切换按钮 */
.admin-toggle-btn {
  display: inline-block;
  margin-left: 20rpx;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: #F2F2F7;
  color: #8E8E93;
  border: 1rpx solid #E5E5EA;
  vertical-align: middle;
  transition: all 0.3s;
  font-weight: 600;
}

.admin-toggle-btn.on {
  background: #000;
  color: #fff;
  border-color: #000;
}

.nav-back-btn .back-icon {
  font-size: 48rpx;
  font-weight: 300;
  color: #000;
  line-height: 1;
}

.nav-back-btn .back-icon::before {
  display: none; /* 禁用伪元素，使用文字符号 */
  transform: translate(-50%, -50%) rotate(45deg);
  width: 16rpx;
  height: 16rpx;
  border-left: 3rpx solid #1D1D1F;
  border-bottom: 3rpx solid #1D1D1F;
  border-radius: 2rpx;
}

.header-title-row {
  position: absolute;
  left: 50%;
  /* 🔴 使用动态计算，通过内联样式设置 top */
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
}

.large-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #1D1D1F;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

/* 管理员切换按钮 */
.admin-toggle-btn {
  display: inline-block;
  margin-left: 20rpx;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: #F2F2F7;
  color: #8E8E93;
  border: 1rpx solid #E5E5EA;
  vertical-align: middle;
  transition: all 0.3s;
  font-weight: 600;
  pointer-events: auto;
}

/* 开启状态的颜色 */
.admin-toggle-btn.on {
  background: #000;
  color: #fff;
  border-color: #000;
}

.subtitle {
  font-size: 26rpx;
  color: #86868B;
  margin-top: 10rpx;
  text-align: center;
}

.nav-right-placeholder {
  width: 64rpx;
  flex-shrink: 0;
}

/* 管理员功能区域（独立容器） */
.admin-actions-container {
  padding: 0 40rpx 20rpx 40rpx;
  background-color: #F2F2F7;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 退出管理员按钮 */
.exit-admin-btn {
  padding: 16rpx 32rpx;
  background: rgba(255, 59, 48, 0.1);
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
  border: 1rpx solid rgba(255, 59, 48, 0.3);
}

.exit-admin-btn:active {
  background: rgba(255, 59, 48, 0.2);
  transform: scale(0.98);
}

.exit-icon {
  font-size: 28rpx;
  color: #FF3B30;
  font-weight: 600;
}

.admin-badge {
  font-size: 20rpx;
  background: #FF3B30;
  color: #fff;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  vertical-align: middle;
}

/* 管理员同步按钮 */
.sync-parts-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 16rpx 32rpx;
  background: #007AFF;
  color: #fff;
  border-radius: 50rpx;
  font-size: 26rpx;
  font-weight: 600;
  transition: all 0.2s;
}

.sync-parts-btn:active {
  background: #0051D5;
  transform: scale(0.98);
}

.sync-icon {
  font-size: 28rpx;
}

.sync-text {
  font-size: 26rpx;
}

.section-title {
  padding: 0rpx 40rpx 20rpx 40rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #86868B;
  letter-spacing: 2rpx;
}

.card-grid {
  display: flex;
  justify-content: space-between;
  padding: 0 40rpx;
  margin-bottom: 60rpx;
}

.card-grid-triple {
  gap: 16rpx;
}

.card-grid-triple--with-long {
  margin-bottom: 16rpx;
}

.card-grid-double {
  gap: 16rpx;
}

.card-grid-f2long {
  justify-content: stretch;
  margin-bottom: 60rpx;
}

.f2-long-bar {
  width: 100%;
  height: 168rpx;
  background: #1C1C1E;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.f2-long-bar__main {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.f2-long-bar__tag {
  flex-shrink: 0;
  padding: 10rpx 20rpx;
  background: #000000;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 999rpx;
  line-height: 1.2;
}

.f2-long-bar__title {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.2;
  white-space: nowrap;
}

.f2-long-bar__price {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
  font-weight: 500;
  flex-shrink: 0;
}

.f2-long-bar__link {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #86868B;
  line-height: 1.2;
}

.card-grid-triple .i-card--compact,
.card-grid-double .i-card--compact {
  height: 320rpx;
  padding: 30rpx;
  box-sizing: border-box;
}

.card-grid-triple .i-card--compact {
  width: calc((100% - 32rpx) / 3);
  flex: 0 0 calc((100% - 32rpx) / 3);
}

.card-grid-double .i-card--compact {
  width: calc((100% - 16rpx) / 2);
  flex: 0 0 calc((100% - 16rpx) / 2);
}

.card-grid-triple .p-name,
.card-grid-double .p-name {
  font-size: 30rpx;
  line-height: 1.25;
  word-break: break-all;
}

.card-grid-triple .p-desc,
.card-grid-double .p-desc {
  font-size: 24rpx;
  margin-top: 6rpx;
  line-height: 1.35;
}

.card-grid-triple .badge,
.card-grid-double .badge {
  font-size: 20rpx;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
}

.card-grid-triple .circle-decor,
.card-grid-double .circle-decor {
  width: 160rpx;
  height: 160rpx;
  bottom: -40rpx;
  right: -40rpx;
}

.badge--gold {
  background: #FFD60A !important;
  color: #000 !important;
}

.style-ultra {
  background: #000000;
  color: #FFFFFF;
}

.style-ultra .p-desc {
  color: #86868B;
}

.style-ultra .circle-decor {
  background: #1C1C1E;
}

/* 单列：整行融合卡 */
.card-grid-single {
  justify-content: stretch;
}
.card-grid-single .fusion-card {
  width: 100%;
  flex: 1;
}

/* 融合版本长按钮 */
.fusion-card {
  position: relative;
  height: 290rpx;
  background-color: #1c1c1e;
  border-radius: 36rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

/* 点击反馈效果 */
.card-hover {
  transform: scale(0.98);
  transition: all 0.2s ease;
}

/* 左侧白色大曲率嵌套层 */
.white-section {
  position: absolute;
  top: 0;
  left: 0;
  width: 74%;
  height: 80%;
  background-color: #FFFFFF;
  border-radius: 0 0 320rpx 0;
  z-index: 0;
}

/* 右下角装饰圆圈 */
.circle-symbol {
  position: absolute;
  bottom: -40rpx;
  right: -40rpx;
  width: 180rpx;
  height: 180rpx;
  background-color: #2C2C2E;
  border-radius: 50%;
  z-index: 1;
}

/* 文字内容层 */
.content-area {
  position: absolute;
  inset: 0;
  z-index: 2;
  padding: 28rpx 30rpx 30rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

/* 工业指示灯标签 */
.status-tag {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  margin-bottom: 30rpx;
  padding: 8rpx 16rpx;
  background: #F2F2F7;
  border-radius: 999rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.75);
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  background-color: #ffffff;
  border-radius: 50%;
  margin-right: 12rpx;
}

.tag-text {
  font-size: 20rpx;
  font-weight: 700;
  color: #000000;
  letter-spacing: 1rpx;
}

/* 标题文字样式 */
.main-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #000000;
  line-height: 1.08;
}

.sub-title {
  font-size: 24rpx;
  font-weight: 500;
  color: #86868b;
  margin-top: 6rpx;
}

/* === 卡片核心样式修复 === */
.i-card {
  width: 48%;
  height: 320rpx;
  border-radius: 36rpx;
  position: relative; /* 关键：作为定位基准 */
  overflow: hidden;   /* 关键：切掉溢出的圆圈 */
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.04);
}

/* 确保文字在圆圈上面 */
.card-top,
.card-btm {
  position: relative;
  z-index: 2; /* 文字层级高 */
}

/* 圆形装饰 */
.circle-decor {
  position: absolute;
  bottom: -40rpx;
  right: -40rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  z-index: 1; /* 在文字下面 */
}

/* 白色卡片 (PRO) 配色 */
.style-white {
  background: #FFFFFF;
  color: #000;
}
.style-white .badge {
  background: #F2F2F7;
  color: #000;
}
.style-white .circle-decor {
  background: #F2F2F7;
}

/* 黑色卡片 (MAX) 配色 */
.style-black {
  background: #1C1C1E;
  color: #FFF;
}
.style-black .badge {
  background: #333;
  color: #D1D1D6;
}
.style-black .p-desc {
  color: #888;
}
.style-black .circle-decor {
  background: #2C2C2E;
}

.badge {
  font-size: 20rpx;
  font-weight: 700;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
}
.p-name {
  font-size: 36rpx;
  font-weight: 700;
}
.p-desc {
  font-size: 24rpx;
  margin-top: 6rpx;
  color: #86868B;
}
.p-price {
  font-size: 22rpx;
  margin-top: 8rpx;
  color: #aeaeb2;
  font-weight: 500;
}
.style-black .p-price {
  color: #9a9aa0;
}
.style-ultra .p-price {
  color: rgba(255, 255, 255, 0.72);
}

/* === 二级页面视图 === */
.detail-view {
  /* fixed：相对视口铺满，避免与 .container 叠层/裁剪差异；全程高于首页 .header(10000) */
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  width: 100%;
  height: 100%;
  min-height: 100vh;
  background: #FFFFFF;
  transform: translateX(100%);
  transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  z-index: 10100;
  display: flex;
  flex-direction: column;
  overflow: hidden; /* 防止整体滚动 */
  box-sizing: border-box;
}

.detail-view:not(.slide-in) {
  pointer-events: none;
}

.detail-view.slide-in {
  transform: translateX(0);
  pointer-events: auto;
}

/* 独立占位：避免 transform 与 padding-top 在部分 WebView 下组合失效 */
.detail-status-spacer {
  width: 100%;
  flex-shrink: 0;
  box-sizing: border-box;
}

.detail-nav {
  /* min-height 由 wxml 内联 detailNavBandPx（胶囊行高）控制，避免与状态栏占位叠加成双倍顶栏 */
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  border-bottom: 1rpx solid #F2F2F7;
  background: rgba(255,255,255,0.95);
  position: relative;
  z-index: 999; /* 确保层级最高 */
  flex-shrink: 0; /* 防止被压缩 */
}
/* 返回按钮 - 仅图标，无背景 */
.nav-back-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  background: transparent;
  transition: all 0.2s;
  cursor: pointer;
}

.nav-back-btn:active {
  opacity: 0.6;
  transform: scale(0.96);
}

/* 返回箭头图标 - 统一使用文字符号 */
.back-icon {
  font-size: 48rpx;
  font-weight: 300;
  color: #000;
  line-height: 1;
  margin-left: -4rpx; /* 微调位置，让箭头更居中 */
}

.back-icon::before {
  display: none; /* 禁用伪元素，使用文字符号 */
}

.nav-title-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 0 8rpx;
  box-sizing: border-box;
}

.nav-title {
  max-width: 100%;
  font-size: 32rpx;
  font-weight: 700;
  color: #1d1d1f;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
}

.content-scroll {
  flex: 1;
  overflow-y: scroll;
  padding: 30rpx;
  padding-bottom: 180rpx; /* 为底部提交栏留出空间，减少空白 */
  -webkit-overflow-scrolling: touch; /* iOS 平滑滚动 */
  height: 0; /* 关键：配合 flex: 1 使用，确保正确计算高度 */
  min-height: 0; /* 防止 flex 子元素溢出 */
}

.content-scroll--table-mode {
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

/* Tabs */
.tab-group {
  display: flex;
  background: #F2F2F7;
  padding: 8rpx;
  border-radius: 24rpx;
  margin-bottom: 40rpx;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #86868B;
  border-radius: 20rpx;
}
.tab-item.active {
  background: #FFFFFF;
  color: #000;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.05);
}

/* 服务切换 */
.svc-switch {
  position: relative;
  display: flex;
  gap: 20rpx;
  margin-bottom: 40rpx;
  background: #F9F9F9;
  border-radius: 24rpx;
}

.svc-switch-pill {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: calc((100% - 20rpx) / 2);
  background: #F0F8FF;
  border: 4rpx solid #007AFF;
  border-radius: 24rpx;
  box-sizing: border-box;
  z-index: 0;
  transition: transform 0.38s cubic-bezier(0.4, 0, 0.2, 1);
  pointer-events: none;
}

.svc-switch-pill--repair {
  transform: translateX(calc(100% + 20rpx));
}

.svc-item {
  position: relative;
  z-index: 1;
  flex: 1;
  text-align: center;
  padding: 30rpx;
  background: transparent;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: 4rpx solid transparent;
  transition: color 0.28s ease;
}
.svc-item.selected {
  background: transparent;
  border-color: transparent;
  color: #007AFF;
}

/* 配件网格 */
.section-label {
  font-size: 24rpx;
  color: #86868B;
  font-weight: 700;
  margin-bottom: 0;
}

.parts-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.parts-table-mode-toggle {
  font-size: 22rpx;
  color: #007AFF;
  font-weight: 600;
  padding: 8rpx 20rpx;
  border: 2rpx solid #007AFF;
  border-radius: 24rpx;
  background: #F0F8FF;
}
.parts-table-mode-toggle.on {
  background: #007AFF;
  color: #fff;
}
.parts-table-mode-toggle:active {
  opacity: 0.75;
}

/* 管理员工具行 */
.admin-tools-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 同步配件按钮 */
.sync-parts-btn {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
