  will-change: transform;
  animation: fs-portrait-exit-stage-float 2.6s ease-in-out 0.52s infinite;
}

@keyframes fs-portrait-exit-stage-float {
  0%,
  100% {
    transform: translateY(0) translateZ(0);
  }
  50% {
    transform: translateY(-10rpx) translateZ(0);
  }
}

.fs-portrait-exit-phone {
  width: 54rpx;
  height: 96rpx;
  border-radius: 12rpx;
  border-width: 4rpx;
  border-style: solid;
  border-color: rgba(255, 255, 255, 0.88);
  background-color: rgba(255, 255, 255, 0.12);
  transform-origin: center center;
  backface-visibility: hidden;
}

/* 横握 ↔ 竖握循环示意（与「请竖握手机」文案一致） */
.fs-portrait-exit-web-root .fs-portrait-exit-phone {
  will-change: transform;
  animation: fs-portrait-exit-phone-land-port-cycle 2.6s ease-in-out infinite;
}

@keyframes fs-portrait-exit-phone-land-port-cycle {
  0% {
    transform: rotate(90deg) scale(0.9);
  }
  40% {
    transform: rotate(0deg) scale(1);
  }
  50% {
    transform: rotate(0deg) scale(1);
  }
  90% {
    transform: rotate(90deg) scale(0.9);
  }
  100% {
    transform: rotate(90deg) scale(0.9);
  }
}

@keyframes fs-portrait-exit-fade-up {
  0% {
    opacity: 0;
    transform: translateY(16rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

