  flex-direction: column;
  min-height: 0;
}

.view-content {
  height: 100%;       /* ???????? */
  padding: 220rpx 48rpx 60rpx; /* ?? ???????? 180rpx ????220rpx???????? */
  display: flex;
  flex-direction: column; /* ???? */
  justify-content: center; /* ?? ???????????? */
  box-sizing: border-box;
}

/* step3：横向留白只放在 tutorial-scroll（与 shouhou .content-scroll 单层 30rpx 一致，避免卡片被压窄） */
#step3 .view-content {
  padding-top: 8rpx !important;
  padding-left: 0 !important;
  padding-right: 0 !important;
  flex: 1;
  min-height: 0;
  justify-content: flex-start !important;
  box-sizing: border-box;
}

/* 与 shouhou .content-scroll 同：padding 30rpx，卡片可用宽度一致 */
.tutorial-scroll {
  flex: 1 1 auto;
  min-height: 0;
  height: 0;
  width: 100%;
  overflow-y: scroll;
  overflow-x: visible;
  -webkit-overflow-scrolling: touch;
  padding: 0 30rpx;
  box-sizing: border-box;
}

/* 与 shouhou .video-list-container 一致 */
.tutorial-body {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
  padding-bottom: 60rpx;
  box-sizing: border-box;
  overflow: visible;
}

.tutorial-body--compact {
  flex-direction: row;
  flex-wrap: wrap;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

