page { height: 100%; background: #fff; overflow: hidden; }

/* 教程内容页：回到顶部并重新选择 */
.azjc-back-top {
  position: fixed;
  right: 28rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  z-index: 900;
  min-width: 112rpx;
  padding: 18rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(17, 17, 17, 0.92);
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.22);
}

.azjc-back-top--active {
  opacity: 0.88;
  transform: scale(0.96);
}

.azjc-back-top-arrow {
  font-size: 28rpx;
  line-height: 1;
  font-weight: 700;
}

.azjc-back-top-text {
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* ?????????????????*/
.stage-wrapper {
  width: 100%;
  height: 100%;
  transition: transform 1.2s cubic-bezier(0.645, 0.045, 0.355, 1); /* ????????*/
  will-change: transform;
}

.step-view {
  width: 100%;
  height: 100vh; /* ????????*/
  box-sizing: border-box;
  position: relative;
}

/* ?????????????????????*/
#step3.step-view {
  padding-top: 176rpx;
