/* === 教程章节卡：与 shouhou .video-card--tutorial-chapter 同款 === */
.tutorial-body .video-card,
.tutorial-body .v-card.v-card--chapter {
  background: #ffffff;
  border-radius: 28rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  position: relative;
  margin-bottom: 0;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  transition: box-shadow 0.2s, opacity 0.2s;
  box-shadow:
    0 0 0 1rpx rgba(0, 0, 0, 0.04),
    0 0 18rpx rgba(0, 0, 0, 0.06),
    0 0 40rpx rgba(0, 0, 0, 0.08),
    0 0 72rpx rgba(0, 0, 0, 0.05);
}

.tutorial-body .video-card.video-card--important,
.tutorial-body .v-card.v-card--chapter.video-card--important {
  border: 3rpx solid #e23c31;
  box-shadow:
    0 0 0 1rpx rgba(226, 60, 49, 0.12),
    0 0 18rpx rgba(226, 60, 49, 0.1);
}

.tutorial-body .video-card.dragging,
.tutorial-body .v-card.v-card--chapter.dragging {
  transition: none !important;
  transform: translateZ(0) scale(1.02);
  overflow: visible;
  box-shadow:
    0 0 1rpx rgba(0, 0, 0, 0.08),
    0 0 24rpx rgba(0, 0, 0, 0.1),
    0 0 52rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
  opacity: 0.95;
  border: 2rpx solid #007aff;
  will-change: transform;
}

.tutorial-body .video-card:not(.dragging),
.tutorial-body .v-card.v-card--chapter:not(.dragging) {
  transition: transform 0.3s ease-out, box-shadow 0.2s, opacity 0.2s;
  transform: none;
  backface-visibility: visible;
}

.tutorial-body--compact .video-card--compact {
  flex: 0 0 calc((100% - 20rpx) / 2);
  width: calc(50% - 10rpx);
  max-width: calc((100% - 20rpx) / 2);
  border-radius: 20rpx;
  min-width: 0;
}

.tutorial-body--compact .video-card--compact .v-chapter-cover-wrap,
