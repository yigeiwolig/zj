/* pages/pagenew/pagenew.wxss */
page {
  background-color: #F2F2F7;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;
  height: 100%; overflow: hidden;
}
.container { height: 100%; display: flex; flex-direction: column; }

/* === 1. 顶部导航 === */
.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  padding-left: 40rpx;
  padding-right: 40rpx;
  box-sizing: border-box;
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 10000;
  pointer-events: none;
  background: transparent;
}

.back-icon {
  position: absolute;
  left: 40rpx;
  width: 70rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: auto;
  transition: all 0.2s;
  z-index: 10001;
}
.back-icon:active {
  transform: scale(0.95);
  opacity: 0.7;
  background-color: rgba(0, 0, 0, 0.05);
}
.back-arrow { 
  font-size: 48rpx; 
  font-weight: 300; 
  color: #000; 
  line-height: 1;
}

.nav-header {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 40rpx;
  box-sizing: border-box;
  background: rgba(242, 242, 247, 0.9);
  backdrop-filter: blur(20px);
  z-index: 100;
}

.brand-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%) translateY(-50%);
  font-size: 38rpx;
  font-weight: 800;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  pointer-events: auto;
}

/* 管理员切换按钮 */
.admin-toggle-btn {
  display: inline-block;
  margin-left: 20rpx;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: #F2F2F7;
  color: #8E8E93;
  border: 1rpx solid #E5E5EA;
  vertical-align: middle;
  transition: all 0.3s;
  font-weight: 600;
}

.admin-toggle-btn.on {
  background: #000;
  color: #fff;
  border-color: #000;
}

/* 管理员条 */
.admin-bar {
  text-align: center; font-size: 24rpx; font-weight: bold; color: #FF3B30;
  margin-bottom: 10rpx; display: flex; justify-content: center; align-items: center; gap: 20rpx;
}
.btn-exit {
  background: #000; color: #fff; padding: 4rpx 16rpx; border-radius: 8rpx; font-size: 20rpx;
}

/* === 2. 卡片区域 === */
.swiper-container {
  flex: 1;
  padding-top: 168rpx;
  padding-bottom: 100rpx;
  box-sizing: border-box;
}
.card-swiper { width: 100%; height: 100%; }
.card-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0;
  box-sizing: border-box;
}

/* 外层仅负责缩放/层级，阴影画在 .apple-card 上 */
.apple-card-frame {
  padding: 0;
  background: transparent;
  border: none;
  border-radius: 0;
  box-shadow: none;
  box-sizing: border-box;
  transition: transform 0.45s cubic-bezier(0.25, 0.8, 0.25, 1), opacity 0.35s ease;
  transform: scale(0.94);
  opacity: 0.72;
  position: relative;
}
.apple-card-frame.active {
  transform: scale(1);
  opacity: 1;
  z-index: 10;
}

/* 单层白卡片：描边 + 分层阴影（贴边、不糊一大片） */
.apple-card {
  width: 600rpx;
  background: #fff;
  border-radius: 36rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
  transition: box-shadow 0.4s ease, border-color 0.4s ease, transform 0.4s ease;
}
.apple-card-frame:not(.active) .apple-card {
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.035);
}
.apple-card-frame.active .apple-card {
  border-color: rgba(0, 0, 0, 0.06);
  box-shadow:
    0 1rpx 3rpx rgba(0, 0, 0, 0.05),
    0 6rpx 16rpx rgba(0, 0, 0, 0.06),
    0 18rpx 36rpx rgba(0, 0, 0, 0.07);
}

/* 图片层：宽 600 → 高 800（严格 3:4 竖版）+ aspectFill，与上传裁切一致 */
.card-cover {
  width: 100%;
  height: 0;
  padding-bottom: 133.3333%;
  flex-shrink: 0;
  background: #e8eaed;
  position: relative;
  overflow: hidden;
}
.product-cover-wrapper {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.cover-img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  transition: filter 0.22s ease, opacity 0.22s ease, transform 0.22s ease;
}
.cover-img.is-loading { filter: blur(1.2px); transform: scale(1.01); opacity: .94; }
.cover-img.is-loaded { filter: blur(0); transform: scale(1); opacity: 1; }
/* 跳转号码标识 */
.jump-number-badge {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  background: rgba(0, 0, 0, 0.7);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  z-index: 60;
  pointer-events: auto;
  backdrop-filter: blur(10px);
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.3);
}

/* 管理员按钮 */
.admin-btn {
  position: absolute; top: 20rpx; 
  width: 80rpx; height: 80rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.95);
  display: flex; align-items: center; justify-content: center;
  z-index: 50; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.2);
}
.btn-del { left: 120rpx; color: #FF3B30; font-weight: 900; font-size: 32rpx; }
.btn-cam { right: 20rpx; font-size: 40rpx; color: #333; }

/* 信息层：标题 → 简介 → 价格，右侧固定箭头列 */
.card-content {
  flex-shrink: 0;
  padding: 28rpx 28rpx 32rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
  background: #fff;
}
.card-content-inner {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}
.info-text {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}
.p-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1d1d1f;
  line-height: 1.28;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.p-desc-wrap {
  width: 100%;
}
.p-desc {
  font-size: 26rpx;
  font-weight: 400;
  color: #636366;
  line-height: 1.55;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}
.p-desc-placeholder {
  font-size: 26rpx;
  color: #aeaeb2;
  line-height: 1.5;
  padding: 8rpx 0 4rpx;
}
.p-price {
  font-size: 30rpx;
  font-weight: 600;
  color: #0071e3;
  letter-spacing: 0.5rpx;
  margin-top: 4rpx;
}

.p-title.editable,
.p-price.editable,
.p-desc.editable {
  border-bottom: 2rpx dashed #c7c7cc;
  width: fit-content;
  max-width: 100%;
}

.card-content-side {
  flex-shrink: 0;
  padding-top: 6rpx;
}

/* 装饰性箭头 */
.btn-go {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  background: #f2f2f7;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.icon-arrow {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid #3a3a3c;
  border-right: 3rpx solid #3a3a3c;
  transform: rotate(45deg);
  margin-left: -4rpx;
}
.admin-icon { font-size: 30rpx; background: #f2f2f7; }

/* 新建卡片：高度与「3:4 封面 + 信息区」接近 */
.add-card {
  border: 2rpx dashed #d1d1d6;
  background: linear-gradient(180deg, #fafafa 0%, #f2f2f7 100%);
  box-shadow:
    0 1rpx 2rpx rgba(0, 0, 0, 0.03),
    0 6rpx 18rpx rgba(0, 0, 0, 0.04);
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  min-height: 1040rpx;
}
.add-icon { font-size: 80rpx; color: #ccc; }
.add-text { font-size: 24rpx; font-weight: 700; color: #999; letter-spacing: 2rpx; }

/* 弹窗 */
.modal-mask { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); display: flex; justify-content: center; align-items: center; z-index: 200; opacity: 0; pointer-events: none; transition: 0.3s; }
.modal-mask.active { opacity: 1; pointer-events: auto; }
.modal-box { background: #fff; width: 520rpx; padding: 50rpx; border-radius: 30rpx; text-align: center; }
.modal-title { font-weight: 800; margin-bottom: 30rpx; }
.pwd-input { background: #f5f5f5; height: 90rpx; margin: 30rpx 0; border-radius: 16rpx; text-align: center; font-size: 36rpx; }
.modal-actions { display: flex; gap: 20rpx; }
.btn { flex: 1; padding: 20rpx; border-radius: 16rpx; font-weight: bold; font-size: 28rpx; }
.btn.cancel { background: #f0f0f0; color: #666; }
.btn.confirm { background: #000; color: #fff; }

/* ================= 自定义编辑弹窗 ================= */
.custom-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(5px);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.custom-modal-box {
  background: #fff;
  width: 600rpx;
  border-radius: 40rpx;
  padding: 50rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
  animation: modalPopIn 0.2s ease-out;
}

@keyframes modalPopIn {
  from {
    transform: scale(0.9);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

.modal-title {
  font-size: 34rpx;
  font-weight: 800;
  margin-bottom: 40rpx;
  color: #1D1D1F;
}

.modal-input {
  background: #F5F5F7;
  width: 100%;
  height: 100rpx;
  border-radius: 50rpx;
  text-align: center;
  font-size: 32rpx;
  margin-bottom: 40rpx;
  padding: 0 30rpx;
  box-sizing: border-box;
}

.modal-textarea {
  width: 100%;
  min-height: 200rpx;
  max-height: 320rpx;
  background: #f5f5f7;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: #1d1d1f;
  box-sizing: border-box;
  margin-bottom: 40rpx;
}

.modal-btn-row {
  display: flex;
  gap: 30rpx;
  width: 100%;
}

.modal-btn {
  flex: 1;
  height: 90rpx;
  line-height: 90rpx;
  text-align: center;
  border-radius: 45rpx;
  font-weight: 600;
  font-size: 30rpx;
  transition: all 0.2s;
}

.modal-btn.cancel {
  background: #F5F5F7;
  color: #888;
}

.modal-btn.confirm {
  background: #000;
  color: #fff;
}

.modal-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}