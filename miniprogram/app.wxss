page {
  background: #f5f7fb;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
  color: #0f1b2d;
}

/* 全局输入框居中（后续页面可单独覆盖） */
input, textarea {
  text-align: center;
}

.page {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 12rpx 24rpx rgba(4, 18, 45, 0.08);
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: #04122d;
}

.primary-btn {
  background: linear-gradient(135deg, #1c4cfe, #0d8bff);
  color: #fff;
  border: none;
}

.secondary-btn {
  background: #fff;
  color: #1c4cfe;
  border: 2rpx solid rgba(28, 76, 254, 0.4);
}

.cta-btn {
  border-radius: 999rpx;
  padding: 0 24rpx;
  line-height: 80rpx;
}

/* ================= 全局弹窗体系 ================= */
.g-loading-mask,
.g-dialog-mask,
.g-sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  /* 仅 loading 要白色模糊，dialog/sheet 保持原逻辑：这里先用透明，分别覆盖 */
  background: transparent;
  z-index: 99999;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Loading：白色虚化遮罩 */
.g-loading-mask {
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(12px);
}

/* 全局 loader：转圈 → 文案 → 进度条，纵向排列 */
.g-loader {
  width: 560rpx;
  max-width: 86vw;
  border-radius: 28rpx;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 28rpx;
  padding: 48rpx 40rpx 44rpx;
  box-shadow: 0 12rpx 40rpx rgba(15, 23, 42, 0.1);
  box-sizing: border-box;
}

.g-loader-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 5rpx solid #e8e8ed;
  border-top-color: #1c1c1e;
  border-radius: 50%;
  flex-shrink: 0;
  animation: gLoaderSpin 0.55s linear infinite;
}

.g-loading-bar {
  width: 100%;
  height: 12rpx;
  background: #e8e8ed;
  border-radius: 999rpx;
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
}

.g-loading-bar::after {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 42%;
  height: 100%;
  background: #1c1c1e;
  border-radius: 999rpx;
  z-index: 1;
  animation: gLoadingBar 0.3s alternate infinite ease-in-out;
}

.g-loader-label {
  color: #1c1c1e;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
  text-align: center;
  width: 100%;
  word-break: break-all;
  box-sizing: border-box;
  animation: gLabelPulse 0.26s alternate infinite ease-in-out;
}

@keyframes gLabelPulse {
  from { opacity: 0.5; }
  to { opacity: 1; }
}

@keyframes gLoaderSpin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes gLoadingBar {
  0%   { left: 0%; }
  50%  { left: 25%; }
  100% { left: 50%; }
}

/* Dialog/Sheet：维持原先的暗色遮罩体验（不影响 loading） */
.g-dialog-mask,
.g-sheet-mask {
  background: rgba(0,0,0,0.55);
}

.g-dialog-box {
  width: 640rpx;
  background: #fff;
  border-radius: 32rpx;
  overflow: hidden;
}

.g-dialog-title {
  padding: 36rpx 40rpx 10rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #111;
}

.g-dialog-content {
  padding: 0 40rpx 30rpx;
  font-size: 28rpx;
  color: #444;
  line-height: 1.5;
}

.g-dialog-btn-row {
  display: flex;
  border-top: 1rpx solid #eee;
}

.g-dialog-btn {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  font-size: 30rpx;
  font-weight: 700;
}

.g-dialog-btn.cancel {
  color: #666;
  border-right: 1rpx solid #eee;
}

.g-dialog-btn.confirm {
  color: #000;
}

/* sheet */
.g-sheet-mask {
  align-items: flex-end;
}

.g-sheet-box {
  width: 100%;
  padding: 20rpx 24rpx calc(env(safe-area-inset-bottom) + 20rpx);
  box-sizing: border-box;
}

.g-sheet-title {
  text-align: center;
  font-size: 26rpx;
  color: #8e8e93;
  padding: 16rpx 0 18rpx;
}

.g-sheet-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 0;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.g-sheet-cancel {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 0;
  text-align: center;
  font-size: 32rpx;
  font-weight: 800;
}

/* input */
.g-input {
  height: 96rpx;
  margin: 0 40rpx 30rpx;
  background: #F5F5F7;
  border-radius: 20rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  text-align: left;
  box-sizing: border-box;
}

/* ================= 全局提示弹窗层级兜底 =================
   目标：所有页面的提示类弹窗（toast/dialog/copy-success）都高于当前业务弹窗 */
page view.g-dialog-mask,
page view.g-sheet-mask,
page view.auto-toast-mask,
page view.custom-dialog-mask,
page view.copy-success-modal-mask,
page view.custom-modal-mask,
page view.custom-modal-mask.copy-success-modal-mask {
  z-index: 10000000080 !important;
}

page view.g-loading-mask,
page view.loading-mask {
  z-index: 10000000090 !important;
}
