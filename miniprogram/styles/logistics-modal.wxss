.logistics-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100000040;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  overflow: hidden;
  backdrop-filter: blur(12px);
  animation: logisticsFadeIn 0.3s ease;
}

.logistics-modal-mask.closing {
  animation: logisticsMaskFadeOut 0.36s ease forwards;
}

.logistics-modal-mask.closing .logistics-modal-box {
  animation: logisticsBoxShrinkOut 0.36s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}

.logistics-modal-box {
  width: 100%;
  /* 真机：必须给明确高度，否则 flex 子项 height:0 会把轨迹区压成 0 */
  height: 75vh;
  max-height: calc(100vh - 60px);
  background: #FFFFFF;
  border-radius: 40rpx 40rpx 0 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: 0 -10rpx 40rpx rgba(0, 0, 0, 0.08);
  transform: translateY(100%);
  animation: logisticsSlideUp 0.35s cubic-bezier(0.32, 1.05, 0.35, 1) forwards;
}

@keyframes logisticsFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes logisticsSlideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

@keyframes logisticsMaskFadeOut {
  from { opacity: 1; }
  to { opacity: 0; }
}

@keyframes logisticsBoxShrinkOut {
  from { transform: translateY(0); opacity: 1; }
  to { transform: translateY(100%); opacity: 0.6; }
}

.logistics-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 48rpx 48rpx 32rpx;
  background: #fff;
  z-index: 10;
  position: relative;
}

.logistics-header::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 48rpx;
  right: 48rpx;
  height: 1rpx;
  background: rgba(0, 0, 0, 0.05);
}

.brand-tag {
  font-size: 32rpx;
  font-weight: 700;
  color: #1D1D1F;
  letter-spacing: -0.5rpx;
}

.close-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #8E8E93;
  background: rgba(142, 142, 147, 0.12);
  border-radius: 50%;
  transition: all 0.2s;
}

.close-btn:active {
  background: rgba(142, 142, 147, 0.24);
  transform: scale(0.92);
}

.logistics-modal-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
  min-height: 0;
  background: #F5F5F7;
}

.logistics-card-container {
  padding: 32rpx 32rpx 0;
  background: #F5F5F7;
  z-index: 5;
  flex-shrink: 0;
}

.logistics-info-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 32rpx;
  position: relative;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.card-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.company-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.company-icon-placeholder {
  width: 64rpx;
  height: 64rpx;
  background: #007AFF;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  box-shadow: 0 8rpx 16rpx rgba(0, 122, 255, 0.25);
}

.company-name {
  font-size: 30rpx;
  color: #1D1D1F;
  font-weight: 600;
}

.status-badge {
  font-size: 22rpx;
  color: #fff;
  background: #007AFF;
  padding: 6rpx 20rpx;
  border-radius: 100rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 122, 255, 0.2);
}

.status-badge.success {
  background: #34C759;
  box-shadow: 0 4rpx 10rpx rgba(52, 199, 89, 0.2);
}

.logistics-status-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.logistics-exception-btn {
  font-size: 20rpx;
  color: #1677FF;
  background: #fff;
  border: 1rpx solid rgba(22, 119, 255, 0.5);
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
  line-height: 1.2;
  margin-right: 8rpx;
}

.logistics-exception-btn:active {
  background: #f0f6ff;
}

.card-body-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #F5F7FA;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
}

.tracking-number {
  font-family: 'DIN Alternate', 'Helvetica Neue', sans-serif;
  font-size: 32rpx;
  font-weight: 700;
  color: #1D1D1F;
  letter-spacing: 1rpx;
}

.copy-btn {
  font-size: 22rpx;
  color: #1D1D1F;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  background: #fff;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  transition: all 0.2s;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.copy-btn:active {
  background: #f2f2f2;
  transform: scale(0.95);
}

.logistics-loading {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 400rpx;
}

.mt-loader {
  width: 50rpx;
  height: 50rpx;
  border: 5rpx solid rgba(0, 122, 255, 0.1);
  border-top: 5rpx solid #007AFF;
  border-radius: 50%;
  animation: logisticsSpin 0.8s linear infinite;
}

@keyframes logisticsSpin {
  to { transform: rotate(360deg); }
}

.logistics-error {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.error-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.error-text {
  font-size: 28rpx;
  color: #8E8E93;
}

.logistics-scroll {
  flex: 1;
  min-height: 400rpx;
  height: 100%;
  padding: 20rpx 32rpx 0;
  box-sizing: border-box;
  -webkit-overflow-scrolling: touch;
}

.timeline-container {
  position: relative;
  padding-bottom: 80rpx;
  padding-left: 0;
}

.timeline-item {
  display: flex;
  position: relative;
  margin-bottom: 0;
  padding-bottom: 40rpx;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-item:last-child .line {
  display: none;
}

.timeline-axis {
  width: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  margin-right: 16rpx;
  flex-shrink: 0;
  padding-top: 24rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  background: #D1D1D6;
  border-radius: 50%;
  z-index: 2;
  position: relative;
  transition: all 0.3s;
}

.dot.active {
  width: 20rpx;
  height: 20rpx;
  background: #007AFF;
  border: 4rpx solid #fff;
  box-shadow: 0 0 0 4rpx rgba(0, 122, 255, 0.2);
  transform: scale(1);
}

.line {
  position: absolute;
  top: 36rpx;
  bottom: -20rpx;
  width: 2rpx;
  background: #E5E5EA;
  left: 50%;
  transform: translateX(-50%);
  z-index: 1;
}

.timeline-content-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.02);
  border: 1rpx solid rgba(0, 0, 0, 0.02);
}

.timeline-content-wrapper.active {
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(0, 122, 255, 0.08);
  border: 1rpx solid rgba(0, 122, 255, 0.08);
}

.timeline-content-wrapper.active .time-full {
  color: #007AFF;
  font-weight: 600;
}

.timeline-content-wrapper.active .desc-text {
  color: #1D1D1F;
  font-weight: 500;
}

.timeline-header {
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
}

.time-full {
  font-size: 22rpx;
  color: #8E8E93;
  font-family: 'SF Pro Text', sans-serif;
  letter-spacing: 0;
}

.timeline-body {
  width: 100%;
}

.desc-text {
  font-size: 26rpx;
  color: #3A3A3C;
  text-align: justify;
  line-height: 1.5;
  letter-spacing: 0;
  display: block;
  word-break: break-all;
}

.logistics-empty {
  padding: 100rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}
