}

/* 绑定设备弹窗：挂 root-portal 根节点；样式写在页面级，避免组件样式隔离导致真机空白 */
@keyframes hubBindModalMaskIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.hub-bind-modal-portal {
  position: fixed !important;
  left: 0 !important;
  top: 0 !important;
  right: 0 !important;
  bottom: 0 !important;
  width: 100vw !important;
  height: 100vh !important;
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.55) !important;
  visibility: visible !important;
  opacity: 1 !important;
  overflow: hidden !important;
  z-index: 100000100 !important;
  pointer-events: auto !important;
  animation: hubBindModalMaskIn 0.22s ease-out;
  transition: opacity 0.28s ease;
}

.hub-bind-modal-portal.is-closing {
  animation: none !important;
  opacity: 0 !important;
  pointer-events: none !important;
}

.hub-bind-modal-portal .modal-content {
  position: absolute !important;
  left: 0 !important;
  right: 0 !important;
  bottom: 0 !important;
  width: 100% !important;
  min-height: 52vh !important;
  max-height: 85vh !important;
  background: #fff !important;
  border-radius: 40rpx 40rpx 0 0 !important;
  display: flex !important;
  flex-direction: column !important;
  /* 默认就在可视位置，避免 animation 卡住时整张白卡在屏外 */
  transform: translate3d(0, 0, 0) !important;
  transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1) !important;
  animation: none !important;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom)) !important;
  overflow: hidden !important;
  box-sizing: border-box !important;
  visibility: visible !important;
  opacity: 1 !important;
  pointer-events: auto !important;
}

/* 打开 / 关闭：自底部滑入 / 滑出 */
.hub-bind-modal-portal .modal-content.hub-sheet--from-bottom {
  transform: translate3d(0, 100%, 0) !important;
}

.hub-bind-modal-portal.is-closing .modal-content {
  transform: translate3d(0, 100%, 0) !important;
}

@keyframes hubBindStageIn {
  from {
    opacity: 0;
    transform: translate3d(0, 28rpx, 0);
  }
  to {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }
}

.hub-bind-modal-portal .bind-stage--enter {
