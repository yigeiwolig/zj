/**
 * 枢纽横滑 track 使用 transform 时，子树内 position:fixed 会相对轨道定位。
 * 嵌入面板弹层经 root-portal 挂到页面根后，用本文件保证全屏与比例正确。
 */
.hub-embed-portal-layer {
  position: relative;
  width: 0;
  height: 0;
  overflow: visible;
}

/* root-portal 单根包装：容纳 0×0 layer 与绑定弹窗兄弟节点 */
.hub-embed-portal-root {
  position: relative;
  width: 0;
  height: 0;
  overflow: visible;
}

