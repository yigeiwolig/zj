.hub-embed-portal-layer .custom-dialog-mask,
.hub-embed-portal-layer .auto-toast-mask,
.hub-embed-portal-layer .after-sales-toast-mask,
.hub-embed-portal-layer .after-sales-dialog-mask,
.hub-embed-portal-layer .loading-mask,
.hub-embed-portal-layer .custom-modal-mask,
.hub-embed-portal-layer .return-required-mask,
.hub-embed-portal-layer .bottom-modal-mask,
.hub-embed-portal-layer .return-required-mask,
.hub-embed-portal-layer .fill-repair-mask,
.hub-embed-portal-layer .purchase-parts-mask,
.hub-embed-portal-layer .location-permission-mask,
.hub-embed-portal-layer .custom-dialog-mask,
.hub-embed-portal-layer .custom-modal-mask {
