{
  "pages": [
    "pages/index/index",
    "pages/blocked/blocked"
  ],
  "subPackages": [
    {
      "root": "package-app",
      "name": "package-app",
      "pages": [
        "pages/shop/shop",
        "pages/my/my",
        "pages/orders/orders",
        "pages/profile/profile",
        "pages/products/products",
        "pages/case/case",
        "pages/scan/scan",
        "pages/can-learn/can-learn",
        "pages/faq/faq"
      ]
    },
    {
      "root": "package-biz",
      "name": "package-biz",
      "pages": [
        "pages/azjc/azjc",
        "pages/ota/ota",
        "pages/pagenew/pagenew",
        "pages/adminLite/adminLite",
        "pages/admin/admin",
        "pages/paihang/paihang",
        "pages/shouhou/shouhou",
        "pages/call/call",
        "pages/home/home",
        "pages/invest/invest"
      ]
    }
  ],
  "preloadRule": {
    "pages/index/index": {
      "network": "all",
      "packages": ["package-app"]
    },
    "package-app/pages/products/products": {
      "network": "all",
      "packages": ["package-app"]
    }
  },
  "usingComponents": {
    "custom-toast": "/components/custom-toast/index"
  },
  "lazyCodeLoading": "requiredComponents",
  "window": {
    "navigationStyle": "custom",
    "backgroundTextStyle": "dark",
    "navigationBarBackgroundColor": "#F9F9F9",
    "navigationBarTitleText": "MT-摩改社",
    "navigationBarTextStyle": "black",
    "backgroundColor": "#F9F9F9"
  },
  "permission": {
    "scope.userLocation": {
      "desc": "用于展示附近维修门店和计算配送距离"
    }
  },
  "requiredPrivateInfos": [
    "getLocation",
    "chooseLocation"
  ],
  "style": "v2",
  "sitemapLocation": "sitemap.json"
}
