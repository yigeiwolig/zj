/* components/custom-toast/index.wxss */
.ct-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 10000000006 !important; /* 🔴 修复：全局Toast应该最高，高于所有页面级弹窗 */
  display: flex; align-items: center; justify-content: center;
  animation: dialogMaskFadeIn 0.25s ease-out forwards;
}
.ct-mask.closing {
  animation: dialogMaskFadeOut 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}
@keyframes dialogMaskFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes dialogMaskFadeOut {
  from { opacity: 1; }
  to { opacity: 0; }
}

/* Modal（带弹出+收缩退出动画） */
.ct-modal {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.12);
  animation: dialogBoxPopIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}
.ct-mask.closing .ct-modal {
  animation: dialogBoxShrinkOut 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}
@keyframes dialogBoxPopIn {
  from { opacity: 0; transform: scale(0.88); }
  to { opacity: 1; transform: scale(1); }
}
@keyframes dialogBoxShrinkOut {
  0% {
    transform: scale(1) translateY(0);
    opacity: 1;
    filter: blur(0);
  }
  100% {
    transform: scale(0.6) translateY(-60rpx);
    opacity: 0;
    filter: blur(12rpx);
  }
}
.ct-modal-title {
  padding: 40rpx 40rpx 0;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #000;
}
.ct-modal-title.error {
  color: #cf1322;
}
.ct-modal-title.warn {
  color: #d48806;
}
.ct-modal-content {
  padding: 30rpx 40rpx 40rpx;
  text-align: center;
  font-size: 30rpx;
  color: #000; /* 🔴 改为纯黑色 */
  line-height: 1.5;
  min-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ct-modal-content-editable {
  padding: 26rpx 40rpx 40rpx;
}
.ct-modal-input {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  background: #f5f6f8;
  border: 1rpx solid #e5e7eb;
  border-radius: 14rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  color: #111827;
}
.ct-modal-footer {
  display: flex;
  border-top: 1rpx solid #eee;
}
.ct-modal-btn {
  flex: 1;
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
}
.ct-modal-btn:active { background: #f5f5f5; }
.ct-modal-btn.cancel { border-right: 1rpx solid #eee; font-weight: 400; color: #000 !important; } /* 🔴 改为黑色 */
.ct-modal-btn.confirm { color: #000 !important; }

/* Loading */
.ct-loading {
  background: rgba(255,255,255,0.98);
  border-radius: 28rpx;
  padding: 48rpx 44rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(15, 23, 42, 0.12);
  min-width: 280rpx;
  max-width: 560rpx;
  box-sizing: border-box;
}
.ct-loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 5rpx solid #e8e8ed;
  border-top-color: #1c1c1e;
  border-radius: 50%;
  flex-shrink: 0;
  animation: spin 0.75s linear infinite;
}
.ct-loading-spinner.small {
  width: 40rpx;
  height: 40rpx;
  border-width: 4rpx;
}
.ct-loading-text {
  margin-top: 0;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
  text-align: center;
  color: #1c1c1e;
  width: 100%;
  word-break: break-all;
  box-sizing: border-box;
}

/* Toast（带收缩退出动画） */
.ct-toast-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  z-index: 10000000006 !important; /* 🔴 修复：全局Toast应该最高，高于所有页面级弹窗 */
  display: flex; align-items: center; justify-content: center;
  pointer-events: none;
  background: transparent; /* 透明背景，不遮挡内容 */
  animation: autoToastMaskFadeIn 0.25s ease-out forwards;
}
.ct-toast-mask.closing {
  animation: autoToastMaskFadeOut 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}
@keyframes autoToastMaskFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes autoToastMaskFadeOut {
  from { opacity: 1; }
  to { opacity: 0; }
}

.ct-toast {
  background: #fff;
  color: #000;
  padding: 34rpx 56rpx;
  border-radius: 24rpx;
  display: flex; flex-direction: column; align-items: center;
  box-shadow: 0 12rpx 48rpx rgba(0,0,0,0.12), 0 4rpx 16rpx rgba(0,0,0,0.08);
  max-width: 60%;
  min-width: 280rpx;
  overflow: hidden;
  animation: toastSlideIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  pointer-events: auto;
  position: relative;
}
.ct-toast-mask.closing .ct-toast {
  animation: autoToastShrinkOut 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}
@keyframes autoToastShrinkOut {
  0% {
    transform: scale(1) translateY(0);
    opacity: 1;
    filter: blur(0);
  }
  100% {
    transform: scale(0.6) translateY(-60rpx);
    opacity: 0;
    filter: blur(12rpx);
  }
}
.ct-toast-text {
  font-size: 32rpx;
  text-align: center;
  line-height: 1.5;
  font-weight: 600;
  color: #1D1D1F;
  letter-spacing: 0.5rpx;
  animation: toastTextPop 0.28s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}
.ct-toast--green {
  border: 1rpx solid rgba(52, 199, 89, 0.22);
  box-shadow: 0 12rpx 48rpx rgba(52, 199, 89, 0.12), 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.ct-toast--green .ct-toast-text {
  color: #248A3D;
}

@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
/* scaleIn 已移除，改用 dialogBoxPopIn */
@keyframes fadeIn { 0% { opacity: 0; transform: translateY(10px); } 100% { opacity: 1; transform: translateY(0); } }
@keyframes toastSlideIn {
  0% {
    opacity: 0;
    transform: translateY(-40rpx) scale(0.9);
  }
  60% {
    transform: translateY(8rpx) scale(1.02);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes toastTextPop {
  0%   { transform: translateY(6rpx); opacity: 0.2; }
  65%  { transform: translateY(-2rpx); opacity: 1; }
  100% { transform: translateY(0); opacity: 1; }
}