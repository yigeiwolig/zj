<!-- 真机：挂到页面根，避开 detail-view transform / container overflow 导致 fixed 弹层不显示 -->
<root-portal>
<view class="device-bind-modal-root">

<!-- 蓝牙绑定 -->
<view
  wx:if="{{showModal && !showFaultBindForm}}"
  class="modal bind-device-modal hub-bind-modal-portal show {{bindModalClosing ? 'is-closing' : ''}}"
  catchtouchmove="noop">
  <view class="modal-content {{bluetoothReady ? 'connected' : ''}} {{showBindAuditForm ? 'bind-audit-open' : ''}} {{showBindSuccess ? 'bind-success-open' : ''}} {{bindSheetFromBottom ? 'hub-sheet--from-bottom' : ''}}" catchtouchmove="noop">
    <view class="modal-header">
      <text>{{showBindSuccess ? '绑定完成' : '绑定设备'}}</text>
      <view class="close-modal" bindtap="onCloseTap">✕</view>
    </view>

    <scroll-view scroll-y="true" class="modal-scroll-area">
      <view class="bind-stage bind-stage--enter" wx:if="{{!bluetoothReady}}">
        <view class="bt-scan-container">
          <view class="radar-circle" bindtap="startConnect">
            <view class="radar-core">
              <image class="bt-icon-img" src="data:image/svg+xml;base64," mode="aspectFit" lazy-load="true"></image>
            </view>
            <view class="radar-ring r1 {{isScanning?'anim':''}}"></view>
            <view class="radar-ring r2 {{isScanning?'anim':''}}"></view>
            <view class="radar-ring r3 {{isScanning?'anim':''}}"></view>
          </view>
          <text class="radar-tip">{{connectStatusText}}</text>
          <view class="bind-fault-entry" catchtap="openFaultBindForm">
            <text class="bind-fault-entry-link">设备无法连接？走无设备核验</text>
          </view>
        </view>
      </view>

      <block wx:if="{{bluetoothReady}}">
        <view class="bt-connected-bar">
          <view class="bt-c-icon">✅</view>
          <view class="bt-c-info">
            <text class="bt-c-name">已连接设备</text>
            <text class="bt-c-sn">{{connectedDeviceName}}</text>
          </view>
          <view class="bt-disconnect-btn" wx:if="{{!showBindSuccess}}" bindtap="resetBluetoothState">断开</view>
        </view>

        <view class="bind-stage bind-stage--enter" wx:if="{{showBindSuccess}}">
          <view class="bind-success-panel">
            <view class="bind-success-icon">✓</view>
            <text class="bind-success-title">{{bindSuccessTitle || '绑定成功'}}</text>
            <text class="bind-success-desc">{{bindSuccessContent}}</text>
            <view class="bind-success-btn" bindtap="onBindSuccessConfirm">好的</view>
          </view>
        </view>

        <view class="bind-stage bind-stage--enter" wx:elif="{{!showBindAuditForm && !lockedReason}}">
          <view class="bind-verifying-tip">
            <text>正在验证设备…</text>
            <text class="bind-verifying-sub">预登记设备将自动激活绑定，无需上传审核资料</text>
          </view>
        </view>

        <view class="bind-stage bind-stage--enter" wx:elif="{{isDeviceLocked && lockedReason}}">
          <view class="locked-view">
            <view class="locked-icon">🚫</view>
            <text class="locked-title">无法绑定</text>
            <text class="locked-desc">{{lockedReason}}</text>
          </view>
        </view>

        <view class="bind-stage bind-stage--enter" wx:elif="{{showBindAuditForm}}">
          <view class="type-tabs">
            <view class="tab-item {{bindType == 'new' ? 'active' : ''}}" bindtap="changeBindType" data-type="new">全新设备</view>
            <view class="tab-item {{bindType == 'used' ? 'active' : ''}}" bindtap="changeBindType" data-type="used">二手/旧设备</view>
          </view>

          <view class="form-item">
            <text class="form-label">选择产品型号</text>
            <picker bindchange="onModelChange" range="{{modelOptions}}" value="{{modelIndex}}">
              <view class="picker-val">{{modelOptions[modelIndex] || '请选择型号'}}</view>
            </picker>
          </view>

          <view class="form-item">
            <text class="form-label">控制版本</text>
            <view
              class="ctrl-variant-seg {{controlVariant === 'remote' ? 'is-remote' : (controlVariant === 'button' ? 'is-button' : '')}}"
              bindtouchstart="onCtrlVariantTouchStart"
              bindtouchend="onCtrlVariantTouchEnd"
              data-scope="form"
            >
              <view class="ctrl-variant-thumb-wrap"><view class="ctrl-variant-thumb"></view></view>
              <view
                class="ctrl-variant-item {{controlVariant === 'button' ? 'is-on' : ''}}"
                catchtap="onControlVariantChange"
                data-value="button"
              >按钮版</view>
              <view
                class="ctrl-variant-item {{controlVariant === 'remote' ? 'is-on' : ''}}"
                catchtap="onControlVariantChange"
                data-value="remote"
              >遥控版</view>
            </view>
          </view>

          <view class="form-item">
            <text class="form-label">{{bindType == 'new' ? '订单截图' : '上传凭证 (购买截图 + 聊天记录)'}}</text>
            <view class="upload-group">
              <view class="upload-box" bindtap="chooseProofImage" data-type="receipt">
                <view class="upload-box-frame">
                  <view class="upload-placeholder-center">
                    <text class="plus-icon">+</text>
                    <text>购买截图</text>
                  </view>
                  <image wx:if="{{previewImgReceipt}}" src="{{previewImgReceipt}}" mode="aspectFit" class="uploaded-img" lazy-load="true" />
                </view>
              </view>
              <view class="upload-box" wx:if="{{bindType == 'used'}}" bindtap="chooseProofImage" data-type="chat">
                <view class="upload-box-frame">
                  <view class="upload-placeholder-center">
                    <text class="plus-icon">+</text>
                    <text>聊天记录</text>
                  </view>
                  <image wx:if="{{previewImgChat}}" src="{{previewImgChat}}" mode="aspectFit" class="uploaded-img" lazy-load="true" />
                </view>
              </view>
            </view>
          </view>

          <view class="form-item">
            <text class="form-label">购买日期</text>
            <picker mode="date" value="{{buyDate}}" bindchange="onDateChange">
              <view class="picker-val">{{buyDate || '请选择日期'}}</view>
            </picker>
          </view>
        </view>
      </block>

      <view style="height: 40rpx;"></view>
    </scroll-view>

    <view class="bind-audit-footer" wx:if="{{bluetoothReady && showBindAuditForm && !showBindSuccess}}">
      <button class="bind-audit-submit" bindtap="submitAudit">提交上传审核</button>
    </view>
  </view>
</view>

<!-- 无设备核验 -->
<view
  wx:if="{{showModal && showFaultBindForm}}"
  class="modal hub-bind-modal-portal show {{bindModalClosing ? 'is-closing' : ''}}"
  catchtouchmove="noop">
  <view class="modal-content fault-bind-mode bind-audit-open {{bindSheetFromBottom ? 'hub-sheet--from-bottom' : ''}}">
    <view class="modal-header">
      <text>故障核验</text>
      <view class="close-modal" bindtap="onCloseTap">✕</view>
    </view>
    <scroll-view scroll-y class="modal-scroll-area fault-body" enhanced show-scrollbar>
      <view class="fault-bind-form">
        <view class="fault-status-banner">
          <view class="fault-status-icon">!</view>
          <view class="fault-status-copy">
            <text class="fault-status-title">设备无法蓝牙连接</text>
            <text class="fault-status-desc">提交订单截图，审核通过后创建产品档案</text>
          </view>
        </view>
        <view class="fault-form-card">
          <view class="fault-form-row">
            <text class="fault-row-label">产品型号</text>
            <picker class="fault-row-picker" bindchange="onModelChange" range="{{modelOptions}}" value="{{modelIndex}}">
              <view class="fault-row-value {{modelIndex !== null ? '' : 'is-placeholder'}}">
                <text>{{modelOptions[modelIndex] || '请选择'}}</text>
                <text class="fault-row-chevron">›</text>
              </view>
            </picker>
          </view>
          <view class="fault-form-divider"></view>
          <view class="fault-form-row fault-form-row--block">
            <text class="fault-row-label">控制版本</text>
            <view
              class="ctrl-variant-seg {{controlVariant === 'remote' ? 'is-remote' : (controlVariant === 'button' ? 'is-button' : '')}}"
              style="margin-top: 16rpx;"
              bindtouchstart="onCtrlVariantTouchStart"
              bindtouchend="onCtrlVariantTouchEnd"
              data-scope="form"
            >
              <view class="ctrl-variant-thumb-wrap"><view class="ctrl-variant-thumb"></view></view>
              <view
                class="ctrl-variant-item {{controlVariant === 'button' ? 'is-on' : ''}}"
                catchtap="onControlVariantChange"
                data-value="button"
              >按钮版</view>
              <view
                class="ctrl-variant-item {{controlVariant === 'remote' ? 'is-on' : ''}}"
                catchtap="onControlVariantChange"
                data-value="remote"
              >遥控版</view>
            </view>
          </view>
          <view class="fault-form-divider"></view>
          <view class="fault-form-row">
            <text class="fault-row-label">购买日期</text>
            <picker class="fault-row-picker" mode="date" bindchange="onDateChange">
              <view class="fault-row-value {{buyDate ? '' : 'is-placeholder'}}">
                <text>{{buyDate || '请选择'}}</text>
                <text class="fault-row-chevron">›</text>
              </view>
            </picker>
          </view>
        </view>
        <view class="fault-upload-card">
          <text class="fault-upload-label">订单截图</text>
          <view class="fault-upload-box {{previewImgReceipt ? 'fault-upload-box--filled' : ''}}" bindtap="chooseProofImage" data-type="receipt">
            <block wx:if="{{previewImgReceipt}}">
              <image src="{{previewImgReceipt}}" mode="aspectFit" class="fault-upload-preview" catchtap="previewFaultReceipt" lazy-load="true" />
              <view class="fault-upload-change" catchtap="chooseProofImage" data-type="receipt">更换截图</view>
            </block>
            <block wx:else>
              <view class="fault-upload-empty">
                <view class="fault-upload-icon">+</view>
                <text class="fault-upload-tip">上传购买订单截图</text>
                <text class="fault-upload-sub">支持相册或拍照</text>
              </view>
            </block>
          </view>
        </view>
        <view class="fault-bind-note">
          <text class="fault-bind-note-text">审核通过后先创建质保档案；是否需录入新机 SN，由售后在报修卡填写诊断书判定</text>
        </view>
      </view>
    </scroll-view>
    <view class="bind-audit-footer">
      <button class="bind-audit-submit" bindtap="submitFaultAudit">提交核验申请</button>
    </view>
  </view>
</view>

</view>
</root-portal>
