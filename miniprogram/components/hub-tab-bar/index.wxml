<view class="tabbar-glass">
  <view
    class="tab-item {{active === 0 ? 'is-active' : ''}}"
    data-tab="home"
    bindtap="onTap"
  >
    <text class="tab-item-label">首页</text>
    <view class="tab-item-dot"></view>
  </view>
  <view
    class="tab-item {{active === 1 ? 'is-active' : ''}}"
    data-tab="orders"
    bindtap="onTap"
  >
    <text class="tab-item-label">订单</text>
    <view class="tab-item-dot"></view>
  </view>
  <view
    class="tab-item {{active === 2 ? 'is-active' : ''}}"
    data-tab="kf"
    bindtap="onTap"
    wx:if="{{showKf}}"
  >
    <text class="tab-item-label">客服</text>
    <view class="tab-item-dot"></view>
  </view>
  <view
    class="tab-item {{active === (showKf ? 3 : 2) ? 'is-active' : ''}}"
    data-tab="profile"
    bindtap="onTap"
  >
    <view class="tab-item-label-wrap">
      <text class="tab-item-label">我的</text>
      <view class="tab-item-badge" wx:if="{{profileDot && active !== (showKf ? 3 : 2)}}"></view>
    </view>
    <view class="tab-item-dot"></view>
  </view>
</view>
