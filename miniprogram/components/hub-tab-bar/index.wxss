.tabbar-glass {
  position: relative;
  margin: 0 48rpx calc(40rpx + env(safe-area-inset-bottom));
  width: auto;
  height: 110rpx;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(40px) saturate(150%);
  -webkit-backdrop-filter: blur(40px) saturate(150%);
  border-radius: 100rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.05), inset 0 1rpx 1rpx rgba(255, 255, 255, 0.8);
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  align-items: center;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.tab-item {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.tab-item-label {
  font-size: 28rpx;
  color: #999999;
  font-weight: 500;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.tab-item-label-wrap {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.tab-item.is-active .tab-item-label {
  color: #1d1d1f;
  font-weight: 800;
  transform: translateY(-4rpx);
}

.tab-item.is-active .tab-item-label-wrap {
  transform: translateY(-4rpx);
}

.tab-item.is-active .tab-item-label-wrap .tab-item-label {
  transform: none;
}

.tab-item-dot {
  position: absolute;
  bottom: 24rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #1d1d1f;
  opacity: 0;
  transform: scale(0);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.tab-item.is-active .tab-item-dot {
  opacity: 1;
  transform: scale(1);
}

/* 「我的」未读/待办红点（贴在文字右上角） */
.tab-item-badge {
  position: absolute;
  top: -6rpx;
  right: -14rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ff3b30;
  box-shadow: 0 0 0 3rpx rgba(255, 255, 255, 0.92);
  z-index: 2;
  pointer-events: none;
}
