.tabbar-glass {
  position: relative;
  margin: 0 40rpx calc(20rpx + env(safe-area-inset-bottom));
  width: auto;
  min-height: 104rpx;
  background: rgba(255, 255, 255, 0.82);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border-radius: 52rpx;
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  align-items: stretch;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.07);
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
  padding: 8rpx 12rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 14rpx 8rpx 12rpx;
  box-sizing: border-box;
}

.tab-item-label {
  font-size: 24rpx;
  font-weight: 500;
  color: rgba(60, 60, 67, 0.5);
  line-height: 1.2;
  transition: color 0.22s ease, font-weight 0.22s ease;
}

.tab-item.is-active .tab-item-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #1d1d1f;
}

/* 与顶部分段栏一致：文字下方短下划线，不要顶部粗黑条 */
.tab-item-line {
  width: 36rpx;
  height: 6rpx;
  margin-top: 10rpx;
  border-radius: 6rpx;
  background: #1d1d1f;
}
