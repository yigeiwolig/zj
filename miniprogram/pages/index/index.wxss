/* ================= 全局 & 基础 ================= */
page { background-color: #F9F9F9; height: 100%; overflow: hidden; }
.index-page { height: 100%; display: flex; flex-direction: column; padding: 120rpx 60rpx 80rpx; box-sizing: border-box; position: relative; }
.index-page.admin-active { padding: 0; background: #f8f8f8; }

/* 保持首页输入左对齐 */
input, textarea { text-align: left; }

/* 消失动画 */
.fade-out { 
  opacity: 0; 
  transition: opacity 0.4s ease;
  /* 不设置 pointer-events: none，让子元素可以单独控制 */
}

/* 头部底部样式保持不变 */
.header-section { 
  text-align: center; 
  transition: 0.4s;
  position: relative;
  z-index: 2000; /* 确保在最上层 */
}
.main-title { font-size: 64rpx; font-weight: 800; color: #1d1d1f; }
.sub-title { font-size: 24rpx; font-weight: 600; color: #86868b; letter-spacing: 2rpx; }

/* 标题包装器 */
.title-wrap {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 12rpx;
  cursor: pointer;
  position: relative;
  z-index: 2001 !important; /* 确保在最上层 */
  pointer-events: auto !important;
  padding: 30rpx 40rpx; /* 增加点击区域 */
  margin: -30rpx -40rpx; /* 抵消 padding，保持视觉位置 */
  /* 确保即使父元素有 fade-out，这个元素仍然可点击 */
  background: transparent; /* 确保背景透明，不影响视觉效果 */
  -webkit-tap-highlight-color: rgba(0, 0, 0, 0.1); /* 点击反馈 */
}

.brand {
  font-size: 64rpx;
  font-weight: 700; /* 从 800 调低到 700 */
  color: #1d1d1f;
}

.brand-sub {
  font-size: 32rpx;
  font-weight: 600;
  color: #86868b;
  letter-spacing: 2rpx;
}

/* 中间标题样式 */
.center-title {
  text-align: center;
  transition: 0.4s;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 10;
}
.footer-section { 
  transition: 0.4s; 
  position: relative;
  z-index: 50;
  opacity: 1;
  margin-top: auto;
}
.loc-grid { display: flex; gap: 20rpx; justify-content: center; }
.chip { background: #fff; padding: 20rpx 30rpx; border-radius: 20rpx; display: flex; align-items: center; gap: 10rpx; font-size: 26rpx; font-weight: 600; box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.05); }
.status.green { width: 12rpx; height: 12rpx; background: #34c759; border-radius: 50%; }

.tool-label { font-size: 20rpx; color: #ccc; text-align: center; margin-bottom: 30rpx; letter-spacing: 2rpx; font-weight: 600; }

/* ================= 舞台区域 ================= */
.hero-section {
  flex: 1; display: flex; justify-content: center; align-items: center;
  position: relative; width: 100%;
}

/* --- 文字轨道 --- */
.text-track {
  position: absolute;
  top: 50%; left: 0; width: 100%;
  transform: translateY(-50%);
  display: flex;
  justify-content: center;
  gap: 16rpx;
  z-index: 300; /* 确保在黑幕之上 */
  padding-left: 10rpx;
}

/* 移除旧的动画 */
.index-page.animating .text-track {
  animation: none;
  clip-path: none;
}

.char {
  font-size: 42rpx; font-weight: 900; color: #1d1d1f;
  opacity: 0;
  transform: scale(0.8) translateY(20rpx);
  filter: blur(10rpx);
}

/* 极简高级淡入：带一点点模糊变清晰的效果 */
@keyframes cinematicText {
  0% { opacity: 0; transform: scale(0.8) translateY(20rpx); filter: blur(10rpx); }
  100% { opacity: 1; transform: scale(1) translateY(0); filter: blur(0); }
}

/* 错峰出现，如流水般顺滑，加快整体节奏 */
.index-page.animating .char-1 { animation: cinematicText 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.0s forwards; }
.index-page.animating .char-2 { animation: cinematicText 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.04s forwards; }
.index-page.animating .char-3 { animation: cinematicText 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.12s forwards; } /* 稍微停顿区分词组 */
.index-page.animating .char-4 { animation: cinematicText 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.16s forwards; }
.index-page.animating .char-5 { animation: cinematicText 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.20s forwards; }
.index-page.animating .char-6 { animation: cinematicText 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.24s forwards; }
.index-page.animating .char-7 { animation: cinematicText 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.32s forwards; }
.index-page.animating .char-8 { animation: cinematicText 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.36s forwards; }
.index-page.animating .char-9 { animation: cinematicText 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.40s forwards; }
.index-page.animating .char-10 { animation: cinematicText 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.44s forwards; }
.index-page.animating .char-11 { animation: cinematicText 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.48s forwards; }

/* --- 主角：从水滴到齿轮 --- */
.liquid-btn {
  width: 360rpx; height: 360rpx;
  background: #F9F9F9;
  border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
  box-shadow: 24rpx 24rpx 60rpx rgba(174, 174, 192, 0.4), -24rpx -24rpx 60rpx rgba(255, 255, 255, 1);
  display: flex; justify-content: center; align-items: center;
  position: absolute; z-index: 200; /* 提高 z-index，确保在遮罩层上方 */
  animation: morph 3.5s ease-in-out infinite;
  transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  pointer-events: auto; /* 确保可以点击 */
}

.btn-text { font-size: 32rpx; font-weight: 600; letter-spacing: 6rpx; color: #666; mix-blend-mode: multiply; }
.highlight-dot { width: 40rpx; height: 20rpx; background: rgba(255,255,255,0.8); border-radius: 50%; position: absolute; top: 60rpx; left: 80rpx; transform: rotate(-45deg); filter: blur(2rpx); transition: opacity 0.2s; }

/* 齿轮内部结构 (默认透明) */
.gear-shape {
  width: 100%; height: 100%; position: absolute; opacity: 0; transition: opacity 0.3s;
  border-radius: 50%;
  border: 4rpx solid rgba(29, 29, 31, 0.15); /* 极简的浅色轨道 */
  box-sizing: border-box;
}
/* 轨道上的小圆点，旋转时像雷达或旋钮 */
.gear-shape::after {
  content: '';
  position: absolute;
  top: -4rpx; left: 50%; transform: translateX(-50%);
  width: 12rpx; height: 12rpx;
  background: #1d1d1f;
  border-radius: 50%;
  box-shadow: 0 0 8rpx rgba(0,0,0,0.2);
}
.gear-shape .teeth { display: none; } /* 隐藏旧的十字准星/虚线 */
.gear-shape .hub {
  position: absolute; width: 16rpx; height: 16rpx; background: #1d1d1f; border-radius: 50%;
  top: 50%; left: 50%; transform: translate(-50%, -50%);
}

/* === 极简点击反馈：点击瞬间缩小并震动 === */
.liquid-btn:active {
  transform: scale(0.92);
  box-shadow: 12rpx 12rpx 30rpx rgba(174, 174, 192, 0.4), -12rpx -12rpx 30rpx rgba(255, 255, 255, 1);
  transition: transform 0.1s ease, box-shadow 0.1s ease;
}

/* === Step 1: 纯净巨幕 (Cinematic Light Expansion) === */
.liquid-btn.expanded-light {
  animation: expandToLight 1.4s cubic-bezier(0.65, 0, 0.15, 1) forwards;
  pointer-events: none;
}
.liquid-btn.expanded-light .btn-text, 
.liquid-btn.expanded-light .highlight-dot,
.liquid-btn.expanded-light .gear-shape { 
  opacity: 0 !important; 
  transition: opacity 0.1s; 
}

.admin-quick-gen {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  z-index: 250;
  pointer-events: auto;
}

.admin-quick-gen-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  flex-wrap: wrap;
  padding: 0 28rpx;
}

.admin-quick-gen-btn {
  padding: 18rpx 36rpx;
  background: #ffffff;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #111111;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(0, 0, 0, 0.12);
}

.admin-quick-gen-btn--dark {
  background: #111111;
  color: #ffffff;
  border-color: #111111;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.18);
}

.admin-quick-gen-btn.is-loading {
  opacity: 0.65;
  pointer-events: none;
}

.admin-quick-gen-btn:active {
  transform: scale(0.97);
  opacity: 0.88;
}

/* 隐藏其他多余的 step，因为我们直接跳到文字显示和跳转 */
.liquid-btn.step-2, .liquid-btn.step-4 {
  display: none;
}

/* --- 动画关键帧 --- */
@keyframes morph {
  0% { border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%; }
  50% { border-radius: 30% 60% 70% 40% / 50% 60% 30% 60%; }
  100% { border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%; }
}

@keyframes expandToLight {
  0% { transform: scale(1); border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%; background: #F9F9F9; }
  10% { transform: scale(0.8); border-radius: 50%; background: #ffffff; box-shadow: none; } /* 蓄力并变纯白 */
  100% { transform: scale(40); border-radius: 50%; background: #ffffff; box-shadow: none; } /* 爆盖全屏纯白 */
}

/* ================= 遮罩层（布的效果） ================= */
.curtain-mask {
  position: fixed;
  top: 50%; /* 文字水平线位置 */
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(to bottom, 
    rgba(249, 249, 249, 0) 0%,
    rgba(249, 249, 249, 0.4) 5%,
    rgba(249, 249, 249, 0.9) 15%,
    rgba(249, 249, 249, 1) 25%
  );
  z-index: 110; /* 在齿轮(100)上方，文字(120)下方，能遮挡齿轮 */
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.4s ease;
}

.curtain-mask.active {
  opacity: 1; /* 激活时显示遮罩，齿轮跳到布后面 */
}

/* ================= 昵称验证居中弹窗 ================= */

.auth-mask {
  position: fixed; top: 0; left: 0; width: 100%; height: 100%;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(8px);
  z-index: 9999;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 0 32rpx;
  box-sizing: border-box;
  opacity: 1;
  transition: opacity 0.3s;
}

.auth-mask.closing {
  animation: authMaskFadeOut 0.32s ease forwards;
}

@keyframes authMaskFadeOut {
  from { opacity: 1; }
  to { opacity: 0; }
}

/* 底部面板 */
.auth-panel {
  background: #fff;
  width: 100%;
  border-radius: 24rpx 24rpx 0 0; /* 上方圆角 */
  padding: 40rpx 40rpx 80rpx; /* 底部留够安全距离 */
  box-sizing: border-box;
  transform: translateY(100%); /* 初始在屏幕外 */
  animation: slideUp 0.35s cubic-bezier(0.25, 1, 0.5, 1) forwards;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

/* 头部信息 */
.auth-header {
  display: flex; flex-direction: column; align-items: flex-start;
  margin-bottom: 30rpx;
}
.app-icon {
  width: 64rpx; height: 64rpx; background: #333; border-radius: 50%; margin-bottom: 20rpx;
}
.app-name {
  font-size: 30rpx; font-weight: 600; color: #000; margin-bottom: 10rpx;
}
.auth-apply {
  font-size: 34rpx; font-weight: 700; color: #000;
}

/* 权限描述 */
.auth-desc {
  display: flex; align-items: center; gap: 10rpx;
  padding-bottom: 40rpx; border-bottom: 1rpx solid #f1f1f1;
  margin-bottom: 30rpx;
}
.desc-dot {
  width: 8rpx; height: 8rpx; background: #888; border-radius: 50%;
}
.auth-desc text {
  font-size: 26rpx; color: #888;
}

/* 资料填写表单 (伪装成列表) */
.info-form {
  margin-bottom: 60rpx;
}
.form-item {
  display: flex; justify-content: space-between; align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f1f1f1;
}
.avatar-item {
  padding-top: 0;
}

.label {
  font-size: 30rpx; font-weight: 600; color: #333; width: 120rpx;
}

/* 伪装头像 */
.avatar-wrapper {
  display: flex; align-items: center; gap: 10rpx;
}
.default-avatar {
  width: 64rpx; height: 64rpx; background: #eee; border-radius: 8rpx;
}
.arrow {
  width: 16rpx; height: 16rpx;
  border-top: 4rpx solid #ccc; border-right: 4rpx solid #ccc;
