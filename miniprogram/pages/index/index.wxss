/* ================= 【新版】现代极简弹窗样式 ================= */

/* 1. 遮罩层：加深一点背景，突出主体 */
.custom-modal-mask {
  position: fixed; top: 0; left: 0; width: 100%; height: 100%;
  background: rgba(0, 0, 0, 0.7); /* 深色遮罩 */
  backdrop-filter: blur(10px); /* 强力毛玻璃 */
  z-index: 10100 !important; /* 高于 .auth-mask(9999)，确保昵称错误提示可见 */
  display: flex; align-items: center; justify-content: center;
}

/* 2. 弹窗卡片：更圆润，更宽，统一和 shop 页面一样 */
.custom-modal-box {
  width: 600rpx; /* 统一宽度，和 shop 页面一样 */
  background: #ffffff;
  border-radius: 50rpx; /* 统一圆角，和 shop 页面一样 */
  padding: 70rpx 50rpx; /* 统一内边距，和 shop 页面一样 */
  display: flex; flex-direction: column; align-items: center;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15); /* 统一阴影，和 shop 页面一样 */
  
  /* 统一弹出动画，和 shop 页面一样 */
  animation: cartBoxPopIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

/* 统一遮罩层动画 */
.custom-modal-mask {
  animation: cartMaskFadeIn 0.25s ease-out forwards;
}
.custom-modal-mask.closing {
  animation: cartMaskFadeOut 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}
.custom-modal-mask.closing .custom-modal-box {
  animation: cartBoxShrinkOut 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}

/* 复制成功提示：高于首次加微信等其它 custom-modal-mask（同 z-index 时后渲染者在上，仍显式抬高） */
.custom-modal-mask.copy-success-modal-mask {
  z-index: 10110 !important;
}

/* 定位权限提示弹窗样式（白底黑字） */
.location-permission-modal {
  width: 560rpx;
  background: #ffffff;
  border-radius: 40rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 40rpx 80rpx rgba(0, 0, 0, 0.15);
}

.location-permission-modal .modal-icon-new {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #f2f2f7;
  color: #1d1d1f;
  font-size: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
}

.location-permission-modal .modal-title-new {
  font-size: 36rpx;
  font-weight: 700;
  color: #1d1d1f;
  margin-bottom: 20rpx;
}

.location-permission-modal .modal-content-new {
  margin-bottom: 40rpx;
}

.location-permission-modal .content-main {
  font-size: 30rpx;
  color: #424245;
  line-height: 1.6;
  text-align: center;
}

/* 3. 图标：大而黑，无背景 */
.modal-icon-new {
  width: 110rpx; height: 110rpx;
  margin-bottom: 40rpx;
  /* 纯黑图标，不需要透明度，强调警示 */
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 88rpx;
  font-weight: 900;
  color: #000000;
  line-height: 1;
  /* 立即显示，无需等待图片加载 */
  opacity: 1;
  animation: errorIconPop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

/* 错误图标样式：圆形图标 */
.error-icon {
  animation: errorIconPop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  background: #000000;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.error-icon .error-circle {
  color: #ffffff;
  font-size: 70rpx;
  font-weight: 900;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

@keyframes errorIconPop {
  from {
    transform: scale(0) rotate(-180deg);
    opacity: 0;
  }
  to {
    transform: scale(1) rotate(0deg);
    opacity: 1;
  }
}

/* 4. 标题：特粗黑体 */
.modal-title-new {
  font-size: 40rpx;
  font-weight: 900; /* 最粗 */
  color: #000000;
  margin-bottom: 24rpx;
  letter-spacing: 2rpx;
}

/* 5. 文字内容区域 */
.modal-content-new {
  text-align: center;
  margin-bottom: 60rpx;
}

.content-main {
  font-size: 30rpx;
  color: #333333;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.content-sub {
  font-size: 26rpx;
  color: #999999; /* 浅灰色辅助说明 */
}

/* 6. 按钮：纯黑、扁平、全宽 */
.modal-btn-new {
  width: 100% !important;
  height: 100rpx;
  line-height: 100rpx;
  background-color: #000000;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 36rpx; /* 稍微方一点的圆角，更显科技感 */
  padding: 0;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.3); /* 强烈的黑色投影 */
  transition: transform 0.1s ease;
}

.modal-btn-new::after { border: none; }

.modal-btn-new:active {
  transform: scale(0.96); /* 点击时的微缩反馈 */
}

/* ================= 成功提示弹窗样式 - 黑色勾，白色底 ================= */
.success-modal {
  width: 400rpx !important; /* 统一尺寸，和内容已复制一样 */
  padding: 60rpx 40rpx !important; /* 统一内边距 */
  min-height: auto;
  background: #ffffff !important;
}

.success-modal .modal-icon-new {
  display: flex !important; /* 显示勾勾图标 */
  align-items: center;
  justify-content: center;
  width: auto;
  height: auto;
  background: transparent !important; /* 去掉黑色圆形背景 */
  border-radius: 0;
  margin: 0 auto 24rpx;
  font-size: 80rpx;
  color: #000000 !important; /* 黑色勾 */
  font-weight: 300;
  animation: checkmarkPop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

@keyframes checkmarkPop {
  from {
    transform: scale(0) rotate(-180deg);
    opacity: 0;
  }
  to {
    transform: scale(1) rotate(0deg);
    opacity: 1;
  }
}

.success-modal .modal-title-new {
  font-size: 36rpx !important; /* 统一标题字体大小，和内容已复制一样 */
  margin-bottom: 0 !important;
  letter-spacing: 0 !important;
  font-weight: 600 !important; /* 统一字体粗细 */
  color: #000000 !important;
  text-align: center;
  animation: toastTextPop 0.28s cubic-bezier(0.34, 1.56, 0.64, 1) 0.2s both;
}

.success-modal .modal-content-new {
  margin-bottom: 0 !important;
  display: none; /* 成功提示不需要内容区域 */
}

/* ================= 自定义"内容已复制"弹窗 - 黑色勾，白色底，保留文字 ================= */
.copy-success-modal {
  width: 400rpx !important;
