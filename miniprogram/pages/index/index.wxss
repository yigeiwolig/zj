/* azjc 风格：一块块数据区域 */
.data-section {
  margin-bottom: 12rpx;
  padding: 16rpx;
  background: #ffffff;
  border: 1rpx solid #e6ebf2;
  border-radius: 14rpx;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.035);
}

.data-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.data-section-title {
  margin-bottom: 0;
  font-size: 22rpx;
  font-weight: 800;
  color: #0f172a;
  padding-left: 12rpx;
  border-left: 6rpx solid #3b82f6;
}

.data-gps-tag {
  font-size: 18rpx;
  font-weight: 600;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  border: 1rpx solid #9fb6c8;
  background: #eef5fb;
  color: #334155;
}

