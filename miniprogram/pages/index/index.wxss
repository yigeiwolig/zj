}
.auth-btns button {
  margin: 0; 
  padding: 0;
  border: none;
  border-radius: 12rpx; 
  font-size: 32rpx;
  font-weight: 600;
  height: 90rpx; 
  line-height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.auth-btns button::after { border: none; }

.btn-reject {
  flex: 1; 
  background: #f2f2f2; 
  color: #07C160;
}

.btn-allow {
  flex: 1; 
  background: #07C160; /* 官方微信绿 */
  color: #fff;
}
.btn-allow:active {
  background: #06ad56;
  }

/* ================= 高级身份验证弹窗样式（居中卡片） ================= */
.auth-panel-new {
  width: 100%;
  background: #ffffff;
  border-radius: 48rpx;
  padding: 64rpx 48rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
