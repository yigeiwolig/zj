  justify-content: space-between;
  align-items: center;
  min-height: 44rpx;
  border-bottom: 1rpx dashed #dbe4ef;
}

.visit-detail-item:last-child {
  border-bottom: none;
}

.visit-detail-name {
  color: #334155;
  font-size: 22rpx;
  font-weight: 600;
}

.visit-detail-count {
  color: #0f172a;
  font-size: 23rpx;
  font-weight: 800;
}

.data-chip-map {
  margin-top: 6rpx;
