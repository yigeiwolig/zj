/* ================= 首次进入提示弹窗 ================= */
/* 与 wx:if 首帧配合：先挂载再 firstTimeModalEnterReady，遮罩/卡片用 transition 弹出 */
.first-time-modal-mask:not(.first-time-modal-enter-ready):not(.closing) {
  animation: none !important;
  opacity: 0;
}
.first-time-modal-mask.first-time-modal-enter-ready:not(.closing) {
  animation: none !important;
  opacity: 1;
  transition: opacity 0.32s ease-out;
}
.first-time-modal-mask:not(.first-time-modal-enter-ready) .custom-modal-box.first-time-modal {
  animation: none !important;
  opacity: 0;
  transform: translateY(36rpx) scale(0.94);
}
.first-time-modal-mask.first-time-modal-enter-ready:not(.closing) .custom-modal-box.first-time-modal {
  animation: none !important;
  opacity: 1;
  transform: translateY(0) scale(1);
  transition: opacity 0.36s cubic-bezier(0.22, 1, 0.36, 1) 0.05s,
    transform 0.42s cubic-bezier(0.22, 1, 0.36, 1) 0.05s;
}
.first-time-modal-mask.closing {
  animation: cartMaskFadeOut 0.38s cubic-bezier(0.4, 0, 0.2, 1) forwards !important;
}
.first-time-modal-mask.closing .custom-modal-box.first-time-modal {
  animation: cartBoxShrinkOut 0.38s cubic-bezier(0.4, 0, 0.2, 1) forwards !important;
  transition: none !important;
}

.first-time-modal-mask {
