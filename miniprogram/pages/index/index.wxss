  color: #0e7490;
  background: #def3fa;
  border-color: #7cbfd3;
}

.data-chip-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.data-chip-grid-2 .data-chip {
  width: calc(50% - 5rpx);
}

.data-chip-grid-3 .data-chip {
  width: calc((100% - 20rpx) / 3);
}

.data-chip {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  background: #f8fafc;
  border: 1rpx solid #dde5ef;
  border-radius: 12rpx;
  padding: 10rpx 14rpx;
  box-sizing: border-box;
  width: 100%;
}

.data-chip-full {
  width: 100%;
  margin-bottom: 10rpx;
}

.data-chip-k {
  flex-shrink: 0;
  margin-right: 14rpx;
  color: #7a8798;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.4rpx;
}

.data-chip-v {
  flex: 1;
  text-align: right;
  color: #111827;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.25;
  letter-spacing: 0.2rpx;
  word-break: break-all;
}

.data-chip-link {
  color: #0b72c9;
  font-weight: 800;
  text-decoration: underline;
  text-decoration-thickness: 1.5rpx;
  text-underline-offset: 4rpx;
}

.data-chip-muted {
  color: #7b8797;
  font-weight: 700;
  font-size: 24rpx;
}

.data-chip-mono {
