/* ================= 自定义弹窗样式 ================= */
.custom-dialog-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.4); /* 统一背景色，和 shop 页面一样 */
  backdrop-filter: blur(5px);
  z-index: 9150;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: cartMaskFadeIn 0.25s ease-out forwards; /* 统一动画名称 */
}
.custom-dialog-mask.closing {
  animation: cartMaskFadeOut 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards; /* 统一动画名称 */
}
@keyframes cartMaskFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes cartMaskFadeOut {
  from { opacity: 1; }
  to { opacity: 0; }
}

.custom-dialog-box {
  width: 600rpx;
  background: #fff;
  border-radius: 50rpx; /* 统一圆角，和 shop 页面一样 */
  padding: 70rpx 50rpx; /* 统一内边距，和 shop 页面一样 */
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15); /* 统一阴影，和 shop 页面一样 */
  animation: cartBoxPopIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) forwards; /* 统一动画名称 */
}
.custom-dialog-mask.closing .custom-dialog-box {
  animation: cartBoxShrinkOut 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards; /* 统一动画名称 */
}
@keyframes cartBoxPopIn {
  from { opacity: 0; transform: scale(0.88); }
  to { opacity: 1; transform: scale(1); }
}
@keyframes cartBoxShrinkOut {
  0% {
    transform: scale(1) translateY(0);
    opacity: 1;
    filter: blur(0);
  }
  100% {
    transform: scale(0.6) translateY(-60rpx);
    opacity: 0;
    filter: blur(12rpx);
  }
}

.cd-title {
  font-size: 34rpx;
  font-weight: 800;
  margin-bottom: 20rpx;
  color: #000;
}

.cd-content {
  font-size: 28rpx;
  color: #000;
  margin-bottom: 50rpx;
  line-height: 1.5;
  word-break: break-all;
}

.cd-btn-row {
  width: 100%;
  display: flex;
  gap: 30rpx;
}

.cd-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}

.cd-btn.cancel {
  background: #F5F5F7;
  color: #000;
}

.cd-btn.confirm {
  background: #000;
  color: #fff;
}

.cd-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

@keyframes popIn {
  from {
    transform: scale(0.9);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

