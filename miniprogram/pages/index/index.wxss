}

.auth-panel-new.closing {
  animation: authPanelOut 0.32s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}

@keyframes authPanelIn {
  from {
    opacity: 0;
    transform: translateY(36rpx) scale(0.94);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes authPanelOut {
  from {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  to {
    opacity: 0;
    transform: translateY(24rpx) scale(0.92);
  }
}

