<!-- 强制授权弹窗 (蓝牙/定位失败时显示) - 黑白风格 -->
<view class="custom-modal-mask {{authForceModalClosing ? 'closing' : ''}}" wx:if="{{showAuthForceModal || authForceModalClosing}}" catchtouchmove="noop" catchtap="noop">
  <view class="custom-modal-box" catchtouchmove="noop" catchtap="noop">
    <!-- 图标：使用 Unicode 字符，无需加载图片 -->
    <view class="modal-icon-new">📍</view>
    
    <!-- 标题 -->
    <view class="modal-title-new">需要必要权限</view>
    
    <!-- 内容 -->
    <view class="modal-content-new">
      <block wx:if="{{authMissingType === 'bluetooth'}}">
        <view class="content-main">请开启手机蓝牙功能以连接设备</view>
      </block>
      <block wx:if="{{authMissingType === 'location'}}">
        <view class="content-main">需要获取您的位置信息以提供服务</view>
      </block>
    </view>

    <!-- 按钮 -->
    <block wx:if="{{authMissingType === 'bluetooth'}}">
      <button class="modal-btn-new" bindtap="retryBluetooth">已开启，重试</button>
    </block>
    <block wx:if="{{authMissingType === 'location'}}">
      <button class="modal-btn-new" open-type="openSetting" bindopensetting="onOpenSettingResult">去设置开启</button>
    </block>
  </view>
</view>

<!-- 闲鱼/抖音：进入后首个须知弹窗（在加微信引导之前） -->
<view class="custom-modal-mask first-time-modal-mask {{xianyuWarningModalEnterReady ? 'first-time-modal-enter-ready' : ''}} {{xianyuWarningModalClosing ? 'closing' : ''}}" wx:if="{{showXianyuWarningModal}}" catchtouchmove="noop" catchtap="noop">
  <view class="custom-modal-box first-time-modal xianyu-notice-card" catchtouchmove="noop" catchtap="noop">
    <view class="first-time-icon">👋</view>
    <view class="first-time-title">领取访问口令</view>
    <view class="first-time-desc-wrap">
      <view class="first-time-desc-line xianyu-notice-lead-em">闲鱼 / 抖音用户：点「联系客服」领取访问口令</view>
      <view class="first-time-desc-line">微信用户若已有口令，可直接填写</view>
    </view>

    <view class="first-time-btns xianyu-notice-btns">
      <view class="xianyu-notice-progress" wx:if="{{!xianyuWarningActionReady}}">
        <view class="xianyu-notice-progress-track">
          <view class="xianyu-notice-progress-fill" style="width: {{xianyuWarningProgress}}%;"></view>
        </view>
        <text class="xianyu-notice-wait">{{xianyuWarningActionCountdown}} 秒后可继续</text>
      </view>
      <view
        class="first-time-btn primary {{xianyuWarningActionReady ? '' : 'is-disabled'}}"
        bindtap="closeXianyuWarningModal"
        hover-class="{{xianyuWarningActionReady ? 'first-time-btn-active' : ''}}"
        hover-start-time="10"
        hover-stay-time="70">
        {{xianyuWarningActionReady ? '联系客服' : '请稍候…'}}
      </view>
      <view
        class="first-time-btn secondary {{xianyuWarningActionReady ? '' : 'is-disabled'}}"
        bindtap="skipXianyuWarningToAccessCode"
        hover-class="{{xianyuWarningActionReady ? 'first-time-btn-active' : ''}}"
        hover-start-time="10"
        hover-stay-time="70">
        {{xianyuWarningActionReady ? '我已有口令' : '我已有口令…'}}
      </view>
    </view>
  </view>
</view>

<!-- 备用：企微客服打开失败时用复制号 / 扫码 -->
<view class="custom-modal-mask first-time-modal-mask {{firstTimeModalEnterReady ? 'first-time-modal-enter-ready' : ''}} {{firstTimeModalClosing ? 'closing' : ''}}" wx:if="{{showFirstTimeModal}}" catchtouchmove="noop" catchtap="noop">
  <view class="custom-modal-box first-time-modal" catchtouchmove="noop" catchtap="noop">
    <image class="first-time-qr-preload" src="/images/qrcode.jpg" mode="aspectFit" aria-hidden="true" />
    <view class="first-time-icon">✨</view>
    <view class="first-time-title">添加客服微信</view>
    <view class="first-time-desc-wrap">
      <view class="first-time-desc-line">长按二维码，或复制微信号添加</view>
      <view class="first-time-desc-line">添加后向客服领取访问口令</view>
    </view>
    <view class="qr-code-container">
      <image class="qr-code-image {{qrPressing ? 'is-pressing' : ''}}" src="/images/qrcode.jpg" mode="aspectFit" show-menu-by-longpress="{{true}}" bindtouchstart="onFirstTimeQrTouchStart" bindtouchend="onFirstTimeQrTouchEnd" bindtouchcancel="onFirstTimeQrTouchEnd" bindtap="saveFirstTimeQrcode" />
      <text class="qr-code-tip">长按识别 · 微信号：{{adminWechat}}</text>
    </view>
    
    <view class="first-time-btns">
      <view
        class="first-time-btn primary {{firstTimeActionReady ? '' : 'is-disabled'}}"
        bindtap="openPresalesKfFromGuide"
        hover-class="{{firstTimeActionReady ? 'first-time-btn-active' : ''}}"
        hover-start-time="10"
        hover-stay-time="70">
        {{firstTimeActionReady ? '联系客服' : '联系客服 (' + firstTimeActionCountdown + 's)'}}
      </view>
      <view
        class="first-time-btn secondary {{firstTimeActionReady ? '' : 'is-disabled'}}"
        bindtap="copyAdminWechat"
        hover-class="{{firstTimeActionReady ? 'first-time-btn-active' : ''}}"
        hover-start-time="10"
        hover-stay-time="70">
        {{copyWechatBusy ? '复制中...' : (firstTimeActionReady ? '复制微信号' : '复制微信号 (' + firstTimeActionCountdown + 's)')}}
      </view>
      <view
        class="first-time-btn secondary {{firstTimeActionReady ? '' : 'is-disabled'}}"
        bindtap="closeFirstTimeModal"
        hover-class="{{firstTimeActionReady ? 'first-time-btn-active' : ''}}"
        hover-start-time="10"
        hover-stay-time="70">
        {{firstTimeActionReady ? '已有口令，去填写' : '已有口令，去填写 (' + firstTimeActionCountdown + 's)'}}
      </view>
    </view>
  </view>
</view>

<!-- 昵称授权窗口：抖音/闲鱼引导关闭后再显示 -->
<view class="auth-mask {{nicknameUiClosing ? 'closing' : ''}}" wx:if="{{(!isAuthorized && isShowNicknameUI && !showFirstTimeModal && !showXianyuWarningModal) || nicknameUiClosing}}" catchtouchmove="noop">
  <view class="auth-panel-new {{nicknameUiClosing ? 'closing' : ''}}" catchtouchmove="noop">
    <view class="auth-icon-lock">✨</view>
    <view class="auth-title-new">开启专属体验</view>
    <view class="auth-subtitle-new">输入访问口令即可进入，无需邀请码</view>
    
    <view class="auth-input-wrapper auth-input-wrapper--main">
      <input type="text" class="auth-input-new" placeholder="VK 访问口令" bindinput="onNickNameInput" bindchange="onNickNameChange" value="{{inputNickName}}" maxlength="8"/>
    </view>

    <view wx:if="{{!showInviteCodeInput}}" class="auth-foot-link auth-foot-link--under-input" bindtap="openInviteCodeInput">有好友邀请码？点此填写（可不填，不影响进入）</view>
    <view wx:else class="auth-invite-expand auth-invite-expand--under-input">
      <view class="auth-invite-expand-head">
        <text class="auth-invite-expand-label">邀请有礼 · 可选</text>
        <text class="auth-invite-expand-close" catchtap="closeInviteCodeInput">收起</text>
      </view>
      <view class="auth-input-wrapper auth-invite-wrap">
        <input
          class="auth-input-new auth-input-invite {{inviteCodeInputInvalid ? 'is-invalid' : ''}}"
          placeholder="没有请留空"
          placeholder-class="auth-invite-placeholder"
          maxlength="9"
          bindinput="onInviteCodeInput"
          value="{{inputInviteCode}}"
        />
      </view>
      <text class="auth-invite-panel-tip">不填邀请码也能正常进入，仅用于邀请活动</text>
    </view>
    
    <view
      class="auth-btn-new {{isLoading ? 'auth-btn-loading' : ''}}"
      bindtap="handleLogin"
      hover-class="auth-btn-pressed"
      hover-start-time="10"
      hover-stay-time="80">
      {{isLoading ? '正在开启…' : '立即开启'}}
    </view>

    <view class="auth-foot">
      <text class="auth-foot-line">普通用户填 VK · 安装人员填 MT</text>
    </view>
  </view>
</view>

<!-- 主程序 (气泡按钮等) -->
<view class="page index-page {{step > 0 ? 'animating' : ''}} {{isAdminMode ? 'admin-active' : ''}}" wx:if="{{isAuthorized}}">
  <!-- 管理员模式：封禁用户列表 -->
  <view class="admin-mode-container" wx:if="{{isAdminMode}}">
    <!-- 顶部栏 -->
    <view class="admin-header">
      <view class="back-btn" bindtap="exitAdminMode">
        <text class="back-icon">←</text>
        <text class="back-text">返回</text>
      </view>
      <text class="admin-title">{{adminViewMode === 'nickname' ? '口令 / 昵称' : (adminViewMode === 'suspicious' ? '可疑人员处理' : (adminViewMode === 'suspiciousIgnored' ? '无视人员追溯' : (adminViewMode === 'bannedIgnored' ? '无视人员追溯' : (adminViewMode === 'suspiciousBanned' ? '可疑手动封禁留存' : (manualBannedMode ? '手动封禁处理' : '封禁管理')))))}}</text>
      <view class="header-capsule-spacer"></view>
    </view>

    <!-- 可疑人员：二级导航（避开右上角胶囊） -->
    <view wx:if="{{adminViewMode === 'suspicious'}}" class="admin-subnav">
      <view class="admin-subnav-btn" catchtap="goToIgnoredUsersFromHeader">无视人员追溯</view>
      <view class="admin-subnav-btn admin-subnav-btn--dark" catchtap="goToBannedUsersFromHeader">被封禁人员</view>
    </view>
    <view wx:elif="{{adminViewMode === 'banned'}}" class="admin-subnav admin-subnav--single">
      <view class="admin-subnav-btn" catchtap="goToBannedIgnoredUsersFromHeader">无视人员追溯</view>
    </view>
    <view wx:elif="{{adminViewMode === 'suspiciousIgnored' || adminViewMode === 'suspiciousBanned' || adminViewMode === 'bannedIgnored'}}" class="admin-subnav admin-subnav--single">
      <view class="admin-subnav-btn admin-subnav-btn--ghost" catchtap="{{adminViewMode === 'bannedIgnored' ? 'goBackToBannedFromHeader' : 'goBackToSuspiciousFromHeader'}}">← {{adminViewMode === 'bannedIgnored' ? '返回封禁列表' : '返回待处理列表'}}</view>
    </view>

    <!-- 昵称录入界面 -->
    <scroll-view
      class="admin-nickname-scroll"
      scroll-y
      wx:if="{{adminViewMode === 'nickname'}}"
      enhanced
      show-scrollbar="{{false}}">
      <view class="admin-nickname-container">
        <view class="admin-section-title">访问口令</view>
        <text class="admin-section-desc">一用户一码，生成后复制发给用户；用户首次登录即自动绑定</text>

        <view class="nickname-option">
          <view class="option-info">
            <text class="option-label">地域放行</text>
            <text class="option-desc">该口令用户不受地域拦截限制</text>
          </view>
          <switch
            checked="{{accessCodeBypassLocation}}"
            bindchange="toggleAccessCodeBypass"
            color="#000"
          />
        </view>

        <button
          class="nickname-submit-btn"
          bindtap="generateAccessCode"
          disabled="{{isGeneratingAccessCode}}"
        >
          {{isGeneratingAccessCode ? '生成中...' : '生成访问口令'}}
        </button>

        <view class="access-code-list-wrap">
          <view class="blocked-region-list-head">
            <text class="blocked-region-list-title">口令列表</text>
            <text class="blocked-region-list-count" wx:if="{{accessCodeList.length}}">共 {{accessCodeList.length}} 条</text>
          </view>
          <view wx:if="{{isLoadingAccessCodes}}" class="blocked-region-empty">加载中...</view>
          <view wx:elif="{{accessCodeList.length === 0}}" class="blocked-region-empty">暂无口令，点击上方生成</view>
          <view wx:else class="access-code-list">
            <view class="access-code-item" wx:for="{{accessCodeList}}" wx:key="_id">
              <view class="access-code-item-main">
                <text class="access-code-item-code">{{item.accessCode}}</text>
                <text class="access-code-item-status access-code-item-status--{{item.statusClass}}">{{item.statusLabel}}</text>
              </view>
              <view class="access-code-item-actions">
                <text class="access-code-item-btn" catchtap="copyAccessCode" data-code="{{item.accessCode}}">复制</text>
                <text wx:if="{{!item.bound}}" class="access-code-item-btn access-code-item-btn--danger" catchtap="revokeAccessCode" data-id="{{item._id}}" data-code="{{item.accessCode}}">作废</text>
              </view>
            </view>
          </view>
        </view>

        <view class="admin-section-divider"></view>

        <view class="admin-section-title">昵称录入</view>
        <text class="admin-section-desc">直接录入闲鱼/抖音昵称到白名单，用户可用昵称登录（旧版方式，与 VK 口令并存）</text>

        <input
          type="text"
          class="nickname-input"
          placeholder="输入用户昵称"
          value="{{adminNicknameInput}}"
          bindinput="onAdminNicknameInput"
          maxlength="32"
        />

        <view class="nickname-option">
          <view class="option-info">
            <text class="option-label">地域放行</text>
            <text class="option-desc">该昵称用户不受地域拦截限制</text>
          </view>
          <switch
            checked="{{nicknameBypassLocation}}"
            bindchange="toggleNicknameBypassLocation"
            color="#000"
          />
        </view>

        <button
          class="nickname-submit-btn"
          bindtap="submitAdminNickname"
          disabled="{{isSubmittingAdminNickname}}"
        >
          {{isSubmittingAdminNickname ? '提交中...' : '录入昵称'}}
        </button>

        <view class="admin-section-divider"></view>

        <view class="admin-section-title">封禁地址</view>
        <text class="admin-section-desc">选择需要拦截的地区，保存到 app_config.blocking_rules</text>

        <view class="nickname-option">
          <view class="option-info">
            <text class="option-label">地域拦截</text>
            <text class="option-desc">{{blockingRulesActive ? '已开启，命中地址将被拦截' : '已关闭（审核放行模式）'}}</text>
          </view>
          <switch
            checked="{{blockingRulesActive}}"
            bindchange="toggleBlockingRulesActive"
            color="#000"
          />
        </view>

        <picker mode="region" value="{{blockedRegionValue}}" bindchange="onBlockedRegionChange">
          <view class="blocked-region-picker">
            <view class="option-info">
              <text class="option-label">选择地区</text>
              <text class="option-desc">{{blockedRegionText || '点击选择省 / 市 / 区'}}</text>
            </view>
            <text class="blocked-region-picker-arrow">›</text>
          </view>
        </picker>

        <view class="nickname-option">
          <view class="option-info">
            <text class="option-label">拦截整市</text>
            <text class="option-desc">开启后只按城市拦截，不限区县</text>
          </view>
          <switch
            checked="{{blockedWholeCity}}"
            bindchange="toggleBlockedWholeCity"
            color="#000"
          />
        </view>

        <button
          class="nickname-submit-btn blocked-region-submit-btn"
          bindtap="submitBlockedRegion"
          disabled="{{isSubmittingBlockedRegion || isLoadingBlockedRegions}}"
        >
          {{isSubmittingBlockedRegion ? '保存中...' : '添加封禁地址'}}
        </button>

        <view class="blocked-region-list-wrap">
          <view class="blocked-region-list-head">
            <text class="blocked-region-list-title">已封禁地址</text>
            <text class="blocked-region-list-count" wx:if="{{blockedCitiesDisplay.length}}">共 {{blockedCitiesDisplay.length}} 条</text>
          </view>
          <view wx:if="{{isLoadingBlockedRegions}}" class="blocked-region-empty">加载中...</view>
          <view wx:elif="{{blockedCitiesDisplay.length === 0}}" class="blocked-region-empty">暂无封禁地址</view>
          <view wx:else class="blocked-region-list">
            <view class="blocked-region-item" wx:for="{{blockedCitiesDisplay}}" wx:key="index">
              <text class="blocked-region-item-label">{{item.label}}</text>
              <view
                class="blocked-region-item-remove"
                catchtap="removeBlockedRegion"
                data-index="{{item.index}}"
                data-city="{{item.city}}"
                data-district="{{item.district}}"
                data-label="{{item.label}}">
                移除
              </view>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>

    <!-- 封禁用户列表 -->
    <scroll-view
      class="admin-user-list"
      scroll-y
      wx:if="{{adminViewMode !== 'nickname'}}"
      enhanced
      show-scrollbar="{{false}}"
      enable-back-to-top="{{true}}"
      refresher-enabled="{{true}}"
      refresher-triggered="{{adminListRefreshing}}"
      bindrefresherrefresh="onAdminListRefresh">
      <block wx:if="{{adminViewMode === 'banned' || adminViewMode === 'suspiciousBanned'}}">
      <!-- 截图超限待审核 -->
      <view class="risk-review-section" wx:if="{{adminViewMode === 'banned' && screenshotRiskUsers.length > 0}}">
        <view class="risk-review-title">截图超限待审核（24小时≥3次）</view>
        <view class="admin-user-cards">
          <view class="admin-user-card risk-review-card" wx:for="{{screenshotRiskUsers}}" wx:key="_id" wx:for-index="ridx">
            <view class="user-card-header">
              <text class="user-nickname">用户: {{item._openid}}</text>
              <text class="user-ban-reason">待审核</text>
            </view>
            <view class="user-card-info">
              <view class="info-row">
                <text class="info-label">页面：</text>
                <text class="info-value">{{item.page}}</text>
              </view>
              <view class="info-row">
                <text class="info-label">当日次数：</text>
                <text class="info-value">{{item.dailyCount}}</text>
              </view>
              <view class="info-row">
                <text class="info-label">近1小时：</text>
                <text class="info-value">{{item.hourlyCount}}</text>
              </view>
            </view>
            <view class="user-card-actions">
              <view class="action-btn unban-btn" catchtap="handleScreenshotRiskDecision" data-risk-id="{{item._id}}" data-action="ignore">
                <text class="action-btn-text">放行</text>
              </view>
              <view class="action-btn retry-btn" catchtap="handleScreenshotRiskDecision" data-risk-id="{{item._id}}" data-action="ban">
                <text class="action-btn-text">封禁</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 加载中 -->
      <view wx:if="{{isLoadingBannedUsers}}" class="admin-loading">
        <text class="loading-dot">···</text>
      </view>

      <!-- 空状态 -->
      <view wx:elif="{{bannedUsers.length === 0}}" class="admin-empty">
        <text class="empty-icon">📭</text>
        <text class="empty-title">{{adminViewMode === 'suspiciousBanned' ? '暂无可疑手动封禁留存' : '暂无封禁用户'}}</text>
        <text class="empty-desc">{{adminViewMode === 'suspiciousBanned' ? '在可疑人员处理中手动封禁的用户会显示在这里' : '违规用户会自动显示在这里'}}</text>
      </view>

      <!-- 用户卡片列表 -->
      <view wx:else class="admin-user-cards">
        <view class="admin-user-card" wx:for="{{bannedUsers}}" wx:key="_id" wx:for-index="idx">
          <!-- 用户基本信息 -->
          <view class="user-card-header">
          </view>

          <!-- 详细信息 -->
          <view class="user-card-info">
            <view class="data-section">
              <view class="data-section-title">用户信息</view>
              <view class="data-chip data-chip-full">
                <text class="data-chip-k">昵称</text>
                <text class="data-chip-v">{{item.nickname}}</text>
              </view>
            </view>

            <view class="data-section">
              <view class="data-section-title">封禁信息</view>
              <view class="data-chip data-chip-full">
                <text class="data-chip-k">封禁原因</text>
                <text class="data-chip-v">{{item.banReasonText}}</text>
              </view>
              <view class="data-chip data-chip-full">
                <text class="data-chip-k">封禁页面</text>
                <text class="data-chip-v">{{item.banPageText}}</text>
              </view>
            </view>

            <view class="data-section">
              <view class="data-section-head">
                <text class="data-section-title">上报位置</text>
                <text class="data-gps-tag {{item.latitude && item.longitude ? 'on' : 'off'}}">{{item.latitude && item.longitude ? '含GPS' : '无GPS'}}</text>
              </view>
              <view class="data-chip-grid data-chip-grid-3">
                <view class="data-chip">
                  <text class="data-chip-k">省</text>
                  <text class="data-chip-v">{{item.province || '—'}}</text>
                </view>
                <view class="data-chip">
                  <text class="data-chip-k">市</text>
                  <text class="data-chip-v">{{item.city || '—'}}</text>
                </view>
                <view class="data-chip">
                  <text class="data-chip-k">区</text>
                  <text class="data-chip-v">{{item.district || '—'}}</text>
                </view>
              </view>
              <view class="data-chip data-chip-full">
                <text class="data-chip-k">详细门址</text>
                <text wx:if="{{item.address}}" class="data-chip-v data-chip-link" catchtap="handleAddressTap"
                  data-latitude="{{item.latitude}}" data-longitude="{{item.longitude}}" data-province="{{item.province}}" data-city="{{item.city}}" data-district="{{item.district}}" data-address="{{item.address}}" data-nickname="{{item.nickname}}">{{item.address}}</text>
                <text wx:else class="data-chip-v data-chip-muted">无（或未填写街道门牌）</text>
              </view>
              <view class="data-chip data-chip-full">
                <text class="data-chip-k">经纬度</text>
                <text wx:if="{{item.latitude && item.longitude}}" class="data-chip-v data-chip-link data-chip-mono" catchtap="handleAddressTap"
                  data-latitude="{{item.latitude}}" data-longitude="{{item.longitude}}" data-province="{{item.province}}" data-city="{{item.city}}" data-district="{{item.district}}" data-address="{{item.address}}" data-nickname="{{item.nickname}}">{{item.latitude}}, {{item.longitude}}</text>
                <text wx:else class="data-chip-v data-chip-muted">无定位坐标</text>
              </view>
              <view class="data-chip-map {{(item.latitude && item.longitude) || item.address || item.province || item.city || item.district ? '' : 'disabled'}}"
                catchtap="handleAddressTap"
                data-latitude="{{item.latitude}}" data-longitude="{{item.longitude}}" data-province="{{item.province}}" data-city="{{item.city}}" data-district="{{item.district}}" data-address="{{item.address}}" data-nickname="{{item.nickname}}">
                地图中查看此位置
              </view>
            </view>

            <view class="data-section" wx:if="{{item.phoneModel}}">
