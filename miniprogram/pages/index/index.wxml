<!-- 强制授权弹窗 (蓝牙/定位失败时显示) - 黑白风格 -->
<view class="custom-modal-mask {{authForceModalClosing ? 'closing' : ''}}" wx:if="{{showAuthForceModal || authForceModalClosing}}" catchtouchmove="noop" catchtap="noop">
  <view class="custom-modal-box" catchtouchmove="noop" catchtap="noop">
    <!-- 图标：使用 Unicode 字符，无需加载图片 -->
    <view class="modal-icon-new">📍</view>
    
    <!-- 标题 -->
    <view class="modal-title-new">需要必要权限</view>
    
    <!-- 内容 -->
    <view class="modal-content-new">
      <block wx:if="{{authMissingType === 'bluetooth'}}">
        <view class="content-main">请开启手机蓝牙功能以连接设备</view>
      </block>
      <block wx:if="{{authMissingType === 'location'}}">
        <view class="content-main">需要获取您的位置信息以提供服务</view>
      </block>
    </view>

    <!-- 按钮 -->
    <block wx:if="{{authMissingType === 'bluetooth'}}">
      <button class="modal-btn-new" bindtap="retryBluetooth">已开启，重试</button>
    </block>
    <block wx:if="{{authMissingType === 'location'}}">
      <button class="modal-btn-new" open-type="openSetting" bindopensetting="onOpenSettingResult">去设置开启</button>
    </block>
  </view>
</view>

<!-- 昵称授权窗口 (改为高级身份验证模式) -->
<view class="auth-mask {{nicknameUiClosing ? 'closing' : ''}}" wx:if="{{(!isAuthorized && isShowNicknameUI && !showFirstTimeModal) || nicknameUiClosing}}" catchtouchmove="noop">
  <view class="auth-panel-new {{nicknameUiClosing ? 'closing' : ''}}" catchtouchmove="noop">
    <view class="auth-icon-lock">✨</view>
    <view class="auth-title-new">开启专属体验</view>
    <view class="auth-subtitle-new">请输入访问口令，解锁更多精彩内容</view>
    
    <view class="auth-input-wrapper">
      <input type="nickname" class="auth-input-new" placeholder="点击下方微信昵称填入" bindinput="onNickNameInput" bindchange="onNickNameChange" value="{{inputNickName}}"/>
    </view>
    
    <view
      class="auth-btn-new {{isLoading ? 'auth-btn-loading' : ''}}"
      bindtap="handleLogin"
      hover-class="auth-btn-pressed"
      hover-start-time="10"
      hover-stay-time="80">
      {{isLoading ? '正在开启…' : '立即开启'}}
    </view>
    
    <view class="auth-hint-text">安装人员请在上方输入安装码以获得权限</view>
  </view>
</view>

<!-- 主程序 (气泡按钮等) -->
<view class="page index-page {{step > 0 ? 'animating' : ''}} {{isAdminMode ? 'admin-active' : ''}}" wx:if="{{isAuthorized}}">
  <!-- 管理员模式：封禁用户列表 -->
  <view class="admin-mode-container" wx:if="{{isAdminMode}}">
    <!-- 顶部栏 -->
    <view class="admin-header">
      <view class="back-btn" bindtap="exitAdminMode">
        <text class="back-icon">←</text>
        <text class="back-text">返回</text>
      </view>
      <text class="admin-title">{{adminViewMode === 'nickname' ? '昵称录入' : (adminViewMode === 'suspicious' ? '可疑人员处理' : (adminViewMode === 'suspiciousBanned' ? '可疑手动封禁留存' : (manualBannedMode ? '手动封禁处理' : '封禁管理')) )}}</text>
      <view wx:if="{{adminViewMode === 'suspicious'}}" class="header-shortcut-btn" catchtap="goToBannedUsersFromHeader">
        被封禁人员处理
      </view>
      <view wx:else class="header-placeholder"></view>
    </view>

    <!-- 昵称录入界面 -->
    <view class="admin-nickname-container" wx:if="{{adminViewMode === 'nickname'}}">
      <input 
        class="nickname-input" 
        type="text" 
        placeholder="输入昵称"
        value="{{nicknameInput}}"
        bindinput="onNicknameInput"
        maxlength="20"
      />
      
      <view class="nickname-option">
        <view class="option-info">
          <text class="option-label">地域放行</text>
          <text class="option-desc">不受地域拦截限制</text>
        </view>
        <switch 
          checked="{{nicknameBypassLocation}}"
          bindchange="toggleNicknameBypass"
          color="#000"
        />
      </view>
      
      <button 
        class="nickname-submit-btn" 
        bindtap="submitNickname"
        disabled="{{isSubmittingNickname || !nicknameInput}}"
      >
        {{isSubmittingNickname ? '提交中...' : '添加'}}
      </button>
    </view>

    <!-- 封禁用户列表 -->
    <scroll-view
      class="admin-user-list"
      scroll-y
      wx:if="{{adminViewMode !== 'nickname'}}"
      enhanced
      show-scrollbar="{{false}}"
      enable-back-to-top="{{true}}"
      refresher-enabled="{{true}}"
      refresher-triggered="{{adminListRefreshing}}"
      bindrefresherrefresh="onAdminListRefresh">
      <block wx:if="{{adminViewMode === 'banned' || adminViewMode === 'suspiciousBanned'}}">
      <!-- 截图超限待审核 -->
      <view class="risk-review-section" wx:if="{{adminViewMode === 'banned' && screenshotRiskUsers.length > 0}}">
        <view class="risk-review-title">截图超限待审核（24小时≥3次）</view>
        <view class="admin-user-cards">
          <view class="admin-user-card risk-review-card" wx:for="{{screenshotRiskUsers}}" wx:key="_id" wx:for-index="ridx">
            <view class="user-card-header">
              <text class="user-nickname">用户: {{item._openid}}</text>
              <text class="user-ban-reason">待审核</text>
            </view>
            <view class="user-card-info">
              <view class="info-row">
                <text class="info-label">页面：</text>
                <text class="info-value">{{item.page}}</text>
              </view>
              <view class="info-row">
                <text class="info-label">当日次数：</text>
                <text class="info-value">{{item.dailyCount}}</text>
              </view>
              <view class="info-row">
                <text class="info-label">近1小时：</text>
                <text class="info-value">{{item.hourlyCount}}</text>
              </view>
            </view>
            <view class="user-card-actions">
              <view class="action-btn unban-btn" catchtap="handleScreenshotRiskDecision" data-risk-id="{{item._id}}" data-action="ignore">
                <text class="action-btn-text">放行</text>
              </view>
              <view class="action-btn retry-btn" catchtap="handleScreenshotRiskDecision" data-risk-id="{{item._id}}" data-action="ban">
                <text class="action-btn-text">封禁</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 加载中 -->
      <view wx:if="{{isLoadingBannedUsers}}" class="admin-loading">
        <text class="loading-dot">···</text>
      </view>

      <!-- 空状态 -->
      <view wx:elif="{{bannedUsers.length === 0}}" class="admin-empty">
        <text class="empty-icon">📭</text>
        <text class="empty-title">{{adminViewMode === 'suspiciousBanned' ? '暂无可疑手动封禁留存' : '暂无封禁用户'}}</text>
        <text class="empty-desc">{{adminViewMode === 'suspiciousBanned' ? '在可疑人员处理中手动封禁的用户会显示在这里' : '违规用户会自动显示在这里'}}</text>
      </view>

      <!-- 用户卡片列表 -->
      <view wx:else class="admin-user-cards">
        <view class="admin-user-card" wx:for="{{bannedUsers}}" wx:key="_id" wx:for-index="idx">
          <!-- 用户基本信息 -->
          <view class="user-card-header">
          </view>

          <!-- 详细信息 -->
          <view class="user-card-info">
            <view class="data-section">
              <view class="data-section-title">用户信息</view>
              <view class="data-chip data-chip-full">
                <text class="data-chip-k">昵称</text>
                <text class="data-chip-v">{{item.nickname}}</text>
              </view>
            </view>

            <view class="data-section">
              <view class="data-section-title">封禁信息</view>
              <view class="data-chip data-chip-full">
                <text class="data-chip-k">封禁原因</text>
                <text class="data-chip-v">{{item.banReasonText}}</text>
              </view>
              <view class="data-chip data-chip-full">
                <text class="data-chip-k">封禁页面</text>
                <text class="data-chip-v">{{item.banPageText}}</text>
              </view>
            </view>

            <view class="data-section">
              <view class="data-section-head">
                <text class="data-section-title">上报位置</text>
                <text class="data-gps-tag {{item.latitude && item.longitude ? 'on' : 'off'}}">{{item.latitude && item.longitude ? '含GPS' : '无GPS'}}</text>
              </view>
              <view class="data-chip-grid data-chip-grid-3">
                <view class="data-chip">
                  <text class="data-chip-k">省</text>
                  <text class="data-chip-v">{{item.province || '—'}}</text>
                </view>
                <view class="data-chip">
                  <text class="data-chip-k">市</text>
                  <text class="data-chip-v">{{item.city || '—'}}</text>
                </view>
                <view class="data-chip">
                  <text class="data-chip-k">区</text>
                  <text class="data-chip-v">{{item.district || '—'}}</text>
                </view>
              </view>
              <view class="data-chip data-chip-full">
                <text class="data-chip-k">详细门址</text>
                <text wx:if="{{item.address}}" class="data-chip-v data-chip-link" catchtap="handleAddressTap"
                  data-latitude="{{item.latitude}}" data-longitude="{{item.longitude}}" data-province="{{item.province}}" data-city="{{item.city}}" data-district="{{item.district}}" data-address="{{item.address}}" data-nickname="{{item.nickname}}">{{item.address}}</text>
                <text wx:else class="data-chip-v data-chip-muted">无（或未填写街道门牌）</text>
              </view>
              <view class="data-chip data-chip-full">
                <text class="data-chip-k">经纬度</text>
                <text wx:if="{{item.latitude && item.longitude}}" class="data-chip-v data-chip-link data-chip-mono" catchtap="handleAddressTap"
                  data-latitude="{{item.latitude}}" data-longitude="{{item.longitude}}" data-province="{{item.province}}" data-city="{{item.city}}" data-district="{{item.district}}" data-address="{{item.address}}" data-nickname="{{item.nickname}}">{{item.latitude}}, {{item.longitude}}</text>
                <text wx:else class="data-chip-v data-chip-muted">无定位坐标</text>
              </view>
              <view class="data-chip-map {{(item.latitude && item.longitude) || item.address || item.province || item.city || item.district ? '' : 'disabled'}}"
                catchtap="handleAddressTap"
                data-latitude="{{item.latitude}}" data-longitude="{{item.longitude}}" data-province="{{item.province}}" data-city="{{item.city}}" data-district="{{item.district}}" data-address="{{item.address}}" data-nickname="{{item.nickname}}">
                地图中查看此位置
              </view>
            </view>

            <view class="data-section" wx:if="{{item.phoneModel}}">
              <view class="data-section-title">设备信息</view>
              <view class="data-chip data-chip-full">
                <text class="data-chip-k">设备</text>
                <text class="data-chip-v">{{item.phoneModel}}</text>
              </view>
            </view>

            <view class="data-section">
              <view class="data-section-title">访问统计</view>
              <view class="data-chip-grid data-chip-grid-2">
                <view class="data-chip">
                  <text class="data-chip-k">总访问</text>
                  <text class="data-chip-v">{{item.totalVisits}}次</text>
                </view>
                <view class="data-chip">
                  <text class="data-chip-k">失败次数</text>
                  <text class="data-chip-v">{{item.failCount || 0}}次</text>
                </view>
              </view>
              <view class="data-chip data-chip-full">
                <text class="data-chip-k">封禁时间</text>
                <text class="data-chip-v">{{item.updateTime}}</text>
              </view>
            </view>
          </view>

          <!-- 操作按钮 -->
          <view class="user-card-actions">
            <!-- 🔴 昵称验证失败时显示"重试"按钮 -->
            <view class="action-btn retry-btn" wx:if="{{item.banReason === 'nickname_verify_fail'}}" catchtap="retryNickname" data-button-id="{{item._id}}" data-index="{{idx}}" data-nickname="{{item.nickname}}">
              <text class="action-btn-text">重试</text>
            </view>
            <view class="action-btn unban-btn" catchtap="unbanUser" data-button-id="{{item._id}}" data-index="{{idx}}" data-ban-reason="{{item.banReason}}" data-openid="{{item._openid}}" data-nickname="{{item.nickname}}">
              <text class="action-btn-text">放行</text>
            </view>
          </view>
        </view>
      </view>
      </block>

      <block wx:elif="{{adminViewMode === 'suspicious'}}">
        <view wx:if="{{isLoadingSuspiciousUsers}}" class="admin-loading">
          <text class="loading-dot">···</text>
        </view>
        <view wx:elif="{{suspiciousUsers.length === 0}}" class="admin-empty">
          <text class="empty-icon">🕵️</text>
          <text class="empty-title">暂无可疑人员</text>
          <text class="empty-desc">命中规则：截图行为 / 多次进入（≥3次）/ 长时间停留（>1分钟）</text>
        </view>
        <view wx:else class="admin-user-cards">
          <view class="admin-user-card" wx:for="{{suspiciousUsers}}" wx:key="rowKey" wx:for-index="sidx">
            <view class="user-card-info">
              <view class="data-section">
                <view class="data-section-title">用户信息</view>
                <view class="data-chip data-chip-full">
                  <text class="data-chip-k">用户昵称</text>
                  <text class="data-chip-v">{{item.viewerNickname}}</text>
                </view>
                <view class="data-chip data-chip-full">
                  <text class="data-chip-k">来源</text>
                  <text class="data-chip-v">{{item.creatorNickname}}</text>
                </view>
                <view class="data-chip data-chip-full">
                  <text class="data-chip-k">访问类型</text>
                  <text class="data-chip-v">{{item.shareCode}}</text>
                </view>
                <view class="data-chip data-chip-full">
                  <text class="data-chip-k">触发原因</text>
                  <text class="data-chip-v">{{item.triggerReasonText}}</text>
                </view>
              </view>

              <view class="data-section">
                <view class="data-section-title">行为统计</view>
                <view class="data-chip-grid data-chip-grid-2">
                  <view class="data-chip">
                    <text class="data-chip-k">进入次数</text>
                    <text class="data-chip-v">{{item.enterCount}}次</text>
                  </view>
                  <view class="data-chip">
                    <text class="data-chip-k">总停留</text>
                    <text class="data-chip-v">{{item.totalStayMinutesText}}分</text>
                  </view>
                  <view class="data-chip">
                    <text class="data-chip-k">视频停留</text>
                    <text class="data-chip-v">{{item.totalVideoMinutesText}}分</text>
                  </view>
                  <view class="data-chip">
                    <text class="data-chip-k">页面访问</text>
                    <text class="data-chip-v">{{item.sectionClicksTotal}}次</text>
                  </view>
                </view>
                <view class="data-chip data-chip-full">
                  <text class="data-chip-k">最近进入</text>
                  <text class="data-chip-v">{{item.lastViewTime}}</text>
                </view>
                <view class="data-chip data-chip-full">
                  <text class="data-chip-k">页面访问明细</text>
                  <view wx:if="{{item.pageVisitsDetailList && item.pageVisitsDetailList.length}}" class="visit-detail-list">
                    <view class="visit-detail-item" wx:for="{{item.pageVisitsDetailList}}" wx:key="pageKey">
                      <text class="visit-detail-name">{{item.pageName}}</text>
                      <text class="visit-detail-count">{{item.count}}次</text>
                    </view>
                  </view>
                  <text wx:else class="data-chip-v data-chip-muted">暂无页面访问记录</text>
                </view>
              </view>

              <view class="data-section">
                <view class="data-section-head">
                  <text class="data-section-title">上报位置</text>
                  <text class="data-gps-tag {{item.latitude && item.longitude ? 'on' : 'off'}}">{{item.latitude && item.longitude ? '含GPS' : '无GPS'}}</text>
                </view>
                <view class="data-chip data-chip-full">
                  <text class="data-chip-k">地区</text>
                  <text class="data-chip-v">{{item.regionText}}</text>
                </view>
                <view class="data-chip data-chip-full">
                  <text class="data-chip-k">详细地址</text>
                  <text wx:if="{{item.address}}" class="data-chip-v data-chip-link" catchtap="handleAddressTap"
                    data-latitude="{{item.latitude}}" data-longitude="{{item.longitude}}" data-province="{{item.province}}" data-city="{{item.city}}" data-district="{{item.district}}" data-address="{{item.address}}" data-nickname="{{item.viewerNickname}}">{{item.addressDisplay}}</text>
                  <text wx:else class="data-chip-v data-chip-muted">—</text>
                </view>
                <view class="data-chip data-chip-full">
                  <text class="data-chip-k">经纬度</text>
                  <text wx:if="{{item.latitude && item.longitude}}" class="data-chip-v data-chip-link data-chip-mono" catchtap="handleAddressTap"
                    data-latitude="{{item.latitude}}" data-longitude="{{item.longitude}}" data-province="{{item.province}}" data-city="{{item.city}}" data-district="{{item.district}}" data-address="{{item.address}}" data-nickname="{{item.viewerNickname}}">{{item.geoText}}</text>
                  <text wx:else class="data-chip-v data-chip-muted">无定位坐标</text>
                </view>
                <view class="data-chip-map {{(item.latitude && item.longitude) || item.address || item.province || item.city || item.district ? '' : 'disabled'}}"
                  catchtap="handleAddressTap"
                  data-latitude="{{item.latitude}}" data-longitude="{{item.longitude}}" data-province="{{item.province}}" data-city="{{item.city}}" data-district="{{item.district}}" data-address="{{item.address}}" data-nickname="{{item.viewerNickname}}">
                  地图中查看此位置
                </view>
              </view>
            </view>
            <view class="user-card-actions">
              <view class="action-btn unban-btn" catchtap="handleSuspiciousDecision" data-action="ignore" data-risk-id="{{item.riskId}}" data-source-type="{{item.sourceType}}" data-viewer-openid="{{item.viewerOpenid}}" data-viewer-nickname="{{item.viewerNickname}}" data-row-key="{{item.rowKey}}" data-province="{{item.province}}" data-city="{{item.city}}" data-district="{{item.district}}" data-address="{{item.address}}" data-latitude="{{item.latitude}}" data-longitude="{{item.longitude}}">
                <text class="action-btn-text">无视</text>
              </view>
              <view class="action-btn retry-btn" catchtap="handleSuspiciousDecision" data-action="ban" data-risk-id="{{item.riskId}}" data-source-type="{{item.sourceType}}" data-viewer-openid="{{item.viewerOpenid}}" data-viewer-nickname="{{item.viewerNickname}}" data-row-key="{{item.rowKey}}" data-province="{{item.province}}" data-city="{{item.city}}" data-district="{{item.district}}" data-address="{{item.address}}" data-latitude="{{item.latitude}}" data-longitude="{{item.longitude}}">
                <text class="action-btn-text">封禁</text>
              </view>
            </view>
          </view>
        </view>
      </block>
    </scroll-view>

    <!-- 底部切换栏 -->
    <view class="admin-bottom-tabs">
      <view class="tab-item {{adminViewMode === 'banned' ? 'active' : ''}}" bindtap="switchAdminTab" data-mode="banned">
        <text class="tab-text">封禁列表</text>
      </view>
      <view class="tab-item {{adminViewMode === 'suspicious' || adminViewMode === 'suspiciousBanned' ? 'active' : ''}}" bindtap="switchAdminTab" data-mode="suspicious">
        <text class="tab-text">可疑人员处理</text>
      </view>
      <view class="tab-item {{adminViewMode === 'nickname' ? 'active' : ''}}" bindtap="switchAdminTab" data-mode="nickname">
        <text class="tab-text">昵称录入</text>
      </view>
    </view>
  </view>

  <!-- 正常模式：原有内容 -->
  <block wx:if="{{!isAdminMode}}">
    <!-- 顶部标题 -->
    <view class="header-section {{step > 0 ? 'fade-out' : ''}}" catchtap="onAdminTap">
      <view class="title-wrap">
        <text class="brand">MT-摩改社</text>
      </view>
    </view>

    <!-- 舞台区域 -->
    <view class="hero-section">
      <!-- 中间标题 -->
      <view class="center-title {{step > 0 ? 'fade-out' : ''}}">
        <text class="sub-title">MT-摩改社</text>
      </view>
      
      <!-- 文字 -->
      <view class="text-track" wx:if="{{step >= 3}}">
        <text class="char char-1">M</text>
        <text class="char char-2">T</text>
        <text class="char char-3">用</text>
        <text class="char char-4">心</text>
        <text class="char char-5">服</text>
        <text class="char char-6">务</text>
        <text class="char char-7">每</text>
        <text class="char char-8">一</text>
        <text class="char char-9">位</text>
        <text class="char char-10">用</text>
        <text class="char char-11">户</text>
      </view>
      <!-- 按钮 -->
      <view class="liquid-btn {{step >= 1 ? 'expanded-light' : ''}}" bindtap="handleAccess">
        <view class="gear-shape"><view class="teeth"></view><view class="hub"></view></view>
        <view class="highlight-dot"></view>
        <text class="btn-text" wx:if="{{step === 0}}">MT  RIDE</text>
      </view>
    </view>
    

    <view class="curtain-mask {{step >= 5 ? 'active' : ''}}"></view>
  </block>
</view>

<!-- 【新增】强制授权弹窗 - 黑白风格 -->
<view class="custom-modal-mask {{authModalClosing ? 'closing' : ''}}" wx:if="{{showAuthModal || authModalClosing}}" catchtouchmove="noop" catchtap="noop">
  <view class="custom-modal-box" catchtouchmove="noop" catchtap="noop">
    <!-- 图标：使用 Unicode 字符，无需加载图片 -->
    <view class="modal-icon-new">📍</view>
    
    <!-- 标题 -->
    <view class="modal-title-new">需要位置权限</view>
    
    <!-- 内容 -->
    <view class="modal-content-new">
      <view class="content-main">为了检测当前区域服务可用性及展示附近门店，请允许获取您的位置信息。</view>
    </view>

    <!-- 按钮 -->
    <button class="modal-btn-new" open-type="openSetting" bindopensetting="onOpenSetting">
      去设置开启
    </button>
  </view>
</view>

<!-- 【全局通用】自定义黑白极简弹窗 - 错误类型 -->
<view class="custom-modal-mask {{customErrorModalClosing ? 'closing' : ''}}" wx:if="{{showCustomErrorModal || customErrorModalClosing}}" catchtouchmove="noop" bindtap="dismissTransientModals">
  <view class="custom-modal-box" catchtouchmove="noop" bindtap="dismissTransientModals">
    
    <!-- 1. 图标：使用 CSS 绘制的圆形图标，无需加载图片 -->
    <view class="modal-icon-new error-icon">
      <view class="error-circle">!</view>
    </view>
    
    <!-- 2. 标题 -->
    <view class="modal-title-new">验证未通过</view>
    
    <!-- 3. 内容 -->
    <view class="modal-content-new">
      <view class="content-main">该昵称暂未获得授权</view>
      <view class="content-sub">建议点击一键填写确保准确</view>
    </view>

    <!-- 4. 按钮：纯黑风格 -->
    <button class="modal-btn-new" bindtap="handleCopyFromModal">
      复制管理员微信号
    </button>
  </view>
</view>

<!-- 【全局通用】自定义黑白极简弹窗 - 成功类型（统一使用 copy-success-modal 样式） -->
<view class="custom-modal-mask {{customSuccessModalClosing ? 'closing' : ''}}" wx:if="{{showCustomSuccessModal || customSuccessModalClosing}}" catchtouchmove="noop" bindtap="dismissTransientModals">
  <view class="custom-modal-box copy-success-modal" catchtouchmove="noop" bindtap="dismissTransientModals">
    <!-- 图标：使用 Unicode 字符 -->
    <view class="modal-icon-new success-icon">✓</view>
    <!-- 标题 -->
    <view class="modal-title-new">{{successModalTitle}}</view>
  </view>
</view>

<!-- 【新增】自定义二次确认弹窗 - 白底黑字 -->
<view class="custom-modal-mask {{confirmModalClosing ? 'closing' : ''}}" wx:if="{{showConfirmModal || confirmModalClosing}}" catchtouchmove="noop" bindtap="dismissTransientModals">
  <view class="custom-modal-box confirm-modal" catchtouchmove="noop" bindtap="dismissTransientModals">
    <view class="modal-title-new">确认操作</view>
    <view class="modal-content-new">
      <view class="content-main">{{confirmModalContent}}</view>
    </view>
    <view class="modal-btns-row">
      <view class="modal-btn-cancel" bindtap="hideConfirmModal">取消</view>
      <view class="modal-btn-confirm" bindtap="handleConfirmAction">确定</view>
    </view>
  </view>
</view>

<!-- 【新增】首次进入提示弹窗（遮罩 + 卡片用 transition，关闭用 closing 关键帧） -->
<view class="custom-modal-mask first-time-modal-mask {{firstTimeModalEnterReady ? 'first-time-modal-enter-ready' : ''}} {{firstTimeModalClosing ? 'closing' : ''}}" wx:if="{{showFirstTimeModal}}" catchtouchmove="noop" catchtap="noop">
  <view class="custom-modal-box first-time-modal" catchtouchmove="noop" catchtap="noop">
    <!-- 弹窗出现即解码同一张图，复制后再展示区域时不必等首包 -->
    <image class="first-time-qr-preload" src="/images/qrcode.jpg" mode="aspectFit" aria-hidden="true" />
    <view class="first-time-icon">✨</view>
    <view class="first-time-title">开启专属体验</view>
    <view class="first-time-desc">如果您是在抖音或闲鱼添加的用户，请添加管理员微信录入昵称</view>
    
    <!-- 二维码显示区域 -->
    <view class="qr-code-container" wx:if="{{showWechatQRCode}}">
      <image class="qr-code-image {{qrPressing ? 'is-pressing' : ''}}" src="/images/qrcode.jpg" mode="aspectFit" bindtouchstart="onFirstTimeQrTouchStart" bindtouchend="onFirstTimeQrTouchEnd" bindtouchcancel="onFirstTimeQrTouchEnd" bindtap="saveFirstTimeQrcode" />
      <text class="qr-code-tip">扫描二维码添加管理员微信</text>
      <text class="qr-code-wechat">微信号：{{adminWechat}}</text>
    </view>
    
    <!-- 按钮区域 -->
    <view class="first-time-btns">
      <view class="first-time-btn primary" bindtap="copyAdminWechat" hover-class="first-time-btn-active" hover-start-time="10" hover-stay-time="70">
        {{copyWechatBusy ? '复制中...' : '点击复制微信号'}}
      </view>
      <view class="first-time-btn secondary" wx:if="{{showWechatQRCode}}" bindtap="toggleQRCode">
        收起二维码
      </view>
    </view>
  </view>
</view>

<!-- 【全局通用】「内容已复制」须叠在所有页面弹窗之上，故放 DOM 后部 + 专用 z-index -->
<view class="custom-modal-mask copy-success-modal-mask {{copySuccessModalClosing ? 'closing' : ''}}" wx:if="{{showCopySuccessModal || copySuccessModalClosing}}" catchtouchmove="noop" bindtap="dismissTransientModals">
  <view class="custom-modal-box copy-success-modal" catchtouchmove="noop" bindtap="dismissTransientModals">
    <view class="modal-icon-new success-icon">✓</view>
    <view class="modal-title-new">内容已复制</view>
  </view>
</view>

<!-- 自定义加载中动画（使用 my 页面的样式） -->
<view class="loading-mask" wx:if="{{showLoadingAnimation}}">
  <view class="loader">
    <text class="loader-label">{{loadingText}}</text>
    <view class="loading-bar"></view>
  </view>
</view>

<!-- ================= 自定义弹窗（替换 wx.showModal） ================= -->
<view class="custom-dialog-mask {{dialogClosing ? 'closing' : ''}}" wx:if="{{dialog.show}}" bindtap="dismissTransientModals" catchtouchmove="noop">
  <view class="custom-dialog-box" bindtap="dismissTransientModals" catchtouchmove="noop">
    <view class="cd-title">{{dialog.title}}</view>
    <view class="cd-content">{{dialog.content}}</view>
    <view class="cd-btn-row">
      <view class="cd-btn cancel" wx:if="{{dialog.showCancel}}" bindtap="closeCustomDialog">{{dialog.cancelText || '取消'}}</view>
      <view class="cd-btn confirm" bindtap="onDialogConfirm">{{dialog.confirmText || '确定'}}</view>
    </view>
  </view>
</view>

<!-- 定位权限提示弹窗（白底黑字） -->
<view class="custom-modal-mask {{showLocationPermissionModal ? 'active' : ''}} {{locationPermissionModalClosing ? 'closing' : ''}}" wx:if="{{showLocationPermissionModal || locationPermissionModalClosing}}" catchtouchmove="noop" catchtap="noop">
  <view class="custom-modal-box location-permission-modal" catchtouchmove="noop" catchtap="noop">
    <view class="modal-icon-new">📍</view>
    <view class="modal-title-new">需要定位权限</view>
    <view class="modal-content-new">
      <view class="content-main">请在设置中允许小程序获取位置信息</view>
    </view>
    <view class="modal-btns-row">
      <view class="modal-btn-cancel" bindtap="hideLocationPermissionModal">暂不</view>
      <view class="modal-btn-confirm" bindtap="openLocationSetting">去设置</view>
    </view>
  </view>
</view>

<!-- 全局自定义弹窗组件 -->
<custom-toast id="custom-toast" />
