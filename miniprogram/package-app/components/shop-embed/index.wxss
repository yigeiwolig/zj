@import "../../pages/shop/shop.wxss";
@import "../../../styles/hub-embed-portal.wxss";

.shop-embed-root {
  height: 100%;
  width: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f5f5f7;
  box-sizing: border-box;
}

.shop-embed-root .container,
.shop-embed-root .container--hub-embed {
  flex: 1;
  min-height: 0;
  height: 100%;
  width: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
  position: relative;
  background: #f5f5f7;
}

.shop-embed-root .shop-hub-loading {
  padding: 80rpx 32rpx;
  text-align: center;
}

.shop-embed-root .shop-hub-loading-text {
  font-size: 28rpx;
  color: rgba(60, 60, 67, 0.55);
}

.shop-embed-root .shop-sections,
.shop-embed-root .shop-section,
.shop-embed-root .hero-swiper-box,
.shop-embed-root .shop-series-swiper {
  width: 100%;
  box-sizing: border-box;
}

