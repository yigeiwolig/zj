@import "../../pages/my/my.wxss";

.pending-repair-list-root {
  width: 100%;
  box-sizing: border-box;
  padding: 0 28rpx calc(160rpx + env(safe-area-inset-bottom));
}

.pending-repair-list-root .pr-card:last-child {
  margin-bottom: 0;
}

.pending-repair-list-root .pr-card {
  position: relative;
  margin: 0 0 20rpx;
  border-radius: 28rpx;
  background: #fff;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.05);
  overflow: hidden;
  transition: transform 0.32s cubic-bezier(0.22, 1, 0.36, 1),
    margin 0.32s cubic-bezier(0.22, 1, 0.36, 1),
    box-shadow 0.32s ease;
  transform-origin: top center;
}

.pending-repair-list-root .pr-card--stacked {
  margin-bottom: -56rpx;
  transform: scale(0.985);
}

.pending-repair-list-root .pr-card--open {
  margin-bottom: 24rpx;
  transform: scale(1);
  box-shadow: 0 16rpx 40rpx rgba(15, 23, 42, 0.1);
}

.pending-repair-list-root .pr-card-head {
  position: relative;
  padding: 28rpx;
}

.pending-repair-list-root .pr-card-head-body {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.pending-repair-list-root .pr-card-head-left {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.pending-repair-list-root .pr-card-model {
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
  line-height: 1.15;
}

.pending-repair-list-root .pr-card-sub {
  font-size: 22rpx;
  color: #94a3b8;
  font-weight: 500;
}

.pending-repair-list-root .pr-card-desc-preview {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #64748b;
  font-style: italic;
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pending-repair-list-root .pr-card-head-right {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.pending-repair-list-root .pr-status-pill {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #f8fafc;
}

.pending-repair-list-root .pr-status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: currentColor;
}

.pending-repair-list-root .pr-status-text {
  font-size: 22rpx;
  font-weight: 700;
}

.pending-repair-list-root .pr-status-pill--pending {
  color: #64748b;
  background: #f1f5f9;
}

.pending-repair-list-root .pr-status-pill--diagnosed {
  color: #1d4ed8;
  background: #eff6ff;
}

.pending-repair-list-root .pr-status-pill--sent {
  color: #b45309;
  background: #fffbeb;
}

.pending-repair-list-root .pr-status-pill--done {
  color: #15803d;
  background: #f0fdf4;
}

.pending-repair-list-root .pr-card-chevron {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.28s ease, background 0.28s ease;
}

.pending-repair-list-root .pr-card-chevron--open {
  transform: rotate(90deg);
  background: #e2e8f0;
}

.pending-repair-list-root .pr-card-chevron-icon {
  font-size: 32rpx;
  font-weight: 700;
  color: #64748b;
  line-height: 1;
  margin-top: -2rpx;
}

.pending-repair-list-root .pr-card-body {
  border-top: 1rpx solid #f1f5f9;
  animation: prCardBodyIn 0.34s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes prCardBodyIn {
  from {
    opacity: 0;
    transform: translateY(-12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.pending-repair-list-root .pr-card-body-inner {
  padding-bottom: 8rpx;
}

.pending-repair-list-root .pr-media {
  width: 100%;
  height: 360rpx;
  background: #1c1c1e;
  display: block;
}

.pending-repair-list-root .pr-media--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
}

.pending-repair-list-root .pr-info {
  padding: 28rpx 28rpx 20rpx;
}

.pending-repair-list-root .pr-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.pending-repair-list-root .pr-title {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  font-weight: 700;
  color: #1d1d1f;
}

.pending-repair-list-root .pr-variant-mark {
  font-weight: 600;
}

.pending-repair-list-root .pr-ship-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.pending-repair-list-root .pr-ship-badge {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  font-weight: 800;
  color: #fff;
}

.pending-repair-list-root .pr-ship-badge--sf {
  background: #1d1d1f;
}

.pending-repair-list-root .pr-ship-badge--zto {
  background: #2563eb;
}

.pending-repair-list-root .pr-ship-label {
  font-size: 22rpx;
  color: #64748b;
  font-weight: 600;
}

.pending-repair-list-root .pr-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
  font-style: italic;
  line-height: 1.5;
}

.pending-repair-list-root .pr-addr-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.pending-repair-list-root .pr-addr {
  flex: 1;
  font-size: 26rpx;
  color: #8e8e93;
  line-height: 1.5;
  word-break: break-all;
}

.pending-repair-list-root .pr-copy-btn {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  background: #e5e5ea;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.pending-repair-list-root .pr-warranty {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
}

.pending-repair-list-root .pr-warranty--normal {
  background: #f0fdf4;
}

.pending-repair-list-root .pr-warranty--expired {
  background: #fef2f2;
}

.pending-repair-list-root .pr-warranty-tag {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
}

.pending-repair-list-root .pr-warranty--normal .pr-warranty-tag {
  color: #15803d;
}

.pending-repair-list-root .pr-warranty--expired .pr-warranty-tag {
  color: #dc2626;
}

.pending-repair-list-root .pr-warranty-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #64748b;
}

.pending-repair-list-root .pr-warranty-banner {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: #fff7ed;
  font-size: 22rpx;
  color: #c2410c;
  line-height: 1.5;
}

.pending-repair-list-root .pr-status-block {
  margin: 16rpx 28rpx;
  padding: 20rpx;
  background: #f5f5f7;
  border-radius: 12rpx;
}

.pending-repair-list-root .pr-status-line {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.pending-repair-list-root .pr-tracking {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #64748b;
}

.pending-repair-list-root .pr-actions {
  padding: 8rpx 28rpx 28rpx;
}

.pending-repair-list-root .pr-actions-primary,
.pending-repair-list-root .pr-actions-grid,
.pending-repair-list-root .pr-actions-wecom,
.pending-repair-list-root .pr-actions-delete {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.pending-repair-list-root .pr-actions-primary {
  flex-direction: column;
}

.pending-repair-list-root .pr-actions-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
}

.pending-repair-list-root .pr-btn {
  box-sizing: border-box;
  min-height: 80rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}

.pending-repair-list-root .pr-btn--full {
  grid-column: 1 / -1;
}

.pending-repair-list-root .pr-btn--diagnosis,
.pending-repair-list-root .pr-btn--ship {
  width: 100%;
}

.pending-repair-list-root .pr-btn--diagnosis {
  background: #fff;
  border: 2rpx solid #d1d5db;
  color: #1d1d1f;
}

.pending-repair-list-root .pr-btn--ship {
  background: #fff;
  border: 2rpx solid #007aff;
  color: #007aff;
}

.pending-repair-list-root .pr-btn--purchase,
.pending-repair-list-root .pr-btn--tutorial {
  background: #fff;
  border: 2rpx solid #e5e7eb;
  color: #374151;
}

.pending-repair-list-root .pr-btn--return {
  background: #fff7ed;
  border: 2rpx solid #fdba74;
  color: #c2410c;
}

.pending-repair-list-root .pr-btn--complete {
  background: #007aff;
  color: #fff;
}

.pending-repair-list-root .pr-btn--wecom {
  width: 100%;
  background: #fff;
  border: 2rpx solid #86efac;
  color: #15803d;
}

.pending-repair-list-root .pr-btn--delete {
  width: 100%;
  background: #fff;
  border: 2rpx solid #fecaca;
  color: #dc2626;
}

.pending-repair-list-root .pr-diagnosis-meta {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
  padding: 0 4rpx;
}

.pending-repair-list-root .pr-pill {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #eff6ff;
  color: #1d4ed8;
  font-size: 22rpx;
  font-weight: 700;
}

.pending-repair-list-root .pr-pill--warn {
  background: #fff7ed;
  color: #c2410c;
}

.pending-repair-list-root .pr-btn:active {
  opacity: 0.82;
  transform: scale(0.98);
}
