/* 出厂设置按钮：使用和其他按钮一样的样式 */

/* F2 MAX 折叠角度页：顶部小提示条 */
.fold-inline-hint {
  width: 100%;
  display: flex;
  justify-content: center;
  margin-bottom: 16rpx;
  pointer-events: none; /* 只做提示，不拦截下面按钮的点击 */
  transition: transform 0.25s cubic-bezier(0.25, 0.8, 0.25, 1); /* 🔴 添加过渡动画，跟随调整按钮移动 */
}

.fold-inline-box {
  padding: 18rpx 44rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.96);
  box-shadow: 0 14rpx 28rpx rgba(0,0,0,0.12);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  opacity: 0;
  transform: translateY(10rpx);
  transition: opacity 0.35s ease, transform 0.35s ease;
}

.fold-inline-box.show {
  opacity: 1;
  transform: translateY(0);
}

.fold-inline-box.hide {
  opacity: 0;
  transform: translateY(10rpx);
}

.fold-inline-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D1D1F;
}

