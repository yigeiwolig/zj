}

/* 🔴 调整按钮滑动相关样式 */
.adjust-slider-wrapper {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: visible; /* 允许滑动时超出容器 */
}

/* 底层：归零按钮（滑动后显示） */
.zero-btn-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
  z-index: 1;
  background: transparent;
}

.zero-btn-layer.show {
  opacity: 1;
  pointer-events: auto;
}

/* 顶层：调整按钮（可向上滑动） */
.adjust-slider-btn {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  z-index: 2;
  /* 默认：手动滑动时无过渡，跟手 */
  transition: none;
  touch-action: pan-y; /* 允许垂直滑动 */
  will-change: transform; /* 性能优化 */
}

/* 演示模式：自动上滑/回落时使用平滑动画 */
.adjust-slider-btn.demo {
  /* 稍微快一点的缓动，让演示看起来更顺滑、不拖沓 */
  transition: transform 0.25s cubic-bezier(0.25, 0.8, 0.25, 1);
}

/* 手动模式：松手时的回弹/归位动画（比演示更短一点） */
.adjust-slider-btn.snap {
  transition: transform 0.18s cubic-bezier(0.25, 0.8, 0.3, 1);
}

