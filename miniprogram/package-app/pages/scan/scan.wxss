  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  z-index: 20000;
  background: #f2f2f7;
  padding: 48rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
