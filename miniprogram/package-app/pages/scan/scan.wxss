.telemetry-gauge {
  position: relative;
  width: 128rpx;
  height: 128rpx;
  flex-shrink: 0;
  display: flex;
  justify-content: center;
  align-items: center;
}

.gauge-bg {
  position: absolute;
  width: 100%;
  height: 100%;
  border: 6rpx solid #f0f0f2;
  border-radius: 50%;
  box-sizing: border-box;
}

.gauge-bar {
  position: absolute;
  width: 100%;
  height: 100%;
  border: 6rpx solid #007aff;
  border-radius: 50%;
  box-sizing: border-box;
  clip-path: polygon(50% 50%, 50% 0%, 100% 0%, 100% 100%, 0% 100%, 0% 50%);
  transform: rotate(-130deg);
  transition: transform 0.42s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.35s ease;
}

.orbit-container {
  position: absolute;
  width: 100%;
  height: 100%;
  z-index: 10;
  transform: rotate(-130deg);
  transition: transform 0.42s cubic-bezier(0.4, 0, 0.2, 1);
}

.orbit-dot {
  position: absolute;
  top: -10rpx;
  left: calc(50% - 12rpx);
  width: 24rpx;
  height: 24rpx;
  background: #ffffff;
  border: 6rpx solid #007aff;
  border-radius: 50%;
  box-shadow: 0 0 16rpx rgba(0, 122, 255, 0.4);
  box-sizing: border-box;
  transition: border-color 0.6s, box-shadow 0.6s;
}

.gauge-center-lamp {
  position: absolute;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #e5f0ff;
  box-shadow: 0 0 24rpx rgba(0, 122, 255, 0.2);
  z-index: 5;
  transition: background 0.35s ease, box-shadow 0.35s ease, transform 0.35s ease;
  display: flex;
  justify-content: center;
  align-items: center;
  box-sizing: border-box;
}

.lamp-core {
  width: 24rpx;
  height: 24rpx;
  background: #007aff;
  border-radius: 50%;
  transition: all 0.6s ease;
}

.telemetry-gauge--open .gauge-bar {
  transform: rotate(45deg);
  border-color: #30d158;
}

.telemetry-gauge--open .orbit-container {
  transform: rotate(45deg);
}

.telemetry-gauge--open .orbit-dot {
  border-color: #30d158;
  box-shadow: 0 0 16rpx rgba(48, 209, 88, 0.5);
}

.telemetry-gauge--open .gauge-center-lamp {
  background: #e8f9ec;
  box-shadow: 0 0 28rpx rgba(48, 209, 88, 0.28);
}

.telemetry-gauge--open .lamp-core {
  background: #30d158;
}

.telemetry-gauge--moving .gauge-bar {
  border-color: #ff9f0a;
  transform: rotate(-130deg);
  transition: border-color 0.35s ease;
  animation: gauge-bar-sweep-open 1.35s ease-in-out infinite alternate;
}

.telemetry-gauge--moving .orbit-container {
  transform: rotate(-130deg);
  transition: none;
  animation: gauge-orbit-sweep-open 1.35s ease-in-out infinite alternate;
}

.telemetry-gauge--moving .orbit-dot {
  border-color: #ff9f0a;
  box-shadow: 0 0 18rpx rgba(255, 159, 10, 0.55);
  background: #ff9f0a;
}

.telemetry-gauge--moving .gauge-center-lamp {
  background: #fff4e0;
  box-shadow: 0 0 30rpx rgba(255, 159, 10, 0.35);
  animation: lamp-pulse-moving 1.1s ease-in-out infinite;
}

.telemetry-gauge--moving .lamp-core {
  background: #ff9f0a;
}

@keyframes gauge-orbit-sweep-open {
  from { transform: rotate(-130deg); }
  to { transform: rotate(12deg); }
}

@keyframes gauge-bar-sweep-open {
  from { transform: rotate(-130deg); }
  to { transform: rotate(12deg); }
}

@keyframes lamp-pulse-moving {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.82; transform: scale(0.96); }
}

.telemetry-gauge--moving-close .gauge-bar {
  transform: rotate(45deg);
  animation: gauge-bar-sweep-close 1.35s ease-in-out infinite alternate;
}

.telemetry-gauge--moving-close .orbit-container {
  transform: rotate(45deg);
  animation: gauge-orbit-sweep-close 1.35s ease-in-out infinite alternate;
}

@keyframes gauge-orbit-sweep-close {
  from { transform: rotate(45deg); }
  to { transform: rotate(-130deg); }
}

@keyframes gauge-bar-sweep-close {
  from { transform: rotate(45deg); }
  to { transform: rotate(-130deg); }
}

.telemetry-gauge--snap .gauge-bar,
.telemetry-gauge--snap .orbit-container {
  transition: none !important;
  animation: none !important;
}

.telemetry-gauge--stealth .gauge-bar {
  border-color: #c4b5fd;
  transform: rotate(-90deg);
}

.telemetry-gauge--stealth .orbit-container {
  transform: rotate(-90deg);
}

.telemetry-gauge--stealth .orbit-dot {
  border-color: #8b5cf6;
  box-shadow: 0 0 14rpx rgba(139, 92, 246, 0.35);
}

.telemetry-gauge--stealth .gauge-center-lamp {
  background: #ede9fe;
  box-shadow: 0 0 24rpx rgba(139, 92, 246, 0.22);
}

.telemetry-gauge--stealth .lamp-core {
  background: #7c3aed;
}

.telemetry-gauge--fault .gauge-bar {
  border-color: #ffb4ab;
  transform: rotate(-90deg);
}

.telemetry-gauge--fault .orbit-container {
  transform: rotate(-90deg);
}

.telemetry-gauge--fault .orbit-dot {
  border-color: #ff3b30;
  box-shadow: 0 0 14rpx rgba(255, 59, 48, 0.35);
}

.telemetry-gauge--fault .gauge-center-lamp {
  background: #ffebea;
  box-shadow: 0 0 24rpx rgba(255, 59, 48, 0.22);
}

.telemetry-gauge--fault .lamp-core {
  background: #ff3b30;
}

