}

/* 折叠页：按钮行锚点（提示绝对叠在上方，不挤占布局） */
.fold-adjust-anchor {
  position: relative;
  width: 100%;
}

/* 上滑演示结束后的「调大/调小」补充说明：浮在「调整」行正上方 */
.fold-finetune-hint {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 100%;
  display: flex;
  justify-content: center;
  padding-bottom: 12rpx;
  box-sizing: border-box;
  pointer-events: none;
  z-index: 8;
}

.fold-finetune-inner {
  max-width: 94%;
  padding: 18rpx 28rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.1);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  transform-origin: center bottom;
  animation: foldFinetuneAppear 0.35s ease-out forwards, foldFinetuneBob 0.85s ease-in-out 0.35s infinite;
}

@keyframes foldFinetuneAppear {
  from {
    opacity: 0;
    transform: translateY(16rpx) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* 一跳一跳：轻微上下弹跳（与上面 appear 衔接后循环） */
@keyframes foldFinetuneBob {
  0%,
  100% {
    transform: translateY(0);
  }
  35% {
    transform: translateY(-12rpx);
  }
  70% {
    transform: translateY(-4rpx);
  }
}

.fold-finetune-line {
  font-size: 24rpx;
  font-weight: 700;
  color: #ff3b30;
  line-height: 1.45;
