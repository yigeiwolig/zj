<!-- WXS 核心修复：移除 activeMode 判断，恢复视觉动画 -->
<wxs module="filters">
var clamp = function(val, min, max) {
  var v = parseInt(val);
  if (isNaN(v)) return 0;
  if (v < min) return min;
  if (v > max) return max;
  return v;
}

// 修改：不再接收 angleMode，始终计算波浪样式
var getWaveClassByX = function(index, translateX) {
  // 1. 直接计算波浪，不拦截
  // 这样未激活时，用户滑动波轮，黑条依然会跳动（视觉反馈）
  var current = -translateX / 20;
  var centerIndex = Math.round(current);
  var diff = Math.abs(index - centerIndex);
  
  if (diff === 0) return 'active';
  if (diff === 1) return 'near-1';
  if (diff === 2) return 'near-2';
  if (diff === 3) return 'near-3';
  return '';
}

var isF1Series = function(name) {
  if (!name) return false;
  return name.indexOf('F1') > -1;
}

var isF2OpenAngleSeries = function(name) {
  if (!name) return false;
  return name.indexOf('F2') > -1;
}

var isF2UltraModel = function(name, type) {
  return name === 'F2' && type === 'Ultra';
}

var isF1UltraType = function(type) {
  return type === 'Ultra' || type === 'ultra' || type === 'Pro Max';
}

var isMtUltraCard = function(name, type) {
  return (name === 'F1' && isF1UltraType(type))
    || (name === 'F2' && type === 'Ultra')
    || (name === 'F3' && type === 'Max');
}

var isF3Max = function(name, type) {
  return name === 'F3' && type === 'Max';
}

var openAngleVisualActive = function(uiActive, name, type) {
  return uiActive;
}

// F2 / 同款 Ultra 固件 UI：内部 90→30°、160→90°；蓝牙指令不变
var openAnglePresetBtnText = function(name, type, angle) {
  if (isF1Series(name) && !isMtUltraCard(name, type)) {
    if (angle === 180) return '180°';
    if (angle === 90) return '90°';
  }
  if (isMtUltraCard(name, type) || isF2OpenAngleSeries(name)) {
    if (angle === 160) return '90°';
    if (angle === 90) return '30°';
  }
  return angle + '°';
}

var openAngleSyncHint = function(name, type) {
  if (isMtUltraCard(name, type) || isF2OpenAngleSeries(name)) return '点击90度或30度同步画面';
  if (isF1Series(name)) return '点击180度或90度同步画面';
  return '点击预设角度同步画面';
}

var openAngleInternalToDisplayNum = function(name, type, internal) {
  var v = parseInt(internal);
  if (isNaN(v)) return 0;
  if (isMtUltraCard(name, type)) {
    return clamp(v, 0, 170);
  }
  if (isF1Series(name) || !isF2OpenAngleSeries(name)) {
    return clamp(v, 0, 180);
  }
  if (v <= 90) return Math.round(v * 30 / 90);
  return Math.round(30 + (v - 90) * 60 / 70);
}

var openAngleDisplayDeg = function(name, type, internal) {
  return openAngleInternalToDisplayNum(name, type, internal) + '°';
}

// 下棍相对上棍的 CSS 旋转：显示角度 90° → rotate(90°) 形成 90° 夹角
