page {
  background: #fff;
  color: #000;
}

.ts-page {
  min-height: 100vh;
  background: #fff;
}

.ts-nav {
  position: fixed;
  inset: 0 0 auto;
  z-index: 20;
  display: flex;
  align-items: center;
  box-sizing: content-box;
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.ts-nav-back,
.ts-nav-action {
  width: 112rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ts-nav-back {
  font-size: 52rpx;
  font-weight: 300;
  line-height: 1;
}

.ts-nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
}

.ts-nav-action {
  font-size: 26rpx;
  color: #007aff;
  font-weight: 600;
}

.ts-nav-action--empty {
  opacity: 0;
}

.ts-content {
  padding: 0 40rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* —— 列表 —— */
.ts-list-head {
  padding: 48rpx 0 28rpx;
}

.ts-list-title {
  display: block;
  font-size: 64rpx;
  font-weight: 750;
  letter-spacing: -2rpx;
  line-height: 1.1;
}

.ts-list-copy {
  display: block;
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: rgba(0, 0, 0, 0.45);
}

.ts-model {
  margin-bottom: 28rpx;
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.4);
}

.ts-tree-list {
  border-top: 1rpx solid rgba(0, 0, 0, 0.08);
}

.ts-tree-row {
  min-height: 128rpx;
  padding: 28rpx 0;
  display: flex;
  align-items: center;
  gap: 24rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.08);
}

.ts-tree-row--pressed {
  opacity: 0.55;
}

.ts-tree-index {
  width: 48rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: rgba(0, 0, 0, 0.28);
}

.ts-tree-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.ts-tree-title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.25;
}

.ts-tree-copy {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.4);
}

.ts-tree-arrow {
  font-size: 42rpx;
  font-weight: 300;
  color: rgba(0, 0, 0, 0.25);
}

/* —— 步骤 —— */
.ts-step-meta {
  padding: 28rpx 0 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.ts-step-tree {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(0, 0, 0, 0.4);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ts-step-num {
  font-size: 24rpx;
  font-weight: 700;
  color: #007aff;
}

.ts-step-title {
  display: block;
  font-size: 56rpx;
  line-height: 1.18;
  font-weight: 780;
  letter-spacing: -1.5rpx;
  margin-bottom: 16rpx;
}

.ts-step-body {
  display: block;
  font-size: 30rpx;
  line-height: 1.55;
  color: rgba(0, 0, 0, 0.55);
  margin-bottom: 28rpx;
}

.ts-player {
  width: 100vw;
  margin-left: -40rpx;
  margin-right: -40rpx;
  background: #000;
}

.ts-video {
  width: 100%;
  height: 460rpx;
  display: block;
  background: #000;
}

.ts-image {
  width: 100%;
  display: block;
  border-radius: 16rpx;
  margin-bottom: 8rpx;
}

/* 等视频：大提示区 */
.ts-gate {
  margin-top: 36rpx;
  padding: 40rpx 32rpx 36rpx;
  border-radius: 24rpx;
  background: #f2f2f7;
}

.ts-gate-title {
  display: block;
  font-size: 36rpx;
  font-weight: 750;
  line-height: 1.3;
  margin-bottom: 12rpx;
}

.ts-gate-copy {
  display: block;
  font-size: 28rpx;
  line-height: 1.5;
  color: rgba(0, 0, 0, 0.5);
}

.ts-gate-bar {
  margin-top: 28rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.08);
  overflow: hidden;
}

.ts-gate-bar-fill {
  width: 42%;
  height: 100%;
  border-radius: 999rpx;
  background: #007aff;
  animation: ts-gate-slide 1.4s ease-in-out infinite;
}

/* 选项 */
.ts-choices {
  margin-top: 36rpx;
  animation: ts-in 0.28s ease;
}

.ts-choices-label {
  display: block;
  font-size: 30rpx;
  font-weight: 750;
  margin-bottom: 18rpx;
}

.ts-choice {
  min-height: 112rpx;
  padding: 0 8rpx 0 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.08);
}

.ts-choice:last-child {
  border-bottom: 0;
}

.ts-choice--pressed {
  opacity: 0.55;
}

.ts-choice-num {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #111;
  color: #fff;
  font-size: 26rpx;
  font-weight: 750;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ts-choice-text {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  font-weight: 650;
  line-height: 1.3;
}

.ts-choice-arrow {
  font-size: 42rpx;
  font-weight: 300;
  color: rgba(0, 0, 0, 0.28);
}

.ts-result {
  margin-top: 40rpx;
}

.ts-result-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 750;
  margin-bottom: 28rpx;
}

.ts-result-badge.is-ok {
  background: #e8f8ef;
  color: #1a7f45;
}

.ts-result-badge.is-help {
  background: #fff1e8;
  color: #c24e12;
}

.ts-primary-btn {
  min-height: 96rpx;
  border-radius: 20rpx;
  background: #111;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
}

.ts-foot {
  margin-top: 40rpx;
  display: flex;
  gap: 16rpx;
}

.ts-foot-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 18rpx;
  background: #f2f2f7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 650;
}

.ts-foot-btn.is-off {
  opacity: 0.35;
  pointer-events: none;
}

.ts-loading,
.ts-error,
.ts-empty {
  padding: 180rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  color: rgba(0, 0, 0, 0.4);
  font-size: 28rpx;
}

.ts-loading-line {
  width: 160rpx;
  height: 6rpx;
  border-radius: 999rpx;
  margin-bottom: 28rpx;
  background: linear-gradient(90deg, transparent, #111, transparent);
  animation: ts-loading 1.2s ease-in-out infinite;
}

.ts-error-title {
  font-size: 40rpx;
  font-weight: 750;
  color: #111;
}

.ts-error-copy {
  margin: 16rpx 0 32rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.ts-error .ts-primary-btn {
  width: 280rpx;
}

@keyframes ts-loading {
  0%, 100% { opacity: 0.25; transform: scaleX(0.55); }
  50% { opacity: 1; transform: scaleX(1); }
}

@keyframes ts-gate-slide {
  0% { transform: translateX(-120%); }
  100% { transform: translateX(280%); }
}

@keyframes ts-in {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}
