<view class="ts-page">
  <view class="ts-nav" style="height: {{navBarHeight}}px; padding-top: {{statusBarHeight}}px;">
    <view class="ts-nav-back" bindtap="goBack">‹</view>
    <text class="ts-nav-title">{{currentNode ? '排查进行中' : '自助排查'}}</text>
    <view class="ts-nav-action" wx:if="{{currentNode}}" bindtap="restartTree">重来</view>
    <view class="ts-nav-action ts-nav-action--empty" wx:else></view>
  </view>

  <view class="ts-content" style="padding-top: {{statusBarHeight + navBarHeight}}px;">
    <view class="ts-loading" wx:if="{{loading}}">
      <view class="ts-loading-line"></view>
      <text>正在加载排查方案…</text>
    </view>

    <view class="ts-error" wx:elif="{{errorText}}">
      <text class="ts-error-title">暂时无法加载</text>
      <text class="ts-error-copy">{{errorText}}</text>
      <view class="ts-primary-btn" bindtap="retryLoad">重新加载</view>
    </view>

    <!-- 主题列表 -->
    <block wx:elif="{{!currentNode}}">
      <view class="ts-list-head">
        <text class="ts-list-title">自助排查</text>
        <text class="ts-list-copy">选一个现象，按视频一步步确认</text>
      </view>
      <view class="ts-model" wx:if="{{model}}">当前机型 · {{model}}</view>

      <view class="ts-tree-list" wx:if="{{trees.length}}">
        <view
          class="ts-tree-row"
          wx:for="{{trees}}"
          wx:key="_id"
          data-id="{{item._id}}"
          bindtap="startTree"
          hover-class="ts-tree-row--pressed"
        >
          <text class="ts-tree-index">{{index + 1}}</text>
          <view class="ts-tree-main">
            <text class="ts-tree-title">{{item.title}}</text>
            <text class="ts-tree-copy">{{item.subtitle || '点击开始'}}</text>
          </view>
          <text class="ts-tree-arrow">›</text>
        </view>
      </view>
      <view class="ts-empty" wx:else>
        <text>当前机型暂无排查方案</text>
      </view>
    </block>

    <!-- 步骤页 -->
    <block wx:else>
      <view class="ts-step-meta">
        <text class="ts-step-tree">{{activeTree.title}}</text>
        <text class="ts-step-num">第 {{historyCount + 1}} 步</text>
      </view>

      <text class="ts-step-title">{{currentNode.title}}</text>
      <text class="ts-step-body" wx:if="{{currentNode.body}}">{{currentNode.body}}</text>

      <!-- 视频：占满宽度，作为主视觉 -->
      <view class="ts-player" wx:if="{{hasVideo}}">
        <video
          id="troubleshoot-video"
          class="ts-video"
          src="{{currentNode.media.url}}"
          poster="{{currentNode.media.poster}}"
          controls
          show-center-play-btn
          enable-progress-gesture
          object-fit="contain"
          bindended="onVideoEnded"
          bindtimeupdate="onVideoTimeUpdate"
          binderror="onVideoError"
        ></video>
      </view>
      <image
        wx:elif="{{currentNode.media.url && currentNode.media.type === 'image'}}"
        class="ts-image"
        src="{{currentNode.media.url}}"
        mode="widthFix"
      />

      <!-- 结果 -->
      <view class="ts-result" wx:if="{{currentNode.type === 'result'}}">
        <view class="ts-result-badge {{currentNode.result === 'ok' ? 'is-ok' : 'is-help'}}">
          {{currentNode.result === 'ok' ? '已排除' : '需要售后'}}
        </view>
        <view class="ts-primary-btn" bindtap="onResultAction">
          {{currentNode.resultCta || (currentNode.result === 'ok' ? '完成' : '去故障报修')}}
        </view>
      </view>

      <!-- 等视频：大提示占位，避免空洞 -->
      <view class="ts-gate" wx:elif="{{hasVideo && !showOptions}}">
        <text class="ts-gate-title">请先看完演示视频</text>
        <text class="ts-gate-copy">看完后，下方会出现「灯闪烁 / 不闪烁」等选项</text>
        <view class="ts-gate-bar">
          <view class="ts-gate-bar-fill"></view>
        </view>
      </view>

      <!-- 选项 -->
      <view class="ts-choices" wx:elif="{{showOptions}}">
        <text class="ts-choices-label">观察到什么？</text>
        <view
          class="ts-choice"
          wx:for="{{currentNode.options}}"
          wx:key="index"
          data-index="{{index}}"
          bindtap="chooseOption"
          hover-class="ts-choice--pressed"
        >
          <text class="ts-choice-num">{{index + 1}}</text>
          <text class="ts-choice-text">{{item.label}}</text>
          <text class="ts-choice-arrow">›</text>
        </view>
      </view>

      <view class="ts-foot">
        <view class="ts-foot-btn {{historyCount ? '' : 'is-off'}}" bindtap="previousStep">上一步</view>
        <view class="ts-foot-btn" bindtap="returnToList">换一个问题</view>
      </view>
    </block>
  </view>
</view>
