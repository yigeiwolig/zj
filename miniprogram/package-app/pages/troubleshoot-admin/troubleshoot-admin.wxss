page {
  background: #f5f5f7;
  color: #111;
}

.ta-page {
  min-height: 100vh;
}

.ta-nav {
  position: fixed;
  inset: 0 0 auto;
  z-index: 20;
  display: flex;
  align-items: center;
  box-sizing: content-box;
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.ta-back,
.ta-nav-add {
  width: 120rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ta-back {
  font-size: 52rpx;
  font-weight: 300;
}

.ta-nav-add {
  font-size: 24rpx;
  font-weight: 700;
  color: #007aff;
}

.ta-nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 750;
}

.ta-content {
  padding-left: 28rpx;
  padding-right: 28rpx;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

.ta-intro {
  padding: 44rpx 8rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ta-intro-title {
  font-size: 44rpx;
  font-weight: 780;
}

.ta-intro-copy {
  font-size: 24rpx;
  line-height: 1.55;
  color: rgba(0, 0, 0, 0.48);
}

.ta-tree-strip {
  width: 100%;
  margin-bottom: 24rpx;
  white-space: nowrap;
}

.ta-tree-strip-inner {
  display: inline-flex;
  gap: 12rpx;
  padding-right: 24rpx;
}

.ta-tree-chip {
  padding: 18rpx 24rpx;
  border-radius: 18rpx;
  background: #fff;
  font-size: 24rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
}

.ta-tree-chip.is-on {
  background: #111;
  color: #fff;
}

.ta-tree-head {
  padding: 30rpx;
  border-radius: 28rpx;
  background: #111;
  color: #fff;
  display: flex;
  gap: 22rpx;
}

.ta-tree-head-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.ta-tree-title {
  font-size: 34rpx;
  font-weight: 750;
}

.ta-tree-meta {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.58);
  word-break: break-all;
}

.ta-head-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 14rpx;
  font-size: 22rpx;
  color: #8dc7ff;
}

.danger {
  color: #ff7b75 !important;
}

.ta-section-head {
  margin: 34rpx 4rpx 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  font-weight: 700;
}

.ta-section-head view {
  color: #007aff;
}

.ta-node-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.ta-node {
  padding: 26rpx;
  border-radius: 26rpx;
  background: #fff;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
}

.ta-node-top {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.ta-node-type,
.ta-node-sort {
  font-size: 19rpx;
  color: #007aff;
  font-weight: 750;
}

.ta-node-title {
  display: block;
  font-size: 29rpx;
  font-weight: 720;
}

.ta-node-id {
  display: block;
  margin-top: 8rpx;
  font-family: ui-monospace, Menlo, Consolas, monospace;
  font-size: 18rpx;
  color: rgba(0, 0, 0, 0.38);
  word-break: break-all;
}

.ta-node-body {
  display: block;
  margin-top: 12rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: rgba(0, 0, 0, 0.52);
}

.ta-node-options {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #f5f5f7;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 20rpx;
  color: rgba(0, 0, 0, 0.55);
}

.ta-node-actions {
  margin-top: 20rpx;
  display: flex;
  gap: 24rpx;
  font-size: 23rpx;
  color: #007aff;
}

.ta-empty,
.ta-loading,
.ta-error {
  padding: 100rpx 30rpx;
  text-align: center;
  color: rgba(0, 0, 0, 0.45);
}

.ta-empty--small {
  padding: 60rpx 30rpx;
}

.ta-empty .ta-primary {
  width: 300rpx;
  margin: 28rpx auto 0;
}

.ta-error {
  color: #c62828;
}

.ta-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(0, 0, 0, 0.48);
  display: flex;
  align-items: flex-end;
}

.ta-sheet {
  width: 100%;
  height: 84vh;
  padding: 12rpx 30rpx 0;
  box-sizing: border-box;
  border-radius: 34rpx 34rpx 0 0;
  background: #fff;
}

.ta-sheet--node {
  height: 92vh;
}

.ta-sheet-scroll {
  width: 100%;
  height: 100%;
}

.ta-sheet-title {
  display: block;
  padding: 26rpx 0 14rpx;
  font-size: 38rpx;
  font-weight: 780;
}

.ta-label {
  display: block;
  margin: 24rpx 0 10rpx;
  font-size: 22rpx;
  font-weight: 650;
  color: rgba(0, 0, 0, 0.5);
}

.ta-input,
.ta-textarea,
.ta-picker {
  width: 100%;
  border-radius: 18rpx;
  background: #f2f2f7;
  box-sizing: border-box;
  font-size: 26rpx;
  color: #111;
}

.ta-input,
.ta-picker {
  height: 82rpx;
  padding: 0 22rpx;
}

.ta-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ta-textarea {
  height: 180rpx;
  padding: 20rpx 22rpx;
  line-height: 1.5;
}

.ta-textarea--short {
  height: 120rpx;
}

.ta-textarea--options {
  height: 230rpx;
  font-family: ui-monospace, Menlo, Consolas, monospace;
  font-size: 22rpx;
}

.ta-switch-row {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 25rpx;
}

.ta-video-pick {
  width: 100%;
  height: 260rpx;
  border-radius: 20rpx;
  background: #f2f2f7;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(0, 0, 0, 0.42);
  font-size: 25rpx;
}

.ta-video {
  width: 100%;
  height: 100%;
}

.ta-clear-media {
  padding: 14rpx 0 0;
  text-align: right;
  font-size: 22rpx;
  color: #d93025;
}

.ta-sheet-actions {
  padding: 32rpx 0 calc(26rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 14rpx;
}

.ta-primary,
.ta-secondary {
  flex: 1;
  height: 88rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
}

.ta-primary {
  background: #111;
  color: #fff;
}

.ta-secondary {
  background: #f2f2f7;
  color: #111;
}

.disabled {
  opacity: 0.45;
  pointer-events: none;
}
