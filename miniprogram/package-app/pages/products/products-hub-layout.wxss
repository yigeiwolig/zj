@import "../../../styles/hub-page-anim.wxss";

/* pages/products — 首页入口布局（参考稿 + hover-class 缩放） */

.hub-page {
  min-height: 100vh;
  height: 100vh;
  background: #f4f4f7;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

.hub-shell .hub-panels-viewport {
  flex: 1;
  width: 100%;
  min-height: 0;
  overflow: hidden;
}

.hub-shell .hub-panels-track {
  display: flex;
  flex-direction: row;
  width: 400%;
  height: 100%;
  will-change: transform;
  backface-visibility: hidden;
}

.hub-shell .hub-panels-track--anim {
  transition: transform 0.32s cubic-bezier(0.25, 0.1, 0.25, 1);
}

.hub-shell .hub-panel-slot {
  width: 25%;
  height: 100%;
  flex-shrink: 0;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

.hub-panel-slot--shop {
  overflow: hidden;
}

/* 底栏：切商城下滑隐藏，回主页上滑出现 */
.hub-tab-bar-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 900;
  pointer-events: none;
  opacity: 0;
  transform: translateY(120%);
  transition:
    transform 0.3s cubic-bezier(0.25, 0.1, 0.25, 1),
    opacity 0.24s ease;
}

.hub-tab-bar-wrap--show {
  pointer-events: auto;
  opacity: 1;
  transform: translateY(0);
}

.hub-shell .hub-home-scroll {
  height: 100%;
  width: 100%;
  box-sizing: border-box;
}

.hub-admin-fab--in-slot {
  position: absolute;
  left: 32rpx;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  z-index: 120;
}

.hub-back {
  position: fixed;
  left: 24rpx;
  z-index: 110;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.hub-back-arrow {
  font-size: 44rpx;
  font-weight: 300;
  color: #1d1d1f;
  line-height: 1;
}

/* 左下角管理入口（避开右上角胶囊，可点击） */
.hub-admin-fab {
  position: fixed;
  left: 32rpx;
  bottom: calc(168rpx + env(safe-area-inset-bottom));
  z-index: 120;
  padding: 18rpx 36rpx;
  background: #fff;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.12);
  border: 1rpx solid rgba(0, 0, 0, 0.06);
}

.hub-admin-fab--pressed {
  transform: scale(0.96);
  opacity: 0.88;
}

.hub-admin-fab-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #007aff;
}

/* 首页悬浮购物车：点击跳转订单 Tab（挂在 hub-page 根，避免轨道 transform 错位） */
.hub-home-float-cart {
  position: fixed;
  right: 24rpx;
  bottom: calc(180rpx + env(safe-area-inset-bottom));
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(165deg, #ffffff 0%, #f2f2f7 100%);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
  border: 1rpx solid rgba(0, 0, 0, 0.07);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 880;
}

.hub-home-float-cart-inner {
  position: relative;
  width: 68rpx;
  height: 68rpx;
}

.hub-home-float-cart-svg {
  width: 68rpx;
  height: 68rpx;
}

.hub-home-float-mt {
  position: absolute;
  left: 60%;
  top: 53%;
  transform: translate(-50%, -50%);
  margin-top: -3rpx;
  font-size: 16rpx;
  font-weight: 900;
  color: #1c1c1e;
  pointer-events: none;
}

.hub-home-float-cart-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 8rpx;
  border-radius: 14rpx;
  background: #ff3b30;
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 28rpx;
  text-align: center;
  box-sizing: border-box;
}

.hub-shell .main-content {
  flex: 1;
  height: 100%;
  min-height: 0;
  box-sizing: border-box;
}

.content-inner {
  padding: 0 30rpx calc(280rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ========== 参考稿：主页 Bento 布局 ========== */
.hub-home-layout {
  display: flex;
  flex-direction: column;
}

.hub-home-layout .hub-home-hero {
  margin-bottom: 4rpx;
}

/* 产品选购大卡 */
.hub-shop-card {
  background: #ffffff;
  border-radius: 60rpx;
  padding: 50rpx 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 30rpx rgba(0,0,0,0.03);
  position: relative;
  border: 1rpx solid rgba(255,255,255,0.8);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  box-sizing: border-box;
  transition: transform 0.2s ease, opacity 0.2s ease;
  height: 260rpx;
  overflow: hidden;
}

.hub-shop-card-info {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  height: 100%;
  z-index: 2;
  position: relative;
  padding-left: 10rpx;
}

.hub-shop-bg-icon {
  display: none;
}

.hub-shop-tag {
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: #0071e3;
  margin-bottom: 14rpx;
  line-height: 1.2;
}

.hub-shop-title {
  font-size: 64rpx;
  font-weight: 900;
  color: #1d1d1f;
  margin-bottom: 0;
  letter-spacing: -2rpx;
}

.hub-shop-desc {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 16rpx;
  line-height: 1.4;
  margin-bottom: 0;
}

.hub-shop-cta-row {
  position: absolute;
  right: 40rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: row;
  align-items: center;
  z-index: 3;
}

.hub-shop-cta {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 140rpx;
  height: 140rpx;
  background: #111;
  border-radius: 50%;
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.15);
}

.hub-shop-cta-text {
  font-size: 32rpx;
  font-weight: 900;
  color: #ffffff;
}

.hub-shop-cta-secondary {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 12rpx 30rpx;
  background: #fff;
  border-radius: 100rpx;
  border: 1rpx solid #eee;
}

.hub-shop-cta-secondary-text {
  font-size: 20rpx;
  color: #999;
}

.hub-card-hover {
  transform: scale(0.98);
  opacity: 0.92;
}

/* Bento + 胶囊：共用二列网格（左列=安装教程，右列=OTA） */
.hub-two-col-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  column-gap: 30rpx;
  row-gap: 30rpx;
  width: 100%;
  margin-bottom: 30rpx;
  box-sizing: border-box;
  align-items: stretch;
}

.hub-col-left {
  grid-column: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-self: stretch;
}

.hub-col-right {
  grid-column: 2;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-self: stretch;
}

/* 覆盖 .hub-page .card 的 height:auto，与右侧 Bento 列同高 */
.hub-page .card.hub-bento-main {
  flex: 1;
  width: 100%;
  min-width: 0;
  height: 100% !important;
  min-height: 480rpx;
  margin-bottom: 0 !important;
}

.hub-bento-main {
  width: 100%;
  min-width: 0;
  padding: 40rpx;
  margin-bottom: 0 !important;
  background: linear-gradient(180deg, #FFFFFF 0%, #F9FAFB 100%) !important;
  border-radius: 60rpx !important;
  border: 1rpx solid rgba(255,255,255,0.8) !important;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.02) !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-sizing: border-box;
  overflow: hidden;
  position: relative;
}

.hub-bento-main-icon {
  position: absolute;
  top: 40rpx;
  right: 40rpx;
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  background: transparent;
  border-radius: 24rpx;
  padding: 0;
  box-sizing: border-box;
}

.hub-bento-main-foot {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-top: auto;
}

.hub-bento-tag {
  font-size: 16rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
  color: #007aff;
}

.hub-bento-main-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #1d1d1f;
  display: block;
}

.hub-bento-col {
  width: 100%;
  min-width: 0;
  height: 480rpx;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.hub-bento-sub {
  flex: 1;
  min-height: 0;
  padding: 30rpx;
  margin-bottom: 0 !important;
  background: linear-gradient(180deg, #FFFFFF 0%, #F9FAFB 100%) !important;
  border-radius: 60rpx !important;
  border: 1rpx solid rgba(255,255,255,0.8) !important;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.02) !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  box-sizing: border-box;
}

.hub-bento-sub-icon {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  background: transparent;
  border-radius: 24rpx;
  padding: 0;
  box-sizing: border-box;
}

.hub-bento-sub:last-child .hub-bento-sub-icon {
  background: transparent;
}

.hub-bento-sub-text {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hub-bento-sub-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1d1d1f;
  display: block;
  text-align: center;
}

.hub-pill-btn {
  width: 100%;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 40rpx 30rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #F9FAFB 100%);
  border-radius: 100rpx;
  border: 1rpx solid rgba(255,255,255,0.8);
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.02);
  box-sizing: border-box;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.hub-pill-icon {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  background: transparent;
  border-radius: 100rpx;
  padding: 0;
  box-sizing: border-box;
}

.hub-pill-btn:last-child .hub-pill-icon {
  background: transparent;
}

.hub-pill-label {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.hub-pill-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1d1d1f;
  display: block;
}

/* 底部菜单列表 */
.hub-menu-card {
  background: linear-gradient(180deg, #FFFFFF 0%, #F9FAFB 100%);
  border-radius: 60rpx;
  padding: 0;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.02);
  border: 1rpx solid rgba(255,255,255,0.8);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  margin-bottom: 30rpx;
}

.hub-menu-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx;
  box-sizing: border-box;
}

.hub-menu-item--line {
  border-bottom: 1rpx solid #f0f0f5;
}

.hub-menu-item-hover {
  background: #f9f9fb;
}

.hub-menu-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #666;
}

.hub-menu-en {
  font-size: 20rpx;
  color: #ccc;
}

.hub-menu-live {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
}

.hub-menu-live-text {
  font-size: 18rpx;
  color: #34c759;
  font-weight: bold;
}

.hub-menu-live-dot {
  width: 10rpx;
  height: 10rpx;
  background: #34c759;
  border-radius: 10rpx;
}

.hub-home-layout .new-card {
  border-radius: 32rpx !important;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04) !important;
  border: none !important;
  overflow: hidden !important;
}

.hub-home-layout .new-card-media,
.hub-home-layout .new-card-swiper,
.hub-home-layout .new-card-media .new-card-bg {
  border-radius: 32rpx;
  overflow: hidden;
}

.hub-home-layout .new-card-media video.new-card-bg {
  object-fit: cover !important;
  width: 100% !important;
  height: 100% !important;
}

/* 功能面板：把选购 / Bento / 列表收进同一块 */
.hub-board {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 16rpx;
  border-radius: 52rpx;
  background: rgba(255, 255, 255, 0.42);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(32px) saturate(1.25);
  -webkit-backdrop-filter: blur(32px) saturate(1.25);
  box-shadow: 0 10rpx 36rpx rgba(15, 23, 42, 0.06);
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.hub-board .hub-board-cell,
.hub-board .card {
  margin-bottom: 0;
  border-radius: 40rpx;
  box-shadow: none;
  background: rgba(255, 255, 255, 0.68);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
}

.hub-board .bento-row {
  gap: 14rpx;
  margin-bottom: 0;
}

.hub-board .list-group {
  margin-bottom: 0;
  border-radius: 40rpx;
  box-shadow: none;
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

.hub-board .list-item {
  padding: 28rpx 24rpx;
}

.hub-board .list-item--line {
  border-bottom-color: rgba(0, 0, 0, 0.06);
}

/* 通用卡片：毛玻璃 */
.hub-page .card {
  background: rgba(255, 255, 255, 0.52);
  border-radius: 52rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 10rpx 40rpx rgba(15, 23, 42, 0.06);
  overflow: hidden;
  position: relative;
  left: auto;
  right: auto;
  top: auto;
  margin-left: 0;
  width: auto;
  height: auto;
  max-width: none;
  transition: transform 0.2s cubic-bezier(0.25, 1, 0.5, 1), background 0.2s ease;
  box-sizing: border-box;
  backdrop-filter: blur(28px) saturate(1.25);
  -webkit-backdrop-filter: blur(28px) saturate(1.25);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
}

.card-hover {
  transform: scale(0.97);
}

.bento-item-main.card-hover,
.bento-item-sub.card-hover,
.bento-item-half.card-hover {
  background: rgba(255, 255, 255, 0.68);
}

.shop-card.card-hover {
  background: rgba(255, 255, 255, 0.68);
}

.card-hover--media {
  transform: scale(0.97);
  background-color: transparent;
}

.card--disabled {
  opacity: 0.45;
}

.opacity-hover {
  opacity: 0.6;
}

/* 顶部 Hero：产品上新 */
.hub-page .hero-card {
  border-radius: 52rpx;
  margin-bottom: 14rpx;
}

.hub-page .new-card {
  width: 100%;
  padding: 0;
  position: relative;
  overflow: hidden;
  background: #e8e8ed;
  border-radius: 52rpx;
}
/* 产品选购 */
.hub-page .shop-card {
  background: rgba(255, 255, 255, 0.68);
  padding: 0;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
  box-shadow: none;
  border-radius: 40rpx;
}

.hub-page .shop-card.card-hover {
  background: rgba(255, 255, 255, 0.78);
  transform: scale(0.97);
}

.hub-page .shop-card-body {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  min-height: 140rpx;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
}

.hub-page .shop-card-info {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.hub-page .tag-label--shop {
  color: #86868b;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  margin-bottom: 10rpx;
}

.hub-page .shop-card-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #1d1d1f;
  letter-spacing: -0.5rpx;
  line-height: 1.2;
}

.hub-page .shop-card-desc {
  display: block;
  font-size: 22rpx;
  color: #86868b;
  margin-top: 6rpx;
  line-height: 1.35;
}

.hub-page .shop-card-icon {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  opacity: 0.92;
}

.hub-page .card-info {
  position: static;
  top: auto;
  left: auto;
  right: auto;
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
  gap: 0;
  z-index: auto;
}

.tag-label {
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
  color: #86868b;
}

.tag-label--featured {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #007aff;
  margin-bottom: 16rpx;
}

.tag-label--shop {
  color: #666;
}

.card-title {
  font-size: 40rpx;
  font-weight: bold;
  letter-spacing: -1rpx;
  color: #1d1d1f;
}

.card-title--light {
  color: #fff;
}

.card-desc {
  font-size: 24rpx;
  color: #8e8e93;
  margin-top: 6rpx;
  line-height: 1.4;
}

.card-desc--light {
  color: #999;
}

/* 产品上新 — 4:3 全图 + 左下角文案（比例盒在 media 内，避免 image 高度为 0） */
.hub-page .new-card-media {
  width: 100%;
  position: relative;
  height: 0;
  padding-bottom: 75%;
  overflow: hidden;
}

.hub-page .new-card-media::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 45%;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.42) 100%);
  pointer-events: none;
  z-index: 1;
}

.hub-page .new-card-media .new-card-bg {
  width: 100%;
  height: 100%;
  position: absolute;
  left: 0;
  top: 0;
  z-index: 1;
  display: block;
}

.hub-page .new-card-swiper {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.hub-page .new-card-empty-upload {
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, #f6f7fb 0%, #eceff6 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.hub-page .new-card-empty-upload-plus {
  font-size: 64rpx;
  line-height: 1;
  color: #007aff;
  font-weight: 300;
}

.hub-page .new-card-empty-upload-text {
  font-size: 24rpx;
  color: #6b7280;
}

.hub-page .new-card-media .new-card-bg--placeholder {
  background: #e8e8ed;
  display: flex;
  align-items: center;
  justify-content: center;
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}

.hub-page .new-card-placeholder-icon {
  width: 88rpx;
  height: 88rpx;
  opacity: 0.35;
  position: relative;
  z-index: 1;
}

.hub-page .new-card-overlay {
  position: absolute;
  z-index: 2;
  left: 28rpx;
  right: auto;
  bottom: 24rpx;
  top: auto !important;
  width: auto;
  max-width: 78%;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: flex-start;
  pointer-events: none;
}

.hub-page .new-card-badge {
  display: inline-block;
  padding: 8rpx 18rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #1d1d1f;
  margin-bottom: 10rpx;
  line-height: 1.2;
}

.hub-page .new-card-overlay .new-card-title {
  color: #fff;
  text-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.28);
}

.hub-page .new-card-edit {
  position: absolute;
  z-index: 3;
  top: 24rpx;
  right: 24rpx;
  padding: 10rpx 22rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #1d1d1f;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 999rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.hub-page .new-card-del-btn {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  z-index: 4;
  width: 42rpx;
  height: 42rpx;
  border-radius: 21rpx;
  background: #ff3b30;
  color: #fff;
  font-size: 26rpx;
  line-height: 42rpx;
  text-align: center;
  font-weight: 600;
}

.hub-page .new-card-admin-tools {
  margin: 14rpx 14rpx 0;
  display: flex;
  gap: 10rpx;
  align-items: center;
}

.hub-page .new-card-tool-btn {
  flex: 1;
  text-align: center;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #111827;
  background: #fff;
  border-radius: 999rpx;
  border: 1rpx solid #e5e7eb;
}

.hub-page .new-card-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #1d1d1f;
  letter-spacing: -1rpx;
  line-height: 1.15;
}

.hub-page .new-card-desc {
  display: block;
  font-size: 26rpx;
  color: #3a3a3c;
  margin-top: 10rpx;
  line-height: 1.35;
}

/* Bento */
.hub-page .bento-row {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  gap: 12rpx;
  margin-bottom: 0;
  width: 100%;
  box-sizing: border-box;
}

/* 案例大卡：右上图标 + 左下文案 */
.hub-page .bento-item-main {
  position: relative;
  flex: 1;
  flex-shrink: 1;
  min-width: 0;
  width: 0;
  height: 300rpx;
  padding: 24rpx 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: stretch;
  margin-bottom: 0;
  box-sizing: border-box;
  overflow: hidden;
}

.hub-page .bento-item-main .bento-card-icon {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  z-index: 2;
  opacity: 0.92;
}

.bento-info--main {
  position: relative;
  z-index: 1;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding-right: 76rpx;
  padding-bottom: 12rpx; /* 与右侧「维修中心」标题底线对齐 */
  box-sizing: border-box;
}

.bento-main-tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  margin-bottom: 10rpx;
  border-radius: 12rpx;
  background: rgba(0, 122, 255, 0.1);
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #007aff;
  line-height: 1.2;
}

.bento-main-title.card-title-sm {
  margin-top: 0;
}

.bento-main-desc.card-desc-sm {
  margin-top: 10rpx;
}

.card-title-sm {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #1d1d1f;
  letter-spacing: -0.5rpx;
  line-height: 1.2;
  margin-top: 0;
}

.card-desc-sm {
  display: block;
  font-size: 26rpx;
  color: #86868b;
  margin-top: 12rpx;
  line-height: 1.45;
  font-weight: 400;
}

.hub-page .bento-col {
  flex: 1;
  flex-shrink: 1;
  min-width: 0;
  width: 0;
  height: 300rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  box-sizing: border-box;
}

.hub-page .bento-item-sub {
  flex: 1;
  height: 0;
  min-height: 0;
  padding: 20rpx 20rpx;
  margin-bottom: 0;
  box-sizing: border-box;
  display: flex;
  align-items: stretch;
}

.bento-sub-inner {
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  text-align: left;
  gap: 14rpx;
}

.hub-page .bento-sub-icon {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
}

.sub-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  text-align: left;
  gap: 4rpx;
  width: auto;
}

.card-title-xs {
  font-size: 28rpx;
  font-weight: 700;
  color: #1d1d1f;
  line-height: 1.25;
}

.card-desc-xs {
  font-size: 24rpx;
  color: #86868b;
  margin-top: 4rpx;
  line-height: 1.4;
  font-weight: 400;
}

.sub-icon-img {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
}

.hub-page .bento-item-half {
  flex: 1;
  flex-shrink: 1;
  min-width: 0;
  width: 0;
  min-height: 132rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: center;
  padding: 20rpx 20rpx;
  margin-bottom: 0;
  box-sizing: border-box;
}

.hub-page .bento-half-inner {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  gap: 14rpx;
  width: 100%;
}

.hub-page .bento-half-icon {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
}

.bento-half-title {
  text-align: left;
  flex: 1;
  min-width: 0;
}

/* 列表组：左文案 + 右图标（毛玻璃） */
.hub-page .list-group {
  margin-bottom: 48rpx;
  background: rgba(255, 255, 255, 0.52);
  border-radius: 52rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 40rpx rgba(15, 23, 42, 0.06);
  backdrop-filter: blur(28px) saturate(1.25);
  -webkit-backdrop-filter: blur(28px) saturate(1.25);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
}

.list-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 32rpx;
  box-sizing: border-box;
}

.list-item--line {
  border-bottom: 1rpx solid #ebebf0;
}

.list-hover {
  background-color: rgba(255, 255, 255, 0.35);
}

.list-content {
  flex: 1;
  min-width: 0;
  padding-right: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
}

.list-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1d1d1f;
  line-height: 1.25;
}

.list-desc {
  font-size: 24rpx;
  color: #86868b;
  line-height: 1.45;
  font-weight: 400;
}

.hub-page .list-icon-box {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.75);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: none;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.hub-page .list-icon-img {
  width: 40rpx;
  height: 40rpx;
}
