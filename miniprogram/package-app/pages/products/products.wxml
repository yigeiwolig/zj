<!-- pages/products/products.wxml — Bento 功能枢纽 -->
<view class="header hub-header" style="padding-top: {{statusBarHeight}}px;">
  <view class="back-icon" catchtap="goBack" style="top: {{statusBarHeight + 4}}px;">
    <text class="back-arrow">‹</text>
  </view>
</view>

<scroll-view scroll-y class="hub-scroll" enhanced show-scrollbar="{{false}}" style="padding-top: {{statusBarHeight + 52}}px;">
  <view class="hub-page-container">

    <!-- 1. 顶部搜索 -->
    <view class="hub-search-section">
      <view class="hub-search-bar" bindtap="onHubSearchTap">
        <text class="hub-search-icon">⌕</text>
        <text class="hub-search-placeholder">搜索产品或服务</text>
      </view>
      <view wx:if="{{isAuthorized}}" class="hub-admin-chip" catchtap="toggleDrawer">管理</view>
    </view>

    <!-- 2. 品牌画廊 -->
    <swiper
      wx:if="{{hubBanners.length > 0}}"
      class="hub-banner-swiper"
      indicator-dots="{{hubBanners.length > 1}}"
      indicator-color="rgba(255,255,255,0.35)"
      indicator-active-color="#ffffff"
      autoplay="{{hubBanners.length > 1}}"
      circular="{{hubBanners.length > 1}}"
      interval="4500"
      duration="400"
    >
      <block wx:for="{{hubBanners}}" wx:key="_id">
        <swiper-item>
          <view
            class="hub-banner-item {{item.cover ? 'hub-banner-item--img' : ''}}"
            bindtap="onHubBannerTap"
            data-id="{{item._id}}"
          >
            <image wx:if="{{item.cover}}" class="hub-banner-img" src="{{item.cover}}" mode="aspectFill" />
            <view class="hub-banner-overlay"></view>
            <text class="hub-banner-title">{{item.title}}</text>
          </view>
        </swiper-item>
      </block>
    </swiper>

    <!-- 3. Bento 核心功能区 -->
    <view class="hub-section-title">核心中心</view>
    <view class="hub-bento-grid">
      <view
        wx:if="{{hubHero}}"
        class="hub-tile hub-hero-card {{!isAuthorized && hubHero.pageEnabled === false ? 'hub-tile--disabled' : ''}}"
        hover-class="hub-tile-active"
        bindtap="onHubFeatureTap"
        data-id="{{hubHero.id}}"
      >
        <view class="hub-hero-inner">
          <view class="hub-hero-top">
            <text class="hub-hero-title">{{hubHero.title}}</text>
            <image class="hub-hero-icon" src="{{hubHero.iconSvg}}" mode="aspectFit" />
          </view>
          <text class="hub-hero-desc">{{hubHero.hint || '浏览配件与实时价格'}}</text>
        </view>
      </view>

      <view
        wx:if="{{hubMidNew}}"
        class="hub-tile hub-mid-card hub-mid-card--blue {{!isAuthorized && hubMidNew.pageEnabled === false ? 'hub-tile--disabled' : ''}}"
        hover-class="hub-tile-active"
        bindtap="onHubFeatureTap"
        data-id="{{hubMidNew.id}}"
      >
        <image class="hub-mid-icon" src="{{hubMidNew.iconSvg}}" mode="aspectFit" />
        <view class="hub-mid-info">
          <text class="hub-mid-title">{{hubMidNew.title}}</text>
          <text class="hub-mid-desc">{{hubMidNew.hint || '查看最新上架'}}</text>
        </view>
      </view>

      <view
        wx:if="{{hubMidControl}}"
        class="hub-tile hub-mid-card {{!isAuthorized && hubMidControl.pageEnabled === false ? 'hub-tile--disabled' : ''}}"
        hover-class="hub-tile-active"
        bindtap="onHubFeatureTap"
        data-id="{{hubMidControl.id}}"
      >
        <image class="hub-mid-icon" src="{{hubMidControl.iconSvg}}" mode="aspectFit" />
        <view class="hub-mid-info">
          <text class="hub-mid-title">{{hubMidControl.title}}</text>
          <text class="hub-mid-desc">{{hubMidControl.hint || '连接设备并调节'}}</text>
        </view>
      </view>
    </view>

    <!-- 4. 快捷服务（8 个小入口） -->
    <view class="hub-section-title">快捷服务</view>
    <view class="hub-mini-grid">
      <block wx:for="{{hubMinis}}" wx:key="id">
        <view
          class="hub-mini-item {{!isAuthorized && item.pageEnabled === false ? 'hub-tile--disabled' : ''}}"
          hover-class="hub-mini-active"
          bindtap="onHubFeatureTap"
          data-id="{{item.id}}"
        >
          <view class="hub-mini-icon-box">
            <image class="hub-mini-icon" src="{{item.iconSvg}}" mode="aspectFit" />
          </view>
          <text class="hub-mini-label">{{item.hubShortLabel || item.title}}</text>
        </view>
      </block>
    </view>

    <view class="hub-safe-bottom"></view>
  </view>
</scroll-view>

<!-- 遮罩层 -->
<view class="drawer-mask" bindtap="closeDrawer" wx:if="{{isDrawerOpen}}"></view>

<!-- 底部抽屉：全部功能 + 管理员开关 -->
<view class="bottom-drawer {{isDrawerOpen ? 'open' : ''}}">
  <view
    class="drawer-handle-area"
    bindtouchstart="onDrawerTouchStart"
    bindtouchmove="onDrawerTouchMove"
    bindtouchend="onDrawerTouchEnd"
    catchtap="closeDrawer"
  >
    <view class="drawer-handle-bar"></view>
  </view>

  <view class="drawer-content">
    <view class="drawer-admin-bar" wx:if="{{isAuthorized}}">
      <text class="drawer-admin-title">管理员</text>
      <text class="drawer-admin-desc">右侧开关：开=可进入；关=对用户不可进入</text>
    </view>
    <view class="function-grid">
      <block wx:for="{{list}}" wx:key="id">
        <view
          class="function-card {{!isAuthorized && item.pageEnabled === false ? 'fc-disabled' : ''}}"
          catchtap="onFunctionTap"
          data-id="{{item.id}}"
        >
          <view class="fc-icon-box">
            <image class="fc-icon" src="{{item.iconSvg}}" mode="aspectFit" lazy-load="true" />
          </view>
          <view class="fc-info">
            <text class="fc-title">{{item.title}}</text>
            <text class="fc-hint" wx:if="{{item.hint}}">{{item.hint}}</text>
          </view>
          <view class="fc-switch-wrap" wx:if="{{isAuthorized}}" catchtap="noop">
            <text class="fc-switch-label {{item.pageEnabled ? 'is-on' : 'is-off'}}">{{item.pageEnabled ? '开放' : '关闭'}}</text>
            <switch
              class="fc-feature-switch"
              checked="{{item.pageEnabled}}"
              data-id="{{item.id}}"
              bindchange="onFeatureFlagChange"
              color="#34C759"
            />
          </view>
        </view>
      </block>
    </view>
  </view>
</view>

<!-- 自动消失提示 -->
<view class="auto-toast-mask {{autoToastClosing ? 'closing' : ''}}" wx:if="{{autoToast.show}}" catchtouchmove="noop" bindtap="dismissTransientModals">
  <view class="auto-toast-box" catchtouchmove="noop" bindtap="dismissTransientModals">
    <view class="at-title">{{autoToast.title}}</view>
    <view class="at-content">{{autoToast.content}}</view>
  </view>
</view>

<!-- 加载动画 -->
<view class="loading-mask" wx:if="{{showLoadingAnimation}}" catchtouchmove="noop" catchtap="noop">
  <view class="loader" catchtouchmove="noop" catchtap="noop">
    <text class="loader-label">请稍候...</text>
    <view class="loading-bar"></view>
  </view>
</view>

<!-- 产品上新弹窗 -->
<view class="new-arrival-mask {{newArrivalClosing ? 'is-closing' : ''}} {{newArrivalAnimIn && !newArrivalClosing ? 'na-mask-in' : ''}}" wx:if="{{showNewArrivalModal}}" catchtouchmove="noop" bindtap="dismissTransientModals">
  <view class="new-arrival-box {{newArrivalClosing ? 'is-closing' : ''}} {{newArrivalAnimIn && !newArrivalClosing ? 'na-box-in' : ''}}" bindtap="dismissTransientModals" catchtouchmove="noop">
    <view class="na-bg-glow"></view>
    <view class="na-close-icon" catchtap="closeNewArrivalModal">×</view>

    <view class="na-header-group">
      <view class="na-main-title">MT 新品推荐</view>
      <view class="na-tag-line">左右滑动查看更多</view>
    </view>

    <swiper
      class="na-swiper"
      current="{{newArrivalIndex}}"
      bindchange="onNewArrivalChange"
      circular="{{false}}"
      previous-margin="30rpx"
      next-margin="30rpx"
    >
      <block wx:for="{{newArrivalList}}" wx:key="_id">
        <swiper-item class="na-swiper-item">
          <view class="na-card">
            <block wx:if="{{item.dualCover}}">
              <image
                class="na-cover-img na-cover-low {{newArrivalHdLoaded[index] ? 'is-hidden' : ''}}"
                src="{{item.coverThumb}}"
                mode="aspectFill"
                lazy-load="{{index > 0}}"
                binderror="onNewArrivalThumbError"
                data-index="{{index}}"
              />
              <image
                class="na-cover-img na-cover-high {{newArrivalHdLoaded[index] ? 'is-visible' : ''}}"
                src="{{item.coverFull}}"
                mode="aspectFill"
                lazy-load="{{index > 0}}"
                bindload="onNewArrivalHdLoad"
                binderror="onNewArrivalImageError"
                data-index="{{index}}"
                data-kind="high"
              />
            </block>
            <block wx:else>
              <image
                class="na-cover-img"
                src="{{item.coverThumb || item.coverFull || item.cover}}"
                mode="aspectFill"
                lazy-load="{{index > 0}}"
                binderror="onNewArrivalImageError"
                data-index="{{index}}"
                data-kind="high"
              />
            </block>
            <view class="na-card-overlay">
              <view class="na-badge">NEW</view>
              <text class="na-name">{{item.title || 'New Product'}}</text>
            </view>
          </view>
        </swiper-item>
      </block>
    </swiper>

    <button class="na-jump-btn" catchtap="handleNewArrivalJump">
      <text>立即查看</text>
      <view class="btn-arrow">→</view>
    </button>
  </view>
</view>

<custom-toast id="custom-toast" />
