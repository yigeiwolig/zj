<!-- pages/products/products.wxml -->
<view class="hub-page hub-shell {{hubPageEnterAnim ? 'hub-page-enter' : ''}}">
  <hub-segment-bar
    wx:if="{{hubTabIndex === 0 || hubTabIndex === 1}}"
    active="{{hubTabIndex === 0 ? 'home' : 'shop'}}"
    statusBarHeight="{{statusBarHeight}}"
    bind:switch="onHubSegmentSwitch"
  />

  <view
    class="hub-panels-viewport"
    bindtouchstart="onHubPanelsTouchStart"
    bindtouchend="onHubPanelsTouchEnd"
  >
    <view
      class="hub-panels-track {{hubPanelsAnim ? 'hub-panels-track--anim' : ''}}"
      style="transform: translateX(-{{hubTrackTranslatePct}}%);"
    >
    <view class="hub-panel-slot">
  <scroll-view
    scroll-y
    class="main-content hub-home-scroll"
    enhanced
    show-scrollbar="{{false}}"
  >
    <view class="content-inner">

      <!-- 产品上新（置顶） -->
      <view
        wx:if="{{hubFeatureNew}}"
        class="card hero-card new-card {{!isAuthorized && hubFeatureNew.pageEnabled === false ? 'card--disabled' : ''}}"
        hover-class="card-hover card-hover--media"
        bindtap="onHubFeatureTap"
        data-id="{{hubFeatureNew.id}}"
      >
        <view class="new-card-media">
          <image
            wx:if="{{hubHomeCoverDisplay || hubFeatureNew.hubCover}}"
            class="new-card-bg"
            src="{{hubHomeCoverDisplay || hubFeatureNew.hubCover}}"
            mode="aspectFill"
            lazy-load="{{false}}"
            binderror="onHubCoverImageError"
          />
          <view wx:else class="new-card-bg new-card-bg--placeholder">
            <image class="new-card-placeholder-icon" src="{{hubFeatureNew.iconSvg}}" mode="aspectFit" />
          </view>
        </view>
        <view class="new-card-overlay">
          <view class="new-card-badge">新品</view>
          <text class="new-card-title">{{hubFeatureNew.title}}</text>
        </view>
        <view
          wx:if="{{isAuthorized}}"
          class="new-card-edit"
          catchtap="onHubAdminCoverTap"
          data-action="choose"
          hover-class="opacity-hover"
        >换封面</view>
      </view>

      <!-- 产品选购 -->
      <view
        wx:if="{{hubHero}}"
        class="card hero-card shop-card {{!isAuthorized && hubHero.pageEnabled === false ? 'card--disabled' : ''}}"
        hover-class="card-hover"
        bindtap="onHubFeatureTap"
        data-id="{{hubHero.id}}"
      >
        <view class="shop-card-body">
          <view class="card-info shop-card-info">
            <text class="tag-label tag-label--shop">SHOP</text>
            <text class="shop-card-title">{{hubHero.title}}</text>
          </view>
          <image class="shop-card-icon" src="{{hubHero.iconSvg}}" mode="aspectFit" />
        </view>
      </view>

      <!-- Bento：案例 + 控制中心 / 维修中心 -->
      <view class="bento-row" wx:if="{{hubFeatureCase || hubFeatureControl || hubBentoRepair}}">
        <view
          wx:if="{{hubFeatureCase}}"
          class="card bento-item-main {{!isAuthorized && hubFeatureCase.pageEnabled === false ? 'card--disabled' : ''}}"
          hover-class="card-hover"
          bindtap="onHubFeatureTap"
          data-id="{{hubFeatureCase.id}}"
        >
          <image class="bento-card-icon" src="{{hubFeatureCase.iconSvg}}" mode="aspectFit" />
          <view class="bento-info bento-info--main">
            <text class="bento-main-tag">{{hubFeatureCase.hubTag || 'FEATURED'}}</text>
            <text class="card-title-sm bento-main-title">{{hubFeatureCase.title}}</text>
          </view>
        </view>
        <view class="bento-col" wx:if="{{hubFeatureControl || hubBentoRepair}}">
          <view
            wx:if="{{hubFeatureControl}}"
            class="card bento-item-sub {{!isAuthorized && hubFeatureControl.pageEnabled === false ? 'card--disabled' : ''}}"
            hover-class="card-hover"
            bindtap="onHubFeatureTap"
            data-id="{{hubFeatureControl.id}}"
          >
            <view class="bento-sub-inner">
              <image class="bento-sub-icon" src="{{hubFeatureControl.iconSvg}}" mode="aspectFit" />
              <view class="sub-info">
                <text class="card-title-xs">{{hubFeatureControl.title}}</text>
              </view>
            </view>
          </view>
          <view
            wx:if="{{hubBentoRepair}}"
            class="card bento-item-sub {{!isAuthorized && hubBentoRepair.pageEnabled === false ? 'card--disabled' : ''}}"
            hover-class="card-hover"
            bindtap="onHubFeatureTap"
            data-id="{{hubBentoRepair.id}}"
          >
            <view class="bento-sub-inner">
              <image class="bento-sub-icon" src="{{hubBentoRepair.iconSvg}}" mode="aspectFit" />
              <view class="sub-info">
                <text class="card-title-xs">{{hubBentoRepair.title}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 安装教程 + OTA -->
      <view class="bento-row" wx:if="{{hubBentoTutorial || hubBentoOta}}">
        <view
          wx:if="{{hubBentoTutorial}}"
          class="card bento-item-half {{!isAuthorized && hubBentoTutorial.pageEnabled === false ? 'card--disabled' : ''}}"
          hover-class="card-hover"
          bindtap="onHubFeatureTap"
          data-id="{{hubBentoTutorial.id}}"
        >
          <view class="bento-half-inner">
            <image class="bento-half-icon" src="{{hubBentoTutorial.iconSvg}}" mode="aspectFit" />
            <text class="card-title-xs bento-half-title">{{hubBentoTutorial.title}}</text>
          </view>
        </view>
        <view
          wx:if="{{hubBentoOta}}"
          class="card bento-item-half {{!isAuthorized && hubBentoOta.pageEnabled === false ? 'card--disabled' : ''}}"
          hover-class="card-hover"
          bindtap="onHubFeatureTap"
          data-id="{{hubBentoOta.id}}"
        >
          <view class="bento-half-inner">
            <image class="bento-half-icon" src="{{hubBentoOta.iconSvg}}" mode="aspectFit" />
            <text class="card-title-xs bento-half-title">{{hubBentoOta.title}}</text>
          </view>
        </view>
      </view>

      <!-- 列表组 -->
      <view class="list-group" wx:if="{{hubListItems.length > 0}}">
        <block wx:for="{{hubListItems}}" wx:key="id">
          <view
            class="list-item {{index < hubListItems.length - 1 ? 'list-item--line' : ''}} {{!isAuthorized && item.pageEnabled === false ? 'card--disabled' : ''}}"
            hover-class="list-hover"
            bindtap="onHubFeatureTap"
            data-id="{{item.id}}"
          >
            <view class="list-content">
              <text class="list-title">{{item.title}}</text>
            </view>
            <view class="list-icon-box">
              <image class="list-icon-img" src="{{item.iconSvg}}" mode="aspectFit" />
            </view>
          </view>
        </block>
      </view>

    </view>
  </scroll-view>

  <view
    wx:if="{{isAuthorized && hubTabIndex === 0}}"
    class="hub-admin-fab hub-admin-fab--in-slot"
    catchtap="toggleDrawer"
    hover-class="hub-admin-fab--pressed"
  >
    <text class="hub-admin-fab-text">管理</text>
  </view>

    </view>

    <view class="hub-panel-slot hub-panel-slot--shop">
      <shop-embed
        id="hubShopPanel"
        active="{{hubTabIndex === 1}}"
        shell-authorized="{{isAuthorized}}"
        shell-admin="{{hubShellIsAdmin}}"
        shell-status-bar-height="{{statusBarHeight}}"
        embed-scroll-height="{{hubShopEmbedScrollHeight}}"
        bind:segment="onHubSegmentSwitch"
      />
    </view>

    <view class="hub-panel-slot">
      <hub-orders-panel
        id="hubOrdersPanel"
        active="{{hubTabIndex === 2}}"
        shell-authorized="{{isAuthorized}}"
        shell-admin="{{hubShellIsAdmin}}"
        bind:switch="onHubTabSwitch"
        bind:adminchange="onHubAdminChange"
      />
    </view>

    <view class="hub-panel-slot">
      <hub-profile-panel
        id="hubProfilePanel"
        active="{{hubTabIndex === 3}}"
        shell-authorized="{{isAuthorized}}"
        shell-admin="{{hubShellIsAdmin}}"
        bind:switch="onHubTabSwitch"
        bind:adminchange="onHubAdminChange"
      />
    </view>
    </view>
  </view>

  <view
    wx:if="{{hubTabIndex === 0}}"
    class="hub-home-float-cart"
    catchtap="onHubHomeCartTap"
  >
    <view class="hub-home-float-cart-inner">
      <image class="hub-home-float-cart-svg" src="/images/shop-float-cart.svg" mode="aspectFit" />
      <text class="hub-home-float-mt">MT</text>
    </view>
    <view class="hub-home-float-cart-badge" wx:if="{{hubCartBadge > 0}}">{{hubCartBadge > 99 ? '99+' : hubCartBadge}}</view>
  </view>

  <view class="hub-tab-bar-wrap {{showHubTabBar ? 'hub-tab-bar-wrap--show' : ''}}">
    <hub-tab-bar active="{{hubBottomBarIndex}}" anim="{{hubPanelsAnim}}" bind:switch="onHubTabSwitch" />
  </view>
</view>

<view class="drawer-mask" bindtap="closeDrawer" wx:if="{{isDrawerOpen}}"></view>

<view class="bottom-drawer {{isDrawerOpen ? 'open' : ''}}">
  <view
    class="drawer-handle-area"
    bindtouchstart="onDrawerTouchStart"
    bindtouchmove="onDrawerTouchMove"
    bindtouchend="onDrawerTouchEnd"
    catchtap="closeDrawer"
  >
    <view class="drawer-handle-bar"></view>
  </view>
  <view class="drawer-content">
    <view class="drawer-admin-bar" wx:if="{{isAuthorized}}">
      <text class="drawer-admin-title">管理员</text>
      <text class="drawer-admin-desc">右侧开关：开=可进入；关=对用户不可进入</text>
    </view>
    <view class="hub-cover-admin" wx:if="{{isAuthorized}}">
      <view class="hub-cover-admin-head">
        <text class="hub-cover-admin-title">首页「产品上新」封面</text>
        <text class="hub-cover-admin-hint">与 pagenew 独立，建议 4:3 横图</text>
      </view>
      <view class="hub-cover-admin-preview">
        <image
          wx:if="{{hubHomeCoverDisplay}}"
          class="hub-cover-admin-img"
          src="{{hubHomeCoverDisplay}}"
          mode="aspectFill"
        />
        <view wx:else class="hub-cover-admin-empty">未设置（将使用列表首图占位）</view>
      </view>
      <view class="hub-cover-admin-actions">
        <view class="hub-cover-admin-btn hub-cover-admin-btn--primary" catchtap="onHubAdminCoverTap" data-action="choose">上传 / 更换</view>
        <view
          wx:if="{{hubHomeCoverFileId}}"
          class="hub-cover-admin-btn"
          catchtap="onHubAdminCoverTap"
          data-action="clear"
        >清除</view>
      </view>
    </view>
    <view class="function-grid">
      <block wx:for="{{list}}" wx:key="id">
        <view
          class="function-card {{!isAuthorized && item.pageEnabled === false ? 'fc-disabled' : ''}}"
          catchtap="onFunctionTap"
          data-id="{{item.id}}"
        >
          <view class="fc-icon-box">
            <image class="fc-icon" src="{{item.iconSvg}}" mode="aspectFit" lazy-load="true" />
          </view>
          <view class="fc-info">
            <text class="fc-title">{{item.title}}</text>
            <text class="fc-hint" wx:if="{{item.hint}}">{{item.hint}}</text>
          </view>
          <view class="fc-switch-wrap" wx:if="{{isAuthorized}}" catchtap="noop">
            <text class="fc-switch-label {{item.pageEnabled ? 'is-on' : 'is-off'}}">{{item.pageEnabled ? '开放' : '关闭'}}</text>
            <switch
              class="fc-feature-switch"
              checked="{{item.pageEnabled}}"
              data-id="{{item.id}}"
              bindchange="onFeatureFlagChange"
              color="#34C759"
            />
          </view>
        </view>
      </block>
    </view>
  </view>
</view>

<view class="auto-toast-mask {{autoToastClosing ? 'closing' : ''}}" wx:if="{{autoToast.show}}" catchtouchmove="noop" bindtap="dismissTransientModals">
  <view class="auto-toast-box" catchtouchmove="noop" bindtap="dismissTransientModals">
    <view class="at-title">{{autoToast.title}}</view>
    <view class="at-content">{{autoToast.content}}</view>
  </view>
</view>

<view class="loading-mask" wx:if="{{showLoadingAnimation}}" catchtouchmove="noop" catchtap="noop">
  <view class="loader" catchtouchmove="noop" catchtap="noop">
    <text class="loader-label">请稍候...</text>
    <view class="loading-bar"></view>
  </view>
</view>

<view class="new-arrival-mask {{newArrivalClosing ? 'is-closing' : ''}} {{newArrivalAnimIn && !newArrivalClosing ? 'na-mask-in' : ''}}" wx:if="{{showNewArrivalModal}}" catchtouchmove="noop" bindtap="dismissTransientModals">
  <view class="new-arrival-box {{newArrivalClosing ? 'is-closing' : ''}} {{newArrivalAnimIn && !newArrivalClosing ? 'na-box-in' : ''}}" bindtap="dismissTransientModals" catchtouchmove="noop">
    <view class="na-bg-glow"></view>
    <view class="na-close-icon" catchtap="closeNewArrivalModal">×</view>
    <view class="na-header-group">
      <view class="na-main-title">MT 新品推荐</view>
      <view class="na-tag-line">左右滑动查看更多</view>
    </view>
    <swiper
      class="na-swiper"
      current="{{newArrivalIndex}}"
      bindchange="onNewArrivalChange"
      circular="{{false}}"
      previous-margin="30rpx"
      next-margin="30rpx"
    >
      <block wx:for="{{newArrivalList}}" wx:key="_id">
        <swiper-item class="na-swiper-item">
          <view class="na-card">
            <block wx:if="{{item.dualCover}}">
              <image
                class="na-cover-img na-cover-low {{newArrivalHdLoaded[index] ? 'is-hidden' : ''}}"
                src="{{item.coverThumb}}"
                mode="aspectFill"
                lazy-load="{{index > 0}}"
                binderror="onNewArrivalThumbError"
                data-index="{{index}}"
              />
              <image
                class="na-cover-img na-cover-high {{newArrivalHdLoaded[index] ? 'is-visible' : ''}}"
                src="{{item.coverFull}}"
                mode="aspectFill"
                lazy-load="{{index > 0}}"
                bindload="onNewArrivalHdLoad"
                binderror="onNewArrivalImageError"
                data-index="{{index}}"
                data-kind="high"
              />
            </block>
            <block wx:else>
              <image
                class="na-cover-img"
                src="{{item.coverThumb || item.coverFull || item.cover}}"
                mode="aspectFill"
                lazy-load="{{index > 0}}"
                binderror="onNewArrivalImageError"
                data-index="{{index}}"
                data-kind="high"
              />
            </block>
            <view class="na-card-overlay">
              <view class="na-badge">NEW</view>
              <text class="na-name">{{item.title || 'New Product'}}</text>
            </view>
          </view>
        </swiper-item>
      </block>
    </swiper>
    <button class="na-jump-btn" catchtap="handleNewArrivalJump">
      <text>立即查看</text>
      <view class="btn-arrow">→</view>
    </button>
  </view>
</view>

<custom-toast id="custom-toast" />
