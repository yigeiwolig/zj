<!-- pages/products/products.wxml -->
<view class="hub-page hub-shell {{hubPageEnterAnim ? 'hub-page-enter' : ''}}">
  <hub-segment-bar
    wx:if="{{hubTabIndex === 0 || hubTabIndex === 1}}"
    active="{{hubTabIndex === 0 ? 'home' : 'shop'}}"
    statusBarHeight="{{statusBarHeight}}"
    bind:switch="onHubSegmentSwitch"
  />
  <view
    wx:if="{{isAuthorized && hubTabIndex === 0}}"
    class="hub-admin-entry-bar"
  >
    <view
      class="hub-admin-entry-btn"
      catchtap="onHubAdminModeToggle"
      hover-class="hub-admin-entry-btn--pressed"
    >
      {{hubShellIsAdmin ? '退出管理员' : '管理员切换'}}
    </view>
  </view>

  <view
    class="hub-panels-viewport"
    bindtouchstart="onHubPanelsTouchStart"
    bindtouchend="onHubPanelsTouchEnd"
  >
    <view
      class="hub-panels-track {{hubPanelsAnim ? 'hub-panels-track--anim' : ''}}"
      style="transform: translateX(-{{hubTrackTranslatePct}}%);"
    >
    <view class="hub-panel-slot">
  <scroll-view
    scroll-y
    class="main-content hub-home-scroll"
    enhanced
    show-scrollbar="{{false}}"
  >
    <view class="content-inner hub-home-layout">

      <!-- 产品上新（有素材时展示） -->
      <view
        wx:if="{{hubFeatureNew && (hubHomeMediaList.length > 0 || hubHomeCoverDisplay || hubFeatureNew.hubCover || isAuthorized)}}"
        class="card hero-card new-card hub-home-hero {{!isAuthorized && hubFeatureNew.pageEnabled === false ? 'card--disabled' : ''}}"
        hover-class="card-hover card-hover--media"
        bindtap="onHubFeatureTap"
        data-id="{{hubFeatureNew.id}}"
      >
        <view class="new-card-media">
          <swiper
            wx:if="{{hubHomeMediaList.length > 0}}"
            class="new-card-swiper"
            indicator-dots="{{hubHomeMediaList.length > 1}}"
            circular="{{hubHomeMediaList.length > 1}}"
            autoplay="{{hubHomeSwiperAutoplay}}"
            disable-touch="{{isAuthorized && hubShellIsAdmin}}"
            interval="2600"
            duration="280"
            current="{{hubHomeMediaCurrent}}"
            bindchange="onHubHomeMediaSwiperChange"
            catchtouchstart="onHubNewCardTouchStart"
            catchtouchend="onHubNewCardTouchEnd"
          >
            <block wx:for="{{hubHomeMediaList}}" wx:key="url">
              <swiper-item>
                <video
                  wx:if="{{item.type === 'video'}}"
                  class="new-card-bg"
                  src="{{item.url}}"
                  object-fit="cover"
                  autoplay="{{item.autoplay === true}}"
                  muted
                  loop="{{false}}"
                  show-center-play-btn="{{false}}"
                  show-play-btn="{{false}}"
                  enable-progress-gesture="{{false}}"
                  controls="{{false}}"
                  bindended="onHubHomeMediaVideoEnded"
                />
                <image
                  wx:else
                  class="new-card-bg"
                  src="{{item.url}}"
                  mode="aspectFill"
                  lazy-load="{{false}}"
                  binderror="onHubCoverImageError"
                />
              </swiper-item>
            </block>
          </swiper>
          <image
            wx:elif="{{hubHomeCoverDisplay || hubFeatureNew.hubCover}}"
            class="new-card-bg"
            src="{{hubHomeCoverDisplay || hubFeatureNew.hubCover}}"
            catchtouchstart="onHubNewCardTouchStart"
            catchtouchend="onHubNewCardTouchEnd"
            mode="aspectFill"
            lazy-load="{{false}}"
            binderror="onHubCoverImageError"
          />
          <view wx:else class="new-card-bg new-card-bg--placeholder">
            <image class="new-card-placeholder-icon" src="{{hubFeatureNew.iconSvg}}" mode="aspectFit" />
          </view>
          <view
            wx:if="{{isAuthorized && hubShellIsAdmin && hubHomeMediaList.length > 0}}"
            class="new-card-del-btn"
            catchtap="onHubAdminMediaDeleteCurrent"
          >✕</view>
        </view>
        <view class="new-card-overlay">
          <view class="new-card-badge">新品</view>
          <text class="new-card-title">{{hubFeatureNew.title}}</text>
        </view>
        <view wx:if="{{isAuthorized && hubShellIsAdmin}}" class="new-card-admin-tools" catchtap="noop">
          <view class="new-card-tool-btn" catchtap="onHubAdminMediaAddTap">添加图片/视频</view>
          <view class="new-card-tool-btn" catchtap="onHubAdminMediaSortTap">调整顺序</view>
          <view class="new-card-tool-btn" catchtap="onHubAdminMediaAutoplayTap">{{hubHomeMediaAutoplay ? '自动切卡开' : '自动切卡关'}}</view>
        </view>
      </view>

      <!-- 产品选购 -->
      <view
        wx:if="{{hubHero}}"
        class="hub-shop-card {{!isAuthorized && hubHero.pageEnabled === false ? 'card--disabled' : ''}}"
        hover-class="hub-card-hover"
        catchtap="onHubFeatureTap"
        data-id="{{hubHero.id}}"
      >
        <view class="hub-shop-card-info">
          <text class="hub-shop-title">{{hubHero.title}}</text>
          <text class="hub-shop-desc">选配高端硬件 · 实时库存同步</text>
        </view>
        <view class="hub-shop-cta-row">
          <view class="hub-shop-cta">
            <text class="hub-shop-cta-text">GO</text>
          </view>
        </view>
      </view>

      <!-- Bento + 胶囊：共用二列网格，左列对齐安装教程，右列对齐 OTA -->
      <view
        class="hub-two-col-layout"
        wx:if="{{hubFeatureCase || hubFeatureControl || hubBentoRepair || hubBentoTutorial || hubBentoOta}}"
      >
        <view
          wx:if="{{hubFeatureCase}}"
          class="hub-col-left"
        >
          <view
            class="card hub-bento-main {{!isAuthorized && hubFeatureCase.pageEnabled === false ? 'card--disabled' : ''}}"
            hover-class="hub-card-hover"
            bindtap="onHubFeatureTap"
            data-id="{{hubFeatureCase.id}}"
          >
            <image class="hub-bento-main-icon" src="{{hubFeatureCase.iconSvg}}" mode="aspectFit" />
            <view class="hub-bento-main-foot">
              <text class="hub-bento-tag">GALLERY</text>
              <text class="hub-bento-main-title">{{hubFeatureCase.title}}</text>
            </view>
          </view>
        </view>
        <view
          class="hub-col-right"
          wx:if="{{hubFeatureControl || hubBentoRepair}}"
        >
          <view class="hub-bento-col">
            <view
              wx:if="{{hubFeatureControl}}"
              class="card hub-bento-sub {{!isAuthorized && hubFeatureControl.pageEnabled === false ? 'card--disabled' : ''}}"
              hover-class="hub-card-hover"
              bindtap="onHubFeatureTap"
              data-id="{{hubFeatureControl.id}}"
            >
              <image class="hub-bento-sub-icon" src="{{hubFeatureControl.iconSvg}}" mode="aspectFit" />
              <view class="hub-bento-sub-text">
                <text class="hub-bento-sub-title">{{hubFeatureControl.title}}</text>
              </view>
            </view>
            <view
              wx:if="{{hubBentoRepair}}"
              class="card hub-bento-sub {{!isAuthorized && hubBentoRepair.pageEnabled === false ? 'card--disabled' : ''}}"
              hover-class="hub-card-hover"
              bindtap="onHubFeatureTap"
              data-id="{{hubBentoRepair.id}}"
            >
              <image class="hub-bento-sub-icon" src="{{hubBentoRepair.iconSvg}}" mode="aspectFit" />
              <view class="hub-bento-sub-text">
                <text class="hub-bento-sub-title">{{hubBentoRepair.title}}</text>
              </view>
            </view>
          </view>
        </view>
        <view
          wx:if="{{hubBentoTutorial}}"
          class="hub-col-left"
        >
          <view
            class="hub-pill-btn {{!isAuthorized && hubBentoTutorial.pageEnabled === false ? 'card--disabled' : ''}}"
            hover-class="hub-card-hover"
            bindtap="onHubFeatureTap"
            data-id="{{hubBentoTutorial.id}}"
          >
            <image class="hub-pill-icon" src="{{hubBentoTutorial.iconSvg}}" mode="aspectFit" />
            <view class="hub-pill-label">
              <text class="hub-pill-title">{{hubBentoTutorial.title}}</text>
            </view>
          </view>
        </view>
        <view
          wx:if="{{hubBentoOta}}"
          class="hub-col-right"
        >
          <view
            class="hub-pill-btn {{!isAuthorized && hubBentoOta.pageEnabled === false ? 'card--disabled' : ''}}"
            hover-class="hub-card-hover"
            bindtap="onHubFeatureTap"
            data-id="{{hubBentoOta.id}}"
          >
            <image class="hub-pill-icon" src="{{hubBentoOta.iconSvg}}" mode="aspectFit" />
            <view class="hub-pill-label">
              <text class="hub-pill-title">{{hubBentoOta.title}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 底部菜单列表 -->
      <view class="hub-menu-card" wx:if="{{hubListItems.length > 0}}">
        <block wx:for="{{hubListItems}}" wx:key="id">
          <view
            class="hub-menu-item {{index < hubListItems.length - 1 ? 'hub-menu-item--line' : ''}} {{!isAuthorized && item.pageEnabled === false ? 'card--disabled' : ''}}"
            hover-class="hub-menu-item-hover"
            bindtap="onHubFeatureTap"
            data-id="{{item.id}}"
          >
            <text class="hub-menu-title">{{item.title}}</text>
            <view wx:if="{{item.id === 8}}" class="hub-menu-live">
              <text class="hub-menu-live-text">Live Support</text>
              <view class="hub-menu-live-dot"></view>
            </view>
            <text wx:elif="{{item.id === 13}}" class="hub-menu-en">FAQ</text>
            <text wx:elif="{{item.id === 12}}" class="hub-menu-en">NEARBY</text>
          </view>
        </block>
      </view>

    </view>
  </scroll-view>

  <view
    wx:if="{{isAuthorized && hubShellIsAdmin && hubTabIndex === 0}}"
    class="hub-admin-fab hub-admin-fab--in-slot"
    catchtap="toggleDrawer"
    hover-class="hub-admin-fab--pressed"
  >
    <text class="hub-admin-fab-text">页面管理</text>
  </view>

    </view>

    <view class="hub-panel-slot hub-panel-slot--shop">
      <shop-embed
        id="hubShopPanel"
        active="{{hubTabIndex === 1}}"
        shell-authorized="{{isAuthorized}}"
        shell-admin="{{hubShellIsAdmin}}"
        shell-status-bar-height="{{statusBarHeight}}"
        embed-scroll-height="{{hubShopEmbedScrollHeight}}"
        bind:segment="onHubSegmentSwitch"
      />
    </view>

    <view class="hub-panel-slot">
      <hub-orders-panel
        id="hubOrdersPanel"
        active="{{hubTabIndex === 2}}"
        shell-authorized="{{isAuthorized}}"
        shell-admin="{{hubShellIsAdmin}}"
        bind:switch="onHubTabSwitch"
        bind:adminchange="onHubAdminChange"
        bind:shellmodal="onHubShellModal"
      />
    </view>

    <view class="hub-panel-slot">
      <hub-profile-panel
        id="hubProfilePanel"
        active="{{hubTabIndex === 3}}"
        shell-authorized="{{isAuthorized}}"
        shell-admin="{{hubShellIsAdmin}}"
        bind:switch="onHubTabSwitch"
        bind:adminchange="onHubAdminChange"
        bind:shellmodal="onHubShellModal"
      />
    </view>
    </view>
  </view>

  <view
    wx:if="{{hubTabIndex === 0}}"
    class="hub-home-float-cart"
    catchtap="onHubHomeCartTap"
  >
    <view class="hub-home-float-cart-inner">
      <image class="hub-home-float-cart-svg" src="/images/shop-float-cart.svg" mode="aspectFit" />
      <text class="hub-home-float-mt">MT</text>
    </view>
    <view class="hub-home-float-cart-badge" wx:if="{{hubCartBadge > 0}}">{{hubCartBadge > 99 ? '99+' : hubCartBadge}}</view>
  </view>

  <view class="hub-tab-bar-wrap {{showHubTabBar && !hubShellModalOpen ? 'hub-tab-bar-wrap--show' : ''}}">
    <hub-tab-bar active="{{hubBottomBarIndex}}" anim="{{hubPanelsAnim}}" bind:switch="onHubTabSwitch" />
  </view>
</view>

<view class="drawer-mask" bindtap="closeDrawer" wx:if="{{isDrawerOpen}}"></view>

<view class="bottom-drawer {{isDrawerOpen ? 'open' : ''}}">
  <view
    class="drawer-handle-area"
    bindtouchstart="onDrawerTouchStart"
    bindtouchmove="onDrawerTouchMove"
    bindtouchend="onDrawerTouchEnd"
    catchtap="closeDrawer"
  >
    <view class="drawer-handle-bar"></view>
  </view>
  <view class="drawer-content">
    <view class="drawer-admin-bar" wx:if="{{isAuthorized}}">
      <text class="drawer-admin-title">管理员</text>
      <text class="drawer-admin-desc">右侧开关：开=可进入；关=对用户不可进入</text>
      <text class="drawer-admin-warn" wx:if="{{featureFlagsUnsynced}}">⚠ 未同步到云端：普通用户仍按数据库旧开关显示「开发中」</text>
    </view>
    <view class="hub-cover-admin" wx:if="{{isAuthorized && hubShellIsAdmin}}">
      <view class="hub-cover-admin-head">
        <text class="hub-cover-admin-title">首页「产品上新」轮播媒体</text>
        <text class="hub-cover-admin-hint">支持多图/视频；视频可单独自动播放</text>
      </view>
      <view class="hub-cover-admin-preview">
        <swiper
          wx:if="{{hubHomeMediaList.length > 0}}"
          class="hub-cover-admin-swiper"
          indicator-dots="{{hubHomeMediaList.length > 1}}"
          circular="{{hubHomeMediaList.length > 1}}"
          autoplay="{{false}}"
          interval="2600"
          duration="280"
        >
          <block wx:for="{{hubHomeMediaList}}" wx:key="url">
            <swiper-item>
              <video wx:if="{{item.type === 'video'}}" class="hub-cover-admin-img" src="{{item.url}}" object-fit="cover" muted autoplay="{{false}}" controls="{{false}}" />
              <image wx:else class="hub-cover-admin-img" src="{{item.url}}" mode="aspectFill" />
            </swiper-item>
          </block>
        </swiper>
        <view wx:else class="hub-cover-admin-empty">未设置（将使用列表首图占位）</view>
      </view>
      <view class="hub-cover-admin-switch">
        <text class="hub-cover-admin-switch-label">自动轮播</text>
        <switch checked="{{hubHomeMediaAutoplay}}" color="#34C759" bindchange="onHubHomeMediaAutoplayChange" />
      </view>
      <view class="hub-cover-admin-actions">
        <view class="hub-cover-admin-btn hub-cover-admin-btn--primary" catchtap="onHubAdminCoverTap" data-action="choose">上传图片/视频</view>
        <view
          wx:if="{{hubHomeMediaList.length > 0}}"
          class="hub-cover-admin-btn"
          catchtap="onHubAdminCoverTap"
          data-action="clear"
        >清除</view>
      </view>
    </view>
    <view class="function-grid">
      <block wx:for="{{list}}" wx:key="id">
        <view
          class="function-card {{!isAuthorized && item.pageEnabled === false ? 'fc-disabled' : ''}}"
          catchtap="onFunctionTap"
          data-id="{{item.id}}"
        >
          <view class="fc-icon-box">
            <image class="fc-icon" src="{{item.iconSvg}}" mode="aspectFit" lazy-load="true" />
          </view>
          <view class="fc-info">
            <text class="fc-title">{{item.title}}</text>
            <text class="fc-hint" wx:if="{{item.hint}}">{{item.hint}}</text>
          </view>
          <view class="fc-switch-wrap" wx:if="{{isAuthorized}}" catchtap="noop">
            <text class="fc-switch-label {{item.pageEnabled ? 'is-on' : 'is-off'}}">{{item.pageEnabled ? '开放' : '关闭'}}</text>
            <switch
              class="fc-feature-switch"
              checked="{{item.pageEnabled}}"
              data-id="{{item.id}}"
              bindchange="onFeatureFlagChange"
              color="#34C759"
            />
          </view>
        </view>
      </block>
    </view>
  </view>
</view>

<view class="auto-toast-mask {{autoToastClosing ? 'closing' : ''}}" wx:if="{{autoToast.show}}" catchtouchmove="noop" bindtap="dismissTransientModals">
  <view class="auto-toast-box" catchtouchmove="noop" bindtap="dismissTransientModals">
    <view class="at-title">{{autoToast.title}}</view>
    <view class="at-content">{{autoToast.content}}</view>
  </view>
</view>

<view class="loading-mask" wx:if="{{showLoadingAnimation}}" catchtouchmove="noop" catchtap="noop">
  <view class="loader" catchtouchmove="noop" catchtap="noop">
    <text class="loader-label">请稍候...</text>
    <view class="loading-bar"></view>
  </view>
</view>

<view class="new-arrival-mask {{newArrivalClosing ? 'is-closing' : ''}} {{newArrivalAnimIn && !newArrivalClosing ? 'na-mask-in' : ''}}" wx:if="{{showNewArrivalModal}}" catchtouchmove="noop" bindtap="dismissTransientModals">
  <view class="new-arrival-box {{newArrivalClosing ? 'is-closing' : ''}} {{newArrivalAnimIn && !newArrivalClosing ? 'na-box-in' : ''}}" bindtap="dismissTransientModals" catchtouchmove="noop">
    <view class="na-bg-glow"></view>
    <view class="na-close-icon" catchtap="closeNewArrivalModal">×</view>
    <view class="na-header-group">
      <view class="na-main-title">MT 新品推荐</view>
      <view class="na-tag-line">左右滑动查看更多</view>
    </view>
    <swiper
      class="na-swiper"
      current="{{newArrivalIndex}}"
      bindchange="onNewArrivalChange"
      circular="{{false}}"
      previous-margin="30rpx"
      next-margin="30rpx"
    >
      <block wx:for="{{newArrivalList}}" wx:key="_id">
        <swiper-item class="na-swiper-item">
          <view class="na-card">
            <block wx:if="{{item.dualCover}}">
              <image
                class="na-cover-img na-cover-low {{newArrivalHdLoaded[index] ? 'is-hidden' : ''}}"
                src="{{item.coverThumb}}"
                mode="aspectFill"
                lazy-load="{{index > 0}}"
                binderror="onNewArrivalThumbError"
                data-index="{{index}}"
              />
              <image
                class="na-cover-img na-cover-high {{newArrivalHdLoaded[index] ? 'is-visible' : ''}}"
                src="{{item.coverFull}}"
                mode="aspectFill"
                lazy-load="{{index > 0}}"
                bindload="onNewArrivalHdLoad"
                binderror="onNewArrivalImageError"
                data-index="{{index}}"
                data-kind="high"
              />
            </block>
            <block wx:else>
              <image
                class="na-cover-img"
                src="{{item.coverThumb || item.coverFull || item.cover}}"
                mode="aspectFill"
                lazy-load="{{index > 0}}"
                binderror="onNewArrivalImageError"
                data-index="{{index}}"
                data-kind="high"
              />
            </block>
            <view class="na-card-overlay">
              <view class="na-badge">NEW</view>
              <text class="na-name">{{item.title || 'New Product'}}</text>
            </view>
          </view>
        </swiper-item>
      </block>
    </swiper>
    <button class="na-jump-btn" catchtap="handleNewArrivalJump">
      <text>立即查看</text>
      <view class="btn-arrow">→</view>
    </button>
  </view>
</view>

<custom-toast id="custom-toast" />
