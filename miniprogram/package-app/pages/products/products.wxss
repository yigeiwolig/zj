} */


/* ================= 底部抽屉样式 ================= */
.bottom-drawer {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 85vh; /* 抽屉展开高度 */
  background: #ffffff;
  border-radius: 40rpx 40rpx 0 0;
  box-shadow: 0 -10rpx 40rpx rgba(0, 0, 0, 0.08);
  z-index: 500; /* 高于其他元素 */
  
  /* 🔴 修改：初始完全隐藏 */
  transform: translateY(100%); 
  
  transition: transform 0.5s cubic-bezier(0.19, 1, 0.22, 1);
  display: flex;
  flex-direction: column;
}

.bottom-drawer.open {
  transform: translateY(0);
}

/* 把手区域 - 仅用于关闭和指示 */
.drawer-handle-area {
  height: 80rpx; /* 减小高度，不再需要承载文字 */
  width: 100%;
  display: flex;
  justify-content: center;
  padding-top: 30rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.drawer-handle-bar {
  width: 80rpx;
  height: 10rpx;
  background: #E5E5EA;
  border-radius: 10rpx;
}

.drawer-hint-text {
  display: none; /* 隐藏原来的提示文字 */
}

/* 内容区域 */
.drawer-content {
  flex: 1;
  width: 100%;
  padding: 20rpx 40rpx 60rpx;
  box-sizing: border-box;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.drawer-admin-bar {
  margin: 0 0 20rpx;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #1c1c1e 0%, #3a3a3c 100%);
  border-radius: 20rpx;
}

.drawer-admin-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 6rpx;
}

.drawer-admin-desc {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
  line-height: 1.4;
}

.drawer-admin-warn {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: #ffd60a;
  font-weight: 600;
}

.hub-cover-admin {
  margin: 0 0 28rpx;
  padding: 24rpx;
  background: #f2f2f7;
  border-radius: 24rpx;
}

.hub-cover-admin-head {
  margin-bottom: 16rpx;
}

.hub-cover-admin-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1d1d1f;
}

.hub-cover-admin-hint {
  display: block;
  font-size: 22rpx;
  color: #8e8e93;
  margin-top: 6rpx;
}

.hub-cover-admin-preview {
  width: 100%;
  height: 0;
  padding-bottom: 75%;
  position: relative;
  border-radius: 20rpx;
  overflow: hidden;
  background: #e5e5ea;
  margin-bottom: 20rpx;
}

.hub-cover-admin-swiper {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.hub-cover-admin-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.hub-cover-admin-empty {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #8e8e93;
  text-align: center;
  padding: 24rpx;
  box-sizing: border-box;
}

.hub-cover-admin-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.hub-cover-admin-switch {
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hub-cover-admin-switch-label {
  font-size: 24rpx;
  color: #1d1d1f;
  font-weight: 600;
}

.hub-cover-admin-btn {
  flex: 1;
  min-width: 200rpx;
  text-align: center;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #1d1d1f;
  background: #fff;
  border: 1rpx solid #e5e5ea;
  box-sizing: border-box;
}

.hub-cover-admin-btn--primary {
  color: #fff;
  background: #007aff;
  border-color: #007aff;
}

/* 功能网格 - 改为长条形列表布局 */
.function-grid {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-bottom: 40rpx;
}

/* 功能卡片 - 长条形样式 */
.function-card {
  background: #ffffff;
  border: 2rpx solid #F2F2F7;
  border-radius: 32rpx;
  padding: 32rpx 36rpx 32rpx 40rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  transition: all 0.2s ease;
  width: 100%;
  box-sizing: border-box;
  /* 添加微阴影增加层次感 */
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
}

.function-card:active {
  background: #F9F9F9;
  transform: scale(0.99); /* 微调按压缩放比例 */
}

/* 图标区域 */
.fc-icon-box {
  width: 82rpx;
  height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.fc-icon {
  width: 100%;
  height: 100%;
}

/* 文字区域 */
.fc-info {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  flex: 1; /* 让文字区域占据剩余空间 */
  justify-content: center;
  gap: 6rpx;
}

.fc-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1d1d1f;
  line-height: 1.2;
  margin-bottom: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.fc-hint {
  margin-top: 0;
  font-size: 21rpx;
  font-weight: 400;
  color: #a4a4aa;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.function-card.fc-disabled {
  opacity: 0.72;
}

.fc-switch-wrap {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  margin-left: 12rpx;
  padding-left: 20rpx;
  border-left: 2rpx solid rgba(0, 0, 0, 0.06);
  min-width: 148rpx;
}

.fc-switch-label {
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
}

.fc-switch-label.is-on {
  color: #34C759;
}

.fc-switch-label.is-off {
  color: #FF3B30;
}

.fc-feature-switch {
  transform: scale(1.08);
}

.hub-header-legacy {
  background: transparent;
}


.drawer-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 450;
  backdrop-filter: blur(4px);
}
