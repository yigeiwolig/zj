/* ================= 自动消失提示（无按钮，3秒后自动消失，带收缩退出动画） ================= */
.auto-toast-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0);
  z-index: 99999;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  animation: autoToastMaskFadeIn 0.25s ease-out forwards;
}
.auto-toast-mask.closing {
  animation: autoToastMaskFadeOut 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}
@keyframes autoToastMaskFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes autoToastMaskFadeOut {
  from { opacity: 1; }
  to { opacity: 0; }
}

.auto-toast-box {
  background: #fff; /* 🔴 改为白色背景 */
  backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  padding: 24rpx 40rpx;
  max-width: 600rpx;
  text-align: center;
  animation: toastFadeIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  pointer-events: auto;
  box-shadow: 0 8rpx 30rpx rgba(0,0,0,0.15); /* 🔴 添加阴影 */
}
.auto-toast-mask.closing .auto-toast-box {
  animation: autoToastShrinkOut 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}
@keyframes toastFadeIn {
  from {
    opacity: 0;
    transform: translateY(-20rpx) scale(0.92);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}
@keyframes autoToastShrinkOut {
  0% {
    transform: scale(1) translateY(0);
    opacity: 1;
    filter: blur(0);
  }
  100% {
    transform: scale(0.6) translateY(-60rpx);
    opacity: 0;
    filter: blur(12rpx);
  }
}

.at-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #000; /* 🔴 改为黑色 */
  margin-bottom: 8rpx;
}

.at-content {
  font-size: 26rpx;
  color: #000; /* 🔴 改为黑色 */
  line-height: 1.5;
}

/* 首页 Bento 布局（须在旧 .card 轮播样式之前引入） */
@import "./products-hub-layout.wxss";

/* ================= 全局背景 ================= */
page {
  background-color: #f2f2f7;
  height: 100%;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;
}

/* 顶部导航 */
.header {
  position: fixed; top: 0; left: 0; right: 0; height: 180rpx;
  padding-top: calc(env(safe-area-inset-top, 0px) + 20rpx); /* 🔴 减少顶部间距 */ 
  padding-left: 40rpx; 
  padding-right: 40rpx;
  box-sizing: border-box; 
  display: flex; 
  justify-content: space-between; 
  align-items: center;
  z-index: 10000; 
  pointer-events: none;
  background: transparent; 
}
/* 🔴 统一返回键样式 - 恢复原来的实现方式 */
/* 🔴 统一返回键样式 - 全局标准 */
.back-icon {
  position: absolute;
  left: 32rpx;
  top: calc(env(safe-area-inset-top, 0px) + 12rpx);
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: auto;
  transition: all 0.2s;
  z-index: 10001;
}
.back-icon:active {
  transform: scale(0.95);
  opacity: 0.7;
  background-color: rgba(0, 0, 0, 0.05);
}
.back-icon::before {
  display: none;
}

/* 统一返回箭头样式 */
.back-arrow {
  font-size: 48rpx;
  font-weight: 300;
  color: #000;
  line-height: 1;
}

/* 容器 */
.container { width: 100%; height: 100vh; position: relative; }

/* ================= 旧轮播卡片（仅 stack 模式，勿与 .hub-page .card 混用） ================= */
.stack-card {
  position: absolute;
  left: 50%; margin-left: -310rpx;
  width: 620rpx; height: 272rpx;
  
  /* 
     === 恢复重点：原来的透明渐变 ===
     左右两边透，中间微亮
  */
  background: linear-gradient(
    90deg, 
    rgba(255, 255, 255, 0.15) 0%, 
    rgba(255, 255, 255, 0.2) 50%,
    rgba(255, 255, 255, 0.15) 100%
  );
  
  /* 强力磨砂模糊 */
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  
  /* 边框：半透明白边 */
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 44rpx;
  
  box-sizing: border-box;
  
  /* 投影：原来的柔和阴影 */
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.05);
  
  /* 动画设置 */
  will-change: transform, opacity;
}

/* 当前选中项 (Current) - 高亮玻璃 */
.stack-card.curr {
  z-index: 100;
  
  /* 选中时更亮、更透 */
  background: linear-gradient(
    90deg, 
    rgba(255, 255, 255, 0.25) 0%, 
    rgba(255, 255, 255, 0.35) 50%,
    rgba(255, 255, 255, 0.25) 100%
  );
  
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  
  /* 投影加深 */
  box-shadow: 
    0 20rpx 50rpx -10rpx rgba(0, 0, 0, 0.1), 
    inset 0 0 20rpx rgba(255, 255, 255, 0.5); 
}

/* ================= 内部布局 (使用刚才修正的绝对定位) ================= */
/* 这里的布局逻辑是新的（修正位置），但样式是旧的（透明背景） */

.card-inner {
  width: 100%; height: 100%;
  position: relative; /* 设为原点 */
  transition: transform 0.16s ease, filter 0.16s ease;
}

.card-pressed .card-inner {
  transform: scale(0.982) translateY(3rpx);
  filter: brightness(0.96);
}

/* 1. 文字：绝对定位到左上角 */
.stack-card .card-info {
  position: absolute;
  top: 64rpx;
  left: 40rpx;
  right: 188rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  z-index: 2;
}

.stack-card .card-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #333;
  line-height: 1.22;
  margin-bottom: 0;
}

.card-hint {
  margin-top: 8rpx;
  max-width: 100%;
  font-size: 22rpx;
  font-weight: 400;
  color: rgba(51, 51, 51, 0.52);
  line-height: 1.35;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

/* 2. 图标：绝对定位到垂直居中偏右 */
.icon-container {
  position: absolute;
  right: 18rpx;
  top: 50%;       /* 垂直居中 */
  transform: translateY(-50%); 
  
  width: 136rpx; height: 136rpx;
  background: #fff; /* 图标底座保持纯白，突出质感 */
  border-radius: 40rpx;
  display: flex; justify-content: center; align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.06);
}

.svg-icon { width: 82rpx; height: 82rpx; }

/* ================= 自定义加载动画 ================= */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(5px);
  z-index: 99999 !important; /* 确保在最上层，覆盖微信原生提示 */
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.2s ease;
}

.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
}

.loader {
  width: 350rpx;
  height: 180rpx;
  border-radius: 20rpx;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-evenly;
  padding: 30rpx;
  box-shadow: 0 0 20rpx rgba(0,0,0,0.1);
}

/* 🆕 产品上新弹窗样式 - 5.1 暗黑流光科技风 (Dark Tech Stream - High Contrast) */
/* 首帧不挂 animation（由 JS nextTick 再加 na-mask-in / na-box-in），避免小程序同帧插入不播动画 */
.new-arrival-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.88); /* 极深背景 */
  backdrop-filter: blur(24px);
  z-index: 1000000000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
}

.new-arrival-mask.na-mask-in {
  animation: naMaskFadeIn 0.4s ease-out forwards;
}

.new-arrival-mask.is-closing {
  animation: naMaskFadeOut 0.32s cubic-bezier(0.22, 1, 0.36, 1) forwards;
}

.new-arrival-box {
  width: 640rpx;
  /* 纯白主弹窗卡片 */
  background: #FFFFFF;
  border-radius: 48rpx;
  padding: 64rpx 0 64rpx;
  box-sizing: border-box;
  /* 柔和高端的阴影与边框 */
  box-shadow: 0 32rpx 90rpx rgba(0, 0, 0, 0.22);
  border: 1rpx solid rgba(0, 0, 0, 0.03);
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 0;
  transform: translateY(140rpx) scale(0.78);
  position: relative;
  overflow: hidden;
  will-change: transform, opacity;
}

.new-arrival-box.na-box-in {
  animation: naPopIn 0.55s cubic-bezier(0.34, 1.38, 0.64, 1) forwards;
}

.new-arrival-box.is-closing {
  animation: naPopOutIOS 0.34s cubic-bezier(0.32, 0.72, 0, 1) forwards;
}

/* 背景光效 */
.na-bg-glow {
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(0,0,0,0.03) 0%, transparent 70%);
  z-index: 0;
  pointer-events: none;
}

/* 关闭按钮 (右上角) */
.na-close-icon {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  width: 60rpx;
  height: 60rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 44rpx;
  color: #C7C7CC; /* 白卡片上使用浅灰色关闭按钮 */
  font-weight: 300;
  z-index: 20;
  transition: all 0.2s;
}
.na-close-icon:active {
  color: #000;
  transform: scale(0.9);
}

/* 顶部标题区 - 科技风 */
.na-header-group {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 56rpx;
  width: 100%;
  z-index: 1;
}

.na-main-title {
  font-size: 56rpx;
  font-weight: 900;
  color: #111111; /* 白卡片上使用深色标题 */
  letter-spacing: 2rpx;
  text-align: center;
  line-height: 1;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;
  margin-bottom: 16rpx;
  text-shadow: 0 2rpx 6rpx rgba(0,0,0,0.12);
}

.na-tag-line {
  font-size: 20rpx;
  font-weight: 600;
  color: #8E8E93; /* 中灰副标题 */
  letter-spacing: 6rpx;
  text-transform: uppercase;
  text-align: center;
}

/* 轮播区 */
.na-swiper {
  width: 100%;
  height: 720rpx; /* 再次加高，全屏海报感 */
  margin-bottom: 56rpx;
  z-index: 1;
}

.na-swiper-item {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 0 20rpx;
  box-sizing: border-box;
}

/* 单个卡片 - 纯白高级质感 */
.na-card {
  width: 100%;
  height: 100%;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  border-radius: 40rpx;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  position: relative;
  /* 改弱阴影，避免出现一圈明显的灰边 */
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid rgba(0, 0, 0, 0.02);
  transform: translateZ(0);
  overflow: hidden; /* 确保外边框完整包裹内部图片 */
}

/* 图片区域 - 留出白边 */
.na-cover-img {
  width: calc(100% - 48rpx);
  height: calc(100% - 44rpx);
  object-fit: cover;
  border-radius: 30rpx;
  position: absolute;
  top: 22rpx;
  left: 24rpx;
}
.na-cover-low {
  /* 缩略图已较小，仅轻微柔化过渡，避免糊成一团 */
  filter: blur(0.35px);
  transform: scale(1.008);
  transition: opacity 0.2s ease;
}
.na-cover-high {
  opacity: 0;
  transition: opacity 0.22s ease;
}
.na-cover-high.is-visible {
  opacity: 1;
}
.na-cover-low.is-hidden {
  opacity: 0;
}

/* 卡片遮罩浮层：只覆盖图片底部区域 */
.na-card-overlay {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 22rpx;
  height: 34%;
  border-radius: 0 0 30rpx 30rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.0) 100%);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
  padding-bottom: 32rpx;
  box-sizing: border-box;
}

/* NEW 徽章 - 动态呼吸 */
.na-badge {
  background: #fff;
  color: #000;
  font-size: 18rpx;
  font-weight: 900;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  letter-spacing: 2rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 0 20rpx rgba(255,255,255,0.4);
  animation: badgePulse 2s infinite;
}

@keyframes badgePulse {
  0% { transform: scale(1); box-shadow: 0 0 20rpx rgba(255,255,255,0.4); }
  50% { transform: scale(1.05); box-shadow: 0 0 40rpx rgba(255,255,255,0.7); }
  100% { transform: scale(1); box-shadow: 0 0 20rpx rgba(255,255,255,0.4); }
}

.na-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  text-align: center;
  padding: 0 40rpx;
  line-height: 1.3;
  text-shadow: 0 2rpx 10rpx rgba(0,0,0,0.5);
}

/* 按钮 - 极简白块 */
.na-jump-btn {
  width: 380rpx;
  height: 100rpx;
  border-radius: 999rpx; /* 椭圆胶囊按钮 */
  /* 轻微立体感：上亮下暗的渐变 + 更实在的阴影和描边 */
  background: linear-gradient(180deg, #FFFFFF 0%, #F3F3F3 100%);
  color: #000;
  font-size: 28rpx;
  font-weight: 800;
  box-shadow: 0 20rpx 40rpx rgba(0,0,0,0.16);
  border: 1rpx solid rgba(0,0,0,0.08);
  transition: transform 0.1s;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  letter-spacing: 2rpx;
  z-index: 1;
  gap: 16rpx;
}

.na-jump-btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}
.na-jump-btn::after {
  border: none;
}

.btn-arrow {
  font-size: 32rpx;
  line-height: 1;
  font-weight: 300;
  transform: translateY(-2rpx); /* 微调对齐 */
}

@keyframes naPopIn {
  0% {
    opacity: 0;
    transform: scale(0.78) translateY(140rpx);
  }
  58% {
    opacity: 1;
    transform: scale(1.045) translateY(-10rpx);
  }
  100% {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

@keyframes naPopOutIOS {
  0% {
    opacity: 1;
    transform: scale(1) translateY(0);
    filter: blur(0);
  }
  28% {
    opacity: 1;
    transform: scale(1.018) translateY(-4rpx);
    filter: blur(0);
  }
  100% {
    opacity: 0;
    transform: scale(0.92) translateY(18rpx);
    filter: blur(2.8rpx);
  }
}

@keyframes naMaskFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes naMaskFadeOut {
  0%   { opacity: 1; }
  65%  { opacity: 0.82; }
  100% { opacity: 0; }
}

.loading-bar {
  width: 100%;
  height: 20rpx;
  background: #E5E5EA;
  border-radius: 20rpx;
  position: relative;
  overflow: hidden;
}
.loading-bar::after {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 50%;
  height: 100%;
  background: #1c1c1e;
  border-radius: 20rpx;
  animation: loadingBar 0.3s alternate infinite ease-in-out;
}
.loader-label {
  color: #1c1c1e;
  font-size: 28rpx;
  animation: labelBlink 0.26s alternate infinite ease-in-out;
}

@keyframes labelBlink {
  from { opacity: 0.5; }
  to   { opacity: 1; }
}
@keyframes loadingBar {
  0%   { left: 0%; }
  50%  { left: 25%; }
  100% { left: 50%; }
}
@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

/* ================= 底部触发按钮 (New) ================= */
.trigger-button {
  position: fixed;
  bottom: calc(env(safe-area-inset-bottom) + 40rpx); /* 适配全面屏 */
  left: 50%;
  
  /* 初始状态：隐藏在下方，透明 */
  transform: translateX(-50%) translateY(200%);
  opacity: 0;

  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  padding: 24rpx 48rpx;
  border-radius: 60rpx;
  box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.1);
  z-index: 400; /* 低于抽屉 */
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255,255,255,0.5);
  
  /* 移除原来的 animation，改用 transition 控制所有状态变化 */
  transition: all 0.6s cubic-bezier(0.19, 1, 0.22, 1);
}

/* 状态1：弹起可见 */
.trigger-button.visible {
  transform: translateX(-50%) translateY(0);
  opacity: 1;
}

/* 状态2：变淡沉下 (闲置状态) */
.trigger-button.faded {
  transform: translateX(-50%) translateY(30%); /* 下沉 30% */
  opacity: 0.6; /* 变半透明 */
  background: rgba(255, 255, 255, 0.75); /* 背景也淡一点 */
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05); /* 阴影减弱 */
  filter: grayscale(0.2); /* 轻微置灰 */
}

/* 交互反馈：即使是 faded 状态，按下去也要变清楚 */
.trigger-button:active,
.trigger-button.faded:active {
  transform: translateX(-50%) scale(0.95) translateY(0); /* 按下时回弹一点 */
  background: rgba(255, 255, 255, 1);
  opacity: 1;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
  filter: grayscale(0);
}

.trigger-button.trigger-admin {
  border-color: rgba(28, 28, 30, 0.12);
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.12);
}

.trigger-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-right: 8rpx;
  line-height: 1; /* 🔴 修正：强制行高为1，确保垂直居中 */
  padding-top: 2rpx; /* 微调：汉字视觉中心修正 */
}

.trigger-admin .trigger-text {
  color: #1c1c1e;
}

.trigger-icon {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.6;
}

