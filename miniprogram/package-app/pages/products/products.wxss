/* ===== 首页功能引导 ===== */
.home-guide-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100000085 !important;
  pointer-events: auto;
}

.home-guide-spot {
  position: fixed;
  border-radius: 28rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 0 0 6rpx rgba(0, 122, 255, 0.35), 0 0 24rpx 4rpx rgba(0, 122, 255, 0.55);
  background: rgba(255, 255, 255, 0.12);
  pointer-events: none;
  /* 步骤切换时高亮框平滑滑到下一处 */
  transition: left 0.32s ease, top 0.32s ease, width 0.32s ease, height 0.32s ease;
  animation: home-guide-spot-pulse 1.05s ease-in-out infinite;
}

@keyframes home-guide-spot-pulse {
  0%, 100% {
    transform: scale(1);
    box-shadow: 0 0 0 5rpx rgba(0, 122, 255, 0.35), 0 0 22rpx 4rpx rgba(0, 122, 255, 0.5);
  }
  50% {
    transform: scale(1.015);
    box-shadow: 0 0 0 12rpx rgba(0, 122, 255, 0.55), 0 0 40rpx 12rpx rgba(0, 122, 255, 0.85);
  }
}

.home-guide-bubble {
  position: fixed;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx 32rpx 28rpx;
  box-shadow: 0 18rpx 44rpx rgba(0, 0, 0, 0.28);
  box-sizing: border-box;
  z-index: 2;
  pointer-events: auto;
}

.home-guide-arrow {
  position: absolute;
  width: 0;
  height: 0;
  border-left: 18rpx solid transparent;
  border-right: 18rpx solid transparent;
  transform: translateX(-50%);
}

.home-guide-bubble--up .home-guide-arrow {
  top: -18rpx;
  border-bottom: 18rpx solid #FFFFFF;
}

.home-guide-bubble--down .home-guide-arrow {
  bottom: -18rpx;
  border-top: 18rpx solid #FFFFFF;
}

.home-guide-bubble--none .home-guide-arrow {
  display: none;
}

.home-guide-step-tag {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 700;
  color: #007AFF;
  background: rgba(0, 122, 255, 0.1);
