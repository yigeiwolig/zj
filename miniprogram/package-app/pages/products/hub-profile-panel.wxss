@import "../my/my.wxss";

.hub-my-panel-root {
  height: 100%;
  box-sizing: border-box;
  overflow: visible;
}

.hub-my-panel-root .container {
  min-height: 100%;
  height: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
  overflow-y: auto;
}

.hub-my-panel-root .container.hub-in-shell {
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 0;
  overflow: hidden;
}

.hub-my-panel-root .hub-admin-scroll--shell,
.hub-my-panel-root .hub-profile-scroll--shell {
  flex: 1;
  width: 100%;
  height: 0;
  min-height: 0;
  box-sizing: border-box;
}
