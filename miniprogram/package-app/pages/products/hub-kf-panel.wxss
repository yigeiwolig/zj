@import "../../../styles/kf-panel.wxss";

.kf-panel-scroll {
  height: 100%;
  box-sizing: border-box;
}

/* ===== 客服功能引导（售前/售后介绍） ===== */
.kf-guide-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100000085 !important;
  pointer-events: auto;
}

.kf-guide-spot {
  position: fixed;
  border-radius: 64rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 0 0 6rpx rgba(0, 122, 255, 0.35), 0 0 24rpx 4rpx rgba(0, 122, 255, 0.55);
  background: rgba(255, 255, 255, 0.12);
  pointer-events: none;
  transition: left 0.25s ease, top 0.25s ease, width 0.25s ease, height 0.25s ease;
  animation: kf-guide-spot-pulse 1.05s ease-in-out infinite;
}

@keyframes kf-guide-spot-pulse {
  0%, 100% {
    transform: scale(1);
    box-shadow: 0 0 0 5rpx rgba(0, 122, 255, 0.35), 0 0 22rpx 4rpx rgba(0, 122, 255, 0.5);
  }
  50% {
    transform: scale(1.015);
    box-shadow: 0 0 0 12rpx rgba(0, 122, 255, 0.55), 0 0 40rpx 12rpx rgba(0, 122, 255, 0.85);
  }
}

.kf-guide-bubble {
  position: fixed;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx 32rpx 28rpx;
  box-shadow: 0 18rpx 44rpx rgba(0, 0, 0, 0.28);
  box-sizing: border-box;
  z-index: 2;
  pointer-events: auto;
}

.kf-guide-arrow {
  position: absolute;
  width: 0;
  height: 0;
  border-left: 18rpx solid transparent;
  border-right: 18rpx solid transparent;
  transform: translateX(-50%);
}

.kf-guide-bubble--up .kf-guide-arrow {
  top: -18rpx;
  border-bottom: 18rpx solid #FFFFFF;
}

.kf-guide-bubble--down .kf-guide-arrow {
  bottom: -18rpx;
  border-top: 18rpx solid #FFFFFF;
}

.kf-guide-step-tag {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 700;
  color: #007AFF;
  background: rgba(0, 122, 255, 0.1);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
}

.kf-guide-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1D1D1F;
  margin-bottom: 12rpx;
}

.kf-guide-desc {
  font-size: 26rpx;
  color: #636366;
  line-height: 1.6;
  margin-bottom: 28rpx;
}

.kf-guide-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.kf-guide-intro-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100000085 !important;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.kf-guide-intro-box {
  width: 100%;
  max-width: 560rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 40rpx 36rpx 32rpx;
  box-shadow: 0 18rpx 44rpx rgba(0, 0, 0, 0.28);
  box-sizing: border-box;
}

.kf-guide-intro-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1D1D1F;
  margin-bottom: 12rpx;
  text-align: center;
}

.kf-guide-intro-desc {
  font-size: 26rpx;
  color: #636366;
  line-height: 1.6;
  text-align: center;
  margin-bottom: 32rpx;
}

.kf-guide-intro-actions {
  display: flex;
  gap: 20rpx;
}

.kf-guide-intro-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.kf-guide-intro-btn--ghost {
  background: #F2F2F7;
  color: #1D1D1F;
}

.kf-guide-intro-btn--primary {
  background: #1D1D1F;
  color: #fff;
}

.kf-guide-intro-btn:active {
  opacity: 0.82;
  transform: scale(0.98);
}

.kf-guide-skip {
  align-self: flex-end;
  font-size: 26rpx;
  color: #8E8E93;
  padding: 4rpx 8rpx;
}

.kf-guide-skip:active {
  opacity: 0.65;
}

.kf-guide-btn {
  width: 100%;
  height: 80rpx;
  background: #1D1D1F;
  color: #fff;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
}

.kf-guide-btn.is-locked {
  opacity: 0.55;
  pointer-events: none;
}

.kf-guide-btn:active {
  transform: scale(0.96);
}
