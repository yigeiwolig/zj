@import "../shop/shop.wxss";

.hub-shop-panel-root {
  height: 100%;
  width: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f5f5f7;
  box-sizing: border-box;
}

.hub-shop-panel-root .container,
.hub-shop-panel-root .container--hub-embed {
  flex: 1;
  min-height: 0;
  height: 100%;
  width: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
  position: relative;
  background: #f5f5f7;
}

.hub-shop-panel-root .shop-hub-loading {
  padding: 80rpx 32rpx;
  text-align: center;
}

.hub-shop-panel-root .shop-hub-loading-text {
  font-size: 28rpx;
  color: rgba(60, 60, 67, 0.55);
}

.hub-shop-panel-root .shop-sections,
.hub-shop-panel-root .shop-section,
.hub-shop-panel-root .shop-series-swiper {
  width: 100%;
  box-sizing: border-box;
}

.hub-shop-panel-root .shop-hero-cover.shop-hero-cover--acc {
  padding-bottom: 75%;
}
