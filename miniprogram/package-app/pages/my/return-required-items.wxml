<template name="returnRequiredItems">
  <block wx:for="{{returnRequiredList}}" wx:key="_id">
    <view class="rr-item {{item.returnTrackingId && (item.status === 'USER_SENT' || item.returnStatus === 'USER_SENT') ? 'user-sent' : (item.returnTrackingId ? 'returned' : 'pending')}} {{isUserRepairOrderSimple ? 'simple-mode' : ''}}">
      <view class="rr-item-header">
        <text class="rr-model" wx:if="{{!isUserRepairOrderSimple}}">{{item.displayModel || item.model}}</text>
        <view class="rr-model-with-badge" wx:else>
          <text class="rr-model-badge">MT</text>
          <text class="rr-model">MT维修单详情</text>
        </view>
        <text class="rr-status-badge {{item.returnTrackingId && (item.status === 'USER_SENT' || item.returnStatus === 'USER_SENT') ? 'user-sent' : (item.returnTrackingId ? 'returned' : 'pending')}}" wx:if="{{!isUserRepairOrderSimple}}">
          {{item.returnTrackingId && (item.status === 'USER_SENT' || item.returnStatus === 'USER_SENT') && item.returnStatus !== 'PENDING_RETURN' ? '用户寄回故障配件' : (item.returnTrackingId && (item.status === 'USER_SENT' || item.returnStatus === 'USER_SENT') ? '用户寄回维修' : (item.returnTrackingId ? '已寄回' : '待寄回'))}}
        </text>
      </view>

      <view class="rr-item-info" wx:if="{{!isUserRepairOrderSimple}}">
        <view class="rr-info-section">
          <view class="rr-info-row">
            <text class="rr-info-label">用户昵称</text>
            <text class="rr-info-value">{{item.userNickname || '匿名用户'}}</text>
          </view>
          <view class="rr-info-row">
            <text class="rr-info-label">质保状态</text>
            <text class="rr-info-value {{(item.warrantyExpired === true || (item.expiryDate && item.remainingDays === 0)) ? 'rr-warranty-expired-text' : 'rr-warranty-normal-text'}}">
              {{(item.warrantyExpired === true || (item.expiryDate && item.remainingDays === 0)) ? '已过期' : ('剩余质保日：' + ((item.remainingDays !== undefined && item.remainingDays !== null) ? item.remainingDays : '--') + '天')}}
            </text>
          </view>
          <view class="rr-info-row" wx:if="{{item.repairItems && item.repairItems.length > 0 && item.repairTotalPrice > 0}}">
            <text class="rr-info-label">支付状态</text>
            <text class="rr-info-value {{item.repairPaid === true ? 'rr-payment-paid-text' : 'rr-payment-unpaid-text'}}">
              {{item.repairPaid === true ? '✓ 已支付' : ('待支付：¥' + (isAdmin ? 0.01 : (item.repairTotalPrice || 0)))}}
            </text>
          </view>
        </view>

        <view class="rr-info-section" wx:if="{{item.returnStatus === 'PENDING_RETURN'}}">
          <view class="rr-info-row rr-address-row">
            <text class="rr-info-label">收货地址</text>
            <view class="rr-info-value-wrapper">
              <text class="rr-info-value">
                {{item.returnAddress ? (item.returnAddress.name + ' ' + item.returnAddress.phone + ' ' + item.returnAddress.address) : (item.contact.name + ' ' + item.contact.phone + ' ' + item.contact.address)}}
              </text>
              <view class="rr-copy-user-address-btn" bindtap="copyUserAddress" data-index="{{index}}">
                <text class="rr-copy-text">复制</text>
              </view>
            </view>
          </view>
        </view>

        <view class="rr-info-section">
          <view class="rr-info-row" wx:if="{{item.returnNote}}">
            <text class="rr-info-label">备注</text>
            <text class="rr-info-value">{{item.returnNote}}</text>
          </view>
          <view class="rr-info-row" wx:if="{{item.shipRemark}}">
            <text class="rr-info-label">备件寄出备注</text>
            <text class="rr-info-value">{{item.shipRemark}}</text>
          </view>
          <view class="rr-info-row">
            <text class="rr-info-label">故障描述</text>
            <text class="rr-info-value">{{item.description}}</text>
          </view>
          <view class="rr-info-row">
            <text class="rr-info-label">商品发出时间</text>
            <text class="rr-info-value">{{item.shipTime}}</text>
          </view>
          <view class="rr-info-row" wx:if="{{item.returnTrackingId}}">
            <text class="rr-info-label">寄回运单号</text>
            <text class="rr-info-value">{{item.returnTrackingId}}</text>
          </view>
        </view>
      </view>

      <view class="rr-item-info" wx:elif="{{isUserRepairOrderSimple}}">
        <view class="rr-info-section">
          <text class="rr-repair-caption">管理员提交维修明细</text>
          <view class="rr-repair-details" wx:if="{{item.repairItems && item.repairItems.length > 0}}">
            <view class="rr-repair-item rr-repair-item-head">
              <text class="rr-repair-name">维修项</text>
              <text class="rr-repair-price">金额</text>
            </view>
            <view class="rr-repair-item" wx:for="{{item.repairItems}}" wx:for-item="repairPart" wx:key="index">
              <text class="rr-repair-name">{{repairPart.name}}</text>
              <text class="rr-repair-price">¥{{repairPart.displayPrice || repairPart.price}}</text>
            </view>
            <view class="rr-repair-total">
              <text class="rr-total-label">合计金额</text>
              <text class="rr-total-price">¥{{isAdmin ? 0.01 : (item.repairTotalDisplayPrice || item.repairTotalPrice || 0)}}</text>
            </view>
          </view>
          <view class="rr-info-row" wx:else>
            <text class="rr-info-value">管理员暂未提交维修明细</text>
          </view>
        </view>
      </view>

      <view class="rr-actions" wx:if="{{!isUserRepairOrderSimple}}">
        <block wx:if="{{item.returnTrackingId && (item.status === 'USER_SENT' || item.returnStatus === 'USER_SENT') && item.returnStatus === 'PENDING_RETURN'}}">
          <block wx:if="{{item.repairItems && item.repairItems.length > 0 && item.repairPaid === true}}">
            <view class="rr-btn-enter-tracking" bindtap="openEnterTrackingModal" data-item="{{item}}" data-index="{{index}}">录入单号</view>
          </block>
          <block wx:else>
            <view class="rr-btn logistics" bindtap="viewLogisticsDetail" data-sn="{{item.returnTrackingId}}" data-phone="{{item.contact.phone}}" data-tail-required="2427">查看物流</view>
            <view class="rr-btn ship-out" wx:if="{{item.repairItems && item.repairItems.length > 0 && ((item.warrantyExpired && item.repairPaid) || (!item.warrantyExpired && item.trackingId))}}" bindtap="adminShipOutAfterRepair" data-id="{{item._id}}">寄出快递</view>
            <view class="rr-btn fill-repair" wx:else bindtap="openFillRepairModal" data-item="{{item}}" data-index="{{index}}">填写售后单</view>
          </block>
        </block>
        <block wx:elif="{{item.returnTrackingId && (item.status === 'USER_SENT' || item.returnStatus === 'USER_SENT') && item.returnStatus !== 'PENDING_RETURN'}}">
          <view class="rr-btn deduct" bindtap="deductWarrantyForRepair" data-id="{{item._id}}">扣除质保</view>
          <view class="rr-btn logistics" bindtap="viewLogisticsDetail" data-sn="{{item.returnTrackingId}}" data-phone="{{item.contact.phone}}" data-tail-required="2427">查看物流</view>
          <view class="rr-btn confirm" bindtap="confirmReturnReceived" data-id="{{item._id}}">确认收货</view>
        </block>
        <block wx:else>
          <view class="rr-btn cancel" bindtap="cancelReturnRequired" data-id="{{item._id}}">取消</view>
          <view class="rr-btn logistics" wx:if="{{item.returnTrackingId}}" bindtap="viewLogisticsDetail" data-sn="{{item.returnTrackingId}}" data-phone="{{item.contact.phone}}" data-tail-required="2427">查看物流</view>
          <view class="rr-btn complete" bindtap="completeReturnRequired" data-id="{{item._id}}">已完成</view>
        </block>
      </view>
    </view>
  </block>
  <view class="rr-empty" wx:if="{{returnRequiredList.length === 0}}">
    <text>暂无需寄回的订单</text>
  </view>
</template>
