/* 绑定新产品：通栏大卡（与设备卡同宽） */
.bind-new-product-btn {
  display: block !important;
  width: calc(100% - 64rpx) !important;
  max-width: none !important;
  margin: 0 32rpx 24rpx !important;
  padding: 0 !important;
  line-height: inherit !important;
  font-size: inherit !important;
  color: inherit !important;
  text-align: left !important;
  background: #fff !important;
  border-radius: 32rpx !important;
  border: 1rpx solid #e8e8ed !important;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03) !important;
  box-sizing: border-box !important;
  overflow: hidden !important;
}
.bind-new-product-btn::after {
  border: none !important;
}
.bind-new-product-btn--pressed {
  background: #f5f5f7 !important;
  transform: scale(0.99);
  opacity: 0.97;
}
.bind-new-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  min-height: 280rpx;
  padding: 48rpx 40rpx;
