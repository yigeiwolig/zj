  z-index: 100000040;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  overflow: hidden;
  backdrop-filter: blur(12px); /* 加重毛玻璃 */
  animation: fadeIn 0.3s ease;
}

.logistics-modal-box {
  width: 100%;
  /* 🔴 使用动态计算高度，考虑状态栏和导航栏 */
  max-height: calc(100vh - 60px);
  background: #FFFFFF;
  border-radius: 40rpx 40rpx 0 0; /* 更大的圆角 */
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: 0 -10rpx 40rpx rgba(0, 0, 0, 0.08); /* 更柔和的投影 */
  transform: translateY(100%);
