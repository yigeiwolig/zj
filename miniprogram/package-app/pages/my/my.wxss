  color: #1D1D1F;
  letter-spacing: 1rpx;
}

.copy-btn {
  font-size: 22rpx; /* 减小字号 24rpx -> 22rpx */
  color: #1D1D1F;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  background: #fff;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
