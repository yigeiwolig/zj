/* 内部诊断书 · 底部抽屉（仅管理员） */
.diag-sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 12000;
  background: rgba(0, 0, 0, 0.38);
  backdrop-filter: blur(16px);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  box-sizing: border-box;
  animation: diagMaskIn 0.32s ease forwards;
}

.diag-sheet-mask.closing {
  animation: diagMaskOut 0.28s ease forwards;
}

.diag-sheet {
  width: 100%;
  max-height: 92vh;
  background: #f9f9fb;
  border-radius: 40rpx 40rpx 0 0;
  padding: 12rpx 0 0;
  box-sizing: border-box;
  box-shadow: 0 -12rpx 60rpx rgba(0, 0, 0, 0.12);
  animation: diagSheetUp 0.38s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.diag-sheet.closing {
  animation: diagSheetDown 0.28s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}

.diag-sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #d1d1d6;
  margin: 8rpx auto 12rpx;
  flex-shrink: 0;
}

.diag-sheet-scroll {
  flex: 1;
  min-height: 0;
  max-height: calc(92vh - 220rpx);
  padding: 0 32rpx;
  box-sizing: border-box;
}

.diag-sheet-header {
  position: relative;
  text-align: center;
  padding: 0 56rpx 24rpx;
}

.diag-sheet-close {
  position: absolute;
  right: 0;
  top: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #ececf0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.diag-sheet-close:active {
  opacity: 0.7;
  transform: scale(0.96);
}

.diag-sheet-close-icon {
  font-size: 40rpx;
  line-height: 1;
  color: #636366;
  font-weight: 300;
  margin-top: -4rpx;
}

.diag-sheet-icon-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 20rpx;
}

.diag-sheet-icon-doc {
  width: 88rpx;
  height: 104rpx;
  border-radius: 18rpx;
  background: linear-gradient(160deg, #ffffff 0%, #f2f2f7 100%);
  border: 2rpx solid #e5e5ea;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  padding: 22rpx 18rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 12rpx;
}

.diag-doc-line {
  height: 8rpx;
  border-radius: 4rpx;
  background: #1c1c1e;
  opacity: 0.12;
}

.diag-doc-line.short {
  width: 62%;
}

.diag-sheet-title {
  display: block;
  font-size: 38rpx;
  font-weight: 800;
  color: #1c1c1e;
  letter-spacing: 0.5rpx;
  line-height: 1.25;
}

.diag-sheet-badges {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 14rpx;
}

.diag-sheet-badge {
  font-size: 20rpx;
  font-weight: 700;
  color: #007aff;
  background: rgba(0, 122, 255, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  letter-spacing: 1rpx;
}

.diag-sheet-badge.muted {
  color: #8e8e93;
  background: #ececf0;
  font-weight: 600;
}

.diag-sheet-body {
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.diag-field-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.diag-field-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #3a3a3c;
}

.diag-field-count {
  font-size: 22rpx;
  color: #aeaeb2;
  font-variant-numeric: tabular-nums;
}

.diag-field-box {
  background: #f5f5f7;
  border-radius: 20rpx;
  border: 2rpx solid #ececf0;
  padding: 4rpx;
  transition: border-color 0.2s ease;
}

.diag-field-input {
  width: 100%;
  min-height: 200rpx;
  max-height: 280rpx;
  padding: 20rpx 22rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.6;
  color: #1c1c1e;
}

.diag-field-placeholder {
  color: #aeaeb2;
  font-size: 28rpx;
}

.diag-callout {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  background: #f0f7ff;
  border: 1rpx solid #d6e8ff;
}

.diag-callout-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #007aff;
  margin-top: 10rpx;
  flex-shrink: 0;
  box-shadow: 0 0 0 6rpx rgba(0, 122, 255, 0.15);
}

.diag-callout-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.diag-callout-main {
  font-size: 24rpx;
  font-weight: 700;
  color: #1c1c1e;
}

.diag-callout-sub {
  font-size: 22rpx;
  color: #636366;
  line-height: 1.5;
}

.diag-sheet-footer {
  flex-shrink: 0;
  padding: 16rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #f9f9fb;
  border-top: 1rpx solid #e8e8ed;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.return-request-footer {
  width: 100%;
  box-sizing: border-box;
}

.return-request-btn-row {
  width: 100%;
}

.diag-submit-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  background: #1c1c1e;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 28rpx rgba(28, 28, 30, 0.22);
}

.diag-submit-btn:active {
  transform: scale(0.985);
  opacity: 0.92;
}

.diag-submit-btn.disabled {
  opacity: 0.45;
  pointer-events: none;
}

.diag-cancel-link {
  font-size: 28rpx;
  color: #8e8e93;
  font-weight: 500;
  padding: 8rpx 24rpx 4rpx;
}

.diag-cancel-link:active {
  color: #636366;
}

@keyframes diagMaskIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes diagMaskOut {
  from { opacity: 1; }
  to { opacity: 0; }
}

@keyframes diagSheetUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

@keyframes diagSheetDown {
  from { transform: translateY(0); }
  to { transform: translateY(100%); }
}

/* 控制版本：按钮版 / 遥控版（用 left 平移，避免 transform 在弹窗内盖住文字） */
.ctrl-variant-seg {
  position: relative;
  display: flex;
  width: 100%;
  box-sizing: border-box;
  padding: 8rpx;
  border-radius: 20rpx;
  background: #f2f2f7;
  overflow: hidden;
}
.ctrl-variant-thumb-wrap {
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  top: 8rpx;
  bottom: 8rpx;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
}
.ctrl-variant-thumb {
  position: absolute;
  left: 0;
  top: 0;
  width: 50%;
  height: 100%;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.06);
  opacity: 0;
  transition:
    left 0.32s cubic-bezier(0.22, 1, 0.36, 1),
    opacity 0.18s ease;
}
.ctrl-variant-seg.is-button .ctrl-variant-thumb,
.ctrl-variant-seg.is-remote .ctrl-variant-thumb {
  opacity: 1;
}
.ctrl-variant-seg.is-button .ctrl-variant-thumb {
  left: 0;
}
.ctrl-variant-seg.is-remote .ctrl-variant-thumb {
  left: 50%;
}
.ctrl-variant-item {
  position: relative;
  z-index: 2;
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.2;
  color: #8e8e93;
  padding: 18rpx 8rpx;
  border-radius: 16rpx;
  background: transparent;
  transition: color 0.2s ease;
}
.ctrl-variant-item.is-on {
  background: transparent;
  color: #111;
  box-shadow: none;
}
.ctrl-variant-seg--compact {
  flex: 1;
  width: auto;
  max-width: none;
  min-width: 280rpx;
  margin-left: 24rpx;
  padding: 6rpx;
}
.ctrl-variant-seg--compact .ctrl-variant-thumb-wrap {
  left: 6rpx;
  right: 6rpx;
  top: 6rpx;
  bottom: 6rpx;
}
.ctrl-variant-seg--compact .ctrl-variant-item {
  font-size: 24rpx;
  padding: 14rpx 6rpx;
}
.fault-form-row--variant {
  align-items: center;
}
.fault-form-row--block {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}
.fault-form-row--block .fault-row-label {
  margin-bottom: 0;
}
.audit-variant {
  font-size: 24rpx;
  color: #666;
  font-weight: 600;
}
.bind-device-modal .ctrl-variant-seg,
.hub-embed-portal-layer .bind-device-modal .ctrl-variant-seg {
  width: 100%;
}

.bind-device-modal .ctrl-variant-item.is-on,
.hub-embed-portal-layer .bind-device-modal .ctrl-variant-item.is-on {
  background: transparent;
  color: #111;
  box-shadow: none;
}
