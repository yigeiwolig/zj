.add-tips { font-size: 28rpx; font-weight: 600; color: #1d1d1f; }
.add-subtips { font-size: 22rpx; color: #aeaeb2; }

/* --- 5. 底部独立按钮 --- */
.footer-bar {
  background: transparent; margin-top: 60rpx; display: flex;
  padding: 20rpx 40rpx calc(40rpx + env(safe-area-inset-bottom)); gap: 20rpx;
}
.f-btn { 
  flex: 1; height: 100rpx; background: #fff; border: 1px solid #E5E5E5;
  border-radius: 20rpx; display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: 600; color: #1D1D1F;
}
.f-btn.dark { background: #000; color: #fff; border: 1px solid #000; }

/* --- 6. 模态窗 --- */
.modal { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); visibility: hidden; opacity: 0; transition: 0.3s; z-index: 10000 !important; /* 🔴 修复：绑定设备弹窗应该高于页面内容，但低于其他弹窗 */ overflow: hidden; /* 防止页面滚动 */ }
.modal.show { visibility: visible; opacity: 1; }

.modal-content { 
  position: absolute; bottom: 0; width: 100%; background: #fff; border-radius: 40rpx 40rpx 0 0;
  /* 🔴 使用动态计算高度，考虑状态栏和导航栏 */
  max-height: calc(100vh - 60px); display: flex; flex-direction: column;
  transform: translateY(100%); transition: 0.3s;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  overflow: hidden; /* 🔴 确保内容不会溢出 */
}

.modal.show .modal-content { transform: translateY(0); }

/* 蓝牙连接成功后：只做内容区过渡，不要整张底栏再硬滑一次 */
.modal.show .modal-content.connected {
  animation: none;
}

.modal.show .modal-content.connected.bind-audit-open {
  max-height: calc(100vh - 40px);
}

/* 绑定设备弹窗：原版表单布局，修复 scroll-view 内上传区重叠 */
