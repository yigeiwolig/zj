@import "../../../styles/hub-page-anim.wxss";
@import "../../../styles/hub-embed-portal.wxss";
@import "../../../styles/overlay-z-index.wxss";
@import "../../../styles/checkout-coupon.wxss";

/* 页面背景（避免使用 page 标签选择器以符合组件 WXSS 规范） */
.container {
  background: #F7F7F7;
  color: #1D1D1F;
  padding-bottom: 40rpx;
  box-sizing: border-box;
}

.container.has-hub-tab {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.hub-tab-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: 12rpx;
  box-sizing: border-box;
  background: #f7f7f7;
  pointer-events: auto;
}

.hub-tab-page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1d1d1f;
  letter-spacing: -0.5rpx;
}

.hub-tab-header-right {
  pointer-events: auto;
  padding-bottom: 4rpx;
}

.hub-tab-header--admin {
  justify-content: center;
  align-items: flex-end;
}

.hub-tab-header--admin .hub-tab-page-title {
  display: none;
}

.hub-admin-mode-bar {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  padding-bottom: 8rpx;
  pointer-events: auto;
  box-sizing: border-box;
}

.hub-admin-exit-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 48rpx;
  border-radius: 999rpx;
  background: #1d1d1f;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}

.hub-admin-exit-btn:active {
  opacity: 0.88;
  transform: scale(0.98);
}

/* 嵌入 products 枢纽：不用 fixed，避免叠到首页卡片上 */
.hub-in-shell .hub-tab-header {
  position: relative;
  top: auto;
  left: auto;
  right: auto;
  flex-shrink: 0;
}

.hub-tab-header--shell {
  flex-direction: column;
  align-items: stretch;
  justify-content: flex-end;
  min-height: 88rpx;
  padding-bottom: 20rpx;
  box-sizing: border-box;
}

.hub-tab-header--shell .hub-tab-page-title {
  align-self: flex-start;
  padding-right: 180rpx;
}

/* 订单 Tab 顶栏：横排标题，避免窄宽竖排 */
.hub-tab-orders-head {
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  gap: 16rpx;
  padding-right: 0;
  min-height: 72rpx;
  box-sizing: border-box;
}

.hub-tab-orders-brand {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.hub-tab-orders-title-block {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 2rpx;
  min-width: 0;
  flex-shrink: 0;
}

.hub-tab-orders-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1d1d1f;
  line-height: 1.15;
  letter-spacing: 0;
  white-space: nowrap;
}

.hub-tab-orders-sub {
  font-size: 22rpx;
  font-weight: 500;
  color: #86868b;
  line-height: 1.2;
  white-space: nowrap;
}

.hub-tab-mt-chip {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  border: 2rpx solid #1d1d1f;
  border-radius: 14rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 900;
  color: #1d1d1f;
  letter-spacing: 0.5rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.hub-tab-inline-admin {
  flex-shrink: 0;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #1d1d1f;
  font-size: 26rpx;
  font-weight: 600;
  border: 1rpx solid #e5e5ea;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.hub-tab-inline-admin:active {
  opacity: 0.88;
  transform: scale(0.98);
}

.hub-tab-header-actions {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 8rpx;
  margin-bottom: 4rpx;
  padding: 0 8rpx;
  pointer-events: auto;
  box-sizing: border-box;
}

.hub-tab-header--shell .hub-tab-header-actions .hub-admin-enter-btn,
.hub-tab-header--shell .hub-tab-header-actions .hub-admin-exit-btn {
  width: 100%;
  max-width: 100%;
  min-height: 72rpx;
  padding: 18rpx 48rpx;
  box-sizing: border-box;
}

.hub-admin-enter-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 48rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #1d1d1f;
  font-size: 28rpx;
  font-weight: 600;
  border: 2rpx solid rgba(0, 0, 0, 0.08);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.hub-admin-enter-btn:active {
  opacity: 0.88;
  transform: scale(0.98);
}

.hub-admin-scroll {
  width: 100%;
  box-sizing: border-box;
}

.hub-orders-scroll--shell,
.hub-admin-scroll--shell,
.hub-profile-scroll--shell {
  flex: 1;
  width: 100%;
  height: 0;
  min-height: 0;
  box-sizing: border-box;
}

.hub-profile-scroll {
  width: 100%;
  box-sizing: border-box;
}

.hub-profile-scroll:not(.hub-profile-scroll--shell) {
  height: calc(100vh - 280rpx);
  max-height: calc(100vh - 280rpx);
}

.hub-profile-body {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.pi-bind-hint {
  display: block;
  font-size: 24rpx;
  color: #86868b;
  line-height: 1.5;
  padding: 8rpx 0 4rpx;
}

.hub-profile-body--neo {
  background: transparent;
}

.hub-admin-scroll:not(.hub-admin-scroll--shell) {
  height: calc(100vh - 280rpx);
  max-height: calc(100vh - 280rpx);
}

.hub-admin-profile-body,
.hub-admin-orders-body--shell {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.admin-profile-toolbar {
  padding: 0 32rpx 20rpx;
