}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

/* 1. 品牌头部 */
.logistics-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 48rpx 48rpx 32rpx; /* 增加留白 */
  background: #fff;
  z-index: 10;
  position: relative;
}

.logistics-header::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 48rpx;
  right: 48rpx;
  height: 1rpx;
  background: rgba(0,0,0,0.05); /* 极细的分隔线 */
}

.brand-tag {
  font-size: 32rpx;
  font-weight: 700;
  color: #1D1D1F;
  letter-spacing: -0.5rpx;
}

.close-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #8E8E93;
  background: rgba(142, 142, 147, 0.12); /* 苹果风格的灰色背景 */
  border-radius: 50%;
  transition: all 0.2s;
}
.close-btn:active {
  background: rgba(142, 142, 147, 0.24);
  transform: scale(0.92);
}

.logistics-modal-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
  min-height: 0;
  /* 🔴 关键修复：确保 flex 子元素可以正确计算高度 */
  height: 0; /* 在 flex 布局中，设置为 0 让 flex: 1 生效 */
  background: #F5F5F7; /* 整体背景改为浅灰，突出卡片 */
  /* 🔴 确保内容区域可以滚动 */
  flex-shrink: 1;
}

/* 2. 核心信息区 */
.logistics-card-container {
  padding: 32rpx 32rpx 0;
  background: #F5F5F7;
  z-index: 5;
  flex-shrink: 0;
}

.logistics-info-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 32rpx; /* 减小内边距 40rpx -> 32rpx */
  position: relative;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.04);
}

.card-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx; /* 减小间距 32rpx -> 24rpx */
}

.company-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.company-icon-placeholder {
  width: 64rpx; /* 减小图标 72rpx -> 64rpx */
  height: 64rpx;
  background: #007AFF;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  box-shadow: 0 8rpx 16rpx rgba(0, 122, 255, 0.25);
}

.company-name {
  font-size: 30rpx; /* 减小字号 34rpx -> 30rpx */
  color: #1D1D1F;
  font-weight: 600;
}

.status-badge {
  font-size: 22rpx; /* 减小字号 24rpx -> 22rpx */
  color: #fff;
  background: #007AFF;
  padding: 6rpx 20rpx;
  border-radius: 100rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 122, 255, 0.2);
}

.status-badge.success {
  background: #34C759;
  box-shadow: 0 4rpx 10rpx rgba(52, 199, 89, 0.2);
}

.logistics-status-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.logistics-exception-btn {
  font-size: 20rpx;
  color: #1677FF;
  background: #fff;
  border: 1rpx solid rgba(22, 119, 255, 0.5);
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
  line-height: 1.2;
  margin-right: 8rpx;
}

.logistics-exception-btn:active {
  background: #f0f6ff;
}

.card-body-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #F5F7FA;
  padding: 20rpx 24rpx; /* 减小内边距 */
