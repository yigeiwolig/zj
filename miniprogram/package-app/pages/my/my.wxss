.bind-device-modal .bind-verifying-tip > text:first-child {
  font-size: 26rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.bind-device-modal .bind-verifying-sub {
  margin-top: 8rpx !important;
  font-size: 22rpx !important;
  color: #8e8e93 !important;
}

.bind-device-modal .form-item,
.hub-embed-portal-layer .bind-device-modal .form-item {
  display: block !important;
  width: 100% !important;
  height: auto !important;
  min-height: 0 !important;
  margin-bottom: 30rpx !important;
  padding: 0 !important;
  border-bottom: none !important;
  align-items: stretch !important;
  box-sizing: border-box;
}

.bind-device-modal .form-label,
.hub-embed-portal-layer .bind-device-modal .form-label {
  display: block !important;
  width: 100% !important;
  max-width: none !important;
  margin-bottom: 14rpx !important;
  font-size: 28rpx !important;
  font-weight: 650 !important;
  color: #1c1c1e !important;
  line-height: 1.35 !important;
  white-space: normal !important;
