  display: flex;
  align-items: center;
  gap: 6rpx;
}

.copy-btn:active {
  background: #f2f2f2;
  transform: scale(0.95);
}

/* 3. 加载状态 */
.logistics-loading {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 400rpx;
}
.mt-loader {
  width: 50rpx;
  height: 50rpx;
  border: 5rpx solid rgba(0, 122, 255, 0.1);
  border-top: 5rpx solid #007AFF;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

/* 4. 错误提示 */
.logistics-error {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}
.error-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}
.error-text {
  font-size: 28rpx;
  color: #8E8E93;
}

/* 5. 物流轨迹列表 (高级时间轴) */
.logistics-scroll {
  flex: 1;
  /* 🔴 关键修复：scroll-view 需要明确的高度才能滚动 */
  height: 0; /* 在 flex 布局中，设置为 0 让 flex: 1 生效 */
  min-height: 0; /* 允许收缩 */
  padding: 20rpx 32rpx 0;
  box-sizing: border-box;
  -webkit-overflow-scrolling: touch;
  /* 🔴 确保可以滚动 */
  overflow-y: auto;
  /* 🔴 关键：确保 scroll-view 可以接收触摸事件 */
  touch-action: pan-y;
}

.timeline-container {
  position: relative;
  padding-bottom: 80rpx;
  padding-left: 0; /* 取消左边距，完全靠布局撑开 */
}

.timeline-item {
  display: flex;
  position: relative;
  margin-bottom: 0;
  padding-bottom: 40rpx; /* 调整卡片间距 48rpx -> 40rpx */
}
.timeline-item:last-child {
  padding-bottom: 0;
}
.timeline-item:last-child .line {
  display: none;
}
/* 左侧：轴线 */
.timeline-axis {
  width: 48rpx; /* 减小宽度 60rpx -> 48rpx */
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  margin-right: 16rpx; /* 减小间距 20rpx -> 16rpx */
  flex-shrink: 0;
  padding-top: 24rpx;
}

.dot {
  width: 12rpx; /* 减小圆点 14rpx -> 12rpx */
  height: 12rpx;
  background: #D1D1D6;
  border-radius: 50%;
  z-index: 2;
  position: relative;
  transition: all 0.3s;
}

/* 最新节点样式 */
.dot.active {
  width: 20rpx; /* 减小激活圆点 24rpx -> 20rpx */
  height: 20rpx;
  background: #007AFF;
  border: 4rpx solid #fff;
  box-shadow: 0 0 0 4rpx rgba(0, 122, 255, 0.2); /* 减小光环 */
  transform: scale(1.0);
}

.line {
  position: absolute;
  top: 36rpx;
  bottom: -20rpx;
  width: 2rpx;
  background: #E5E5EA;
  left: 50%;
  transform: translateX(-50%);
  z-index: 1;
}

/* 右侧：内容容器 */
.timeline-content-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 28rpx; /* 调整内边距 */
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.02);
  border: 1rpx solid rgba(0,0,0,0.02);
}

/* 激活状态文本（最新一条） */
.timeline-content-wrapper.active {
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(0, 122, 255, 0.08); /* 减淡阴影 */
  border: 1rpx solid rgba(0, 122, 255, 0.08);
}

.timeline-content-wrapper.active .time-full {
  color: #007AFF;
  font-weight: 600;
}
.timeline-content-wrapper.active .desc-text {
  color: #1D1D1F;
  font-weight: 500;
}

/* 时间行 */
.timeline-header {
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
}

.time-full {
