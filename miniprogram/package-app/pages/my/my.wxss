}
.bind-new-icon {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #111;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.2);
  margin-bottom: 8rpx;
}
.bind-new-plus {
  color: #fff;
  font-size: 64rpx;
  font-weight: 200;
  line-height: 1;
  margin-top: -6rpx;
}
.bind-new-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1d1d1f;
  line-height: 1.2;
}
.bind-new-desc {
  font-size: 24rpx;
  color: #8e8e93;
  line-height: 1.45;
