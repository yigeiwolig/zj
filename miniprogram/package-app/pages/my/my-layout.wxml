              </view>
              <!-- 回顾教程按钮（右侧，黑底白字） -->
              <view 
                class="btn-mini black" 
                catchtap="viewTutorialOnly">
                回顾教程
              </view>
            </view>

          </view>
        </view>
      </swiper-item>
    </swiper>

