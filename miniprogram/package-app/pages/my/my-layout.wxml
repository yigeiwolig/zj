<!-- 全局自定义弹窗组件 -->
<custom-toast id="custom-toast" />

<root-portal enable="{{hubInShell}}">
<view class="hub-embed-portal-layer">
  <!-- ================= 填写售后单弹窗 ================= -->
  <view class="custom-dialog-mask fill-repair-mask {{fillRepairModalClosing ? 'closing' : ''}} {{showFillRepairModal ? 'show' : ''}}" wx:if="{{showFillRepairModal || fillRepairModalClosing}}" bindtap="closeFillRepairModal" catchtouchmove="noop">
    <view class="custom-dialog-box fill-repair-dialog" catchtap="noop" catchtouchmove="noop">
      <view class="cd-header">
        <view class="cd-title">填写售后单</view>
      </view>
      
      <view class="fill-repair-content">
        <!-- 型号显示 -->
        <view class="fr-model-section">
          <view class="fr-label">型号</view>
          <view class="fr-model-value">{{currentFillRepairItem ? currentFillRepairItem.model : ''}}</view>
        </view>
        
        <!-- 维修项目列表 -->
        <view class="fr-items-section">
          <view class="fr-section-header">
            <view class="fr-label">维修项目</view>
            <view class="fr-add-btn" bindtap="addRepairItem">+ 添加项目</view>
          </view>
          
          <!-- 🔴 维修项目列表可滚动区域 -->
          <scroll-view scroll-y class="fr-items-list" style="max-height: 400rpx;">
            <block wx:for="{{fillRepairItems}}" wx:key="index">
              <view class="fr-item-row">
                <view class="fr-item-input-wrapper">
                  <input 
                    class="fr-item-name" 
                    placeholder="维修项名称" 
                    value="{{item.name}}"
                    data-index="{{index}}"
                    data-field="name"
                    bindinput="onRepairItemInput"
                  />
                  <input 
                    class="fr-item-price" 
                    type="digit" 
                    placeholder="单价(元)" 
                    value="{{item.priceText}}"
                    data-index="{{index}}"
                    data-field="price"
                    bindinput="onRepairItemInput"
                  />
                </view>
                <view class="fr-item-delete" bindtap="deleteRepairItem" data-index="{{index}}">删除</view>
              </view>
            </block>
            
            <view class="fr-empty-items" wx:if="{{fillRepairItems.length === 0}}">
              <text>暂无维修项目</text>
              <text style="display: block; margin-top: 8rpx; font-size: 24rpx; color: #C7C7CC;">点击右上角"添加项目"开始</text>
            </view>
          </scroll-view>
        </view>
        
        <!-- 总价显示 -->
        <view class="fr-total-section">
          <view class="fr-total-row">
            <text class="fr-total-label">总价：</text>
            <text class="fr-total-price">¥{{fillRepairTotalPriceFormatted}}</text>
          </view>
        </view>

        <!-- 统一逻辑：不区分是否过保，均可配置是否向用户收取维修费 -->
        <view class="fr-switch-section" wx:if="{{afterSalesState.fillRepairModal && afterSalesState.fillRepairModal.hasItem}}">
          <view class="fr-switch-row">
            <text class="fr-label">需要用户支付维修费</text>
            <switch checked="{{fillRepairRequireUserPay}}" bindchange="onFillRepairRequireUserPayChange" color="#000000" />
          </view>
          <text class="fr-switch-hint" wx:if="{{afterSalesState.fillRepairModal.showPayHint}}">开启后仅保存报价，用户需在「我的」需寄回卡片中完成支付；支付完成前请勿填写寄出运单号。</text>
        </view>

        <!-- 整机寄回维修：可选修回+新件同寄（继续需寄回） -->
        <view class="fr-switch-section" wx:if="{{afterSalesState.fillRepairModal && afterSalesState.fillRepairModal.showReshipSwitch}}">
          <view class="fr-switch-row">
            <text class="fr-label">修回+新件同寄（继续需寄回）</text>
            <switch checked="{{fillRepairReshipPlusSpare}}" bindchange="onFillRepairReshipPlusSpareChange" color="#000000" />
          </view>
          <text class="fr-switch-hint" wx:if="{{afterSalesState.fillRepairModal.showReshipHint}}">填写维修项目告诉用户换了什么；寄出运单号填一个（修好产品与新配件同一包裹）；提交后单子继续留在需寄回，等用户再寄故障件。</text>
        </view>
        
        <!-- 🔴 运单号输入：管理员寄给用户的单号（trackingId），不是用户寄回的 returnTrackingId -->
        <view class="fr-tracking-section" wx:if="{{afterSalesState.fillRepairModal && afterSalesState.fillRepairModal.showTrackingSection}}">
          <view class="fr-label">{{afterSalesState.fillRepairModal.trackingLabel || '寄出运单号'}}</view>
          <input 
            class="fr-tracking-input" 
            placeholder="{{afterSalesState.fillRepairModal.trackingPlaceholder || '请输入寄给用户的快递单号'}}"
            value="{{fillRepairTrackingId}}"
            bindinput="onFillRepairTrackingIdInput"
          />
        </view>
        
      </view>
      
      <!-- 底部按钮 -->
      <view class="cd-btn-row fill-repair-btns">
        <view class="cd-btn cancel" bindtap="closeFillRepairModal">取消</view>
        <view class="cd-btn confirm" bindtap="submitFillRepair">提交</view>
      </view>
    </view>
  </view>

<!-- ================= 购买配件弹窗 ================= -->
<view class="custom-dialog-mask purchase-parts-mask {{purchasePartsModalClosing ? 'closing' : ''}}" wx:if="{{showPurchasePartsModal || purchasePartsModalClosing}}" bindtap="closePurchasePartsModal" catchtouchmove="noop">
  <view class="custom-dialog-box purchase-parts-dialog" catchtap="noop" catchtouchmove="noop">
    <view class="cd-content purchase-parts-content">
      <scroll-view class="parts-scroll" scroll-y>
        <block wx:for="{{purchasePartsList}}" wx:key="model">
          <view class="parts-group">
            <view class="parts-group-title">{{item.model}}</view>
            <view class="parts-list">
              <view 
                class="parts-item {{part.selected ? 'selected' : ''}}" 
                wx:for="{{item.parts}}" 
                wx:key="name"
                wx:for-item="part"
                data-model="{{item.model}}"
                data-part-name="{{part.name}}"
                bindtap="togglePartSelection"
              >
                <text class="parts-checkbox">{{part.selected ? '✓' : ''}}</text>
                <text class="parts-name">{{part.name}}</text>
              </view>
            </view>
          </view>
        </block>
      </scroll-view>
      
      <view class="parts-note-section">
        <text class="parts-note-label">备注说明：</text>
        <textarea 
          class="parts-note-input" 
          placeholder="请输入备注信息（选填）"
          value="{{purchasePartsNote}}"
          bindinput="onPurchasePartsNoteInput"
          maxlength="200"
        />
      </view>
    </view>
    <view class="cd-btn-row">
      <view class="cd-btn cancel" bindtap="closePurchasePartsModal">取消</view>
      <view class="cd-btn confirm" bindtap="submitPurchaseParts">确定</view>
    </view>
  </view>
</view>

<!-- ================= 付费维修确认弹窗 ================= -->
<view class="custom-dialog-mask {{paidRepairConfirmModalClosing ? 'closing' : ''}}" wx:if="{{showPaidRepairConfirmModal || paidRepairConfirmModalClosing}}" bindtap="rejectPaidRepair" catchtouchmove="noop">
  <view class="custom-dialog-box" catchtap="noop" catchtouchmove="noop">
    <view class="cd-title">维修费用确认</view>
    <view class="cd-content">
      <text>维修完成后需要支付维修费用30元+配件费用，是否同意？</text>
    </view>
    <view class="cd-btn-row">
      <view class="cd-btn cancel" bindtap="rejectPaidRepair">取消</view>
      <view class="cd-btn confirm" bindtap="confirmPaidRepair">同意</view>
    </view>
  </view>
</view>

<!-- ================= 寄回维修：页内直接蓝牙更换主板 ================= -->
<view class="custom-dialog-mask {{motherboardBleClosing ? 'closing' : ''}}" wx:if="{{showMotherboardBleModal}}" catchtouchmove="noop">
  <view class="custom-dialog-box motherboard-ble-dialog" catchtap="noop" catchtouchmove="noop">
    <view class="cd-title">更换主板</view>
    <view class="motherboard-ble-sub">
      请靠近新主板并保持蓝牙开启，连接后会自动解析 SN 并替换用户设备卡
    </view>
    <view class="motherboard-ble-meta" wx:if="{{motherboardBleOldSn || motherboardBleModel}}">
      <text wx:if="{{motherboardBleModel}}">型号 {{motherboardBleModel}}</text>
      <text wx:if="{{motherboardBleOldSn}}">旧 SN {{motherboardBleOldSn}}</text>
    </view>

    <view class="bt-scan-container motherboard-ble-radar">
      <view class="radar-circle" bindtap="startMotherboardBleScan">
        <view class="radar-core">
          <image class="bt-icon-img" src="data:image/svg+xml;base64," mode="aspectFit" lazy-load="true"></image>
        </view>
        <view class="radar-ring r1 {{isScanning?'anim':''}}"></view>
        <view class="radar-ring r2 {{isScanning?'anim':''}}"></view>
        <view class="radar-ring r3 {{isScanning?'anim':''}}"></view>
      </view>
      <text class="radar-tip">{{connectStatusText}}</text>
      <text class="motherboard-ble-sn" wx:if="{{currentSn}}">{{currentSn}}</text>
    </view>

    <view class="cd-btn-row">
      <view class="cd-btn cancel {{motherboardBleSubmitting ? 'disabled' : ''}}" bindtap="closeMotherboardBleModal">取消</view>
      <view class="cd-btn confirm {{motherboardBleSubmitting ? 'disabled' : ''}}" bindtap="startMotherboardBleScan">
        {{motherboardBleSubmitting ? '替换中…' : (isScanning ? '扫描中…' : '重新扫描')}}
      </view>
    </view>
  </view>
</view>

<!-- ================= 配置回溯：已审核绑定，可完整重填参数 ================= -->
<view class="custom-dialog-mask {{configRollbackClosing ? 'closing' : ''}}" wx:if="{{showConfigRollbackModal}}" bindtap="closeConfigRollbackModal" catchtouchmove="noop">
  <view class="custom-dialog-box config-rollback-dialog" catchtap="noop" catchtouchmove="noop">
    <view class="cd-title">配置回溯</view>
    <view class="config-rollback-sub">绑定申请记录可完整重填：型号、控制版本、购买日期、质保天数</view>

    <view class="config-rollback-loading" wx:if="{{configRollbackLoading}}">加载中…</view>
    <view class="config-rollback-empty" wx:elif="{{configRollbackHistory.length === 0}}">暂无申请记录</view>

    <scroll-view wx:else class="config-rollback-list" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="config-rollback-item config-rollback-item--edit" wx:for="{{configRollbackHistory}}" wx:key="_id">
        <view class="config-rollback-item-top">
          <text class="config-rollback-item-sn">{{item.sn || '（未录入 SN）'}}</text>
          <text class="config-rollback-item-tag" wx:if="{{item.bindType === 'fault'}}">故障核验</text>
          <text class="config-rollback-item-tag admin" wx:if="{{item.isAdminApply}}">管理员测试</text>
          <text class="config-rollback-item-tag pending" wx:if="{{!item.approved}}">待审核</text>
        </view>
        <view class="config-rollback-item-meta" wx:if="{{item.timeText}}">
          <text class="config-rollback-item-time">{{item.timeText}} 申请</text>
        </view>

        <block wx:if="{{item.hasDevice}}">
          <view class="config-rollback-field">
            <text class="config-rollback-field-label">设备型号</text>
            <picker
              mode="selector"
              range="{{adminAuditModelOptions}}"
              value="{{item.modelIndex}}"
              data-index="{{index}}"
              data-field="model"
              bindchange="onConfigRollbackFieldChange"
            >
              <view class="config-rollback-field-value">
                {{adminAuditModelOptions[item.modelIndex] || item.productModel || '请选择'}}
                <text class="config-rollback-item-model-arrow">▾</text>
              </view>
            </picker>
          </view>

          <view class="config-rollback-field">
            <text class="config-rollback-field-label">控制版本</text>
            <view
              class="ctrl-variant-seg ctrl-variant-seg--compact config-rollback-variant {{item.controlVariant === 'remote' ? 'is-remote' : (item.controlVariant === 'button' ? 'is-button' : '')}}"
              bindtouchstart="onCtrlVariantTouchStart"
              bindtouchend="onConfigRollbackVariantTouchEnd"
              data-scope="rollback"
              data-index="{{index}}"
            >
              <view class="ctrl-variant-thumb-wrap"><view class="ctrl-variant-thumb"></view></view>
              <view
                class="ctrl-variant-item {{item.controlVariant === 'button' ? 'is-on' : ''}}"
                catchtap="onConfigRollbackVariantTap"
                data-index="{{index}}"
                data-value="button"
              >按钮版</view>
              <view
                class="ctrl-variant-item {{item.controlVariant === 'remote' ? 'is-on' : ''}}"
                catchtap="onConfigRollbackVariantTap"
                data-index="{{index}}"
                data-value="remote"
              >遥控版</view>
            </view>
          </view>

          <view class="config-rollback-field" wx:if="{{item.sensorStampLabel}}">
            <text class="config-rollback-field-label">传感器（只读）</text>
            <view class="config-rollback-field-value">{{item.sensorStampLabel}}</view>
          </view>

          <view class="config-rollback-field">
            <text class="config-rollback-field-label">购买日期</text>
            <picker
              mode="date"
              value="{{item.buyDate}}"
              data-index="{{index}}"
              data-field="buyDate"
              bindchange="onConfigRollbackFieldChange"
            >
              <view class="config-rollback-field-value">
                {{item.buyDate || '请选择日期'}}
                <text class="config-rollback-item-model-arrow">▾</text>
              </view>
            </picker>
          </view>

          <view class="config-rollback-field">
            <text class="config-rollback-field-label">质保时长</text>
            <picker
              mode="selector"
              range="{{warrantyOptions}}"
              value="{{item.warrantyIndex}}"
              data-index="{{index}}"
              data-field="warranty"
              bindchange="onConfigRollbackFieldChange"
            >
              <view class="config-rollback-field-value">
                {{warrantyOptions[item.warrantyIndex] || (item.totalDays + '天')}}
                <text class="config-rollback-item-model-arrow">▾</text>
              </view>
            </picker>
          </view>

          <view class="config-rollback-item-meta" wx:if="{{item.expiryDate}}">
            <text class="config-rollback-item-expiry">到期 {{item.expiryDate}} · 剩 {{item.remainingDays}} 天</text>
          </view>

          <view
            class="config-rollback-save"
            data-index="{{index}}"
            bindtap="saveConfigRollbackItem"
          >保存修改</view>
        </block>

        <block wx:elif="{{item.approved}}">
          <view class="config-rollback-item-meta">
            <text class="config-rollback-item-expiry warn">设备档案不存在（可能已删除）</text>
          </view>
        </block>
        <block wx:else>
          <view class="config-rollback-item-meta">
            <text class="config-rollback-item-expiry">尚未审核，请先在「绑定审核」中处理</text>
          </view>
        </block>
      </view>
    </scroll-view>

    <view class="cd-btn-row config-rollback-btns">
      <view class="cd-btn confirm" bindtap="closeConfigRollbackModal">关闭</view>
    </view>
  </view>
</view>

<!-- ================= 寄回完结回溯：误点完结后拉回需寄回列表 ================= -->
<view class="custom-dialog-mask {{returnCompleteRollbackClosing ? 'closing' : ''}}" wx:if="{{showReturnCompleteRollbackModal}}" bindtap="closeReturnCompleteRollbackModal" catchtouchmove="noop">
  <view class="custom-dialog-box config-rollback-dialog" catchtap="noop" catchtouchmove="noop">
    <view class="cd-title">寄回回溯</view>
    <view class="config-rollback-sub">误完结可撤销；误撤回待处理的会查运单记录并恢复到「需寄回确认」</view>

    <view class="config-rollback-loading" wx:if="{{returnCompleteRollbackLoading}}">加载中…</view>
    <view class="config-rollback-empty" wx:elif="{{returnCompleteRollbackList.length === 0}}">暂无可回溯工单</view>

    <scroll-view wx:else class="config-rollback-list" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="config-rollback-item config-rollback-item--edit" wx:for="{{returnCompleteRollbackList}}" wx:key="_id">
        <view class="config-rollback-item-top">
          <text class="config-rollback-item-sn">{{item.sn || '（无 SN）'}}</text>
          <text class="config-rollback-item-tag">{{item.statusLabel}}</text>
        </view>
        <view class="config-rollback-item-meta" wx:if="{{item.model}}">
          <text class="config-rollback-item-time">{{item.model}}</text>
        </view>
        <view class="config-rollback-item-meta" wx:if="{{item.completeTimeText}}">
          <text class="config-rollback-item-time">时间 {{item.completeTimeText}}</text>
        </view>
        <view class="config-rollback-item-meta" wx:if="{{item.trackingId}}">
          <text class="config-rollback-item-time">备件运单 {{item.trackingId}}</text>
        </view>
        <view class="config-rollback-item-meta" wx:elif="{{item.kind === 'restore'}}">
          <text class="config-rollback-item-expiry warn">未查到运单号，恢复后可在需寄回里重录</text>
        </view>
        <view class="config-rollback-item-meta" wx:if="{{item.returnTrackingId}}">
          <text class="config-rollback-item-time">用户运单 {{item.returnTrackingId}}</text>
        </view>
        <view class="config-rollback-item-meta" wx:if="{{item.returnNote}}">
          <text class="config-rollback-item-expiry">{{item.returnNote}}</text>
        </view>
        <view
          class="config-rollback-save"
          data-id="{{item._id}}"
          data-index="{{index}}"
          data-kind="{{item.kind}}"
          bindtap="undoReturnCompleteItem"
        >{{item.actionText}}</view>
      </view>
    </scroll-view>

    <view class="cd-btn-row config-rollback-btns">
      <view class="cd-btn confirm" bindtap="closeReturnCompleteRollbackModal">关闭</view>
    </view>
  </view>
</view>

<!-- ================= 测试清空密码弹窗（带收缩退出动画） ================= -->
