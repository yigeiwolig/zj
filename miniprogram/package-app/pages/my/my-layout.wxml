            <view class="rr-payment-status-text rr-payment-status-text-paid" wx:if="{{myReturnRequiredRepair.repairPaid === true}}">
              <text class="rr-payment-paid">✓ 已支付</text>
            </view>
            <view class="rr-payment-status-text" wx:else>
              <view class="rr-payment-unpaid-wrap">
              </view>
              <view class="rr-payment-btn" bindtap="payRepairFee" data-id="{{myReturnRequiredRepair._id}}">立即支付</view>
