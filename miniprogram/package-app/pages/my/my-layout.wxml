<!-- ================= 定位权限提示遮罩 ================= -->
<view class="location-permission-mask {{locationPermissionModalClosing ? 'closing' : ''}}" wx:if="{{showLocationPermissionModal || locationPermissionModalClosing}}" catchtouchmove="noop">
  <view class="location-permission-content" catchtouchmove="noop">
    <view class="location-permission-icon">📍</view>
    <text class="location-permission-title">需要获取您的位置信息</text>
    <text class="location-permission-desc">用于展示附近维修门店和计算配送距离</text>
    <view class="location-permission-buttons">
      <view class="location-permission-btn cancel" bindtap="closeLocationPermissionModal">拒绝</view>
      <view class="location-permission-btn confirm" bindtap="_openLocationSetting">去设置</view>
    </view>
    <text class="location-permission-tip" wx:if="{{locationPermissionChecking}}">等待授权中...</text>
  </view>
</view>

<!-- 【全局通用】自定义"内容已复制"弹窗（统一使用 copy-success-modal 样式） -->
<view class="custom-modal-mask {{copySuccessModalClosing ? 'closing' : ''}}" wx:if="{{showCopySuccessModal || copySuccessModalClosing}}" catchtouchmove="noop" bindtap="dismissTransientModals">
  <view class="custom-modal-box copy-success-modal" catchtouchmove="noop" bindtap="dismissTransientModals">
    <!-- 图标：使用 Unicode 字符 -->
    <view class="modal-icon-new success-icon">✓</view>
    <!-- 标题 -->
    <view class="modal-title-new">内容已复制</view>
  </view>
</view>

<!-- ======================= -->
<!-- 🔴 权限拒绝提示弹窗 (复用 scan 页样式) -->
<!-- ======================= -->
<view class="password-modal-mask {{permissionModalClosing ? 'closing' : ''}}" wx:if="{{showPermissionModal}}" catchtouchmove="noop" catchtap="noop">
  <view class="password-box" catchtouchmove="noop" catchtap="noop">
    <view class="pass-title">蓝牙权限未开启</view>
    
    <view class="permission-guide">
       <view class="guide-title">开启蓝牙权限</view>
       
       <view class="guide-flow">
          <view class="flow-item">
             <view class="flow-number">1</view>
             <view class="flow-content">
                <view class="flow-icon-box">
                   <image class="flow-icon" src="{{icons.moreDark}}" mode="aspectFit" lazy-load="true"></image>
                </view>
                <text class="flow-text">点击右上角</text>
             </view>
          </view>
          
          <view class="flow-connector"></view>
          
          <view class="flow-item">
             <view class="flow-number">2</view>
             <view class="flow-content">
                <view class="flow-icon-box">
                   <image class="flow-icon" src="{{icons.gearSmall}}" mode="aspectFit" lazy-load="true"></image>
                </view>
                <text class="flow-text">选择设置</text>
             </view>
          </view>
          
          <view class="flow-connector"></view>
          
          <view class="flow-item">
             <view class="flow-number">3</view>
             <view class="flow-content">
                <view class="flow-icon-box">
                   <image class="flow-icon" src="{{icons.btDark}}" mode="aspectFit" lazy-load="true"></image>
                </view>
                <text class="flow-text">开启蓝牙</text>
             </view>
          </view>
       </view>
    </view>

    <view class="pass-btns">
       <view class="p-btn confirm full-width" bindtap="closePermissionModal">知道了</view>
    </view>
  </view>
</view>

<!-- 🔴 新增：上传选项弹窗（选择相册/拍照） -->
<view class="upload-modal-overlay" wx:if="{{showUploadOptions}}" bindtap="closeUploadOptions">
  <view class="upload-modal-content" catchtap="preventBubble">
    <view class="upload-options-container">
      <view class="upload-modal-title">选择上传方式</view>
      <view class="upload-options-list">
        <view class="upload-option-card" bindtap="chooseImageFromAlbum" data-action="album">
          <view class="upload-option-icon-wrapper">
            <view class="upload-option-icon album-icon"></view>
          </view>
          <view class="upload-option-label">从相册选择</view>
        </view>
        <view class="upload-option-card" bindtap="chooseImageFromCamera" data-action="camera">
          <view class="upload-option-icon-wrapper">
            <view class="upload-option-icon video-icon"></view>
          </view>
          <view class="upload-option-label">拍照</view>
        </view>
      </view>
    </view>
    <view class="upload-modal-cancel" bindtap="closeUploadOptions">取消</view>
  </view>
</view>

<template is="checkoutCouponSheet" data="{{couponSheetOpen: couponSheetOpen, couponSheetClosing: couponSheetClosing, couponSheetAnimIn: couponSheetAnimIn, checkoutCoupons: checkoutCoupons, selectedCouponIds: selectedCouponIds, couponDiscountYuan: couponDiscountYuan, preCouponTotalYuan: preCouponTotalYuan, checkoutCouponsLoading: checkoutCouponsLoading, isAdmin: isAdmin}}"/>
</view>
</root-portal>
