/* ================= 极简 AI 语音页面（按设计稿） ================= */

.pure-screen {
  position: relative;
  width: 100%;
  height: 100vh;
  min-height: 100vh;
  background: #ffffff;
  overflow: hidden;
  box-sizing: border-box;
}

.pure-back-hit {
  position: fixed;
  left: 0;
  z-index: 30;
  width: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pure-back-hit:active {
  opacity: 0.45;
}

.pure-back-arrow {
  font-size: 48rpx;
  font-weight: 300;
  color: #1d1d1f;
  line-height: 1;
  margin-left: -8rpx;
}

/* 1. 顶部状态 */
.top-meta {
  position: fixed;
  left: 0;
  right: 0;
  text-align: center;
  z-index: 20;
  pointer-events: none;
}

.top-meta-row {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(245, 245, 247, 0.92);
  border: 1rpx solid rgba(0, 0, 0, 0.06);
}

.top-meta-row--open {
  background: rgba(52, 199, 89, 0.1);
  border-color: rgba(52, 199, 89, 0.18);
}

.top-meta-row--closed {
  background: rgba(142, 142, 147, 0.1);
  border-color: rgba(142, 142, 147, 0.16);
}

.top-meta-row--stealth {
  background: rgba(175, 82, 222, 0.1);
  border-color: rgba(175, 82, 222, 0.18);
}

.top-meta-row--moving,
.top-meta-row--unknown {
  background: rgba(255, 159, 10, 0.12);
  border-color: rgba(255, 159, 10, 0.22);
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  background: #ff9f0a;
  border-radius: 50%;
  margin-right: 14rpx;
  flex-shrink: 0;
  box-shadow: 0 0 0 4rpx rgba(255, 159, 10, 0.18);
}

.status-dot--open {
  background: #34c759;
  box-shadow: 0 0 0 4rpx rgba(52, 199, 89, 0.2);
}

.status-dot--closed {
  background: #636366;
  box-shadow: 0 0 0 4rpx rgba(99, 99, 102, 0.16);
}

.status-dot--stealth {
  background: #af52de;
  box-shadow: 0 0 0 4rpx rgba(175, 82, 222, 0.2);
}

.status-dot--moving,
.status-dot--unknown {
  background: #ff9f0a;
  box-shadow: 0 0 0 4rpx rgba(255, 159, 10, 0.2);
}

.status-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d1d1f;
  letter-spacing: 0.5rpx;
  line-height: 1;
}

.top-meta-row--open .status-text {
  color: #248a3d;
}

.top-meta-row--closed .status-text {
  color: #48484a;
}

.top-meta-row--stealth .status-text {
  color: #8944ab;
}

.top-meta-row--moving .status-text,
.top-meta-row--unknown .status-text {
  color: #c93400;
}

/* 2. 核心区：AI 灵动弦 — 屏幕正中 */
.ai-engine {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  transform: translateY(-50%);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1;
}

.string-container {
  width: 480rpx;
  height: 4rpx;
  background: rgba(0, 0, 0, 0.03);
  position: relative;
  border-radius: 4rpx;
  overflow: visible;
}

.ai-string {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 4rpx;
  background: linear-gradient(90deg,
      transparent 0%,
      #007aff 50%,
      transparent 100%
  );
  filter: blur(2rpx);
  transform-origin: center center;
  animation: string-flow 3s infinite ease-in-out;
}

.string-wave {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 240rpx;
  height: 56rpx;
  margin-top: -28rpx;
  margin-left: -120rpx;
  background: radial-gradient(ellipse at center, rgba(0, 122, 255, 0.14) 0%, transparent 72%);
  pointer-events: none;
  animation: ripple 2.5s infinite ease-in-out;
}

.ai-engine.quiet .ai-string {
  animation-duration: 2.4s;
}

.ai-engine.quiet .string-wave {
  animation-duration: 2.2s;
}

.ai-engine.speaking .ai-string {
  animation-duration: 1s;
  filter: blur(1.5rpx);
  opacity: 1;
}

.ai-engine.speaking .string-wave {
  animation-duration: 0.85s;
  background: radial-gradient(ellipse at center, rgba(0, 122, 255, 0.28) 0%, transparent 72%);
}

.ai-engine.dormant .ai-string {
  animation-duration: 3s;
  opacity: 0.45;
}

.ai-engine.dormant .string-wave {
  animation-duration: 2.8s;
  opacity: 0.35;
}

/* 3. 底部对话引导 */
.dialog-area {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding-bottom: 240rpx;
  text-align: center;
  z-index: 2;
}

.main-msg {
  font-size: 48rpx;
  font-weight: 600;
  color: #1d1d1f;
  letter-spacing: -1rpx;
  margin-bottom: 24rpx;
  opacity: 0.9;
}

.sub-msg {
  font-size: 28rpx;
  color: #86868b;
  font-weight: 400;
  line-height: 1.4;
}

.admin-footer {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 80rpx;
  text-align: center;
  font-size: 22rpx;
  color: #d1d1d6;
  letter-spacing: 2rpx;
  z-index: 2;
}

@keyframes string-flow {
  0%, 100% {
    transform: scaleX(0.4);
    opacity: 0.2;
  }
  50% {
    transform: scaleX(1);
    opacity: 0.8;
  }
}

@keyframes ripple {
  0%, 100% {
    transform: scale(0.75);
    opacity: 0.25;
  }
  50% {
    transform: scale(1.35);
    opacity: 0.95;
  }
}
