<view class="pure-screen">
  <view class="pure-back-hit" catchtap="goBack" style="top: {{statusBarHeight}}px; height: {{navBarHeight}}px;">
    <text class="pure-back-arrow">‹</text>
  </view>

  <!-- 顶部状态 -->
  <view class="top-meta" style="top: {{statusBarHeight + navBarHeight + 8}}px;">
    <view class="top-meta-row top-meta-row--{{flapPanelState}}">
      <view class="status-dot status-dot--{{flapPanelState}}"></view>
      <text class="status-text">{{statusMetaText}}</text>
    </view>
  </view>

  <!-- 中部：AI 灵动弦（屏幕垂直正中） -->
  <view class="ai-engine {{rippleClass}}">
    <view class="string-container">
      <view class="string-wave"></view>
      <view class="ai-string"></view>
    </view>
  </view>

  <!-- 底部对话 -->
  <view class="dialog-area">
    <view class="main-msg">{{mainMsg}}</view>
    <view class="sub-msg">{{subMsg}}</view>
  </view>

  <view class="admin-footer" wx:if="{{showAdminFooter}}">MANAGEMENT PREVIEW</view>

  <custom-toast id="custom-toast"></custom-toast>
</view>
