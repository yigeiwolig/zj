<!-- pages/pagenew/pagenew.wxml -->
<view class="container">

<!-- ================= 1. 自定义导航栏 ================= -->
<view class="header" style="padding-top: {{statusBarHeight}}px;">
  <view class="back-icon" catchtap="goBack" style="top: {{statusBarHeight + 10}}px;">
    <text class="back-arrow">‹</text>
  </view>
</view>
<view class="nav-header" style="padding-top: {{statusBarHeight}}px; height: {{statusBarHeight + navBarHeight + 20}}px;">
  <view class="brand-title" style="top: {{statusBarHeight + navBarHeight / 2}}px;">
    <text>MT 新品展示</text>
    <view wx:if="{{isAuthorized}}" class="admin-toggle-btn {{isAdmin ? 'on' : ''}}" catchtap="toggleAdminMode">
      {{isAdmin ? 'EXIT' : 'EDIT'}}
    </view>
  </view>
</view>

<!-- ================= 2. 核心滑动区 ================= -->
<view class="swiper-container">
  <swiper 
    class="card-swiper" 
    current="{{currentIndex}}" 
    previous-margin="56rpx" 
    next-margin="56rpx" 
    bindchange="onSwiperChange"
    circular="{{false}}"
  >
    <block wx:for="{{products}}" wx:key="_id">
      <swiper-item class="card-wrapper">
        <!-- 白色外框（画框感），与灰底区分 -->
        <view
          class="apple-card-frame {{currentIndex === index ? 'active' : ''}}"
          bindtap="{{!isAdmin ? 'handleCardClick' : ''}}"
          data-index="{{index}}"
        >
        <view class="apple-card">
          
          <!-- A. 图片区域 -->
          <view class="card-cover">
            <view class="product-cover-wrapper">
              <image class="cover-img" src="{{item.cover || defaultCover}}" mode="aspectFill" lazy-load binderror="onPagenewCoverError" data-index="{{index}}"/>
              <!-- 跳转号码标识（管理员模式下可编辑） -->
              <view wx:if="{{isAdmin}}" class="jump-number-badge" catchtap="handleEditJumpNumber" data-index="{{index}}">
                <text wx:if="{{item.jumpNumber}}">#{{item.jumpNumber}}</text>
                <text wx:else>#</text>
              </view>
            </view>
            
            <!-- [管理员] 功能区 (只有管理员能点) -->
            <block wx:if="{{isAdmin}}">
              <!-- 左上角：删除 -->
              <view class="admin-btn btn-del" catchtap="handleDeleteProduct">✕</view>
              <!-- 右上角：换封面 -->
              <view class="admin-btn btn-cam" catchtap="handleUploadCover">📷</view>
            </block>
          </view>

          <!-- B. 信息区域：标题 → 简介 → 价格，右侧箭头 -->
          <view class="card-content">
            <view class="card-content-inner">
              <view class="info-text">
                <text
                  class="p-title {{isAdmin ? 'editable' : ''}}"
                  catchtap="{{isAdmin ? 'handleEditTitle' : ''}}"
                >{{item.title || 'New Product'}}</text>

                <view class="p-desc-wrap" wx:if="{{item.desc}}">
                  <text
                    class="p-desc {{isAdmin ? 'editable' : ''}}"
                    catchtap="{{isAdmin ? 'handleEditDesc' : ''}}"
                  >{{item.desc}}</text>
                </view>
                <view
                  wx:elif="{{isAdmin}}"
                  class="p-desc-placeholder"
                  catchtap="handleEditDesc"
                >点击添加商品简介</view>

                <text
                  class="p-price {{isAdmin ? 'editable' : ''}}"
                  catchtap="{{isAdmin ? 'handleEditPrice' : ''}}"
                >¥ {{item.price || '0'}}</text>
              </view>

              <view class="card-content-side">
                <view class="btn-go" wx:if="{{!isAdmin}}">
                  <view class="icon-arrow"></view>
                </view>
                <view class="btn-go admin-icon" wx:if="{{isAdmin}}">⚙️</view>
              </view>
            </view>
          </view>

        </view>
        </view>
      </swiper-item>
    </block>

    <!-- [管理员] 新建卡片 -->
    <swiper-item class="card-wrapper" wx:if="{{isAdmin}}">
      <view class="apple-card-frame {{currentIndex === products.length ? 'active' : ''}}">
        <view class="apple-card add-card" bindtap="handleAddNew">
          <view class="add-icon">+</view>
          <text class="add-text">NEW ARRIVAL</text>
        </view>
      </view>
    </swiper-item>

  </swiper>
</view>


</view>

<!-- ================= 自定义编辑弹窗 ================= -->
<view class="custom-modal-mask {{customEditModalClosing ? 'closing' : ''}}" wx:if="{{showCustomEditModal}}" bindtap="closeCustomEditModal" catchtouchmove="noop">
  <view class="custom-modal-box" catchtap="noop" catchtouchmove="noop">
    <view class="modal-title">{{customEditTitle}}</view>
    <textarea
      wx:if="{{customEditMultiline}}"
      class="modal-textarea"
      placeholder="{{customEditPlaceholder}}"
      value="{{customEditVal}}"
      maxlength="200"
      show-confirm-bar="{{false}}"
      bindinput="onCustomEditInput"
    />
    <input
      wx:else
      class="modal-input"
      type="text"
      placeholder="{{customEditPlaceholder || '请输入'}}"
      value="{{customEditVal}}"
      bindinput="onCustomEditInput"
      confirm-type="done"
      bindconfirm="confirmCustomEdit"
      focus="{{showCustomEditModal}}"
    />
    <view class="modal-btn-row">
      <view class="modal-btn cancel" bindtap="closeCustomEditModal">取消</view>
      <view class="modal-btn confirm" bindtap="confirmCustomEdit">确定</view>
    </view>
  </view>
</view>

<!-- 全局自定义弹窗组件 -->
<custom-toast id="custom-toast" />
