<!-- pages/my/my.wxml -->
<import src="./return-required-items.wxml" />
<wxs module="tools">
  module.exports.firstChar = function(str) {
    if (!str || str.length === 0) return '�?;
    return str.substring(0, 1);
  }
</wxs>
<wxs module="memberTier">
  function countOf(n) {
    var c = parseInt(n, 10);
    return isNaN(c) || c < 0 ? 0 : c;
  }
  function levelName(deviceCount) {
    var n = countOf(deviceCount);
    if (n >= 5) return '王�?;
    if (n >= 4) return '星耀';
    if (n >= 3) return '钻石';
    if (n >= 2) return '铂金';
    return '普通黄�?;
  }
  function badge(deviceCount) {
    var lv = levelName(deviceCount);
    if (lv === '普通黄�?) return '普通黄金会�?;
    return lv + '尊享会员';
  }
  function theme(deviceCount) {
    var n = countOf(deviceCount);
    if (n >= 5) return 'king';
    if (n >= 4) return 'star';
    if (n >= 3) return 'diamond';
    if (n >= 2) return 'platinum';
    return 'gold';
  }
  module.exports.levelName = levelName;
  module.exports.badge = badge;
  module.exports.theme = theme;
</wxs>

<view class="container {{hasModalOpen ? 'modal-open' : ''}} {{showHubTabBar || hubInShell ? 'has-hub-tab' : ''}} {{hubInShell ? 'hub-in-shell' : ''}} {{hubPageEnterAnim ? 'hub-page-enter' : ''}}">

  <!-- Tab 页顶栏（无返回键）；嵌入枢纽时仅当前 Tab 显示，避�?fixed 叠到首页 -->
  <view
    wx:if="{{(showHubTabBar || hubInShell) && (!hubInShell || active)}}"
    class="header hub-tab-header {{hubInShell ? 'hub-tab-header--shell' : ''}} {{isAdmin && isAuthorized && !hubInShell ? 'hub-tab-header--admin' : ''}}"
    style="padding-top: {{statusBarHeight}}px; {{hubInShell ? '' : 'height: ' + (statusBarHeight + navBarHeight) + 'px;'}}"
  >
    <block wx:if="{{hubInShell}}">
      <view wx:if="{{hubView === 'orders' && (!isAdmin || !isAuthorized)}}" class="hub-tab-orders-head">
        <view class="hub-tab-orders-title-wrap">
          <view class="hub-tab-mt-chip" aria-hidden="true">MT</view>
          <text class="hub-tab-page-title hub-tab-page-title--orders">订单</text>
        </view>
        <view wx:if="{{isAuthorized && !isAdmin}}" class="hub-tab-inline-admin" catchtap="toggleAdminMode">管理</view>
      </view>
      <text class="hub-tab-page-title" wx:elif="{{!isAdmin || !isAuthorized}}">我的</text>
      <view class="hub-tab-header-actions" wx:if="{{isAuthorized && (isAdmin || hubView === 'profile')}}">
        <view wx:if="{{!isAdmin}}" class="hub-admin-enter-btn" catchtap="toggleAdminMode">管理模式</view>
        <view wx:else class="hub-admin-exit-btn" catchtap="toggleAdminMode">切回普通模�?/view>
      </view>
    </block>
    <block wx:else>
      <text class="hub-tab-page-title" wx:if="{{!isAdmin || !isAuthorized}}">{{hubView === 'orders' ? '订单' : '我的'}}</text>
      <view class="hub-tab-header-right" wx:if="{{isAuthorized && !isAdmin}}">
        <view class="admin-toggle-btn" catchtap="toggleAdminMode">管理模式</view>
      </view>
      <view class="hub-admin-mode-bar" wx:if="{{isAuthorized && isAdmin}}">
        <view class="hub-admin-exit-btn" catchtap="toggleAdminMode">切回普通模�?/view>
      </view>
    </block>
  </view>

  <!-- 子页顶栏（带返回）；枢纽内嵌时不渲染，避�?EDIT 叠到订单/我的 -->
  <view
    wx:elif="{{!showHubTabBar && !hubInShell}}"
    class="header"
    style="padding-top: {{statusBarHeight}}px; height: {{statusBarHeight + navBarHeight + 20}}px;"
  >
    <view class="back-icon" catchtap="goBack" style="top: {{statusBarHeight + navBarHeight / 2}}px;">
      <text class="back-arrow">�?/text>
    </view>
    <view class="admin-toggle-wrapper" wx:if="{{isAuthorized}}">
      <view class="admin-toggle-btn {{isAdmin ? 'on' : ''}}" catchtap="toggleAdminMode">
        {{isAdmin ? 'ADMIN' : 'EDIT'}}
      </view>
    </view>
  </view>

  <!-- === 管理员：订单发货（订�?Tab�?=== -->
  <block wx:if="{{isAdmin && hubView === 'orders' && (!hubInShell || active)}}">
    <scroll-view
      scroll-y
      class="hub-admin-scroll {{hubInShell ? 'hub-admin-scroll--shell' : ''}}"
      enhanced
      show-scrollbar="{{false}}"
    >
    <view
      class="hub-admin-orders-body {{hubInShell ? 'hub-admin-orders-body--shell' : ''}}"
      style="padding-top: {{hubInShell ? 8 : (showHubTabBar ? (statusBarHeight + navBarHeight + 8) : 0)}}px;"
    >
    <view class="admin-header-row admin-header-row--hub admin-header-row--compact" style="padding-top: {{hubInShell ? 0 : (showHubTabBar ? 12 : (statusBarHeight + navBarHeight + 20))}}px;">
      <view class="admin-page-title" wx:if="{{!showHubTabBar && !hubInShell}}">待处理订�?/view>
      <view class="admin-dev-actions admin-dev-actions--row">
        <view class="admin-dev-btn admin-dev-btn--test" bindtap="openTestPasswordModal">测试</view>
        <view class="admin-dev-btn admin-dev-btn--seed" bindtap="seedAfterSalesOrdersQuick">生成售后�?/view>
      </view>
    </view>

    <!-- 2. 待物料发�?(横向 Swiper) -->
    <swiper 
      class="order-swiper" 
      bindchange="onOrderChange" 
      circular 
      previous-margin="60rpx" 
      next-margin="60rpx"
      catchtouchstart="noop"
      catchtouchend="noop"
      style="height: {{swiperHeight}}px; transition: height 0.3s ease;"
    >
      <!-- 如果没有待物料发出订�?-->
      <swiper-item wx:if="{{pendingList.length === 0}}">
        <view class="empty-card">🎉 太棒了，所有订单都已物料发出！</view>
      </swiper-item>

      <!-- 循环 pendingList -->
      <swiper-item wx:for="{{pendingList}}" wx:key="id" wx:for-index="idx">
        <view class="order-card detail-mode {{item.guidedPartsPurchase ? 'order-card-guided-parts' : ''}}" id="card-{{idx}}">
          
          <!-- 1. 头部：修复位置不对的问题 -->
          <view class="card-header {{item.guidedPartsPurchase ? 'card-header--guided-ship' : ''}}">
            <view class="card-header-left">
              <view class="order-id-group">
                <text class="order-label">{{item.guidedPartsPurchase ? '订单编号' : '订单�?}}</text>
                <text class="order-val">{{item.orderId}}</text>
              </view>
            </view>
            <view class="card-header-right">
              <view class="status-tag {{item.realStatus}} {{item.guidedPartsPurchase ? 'status-tag-guided' : ''}}">
                <text>{{item.guidedPartsPurchase ? '引导购配件·待发出' : item.statusText}}</text>
                <block wx:if="{{item.shippingMethod}}">
                  <view class="status-divider"></view>
                  <text class="status-shipping-text">{{item.shippingMethod === 'sf' ? '顺丰' : '中�?}}{{item.shippingFeeText === '包邮' ? '包邮' : ''}}</text>
                </block>
              </view>
            </view>
          </view>

          <!-- 引导购配件：发货卡（参考设计稿：浅灰收件块 + 首行合并称呼/电话/复制 + | 配件清单�?-->
          <block wx:if="{{item.guidedPartsPurchase}}">
            <view class="guided-ship-recipient">
              <view class="guided-ship-line1">
                <view class="guided-ship-line1-main">
                  <text class="guided-ship-who">{{item.userNickname ? (item.userNickname + (item.userName ? (' (' + item.userName + ')') : '')) : (item.userName || '匿名用户')}}</text>
                  <text class="guided-ship-phone-inline">{{item.userPhone}}</text>
                </view>
                <view class="guided-ship-copy-btn" catchtap="copyOrderAddress" data-index="{{idx}}" data-address="{{item.userAddr}}" data-name="{{item.userName}}" data-phone="{{item.userPhone}}">
                  <text class="guided-ship-copy-btn-text">复制</text>
                </view>
              </view>
              <text class="guided-ship-addr">{{item.userAddr}}</text>
              <view class="guided-ship-remark" wx:if="{{item.orderRemark}}">
                <text class="guided-ship-remark-full">备注：{{item.orderRemark}}</text>
              </view>
            </view>
            <view class="goods-detail-list goods-detail-list--guided-ship">
              <view class="guided-parts-list-head">
                <view class="guided-parts-list-bar"></view>
                <text class="guided-parts-list-title">配件清单</text>
              </view>
              <block wx:for="{{item.goodsList}}" wx:for-item="g" wx:key="index">
                <view class="g-item g-item--guided-ship">
                  <view class="g-info">
                    <text class="g-n">{{g.name}}</text>
                    <text class="g-s">{{g.spec}}</text>
                  </view>
                  <view class="g-count">x{{g.quantity}}</view>
                  <view class="g-p">¥{{g.total}}</view>
                </view>
              </block>
            </view>
            <view class="card-footer-new card-footer-new--guided-ship">
              <view class="total-row total-row--guided-ship">
                <text class="time-text guided-ship-order-time">下单：{{item.createTimeShort}}</text>
                <view class="price-box">
                  <text>实付</text>
                  <text
                    class="price-num guided-ship-pay-num {{isAdmin && item.realStatus === 'PAID' ? 'editable-price' : ''}}"
                    catchtap="adminModifyPrice"
                    data-id="{{item.id}}"
                    data-price="{{item.amount}}"
                    data-status="{{item.realStatus}}">
                    ¥{{isAdmin ? 0.01 : item.amount}}
                  </text>
                </view>
              </view>
              <view
                class="admin-ship-btn admin-ship-btn-guided"
                catchtap="adminShipOrder"
                data-id="{{item.id}}"
                data-orderid="{{item.orderId}}"
                data-express="{{item.shippingMethod}}">
                录入运单号并发货（引导购配件�?              </view>
            </view>
          </block>
          <block wx:else>
            <view class="buyer-info-box">
              <view class="b-row">
                <text class="b-name" style="font-size: {{item.userNameFontSize || 30}}rpx;">{{item.userName || '匿名用户'}}</text>
                <text class="b-phone">{{item.userPhone}}</text>
              </view>
              <view class="b-nickname-row" wx:if="{{isAdmin && item.userNickname}}">
                <text class="b-nickname-label">用户昵称�?/text>
                <text class="b-nickname">{{item.userNickname}}</text>
              </view>
              <view class="b-addr-row">
                <text class="b-addr">{{item.userAddr}}</text>
                <view class="b-copy-btn" wx:if="{{isAdmin}}" bindtap="copyOrderAddress" data-index="{{idx}}" data-address="{{item.userAddr}}" data-name="{{item.userName}}" data-phone="{{item.userPhone}}">
                  <text class="b-copy-text">复制</text>
                </view>
              </view>
            </view>
            <view class="goods-detail-list">
              <view class="mini-tag">购物清单</view>
              <block wx:for="{{item.goodsList}}" wx:for-item="g" wx:key="index">
                <view class="g-item">
                  <view class="g-info">
                    <text class="g-n">{{g.name}}</text>
                    <text class="g-s">{{g.spec}}</text>
                  </view>
                  <view class="g-count">x{{g.quantity}}</view>
                  <view class="g-p">¥{{g.total}}</view>
                </view>
              </block>
            </view>
            <view class="card-footer-new">
              <view class="total-row">
                <text class="time-text">{{item.createTime}}</text>
                <view class="price-box">
                  <text>实付</text>
                  <text
                    class="price-num {{isAdmin && item.realStatus === 'PAID' ? 'editable-price' : ''}}"
                    catchtap="adminModifyPrice"
                    data-id="{{item.id}}"
                    data-price="{{item.amount}}"
                    data-status="{{item.realStatus}}">
                    ¥{{isAdmin ? 0.01 : item.amount}}
                  </text>
                </view>
              </view>
              <view
                class="admin-ship-btn"
                catchtap="adminShipOrder"
                data-id="{{item.id}}"
                data-orderid="{{item.orderId}}"
                data-express="{{item.shippingMethod}}">
                录入运单号并物料发出
              </view>
            </view>
          </block>
        </view>
      </swiper-item>
    </swiper>
    </view>
    </scroll-view>

  </block>

  <!-- === 管理员：设备审核与维修（我的 Tab�?=== -->
  <block wx:if="{{isAdmin && hubView === 'profile' && (!hubInShell || active)}}">
    <scroll-view
      scroll-y
      class="hub-admin-scroll {{hubInShell ? 'hub-admin-scroll--shell' : ''}}"
      enhanced
      show-scrollbar="{{false}}"
    >
    <view
      class="hub-admin-profile-body"
      style="padding-top: {{hubInShell ? 8 : (showHubTabBar ? (statusBarHeight + navBarHeight + 8) : 0)}}px;"
    >
    <view class="admin-profile-toolbar">
      <view class="admin-after-sales-segment">
        <view
          class="admin-after-sales-seg-item {{adminAfterSalesTab === 'repairs' ? 'is-active' : ''}}"
          bindtap="switchAdminAfterSalesTab"
          data-tab="repairs"
        >待处理报�?/view>
        <view
          class="admin-after-sales-seg-item {{adminAfterSalesTab === 'returns' ? 'is-active' : ''}}"
          bindtap="switchAdminAfterSalesTab"
          data-tab="returns"
        >
          <text>需寄回确认</text>
          <text class="admin-seg-badge" wx:if="{{returnRequiredCount > 0}}">{{returnRequiredCount > 99 ? '99+' : returnRequiredCount}}</text>
        </view>
      </view>
      <view class="admin-dev-actions">
        <view class="admin-dev-btn admin-dev-btn--test" bindtap="openTestPasswordModal">测试</view>
        <view class="admin-dev-btn admin-dev-btn--seed" bindtap="seedAfterSalesOrdersQuick">生成售后�?/view>
      </view>
    </view>

    <block wx:if="{{adminAfterSalesTab === 'repairs'}}">
    <view class="section-label repair-section-label" wx:if="{{repairList.length > 0}}">PENDING REPAIRS / 待处理报�?/view>
    <view class="admin-panel-empty" wx:if="{{repairList.length === 0}}">暂无待处理报�?/view>
    <view class="repair-list-admin">
      <block wx:for="{{repairList}}" wx:key="_id">
        <view class="repair-admin-card">
          <!-- 故障素材预览：视�?图片都支�?-->
          <block wx:if="{{item.mediaPreviewUrl}}">
            <block wx:if="{{item.isImageMedia}}">
            <image
              src="{{item.mediaPreviewUrl}}"
              mode="aspectFill"
              class="repair-image"
              bindtap="previewImage"
              data-url="{{item.mediaPreviewUrl}}"
              lazy-load="true"
            />
            </block>
            <video wx:else src="{{item.mediaPreviewUrl}}" class="repair-video" controls preload="metadata"></video>
          </block>
          <view wx:else class="repair-media-empty">素材加载失败</view>
          
          <!-- 信息 -->
          <view class="repair-info">
            <view class="r-title-row">
              <view class="r-title">{{item.displayModel || item.model}} - {{item.contact.name}}</view>
              <view class="status-tag {{item.realStatus}}" style="margin-left: 16rpx;" wx:if="{{item.shippingMethod}}">
                <text class="status-shipping-text">{{item.shippingMethod === 'sf' ? '顺丰' : '中�?}}{{item.shippingFeeText === '包邮' ? '包邮' : ''}}</text>
              </view>
            </view>
            <view class="r-desc">"{{item.description}}"</view>
            <view class="r-addr-row">
              <text class="r-addr">{{item.contact.address}}</text>
              <view 
                class="r-copy-btn" 
                bindtap="copyRepairAddress"
                data-name="{{item.contact.name}}"
                data-phone="{{item.contact.phone}}"
                data-address="{{item.contact.address}}"
              >
                <text class="r-copy-text">复制商家地址</text>
              </view>
            </view>
            <!-- 🔴 新增：质保状态显示，无质保时显示「用户质保已过期�?-->
            <view class="r-warranty-status expired" wx:if="{{item.warrantyExpired === true || (item.expiryDate && item.remainingDays === 0)}}">
              <text class="warranty-expired-tag">用户质保已过�?/text>
              <text class="warranty-expired-info" wx:if="{{item.expiryDate}}">到期日：{{item.expiryDate}}</text>
            </view>
            <view class="r-warranty-status normal" wx:elif="{{item.remainingDays !== undefined && item.remainingDays > 0}}">
              <text class="warranty-normal-tag">剩余质保：{{item.remainingDays}}�?/text>
            </view>
          </view>
          
          <!-- 需要寄回开�?-->
          <view class="repair-return-switch">
            <text class="switch-label">需要寄�?/text>
            <switch 
              checked="{{item.needReturn}}" 
              bindchange="toggleReturnRequired" 
              data-id="{{item._id}}"
              color="#007AFF"
            />
          </view>
          
          <!-- 状态显�?-->
          <view class="repair-status-info" wx:if="{{item.returnStatus === 'USER_SENT' || item.status === 'USER_SENT'}}">
            <text class="repair-status-text">用户已寄出快�?/text>
            <text class="repair-tracking-id" wx:if="{{item.returnTrackingId}}">运单号：{{item.returnTrackingId}}</text>
          </view>
          
          <!-- 操作按钮 -->
          <view class="repair-actions">
            <!-- 如果用户已寄出，显示维修完成按钮 -->
            <view class="r-btn complete" wx:if="{{item.returnStatus === 'USER_SENT' || item.status === 'USER_SENT'}}" bindtap="adminCompleteRepair" data-id="{{item._id}}">维修完成</view>
            <!-- 如果维修完成已寄出，显示状�?-->
            <view class="repair-status-info" wx:if="{{item.status === 'REPAIR_COMPLETED_SENT'}}">
              <text class="repair-status-text">维修完成已寄�?/text>
              <text class="repair-tracking-id" wx:if="{{item.trackingId}}">运单号：{{item.trackingId}}</text>
            </view>
            <!-- 其他状态：主按�?+ 次要操作（竖向排列，便于点击�?-->
            <block wx:if="{{item.returnStatus !== 'USER_SENT' && item.status !== 'USER_SENT' && item.status !== 'REPAIR_COMPLETED_SENT'}}">
              <view class="repair-actions-primary">
                <view class="r-btn ship" bindtap="resolveRepair" data-id="{{item._id}}" data-type="ship">录单备件寄出</view>
              </view>
              <view class="repair-actions-secondary repair-actions-grid">
                <view class="r-btn purchase grid-half" bindtap="openPurchasePartsModal" data-item="{{item}}">请购买配�?/view>
                <view class="r-btn tutorial grid-half" bindtap="resolveRepair" data-id="{{item._id}}" data-type="tutorial">看教程可�?/view>
                <view class="r-btn return grid-full" bindtap="requestUserReturn" data-id="{{item._id}}">需要寄回产品维�?/view>
              </view>
            </block>
          </view>
        </view>
      </block>
    </view>
    </block>

    <view class="admin-returns-inline" wx:if="{{adminAfterSalesTab === 'returns'}}">
      <view class="section-label repair-section-label">RETURN ORDERS / 需寄回确认</view>
      <template is="returnRequiredItems" />
    </view>
    </view>

    <block wx:if="{{auditList.length > 0}}">
    <view class="section-label">PENDING AUDITS / 待审核申�?/view>
    <swiper
      class="audit-swiper"
      circular
      previous-margin="60rpx"
      next-margin="60rpx"
    >
      <swiper-item wx:for="{{auditList}}" wx:key="_id">
        <view class="audit-card">
          <view class="audit-row">
            <text class="audit-model">{{item.productModel}}</text>
            <text class="audit-sn">SN: {{item.sn}}</text>
          </view>
          <view class="audit-row">
            <text class="audit-date">用户�? {{item.buyDate}}</text>
            <text class="audit-type">{{item.bindType == 'new' ? '全新' : '二手'}}</text>
          </view>
          <view class="audit-imgs">
            <image src="{{item.imgReceipt}}" mode="aspectFill" class="audit-thumb" bindtap="previewImage" data-url="{{item.imgReceipt}}" lazy-load="true" binderror="onMyAuditImageError" data-index="{{index}}" data-field="imgReceipt"></image>
            <image wx:if="{{item.imgChat}}" src="{{item.imgChat}}" mode="aspectFill" class="audit-thumb" bindtap="previewImage" data-url="{{item.imgChat}}" lazy-load="true" binderror="onMyAuditImageError" data-index="{{index}}" data-field="imgChat"></image>
          </view>
          <view class="audit-actions">
            <view class="audit-btn reject" catchtap="handleReject" data-id="{{item._id}}">拒绝</view>
            <view class="audit-btn approve" catchtap="openAuditModal" data-item="{{item}}">审核设置</view>
          </view>
        </view>
      </swiper-item>
    </swiper>
    </block>
    </scroll-view>

  </block>

  <!-- 普通用户：商城订单（订�?Tab�?-->
  <block wx:if="{{!isAdmin && hubView === 'orders' && (!hubInShell || active)}}">
    <scroll-view
      scroll-y
      class="hub-orders-scroll {{hubInShell ? 'hub-orders-scroll--shell' : ''}}"
      enhanced
      show-scrollbar="{{false}}"
    >
    <view
      class="hub-orders-body {{hubInShell ? 'hub-orders-body--shell' : ''}}"
      style="padding-top: {{hubInShell ? 0 : (showHubTabBar ? (statusBarHeight + navBarHeight + 12) : 0)}}px;"
    >
    <!-- 情况 A: 有订单，显示滑动列表 -->
    <swiper 
      wx:if="{{orders.length > 0}}"
      class="order-swiper order-swiper--hub" 
      bindchange="onOrderChange" 
      circular 
      previous-margin="60rpx" 
      next-margin="60rpx"
      catchtouchstart="noop"
      catchtouchend="noop"
      style="height: {{swiperHeight}}px; transition: height 0.3s ease;"
    >
      <swiper-item wx:for="{{orders}}" wx:key="id" wx:for-index="idx">
        <view class="order-card detail-mode" id="card-{{idx}}">
          
          <!-- 1. 头部 -->
          <view class="card-header">
            <view class="card-header-left">
              <view class="order-id-group">
                <view class="order-label-row">
                  <text class="hub-order-mt-chip hub-order-mt-chip--sm">MT</text>
                  <text class="order-label">订单�?/text>
                </view>
                <text class="order-val">{{item.orderId}}</text>
              </view>
            </view>
            <view class="card-header-right">
              <view class="status-tag {{item.realStatus}}">
                <text>{{item.statusText}}</text>
                <block wx:if="{{item.shippingMethod}}">
                  <view class="status-divider"></view>
                  <text class="status-shipping-text">{{item.shippingMethod === 'sf' ? '顺丰' : '中�?}}{{item.shippingFeeText === '包邮' ? '包邮' : ''}}</text>
                </block>
              </view>
            </view>
          </view>

          <!-- 收货信息（用户订�?Tab 内折叠为单行摘要�?-->
          <view class="order-ship-summary" wx:if="{{item.userAddr}}">
            <text class="order-ship-label">收货</text>
            <text class="order-ship-text">{{item.userName}} {{item.userPhone}} · {{item.userAddr}}</text>
          </view>

