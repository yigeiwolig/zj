                <view class="dot-f"></view>已驳�?              </view>
              
              <!-- [新增] 维修单特殊状�?-->
              
              <!-- 已维修完成（需要用户寄回的流程，管理员寄出快递后，绿色） -->
              <view class="status-pill success" wx:if="{{item.type === 'repair' && item.status === 'REPAIR_COMPLETED_SENT' && item.needReturn}}">
                <view class="dot-s"></view>已维修完�?              </view>
              
              <!-- 🔴 场景A：故障需寄回（红色） -->
              <view class="status-pill fail" wx:if="{{item.type === 'repair' && (item.status === 1 || item.status === 'SHIPPED') && item.needReturn && item.returnStatus !== 'PENDING_RETURN' && item.status !== 'REPAIR_COMPLETED_SENT'}}">
                <view class="dot-f"></view>故障需寄回
              </view>
              
              <!-- 已备件寄出（不显示运单号，运单号在查看物流按钮中�?-->
              <view class="status-pill success" wx:if="{{item.type === 'repair' && (item.status === 1 || item.status === 'SHIPPED') && item.trackingId && item.status !== 'REPAIR_COMPLETED_SENT' && !(item.needReturn && item.returnStatus !== 'PENDING_RETURN')}}">
                <view class="dot-s"></view>已寄�?              </view>
              
              <!-- 看教�?(蓝色) -->
              <view class="status-pill info" wx:if="{{item.type === 'repair' && (item.status === 1 || item.status === 'TUTORIAL') && !item.trackingId && item.status !== 'REPAIR_COMPLETED_SENT'}}">
                查看教程可修�?              </view>
              
              <!-- 🔴 场景B：已支付·待维�?- 绿色（不区分是否过保�?-->
              <view class="status-pill success" wx:if="{{item.type === 'repair' && item.needReturn && !item.returnCompleted && item.status !== 'REPAIR_COMPLETED_SENT' && item.status !== 'USER_SENT' && item.returnStatus !== 'USER_SENT' && item.returnStatus === 'PENDING_RETURN' && item.status !== 'SHIPPED' && item.repairItems && item.repairItems.length > 0 && item.repairTotalPrice > 0 && item.repairPaid === true}}">
                <view class="dot-s"></view>已支付·待维修
              </view>
              
              <!-- 🔴 场景B：待支付·需寄回 - 红色 -->
              <!-- 🔴 确保只有维修类型才显示，使用括号明确优先�?-->
              <view class="status-pill fail" wx:if="{{(item.type === 'repair') && (item.needReturn === true) && (item.returnCompleted !== true) && (item.status !== 'REPAIR_COMPLETED_SENT') && (item.status !== 'USER_SENT') && (item.returnStatus !== 'USER_SENT') && (item.returnStatus === 'PENDING_RETURN') && (item.status !== 'SHIPPED') && ((item.repairItems && item.repairItems.length > 0 && item.repairTotalPrice > 0 && item.repairPaid === false) || !(item.repairItems && item.repairItems.length > 0 && item.repairTotalPrice > 0))}}">
                <view class="dot-f"></view>
                <text wx:if="{{item.repairItems && item.repairItems.length > 0 && item.repairTotalPrice > 0}}">待支付·需寄回</text>
                <text wx:else>需寄回维修</text>
              </view>
              
              <!-- 🔴 待寄回维修（其他情况，黄色）- 排除场景A和场景B -->
              <!-- 🔴 确保只有维修类型才显示，使用括号明确优先�?-->
              <!-- 注意：此状态仅用于提示，不再在用户端点击弹出管理员的“需寄回订单确认”弹�?-->
              <view class="status-pill processing" wx:if="{{(item.type === 'repair') && (item.needReturn === true) && (item.returnCompleted !== true) && (item.status !== 'REPAIR_COMPLETED_SENT') && (item.status !== 'USER_SENT') && (item.returnStatus !== 'USER_SENT') && (item.returnStatus !== 'PENDING_RETURN') && (item.status !== 'SHIPPED')}}">
                <view class="dot-p"></view>待寄回维�?              </view>
              
              <!-- 🔴 待购配件（优先显示） -->
              <view class="status-pill fail" wx:if="{{item.type === 'repair' && (item.needPurchaseParts === true || item.needPurchaseParts === 'true' || (item.purchasePartsList && item.purchasePartsList.length > 0)) && item.purchasePartsStatus !== 'completed'}}">
                <view class="dot-f"></view>待购配件
              </view>
              
              <!-- 已购配件 -->
              <view class="status-pill success" wx:if="{{item.type === 'repair' && item.purchasePartsStatus === 'completed'}}">
                <view class="dot-s"></view>已购配件
              </view>
              
              <!-- 审核中（非需寄回状态，且不需要购买配件） -->
              <view class="status-pill processing" wx:if="{{item.type === 'repair' && (item.status === 0 || item.status === 'PENDING') && item.status !== 'USER_SENT' && item.returnStatus !== 'USER_SENT' && item.status !== 'REPAIR_COMPLETED_SENT' && !item.needReturn && !item.needPurchaseParts && (!item.purchasePartsList || item.purchasePartsList.length === 0)}}">
                <view class="dot-p"></view>审核�?              </view>
              
              <!-- 待确认收货（场景A：用户已寄出快递后�?-->
              <view class="status-pill processing" wx:if="{{item.type === 'repair' && (item.status === 'USER_SENT' || item.returnStatus === 'USER_SENT') && item.returnStatus !== 'PENDING_RETURN' && item.status !== 'REPAIR_COMPLETED_SENT' && !item.warrantyDeducted && !item.isWarrantyDeducted && item.status !== 'RETURN_RECEIVED' && item.status !== 'COMPLETED'}}">
                <view class="dot-p"></view>待确认收�?              </view>
              
              <!-- 已支付·待维修 - 场景B：用户已寄出快递后且已支付（绿色，不区分是否过保） -->
              <view class="status-pill success" wx:if="{{item.type === 'repair' && (item.status === 'USER_SENT' || item.returnStatus === 'USER_SENT') && item.returnStatus === 'PENDING_RETURN' && item.status !== 'REPAIR_COMPLETED_SENT' && item.repairItems && item.repairItems.length > 0 && item.repairTotalPrice > 0 && item.repairPaid === true}}">
                <view class="dot-s"></view>已支付·待维修
              </view>
              
              <!-- 正在维修中（场景B：用户已寄出快递后，未支付或其他情况） -->
              <view class="status-pill processing" wx:if="{{item.type === 'repair' && (item.status === 'USER_SENT' || item.returnStatus === 'USER_SENT') && item.returnStatus === 'PENDING_RETURN' && item.status !== 'REPAIR_COMPLETED_SENT' && !(item.repairItems && item.repairItems.length > 0 && item.repairTotalPrice > 0 && item.repairPaid === true)}}">
                <view class="dot-p"></view>正在维修�?              </view>
              
              <!-- 售后完结（场景A：管理员确认收货后） -->
              <view class="status-pill success" wx:if="{{item.type === 'repair' && (item.status === 'RETURN_RECEIVED' || item.status === 'COMPLETED') && item.returnStatus !== 'PENDING_RETURN'}}">
                <view class="dot-s"></view>售后完结
              </view>
              
              <!-- 已维修完成（场景B：管理员确认收货后） -->
              <view class="status-pill success" wx:if="{{item.type === 'repair' && (item.status === 'RETURN_RECEIVED' || item.status === 'COMPLETED') && item.returnStatus === 'PENDING_RETURN'}}">
                <view class="dot-s"></view>已维修完�?              </view>
              
              <!-- 扣除质保状态（样式优化�?-->
              <view class="status-pill multi-line fail" wx:if="{{item.type === 'repair' && (item.warrantyDeducted || item.isWarrantyDeducted)}}">
                <view class="status-line">
                  <text class="status-text-main" wx:if="{{item.deductionReason === '配件错误' || item.deductionReason === 'wrong_part'}}">配件错误</text>
                  <text class="status-text-main" wx:elif="{{item.deductionReason === '超时' || item.deductionReason === 'timeout'}}">超时未寄</text>
                  <text class="status-text-main" wx:else>已扣质保</text>
                  <text class="status-text-sub">已扣除半年质保（180天）</text>
                </view>
              </view>
            </view>
          </view>
          
          <!-- 维修进度按钮区：备件已发出可查物流、维修完成可查维修单；填写寄回请使用页顶需寄回卡片 -->
          <view class="logistics-btn-wrapper {{item.repairActTwoCol ? 'two-btn' : ''}}" wx:if="{{item.type === 'repair' && item.showRepairActRow}}">
            <view class="btn-logistics-action" wx:if="{{item.showLogisticsRepairBtn}}" catchtap="viewLogisticsDetail" data-sn="{{item.trackingId}}" data-tail-required="2427" data-phone="{{item.contact && item.contact.phone ? item.contact.phone : ''}}">
              查看物流
            </view>
            <view class="btn-logistics-action btn-repair-order" wx:if="{{item.showRepairOrderBtn}}" catchtap="viewRepairOrderDetail" data-item="{{item}}">
              查看维修�?            </view>
          </view>
          <view class="logistics-btn-wrapper" wx:if="{{item.type === 'repair' && item.showTutorialJumpBtn}}">
            <view class="btn-logistics-action btn-tutorial-jump" catchtap="goToShouhouTutorialFromActivity" data-item="{{item}}">
              跳转教程
            </view>
          </view>
          
          <!-- 🔴 拒绝理由独立显示在下方，完全不影响上面的布局 -->
          <view class="reject-reason-wrapper" wx:if="{{(item.status === -1 || item.status === 'REJECTED') && item.rejectReason}}">
            <view class="reject-reason">
              <text class="reason-label">拒绝理由�?/text>
              <text class="reason-text">{{item.rejectReason}}</text>
            </view>
          </view>

        </view>
      </block>
    </view>
    <!-- 👆👆👆【核心补全】结�?👆👆👆 -->

    <view class="profile-action-list">
      <view class="profile-action-btn" bindtap="goToRepairService">预约维修服务</view>
      <view class="profile-action-btn profile-action-btn--primary" bindtap="goToCustomerService">联系在线客服</view>
    </view>
    </view>
    </scroll-view>
  </block>

  <root-portal enable="{{hubInShell}}">
  <view class="hub-embed-portal-layer">
  <!-- 5. 绑定模态框 -->
  <view class="modal {{showModal ? 'show' : ''}}" catchtouchmove="noop">
    <!-- 当蓝牙连接成功时，加�?connected 类，触发整张卡片的二次上滑动�?-->
    <view class="modal-content {{bluetoothReady ? 'connected' : ''}}" catchtouchmove="noop">
      
      <!-- 1. 文案修改：绑定设�?-->
      <view class="modal-header">
        <text>绑定设备</text>
        <view class="close-modal" bindtap="closeBindModal">�?/view>
      </view>

      <scroll-view scroll-y="true" class="modal-scroll-area">
        
        <!-- === 2. 蓝牙扫描按钮 (雷达) === -->
        <!-- 只有未连接时显示 -->
        <view class="bt-scan-container" wx:if="{{!bluetoothReady}}">
          <view class="radar-circle" bindtap="startConnect">
            <view class="radar-core">
              <!-- 👇👇👇【核心修改】换成图�?👇👇👇 -->
              <image class="bt-icon-img" src="data:image/svg+xml;base64," mode="aspectFit" lazy-load="true"></image>
            </view>
            
            <!-- 波纹动画 (保持结构，样式下面重�? -->
            <view class="radar-ring r1 {{isScanning?'anim':''}}"></view>
            <view class="radar-ring r2 {{isScanning?'anim':''}}"></view>
            <view class="radar-ring r3 {{isScanning?'anim':''}}"></view>
          </view>
          <text class="radar-tip">{{connectStatusText}}</text>
        </view>

        <!-- === 3. 连接成功后的状态条 === -->
        <view class="bt-connected-bar" wx:if="{{bluetoothReady}}">
          <view class="bt-c-icon">�?/view>
          <view class="bt-c-info">
            <text class="bt-c-name">已连接设�?/text>
            <text class="bt-c-sn">{{connectedDeviceName}}</text>
          </view>
          <view class="bt-disconnect-btn" bindtap="resetBluetoothState">断开</view>
        </view>

        <!-- === 4. Tab 切换 (逻辑修改：连上蓝牙后才显示！) === -->
        <!-- 🔴 强制显示：只�?bluetoothReady �?true 就显�?-->
        <view class="bind-verifying-tip" wx:if="{{bluetoothReady && !showBindAuditForm && !lockedReason}}">
          <text>正在验证设备�?/text>
          <text class="bind-verifying-sub">预登记设备将自动激活绑定，无需上传审核资料</text>
        </view>

        <view class="type-tabs" wx:if="{{bluetoothReady && showBindAuditForm}}">
          <view class="tab-item {{bindType == 'new' ? 'active' : ''}}" bindtap="changeBindType" data-type="new">全新设备</view>
          <view class="tab-item {{bindType == 'used' ? 'active' : ''}}" bindtap="changeBindType" data-type="used">二手/旧设�?/view>
        </view>

        <!-- === 5. 被锁状�?=== -->
        <!-- 🔴 修复：只有在有锁定原因时才显�?无法绑定"，验证中不显�?-->
        <view class="locked-view" wx:if="{{bluetoothReady && isDeviceLocked && lockedReason}}">
          <view class="locked-icon">🚫</view>
          <text class="locked-title">无法绑定</text>
          <text class="locked-desc">{{lockedReason}}</text>
        </view>

        <!-- === 6. 正常填表区域 (强制显示：只�?bluetoothReady �?true 就显�? === -->
        <!-- 🔴 强制显示表格，只要蓝牙连接成功就显示，不允许消失 -->
        <view class="bind-form-area" wx:if="{{bluetoothReady && showBindAuditForm}}">
          
          <view class="form-item">
            <text class="form-label">选择产品型号</text>
            <picker bindchange="onModelChange" range="{{modelOptions}}" value="{{modelIndex}}">
              <view class="picker-val">{{modelOptions[modelIndex] || '请选择型号'}}</view>
            </picker>
          </view>

          <view class="form-item">
            <text class="form-label">{{bindType == 'new' ? '订单截图' : '上传凭证 (购买截图 + 聊天记录)'}}</text>
            <view class="upload-group">
              <view class="upload-box" bindtap="chooseProofImage" data-type="receipt">
                <!-- 背景占位：始终显�?+ 和文案，图片会覆盖在上面 -->
                <view class="upload-placeholder-center">
                  <text class="plus-icon">+</text>
                  <text>购买截图</text>
                </view>
