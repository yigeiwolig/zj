          <view class="form-item">
            <text class="form-label">购买日期</text>
            <picker mode="date" bindchange="onDateChange">
              <view class="picker-val">{{buyDate || '请选择日期'}}</view>
            </picker>
          </view>
        </view>
        
        <view style="height: 40rpx;"></view>
      </scroll-view>

      <!-- 底部提交按钮 -->
      <!-- 🔴 强制显示：只�?bluetoothReady �?true 就显示提交按�?-->
      <view class="modal-footer" wx:if="{{bluetoothReady && showBindAuditForm}}">
